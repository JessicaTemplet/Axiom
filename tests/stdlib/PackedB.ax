(import Str)

(pub struct Frame
  (value : String)
  (first : UInt32)
  (second : UInt16))

(pub :: packedB (-> Int Frame))
(pub fn (packedB n)
  (Frame (concat "right" " frame") (as n UInt32) (as 65535 UInt16)))

(pub :: packedBRead (-> Frame Int))
(pub fn (packedBRead frame)
  (+ (as frame.first Int) (strLen frame.value)))
