; exit 63 (see .exit)
; MM-LIFE-2e: released blocks on both sides of 64 KiB are reused
; and scrubbed. The 2 KiB and 4 KiB requests remain separate classes.
(:: b2i (-> Bool Int))
(fn (b2i x)
  (if x
    1
    0))

(:: main Int)
;@axiom:effect(unsafe)
(fn (main)
  {
    (let h1 (__alloc 2048))
    (let mut acc 0)
    (let mut steps 0)
    {
      (__store64 h1 0 999999)
      (__store64 h1 255 999999)
      (__retain h1)
      (__release h1)
      {
        (let h2 (__alloc 2048))
        {
          (set acc (+ acc (* 32 (b2i (== h2 h1)))))
          ; guarded by the reuse itself: a FRESH block reads zero for
          ; reasons that have nothing to do with the scrub, and an
          ; unguarded term would pass on a compiler that pools nothing
          (set acc (+ acc
                     (* 16
                       (b2i (&& (== h2 h1) (&& (== (__load64 h2 0) 0) (== (__load64 h2 255) 0)))))))
          (set steps (+ steps 1))
          (__retain h2)
          (__release h2)
          {
            (let h3 (__alloc 4096))
            {
              (set acc (+ acc
                         (* 8
                           (b2i
                             (if (== h3 h2)
                               false
                               true)))))
              (set steps (+ steps 1))
            }
          }
        }
      }
      {
        (let b1 (__alloc 65552))
        {
          (__retain b1)
          (__release b1)
          {
            (let b2 (__alloc 65552))
            {
              (set acc (+ acc (* 4 (b2i (== b2 b1)))))
              (set steps (+ steps 1))
            }
          }
        }
      }
      {
        (let c1 (__alloc 65536))
        {
          (__retain c1)
          (__release c1)
          {
            (let c2 (__alloc 65536))
            {
              (set acc (+ acc (* 2 (b2i (== c2 c1)))))
              (set steps (+ steps 1))
            }
          }
        }
      }
      (if (== steps 4)
        (+ acc 1)
        acc)
    }
  })
