; Deterministic UUID properties across both versions and timestamps on
; both sides of the signed high-word boundary. RFC examples live in 970.
(import IO)
(import Err)
(import Str)
(import Uuid)

(:: roundtrips (-> Uuid Bool))
(fn (roundtrips uuid)
  (&&
    (match (uuidParse (uuidToString uuid))
      ((Ok parsed) (uuidEq parsed uuid))
      ((Err _) false))
    (match (uuidFromBytes (uuidBytes uuid))
      ((Ok parsed) (uuidEq parsed uuid))
      ((Err _) false))))

(:: correctShape (-> Uuid Int Bool))
(fn (correctShape uuid version)
  (&& (== (uuidVersion uuid) version) (== (& (strByte (uuidBytes uuid) 8) 192) 128)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let mut failures 0)
    (for index in 0..2048
      {
        (let seed (- (* index 982451653) 1000000000000))
        (let timestamp (* index 100000000000))
        (let v4 (uuidV4Seeded seed))
        (let v7 (uuidV7Seeded seed timestamp))
        (if (! (&& (roundtrips v4) (correctShape v4 4)))
          (set failures (+ failures 1)))
        (if (! (&& (roundtrips v7) (correctShape v7 7)))
          (set failures (+ failures 1)))
        (if (! (uuidEq v4 (uuidV4Seeded seed)))
          (set failures (+ failures 1)))
        (match (uuidTimestampMs v7)
          ((Some actual)
            (if (!= actual timestamp)
              (set failures (+ failures 1)))
          )
          ((None)
            (set failures (+ failures 1))
          ))
        (if (>= (uuidCompare v7 (uuidV7Seeded seed (+ timestamp 1))) 0)
          (set failures (+ failures 1)))
      })
    (if (>= (uuidCompare (uuidV7Seeded -1 140737488355327) (uuidV7Seeded -1 140737488355328)) 0)
      (set failures (+ failures 1)))
    (match (uuidTimestampMs (uuidV7Seeded -9223372036854775808 -1))
      ((Some timestamp)
        (if (!= timestamp 281474976710655)
          (set failures (+ failures 1)))
      )
      ((None)
        (set failures (+ failures 1))
      ))
    (match (uuidTimestampMs (uuidV7Seeded 9223372036854775807 281474976710656))
      ((Some timestamp)
        (if (!= timestamp 0)
          (set failures (+ failures 1)))
      )
      ((None)
        (set failures (+ failures 1))
      ))
    (println failures)
    failures
  })
