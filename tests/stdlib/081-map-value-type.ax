; A `(Map v)` names its value type, and `mapGet` answers it.
;
; `(mapGet m key dflt)` answers the value under `key`, or `dflt` when
; the key is absent, and both are the table's own `v`. So a default
; can't choose the result type: over a `(Map Int)`,
; `(strLen (mapGet ints 1 "absent"))` is a type error at the default
; (tests/diagnostics/354-map-value-type.ax), where an untyped table let
; it check and then read an integer as a string's header.
;
; THIS FIXTURE IS THE POSITIVE HALF: a `(Map Int)` and a `(Map String)`
; each read back what they hold, and an absent key answers the default.
(import Map)
(import IO)
(import Fmt)
(import Str)

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let ints mapNew)
    (let strs mapNew)
    {
      (mapInsert ints 1 100000000)
      (mapInsert strs 2 "interned")
      ; each table answers its own value type
      (println (fmtInt (mapGet ints 1 (- 0 1))))
      (println (mapGet strs 2 "absent"))
      ; and an absent key answers the default, on both
      (println (fmtInt (mapGet ints 99 (- 0 7))))
      (println (mapGet strs 99 "missing"))
    }
  })
