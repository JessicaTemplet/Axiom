(import IO)

(type Real = Float)

(type Step = (-> Int Int))

(:: inc (-> Int Int))
(fn (inc n)
  (+ n 1))

(:: main ())
;@axiom:effect(io)
(fn (main)
  (println
    (if (&&
          (== (as 42 Real) 42.0)
          (&&
            (== (as 3.75 Int) 3)
            (&&
              (== (__floatToBits 1.0) 4607182418800017408)
              (&&
                (== (__floatFromBits 4607182418800017408) 1.0)
                (==
                  (let ((f (as inc Step)))
                    (f 41))
                  42)))))
      "as conversions and aliases: correct"
      "wrong conversion")))
