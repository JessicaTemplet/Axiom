; Standard Result dispatch keeps Err's constructor and Error identities.
(import IO)
(import Str)
(import Err)

(data Result (a b)
  (Err a)
  (Ok b))

(struct Error word shared
  (code : Int))

(:: localResult (-> Bool (Result String Int)))
(fn (localResult fails)
  (if fails
    (Err (concat "local " "payload"))
    (Ok 42)))

(:: main (Err::Result Int Err::Error))
;@axiom:effect(io)
(fn (main)
  {
    (println
      (match (localResult true)
        ((Err text)
          (if (strEq text "local payload")
            "local Result payload: correct"
            "wrong")
        )
        ((Ok _) "wrong")))
    (println
      (match (localResult false)
        ((Err _) "wrong")
        ((Ok n)
          (if (== n 42)
            "local Result constructor order: correct"
            "wrong")
        )))
    (Err::Err (Err::mkError 7 "nominal error dispatch"))
  })
