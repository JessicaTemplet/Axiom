; INT_MIN % -1 answers 0: a remainder by -1 is 0 for every dividend,
; so the emitter rewrites that divisor to 1 and `srem` never sees its
; one overflowing pair. `/` on the same pair still traps 83, which
; `695-intmin-div-trap.ax` covers.
(import IO)

(:: intmin Int)
(fn (intmin)
  (- (- 0 9223372036854775807) 1))

(:: negone Int)
(fn (negone)
  (- 0 1))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println (% intmin negone))
    (println (% 7 negone))
    (println (% intmin 3))
    0
  })
