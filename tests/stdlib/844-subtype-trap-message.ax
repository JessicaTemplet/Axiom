; A value outside a subtype's range stops the program with status 80,
; and the message is a line of its own: the backtrace header starts on
; the next line, as it does after every other trap's message. `.err`
; pins the stderr up to that header, which the runner can only find
; when it begins a line.
(import IO)

(subtype Port is Int range 0..65536)

(:: portOf (-> Port Int))
(fn (portOf p)
  (+ p 0))

(:: tooBig Int)
(fn (tooBig)
  70000)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println (portOf 8080))
    (println (portOf tooBig))
    ; Not reached, and not a `println` or a bare number: the stdlib
    ; output verifier reads either as a claim about the run, and this
    ; one ends in the trap.
    (writeStr stdout "UNREACHABLE: the subtype check let 70000 through\n")
  })
