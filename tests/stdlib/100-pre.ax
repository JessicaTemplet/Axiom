; The prelude's two derivers, imported by name and invoked at the top
; level: `deriveEq` writes `eqColour`, and `deriveArity` writes
; `arityShape`.
(import Pre (deriveEq deriveArity))
(import IO)
(import Fmt)

(data Colour
  (Red)
  (Green))

(data Shape
  (Dot)
  (Circle Int)
  (Rect Int Int))

(deriveEq Colour)

(deriveArity Shape)

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  {
    (if (eqColour Red Red) (println "Red is Red"))
    (if (! (eqColour Red Green)) (println "Red is not Green"))
    (println (concat "a Rect has " (fmtInt (arityShape (Rect 2 3)))))
    (println (concat "a Dot has " (fmtInt (arityShape Dot))))
    0
  })
