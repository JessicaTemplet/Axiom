(import IO)

(struct Box
  (send : (-> Int Int)))

(:: apply (-> (-> Int Int) Int Int))
;@axiom:nolint(AX3051)
;@axiom:restrict(no-io)
(fn (apply f x)
  (f x))

(:: forward (-> (-> Int Int) Int Int))
(fn (forward f x)
  {
    (let alias f)
    (apply alias x)
  })

(:: captured (-> (-> Int Int) Int Int))
(fn (captured f x)
  (apply (lambda (n) (f n)) x))

(:: readBox (-> Box Int))
;@axiom:restrict(no-cast:deep)
(fn (readBox box)
  (box.send 1))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let offset 40)
    (let box (Box :send (lambda (n) (+ offset n))))
    (println (+ (readBox box) 1))
    (println (forward (lambda (n) (+ n 1)) 41))
    (println (captured (lambda (n) (+ n 1)) 41))
    0
  })
