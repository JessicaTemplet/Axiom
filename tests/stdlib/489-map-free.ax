; Map.ax teardown: a map is released exactly once, at scope end.
;
; There is no hand free: `mapFree` left the public library, because an
; early drop could free a block a caller still used. A let-bound map
; is released when its scope ends (MM-LIFE-2c event 3), so 100
; build-and-drop iterations in each spelling (sized and nullary) must
; still exit 0: a release spent twice corrupts the header count, and
; the corruption accumulates. The sized spelling double-freed on
; trunk when it was freed by hand (issue #35); the nullary spelling's
; leak masked it there.
(import IO)
(import Map)

(:: eqInt (-> String Int Int Int))
;@axiom:effect(io)
(fn (eqInt name got want)
  (if (== got want)
    {
      (println "ok   {name}")
      0
    }
    {
      (println "FAIL {name} got={got} want={want}")
      1
    }))

; Build a sized map and let its scope release it.
(:: buildDropSized (-> Int Int))
(fn (buildDropSized n)
  (let ((m (mapWithCapacity 32)) (mut i 0))
    {
      (while (< i n)
        { (mapInsert m i (strDup "hello world hello world")) (set i (+ i 1)) })
      (mapLen m)
    }))

; Build a nullary map and let its scope release it.
(:: buildDropNullary (-> Int Int))
(fn (buildDropNullary n)
  (let ((m mapNew) (mut i 0))
    {
      (while (< i n)
        { (mapInsert m i (strDup "hello world hello world")) (set i (+ i 1)) })
      (mapLen m)
    }))

(:: loop (-> Int Int Int))
(fn (loop sized n)
  (if (== n 0)
    0
    {
      (if (== sized 1)
        (buildDropSized 32)
        (buildDropNullary 32))
      (loop sized (- n 1))
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let (
    (mut bad 0)
    (mut n 0)
  )
    {
      (set bad (+ bad (eqInt "sized count" (buildDropSized 1) 1)))
      (set bad (+ bad (eqInt "nullary count" (buildDropNullary 1) 1)))
      (set n (+ n 2))
      (loop 1 100)
      (loop 0 100)
      (println "checks {n}")
      (println "failures {bad}")
      bad
    }))
