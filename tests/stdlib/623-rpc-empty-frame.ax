; A frame whose body is empty is a message, not the end of the stream.
;
; `Content-Length: 0` is a whole frame with the empty string as its
; body. `rpcRead` answers `Some` the body of every whole frame, the
; empty one included, and `None` only when no whole frame is left
; (tests/fuzz/lsp/empty-body.lspfuzz is the server's half).
(import IO)
(import Err)
(import Rpc)
(import Str)

(:: show (-> String (Option String) Int))
;@axiom:effect(io)
(fn (show label got)
  (match got
    ((Some body)
      (let ((n (strLen body)))
        (println "{label}: Some, {n} bytes: [{body}]"))
    )
    ((None) (println "{label}: None"))))

(pub :: main Int)
;@axiom:effect(io)
(pub fn (main)
  (let ((path "axiom-rpc-empty-frame.tmp"))
    {
      (let ((_ (writeFile path "Content-Length: 0\r\n\r\nContent-Length: 2\r\n\r\n{}Content-Length: 0\r\n\r\n")))
        ())
      (match (openPath path oRdonly)
        ((Err e) (die "open for read failed" 1))
        ((Ok f)
          (let ((r (rdNew f)))
            {
              (show "first, empty" (rpcRead r))
              (show "second" (rpcRead r))
              (show "third, empty and last" (rpcRead r))
              (show "end of the stream" (rpcRead r))
              (let ((_ (fileClose f)))
                ())
            })
        ))
      (unwrapOr (removeFile path) 0)
      0
    }))
