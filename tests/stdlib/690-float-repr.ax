; Float's printer against Python's repr, and every printed value read
; back to the same bits. The input (690-float-repr.in) is
; "<bits> <repr>" per line, written by tests/stdlib/tools/float_vectors.py:
; uniformly random encodings, short decimals at every scale, and every
; power of two and ten with its two neighbours.
(import IO)
(import Str)
(import Err)
(import Fmt)
(import Vec)
(import Float)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (match (readAll stdin)
    ((Err e) (die (errorText e) 1))
    ((Ok text)
      {
        (let lines (strSplit text 10))
        (let mut checked 0)
        (let mut wrong 0)
        {
          (for i in 0..(vecLen lines)
            {
              (let line (vecGet lines i))
              (if (! (== (strLen line) 0))
                {
                  (let fields (strSplit line 32))
                  (match (strParseInt (vecGet fields 0))
                    ((None) (die (concat "bad line: " line) 1))
                    ((Some bits)
                      {
                        (let want (vecGet fields 1))
                        (let got (floatToString (floatFromBits bits)))
                        {
                          (set checked (+ checked 1))
                          (if (! (strEq got want))
                            {
                              (set wrong (+ wrong 1))
                              (println
                                (concat "FAIL print "
                                  (concat (fmtInt bits)
                                    (concat ": got " (concat got (concat ", want " want))))))
                            }
                            (match (floatParse got)
                              ((Ok y)
                                (if (! (== (floatToBits y) bits))
                                  {
                                    (set wrong (+ wrong 1))
                                    (println (concat "FAIL read back " got))
                                  })
                              )
                              ((Err _)
                                {
                                  (set wrong (+ wrong 1))
                                  (println (concat "FAIL read back " got))
                                }
                              )))
                        }
                      }
                    ))
                })
            })
          (println (concat "values: " (fmtInt checked)))
          (println (concat "wrong: " (fmtInt wrong)))
          (if (== wrong 0)
            0
            1)
        }
      }
    )))
