; Label order controls evaluation; declaration order controls storage.
(import IO)
(import Vec)
(import Str)
(import NominalA)
(import NominalB)

(struct NamedPair
  (left : Int)
  (right : Int))

(struct NamedBox (a)
  (value : a)
  (count : Int))

(struct NamedPacked
  (mut flag : UInt8)
  (total : Int32))

(struct NamedTicket word
  (slot : Int))

(macro (makeNamed left right) (NamedPair :left left :right right))

(:: mark (-> (Vec Int) Int Int))
(fn (mark seen value)
  {
    (vecPush seen value)
    value
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let seen vecNew)
    (let pair (NamedPair :right (mark seen 20) :left (mark seen 10)))
    (println (+ pair.left pair.right))
    (println (vecGet seen 0))
    (println (vecGet seen 1))
    (let boxed (NamedBox :count 42 :value (concat "named" " fields")))
    (println boxed.value)
    (println boxed.count)
    (let generated (makeNamed 19 23))
    (println (+ generated.left generated.right))
    (let packed (NamedPacked :total (as 42 Int32) :flag (as 1 UInt8)))
    (set packed.flag (as 255 UInt8))
    (println (as packed.flag Int))
    (println (as packed.total Int))
    (let ticket (NamedTicket :slot 42))
    (println ticket.slot)
    (let a (NominalA::Config :pad 0 :item (aMake 42)))
    (let b (NominalB::Config :item (bMake "typed") :pad 0))
    (println (aConfigRead a))
    (println (bConfigRead b))
    (let piped (|> 40 (NamedPair :right 2 :left _)))
    (println (+ piped.left piped.right))
    (let makePair (NamedPair :right _ :left _))
    (let fromHoles (makePair 2 40))
    (println fromHoles.left)
    (println fromHoles.right)
    (let makeCounted (NamedPair :right (mark seen 3) :left _))
    (println (vecLen seen))
    (let first (makeCounted 39))
    (let second (makeCounted 40))
    (println (+ first.left first.right))
    (println (+ second.left second.right))
    (println (vecLen seen))
    ()
  })
