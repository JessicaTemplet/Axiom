; Large leaves, arrays and mapped records reuse their capacity class.
(import IO)
(import Mem)
(import Str)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (main)
  {
    (let mut failures 0)
    (let p (memAlloc 65552))
    (__store64 p 0 123)
    (__store64 p 8193 456)
    (__retain p)
    (let filed (__axiom_mem_stat 1))
    (__release p)
    (if (! (== (- (__axiom_mem_stat 1) filed) 131104))
      (set failures (+ failures 1)))
    (let q (memAlloc 90000))
    (if (! (&& (== p q) (&& (== (__load64 q 0) 0) (== (__load64 q 8193) 0))))
      (set failures (+ failures 2)))
    (if (! (== (__axiom_mem_stat 1) filed))
      (set failures (+ failures 4)))
    (let child (memAlloc 16))
    (__retain child)
    (__retain child)
    (let array (memMarkArray (memAlloc 200000) 25000))
    (__store64 array 0 child)
    (__store64 array 24999 child)
    (__retain array)
    (__release array)
    (if (! (< (__load64 (- child 16) 0) 0))
      (set failures (+ failures 8)))
    (let recycled (memAlloc 250000))
    (if (! (&& (== recycled array) (== (__load64 recycled 24999) 0)))
      (set failures (+ failures 16)))
    (let mappedChild (memAlloc 32))
    (__retain mappedChild)
    (let mapped (memAllocMapped 270000 (<< 1 40)))
    (__store64 mapped 40 mappedChild)
    (__retain mapped)
    (__release mapped)
    (if (! (< (__load64 (- mappedChild 16) 0) 0))
      (set failures (+ failures 32)))
    ; Replacing a growing string crosses large capacity classes without
    ; accumulating one unreusable buffer for each intermediate length.
    (let piece (strAlloc 9000))
    (let mut text "")
    (let mut i 0)
    (while (< i 128)
      {
        (set text (concat text piece))
        (set i (+ i 1))
      })
    (if (! (== (strLen text) 1152000))
      (set failures (+ failures 64)))
    (if (> (__axiom_mem_stat 2) 16777216)
      (set failures (+ failures 128)))
    (println failures)
    failures
  })
