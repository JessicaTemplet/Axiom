; A dropped TCP client signals EOF; a dropped listener closes its
; descriptor. The descriptor count is read from /dev/fd.
(import IO)
(import Net)
(import Sys)
(import Err)
(import Str)
(import Vec)

(:: openCount Int)
;@axiom:effect(io)
(fn (openCount)
  (vecLen (unwrapOr (listDir "/dev/fd") vecNew)))

(:: roundTrip (-> SocketAddr Int))
;@axiom:effect(io)
(fn (roundTrip addr)
  (match (tcpListenAddr addr)
    ((Ok listener)
      (match (tcpListenerLocalAddr listener)
        ((Ok local)
          (match (tcpConnectAddr local)
            ((Ok client)
              (match (tcpAccept listener)
                ((Ok peer)
                  {
                    (let ((_ (tcpWrite client "hello")))
                      ())
                    (let ((_ (tcpClose client)))
                      ())
                    (match (tcpReadAll peer)
                      ((Ok s) (println (strEq s "hello")))
                      ((Err e) (die (errorText e) 1)))
                    0
                  }
                )
                ((Err e) (die (errorText e) 1)))
            )
            ((Err e) (die (errorText e) 1)))
        )
        ((Err e) (die (errorText e) 1)))
    )
    ((Err e) (die (errorText e) 1))))

(:: automaticClient (-> SocketAddr Int))
;@axiom:effect(io)
(fn (automaticClient addr)
  (match (tcpConnectAddr addr)
    ((Ok client) 0)
    ((Err e) (die (errorText e) 1))))

(:: eofAfterDrop (-> SocketAddr Int))
;@axiom:effect(io)
(fn (eofAfterDrop addr)
  (match (tcpListenAddr addr)
    ((Ok listener)
      (match (tcpListenerLocalAddr listener)
        ((Ok local)
          {
            (automaticClient local)
            (match (tcpAccept listener)
              ((Ok peer)
                (match (tcpReadSome peer 1)
                  ((Ok s) (println (== (strLen s) 0)))
                  ((Err e) (die (errorText e) 1)))
              )
              ((Err e) (die (errorText e) 1)))
            0
          }
        )
        ((Err e) (die (errorText e) 1)))
    )
    ((Err e) (die (errorText e) 1))))

(:: main ())
;@axiom:effect(io)
(fn (main)
  (match (socketAddrParse "127.0.0.1:0")
    ((Ok addr)
      (let ((before openCount))
        {
          (roundTrip addr)
          (println (== openCount before))
          (eofAfterDrop addr)
        })
    )
    ((Err e) (die (errorText e) 1))))
