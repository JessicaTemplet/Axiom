; The unit type and the else-less `if`. `trace` records what ran; each
; line prints what a form answered or did.
(import IO)
(import Str)
(import Vec)
(import Fmt)

; A procedure: declared to answer `()`, so its body's value (the Vec
; `vecPush` answers) is dropped.
(:: note (-> (Vec String) String ()))
(fn (note trace s)
  (vecPush trace s))

; No else: `(if t b)` runs `b` when `t` holds.
(:: classify (-> (Vec String) Int ()))
(fn (classify trace n)
  {
    (if (> n 0)
      (note trace "pos"))
    (if (< n 0)
      (note trace "neg")
      (== n -100)
      (note trace "never"))
    (if (== n 0)
      {
        (note trace "zero")
        (note trace "still zero")
      })
  })

; A `()` arm makes the match answer `()`; the other arm's String is
; dropped and released.
(:: describe (-> (Vec String) (Option Int) ()))
(fn (describe trace o)
  (match o
    ((Some v) (concat "had " (fmtInt v)))
    (_ (note trace "none"))))

; `()` is a value: bind it, pass it, answer it.
(:: unitArg (-> () Int))
(fn (unitArg u)
  7)

(:: joined (-> (Vec String) String))
(fn (joined xs)
  {
    (let mut out "")
    (let mut i 0)
    {
      (while (< i (vecLen xs))
        {
          (set out (if (== i 0)
            (vecGet xs i)
            (concat (concat out ",") (vecGet xs i))))
          (set i (+ i 1))
        })
      out
    }
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let t vecNew)
    {
      (classify t 5)
      (classify t -3)
      (classify t 0)
      (describe t (Some 4))
      (describe t None)
      {
        (let u ())
        (println (unitArg u))
      }
      (println
        (unitArg
          (if false
            (println "no"))))
      (println (joined t))
    }
  })
