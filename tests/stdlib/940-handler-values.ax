; Handler calls inherit the installation's outer handlers. A handler
; parameter forwards the effects of its argument, and a built-in-only
; handle does not evaluate its unused handler expression.
(import IO)

(effect Trigger
  (trigger :: (-> Int Int)))

(effect Outer
  (outer :: (-> Int Int)))

(:: install (-> (-> Int Int) Int))
(fn (install h)
  (handle
    (trigger 7)
    (Trigger Alloc)
    h))

(:: forward (-> Int Int))
(fn (forward n)
  (outer n))

(:: nestedLocal Int)
(fn (nestedLocal)
  {
    (let h (lambda (n) (outer n)))
    (handle
      (handle
        (trigger 5)
        (Trigger Alloc)
        h)
      (Outer Alloc)
      (lambda (n) (* n 10)))
  })

(:: nestedParameter Int)
(fn (nestedParameter)
  (handle
    (install forward)
    (Outer Alloc)
    (lambda (n) (* n 10))))

(:: ignoredHandler Int)
;@axiom:restrict(no-io)
(fn (ignoredHandler)
  (handle
    42
    (Pure)
    (lambda (n)
      {
        (println "unused")
        n
      }
    )))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println nestedLocal)
    (println nestedParameter)
    (println ignoredHandler)
  })
