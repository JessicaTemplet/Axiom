; Constructor lookup includes declarations generated after the caller.
(import IO)

(macro defineRow ((defineRow Name)
    (struct Name
      (value : Int)
      (next : Int))))

(:: readRow (-> Int Int))
(fn (readRow n)
  {
    (let row (GeneratedRow :next (+ n 1) :value n))
    (+ row.value row.next)
  })

(defineRow GeneratedRow)

(:: main ())
;@axiom:effect(io)
(fn (main)
  (println (readRow 20)))
