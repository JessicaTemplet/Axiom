(import IO)
(import Fmt)
(import Vec)

(type WidthByte UInt8)

(type Pair a (Packet a))

(data Packet a
  (Packet a String))

(struct Sample
  (mut small : Int8)
  (wide : UInt64)
  (name : String))

(:: id (-> a a))
(fn (id n)
  n)

(:: byteAdd (-> WidthByte WidthByte WidthByte))
(fn (byteAdd a b)
  (+ a b))

(:: unsignedChecksum Int)
(fn (unsignedChecksum)
  {
    (let mut hash 17)
    {
      (for a in 0..256
        (for b in 0..256
          {
            (let x (as a UInt8))
            (let y (as b UInt8))
            (let shift (as (& b 7) UInt8))
            {
              (set hash (+ (* hash 31) (as (+ x y) Int)))
              (set hash (+ (* hash 31) (as (- x y) Int)))
              (set hash (+ (* hash 31) (as (* x y) Int)))
              (set hash (+ (* hash 31) (as (& x y) Int)))
              (set hash (+ (* hash 31) (as (| x y) Int)))
              (set hash (+ (* hash 31) (as (^ x y) Int)))
              (set hash (+ (* hash 31) (as (<< x shift) Int)))
              (set hash (+ (* hash 31) (as (>> x shift) Int)))
              (set hash (+ (* hash 31)
                          (if (< x y)
                            1
                            0)))
              (if (!= y (as 0 UInt8))
                {
                  (set hash (+ (* hash 31) (as (/ x y) Int)))
                  (set hash (+ (* hash 31) (as (% x y) Int)))
                }
                {
                  (set hash (* hash 31))
                  (set hash (* hash 31))
                })
            }
          }))
      hash
    }
  })

(:: signedChecksum Int)
(fn (signedChecksum)
  {
    (let mut hash 17)
    {
      (for a in 0..256
        (for b in 0..256
          {
            (let x (as a Int8))
            (let y (as b Int8))
            (let shift (as (& b 7) Int8))
            {
              (set hash (+ (* hash 31) (as (+ x y) Int)))
              (set hash (+ (* hash 31) (as (- x y) Int)))
              (set hash (+ (* hash 31) (as (* x y) Int)))
              (set hash (+ (* hash 31) (as (& x y) Int)))
              (set hash (+ (* hash 31) (as (| x y) Int)))
              (set hash (+ (* hash 31) (as (^ x y) Int)))
              (set hash (+ (* hash 31) (as (<< x shift) Int)))
              (set hash (+ (* hash 31) (as (>> x shift) Int)))
              (set hash (+ (* hash 31)
                          (if (< x y)
                            1
                            0)))
              (if (&& (!= y (as 0 Int8)) (! (&& (== x (as 128 Int8)) (== y (as 255 Int8)))))
                {
                  (set hash (+ (* hash 31) (as (/ x y) Int)))
                  (set hash (+ (* hash 31) (as (% x y) Int)))
                }
                {
                  (set hash (* hash 31))
                  (set hash (* hash 31))
                })
            }
          }))
      hash
    }
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let u (as (- 0 1) UInt64))
    (let s (Sample :small (as 255 Int8) :wide u :name "sample"))
    (let packet (Packet (as 65535 UInt16) "packet"))
    (let v (vecNew))
    (let offset (as 1 UInt8))
    (let inc (lambda (x) (+ x offset)))
    {
      (vecPush v (as 255 WidthByte))
      (println (as (byteAdd (vecGet v 0) (as 1 WidthByte)) Int))
      (println (as (+ (as 127 Int8) (as 1 Int8)) Int))
      (println (as (- (as 128 Int8)) Int))
      (println (as (* (as 256 UInt16) (as 256 UInt16)) Int))
      (println (as (as (- 0 1) Int8) UInt16))
      (println (as (as 255 UInt8) Int16))
      (println (as (/ (as 255 UInt8) (as 2 UInt8)) Int))
      (println (as (% (as 255 UInt8) (as 2 UInt8)) Int))
      (println (as (>> (as 128 UInt8) (as 7 UInt8)) Int))
      (println (as (>> (as 128 Int8) (as 7 Int8)) Int))
      (println (as (<< (as 1 UInt8) (as 7 UInt8)) Int))
      (println (as (& (as 255 UInt8) (as 15 UInt8)) Int))
      (println (> u (as 9223372036854775807 UInt64)))
      (println (/ u (as 10 UInt64)))
      (println (% u (as 10 UInt64)))
      (println (+ u (as 1 UInt64)))
      (println (as s.small Int))
      (println (set s.small (as 2 Int8)))
      (println (as s.small Int))
      (println s.wide)
      (println packet)
      (println (as (id (as 4294967295 UInt32)) Int))
      (println (as (inc (as 41 UInt8)) Int))
      (println (as (as 4294967295 UInt32) Float))
      (println (as u Float))
      (println (as 18446744073709551616.0 UInt64))
      (println (as (- 0.0 1.0) UInt64))
      (println (as 999.0 Int8))
      (println (as (- 0.0 999.0) Int8))
      (println (as (/ 0.0 0.0) UInt8))
      (println (as (/ 1.0 0.0) UInt16))
      (println (as (/ (- 0.0 1.0) 0.0) Int32))
      (println unsignedChecksum)
      (println signedChecksum)
    }
  })
