(import IO)
(import Str)
(import Vec)

(:: inc (-> Int Int))
(fn (inc n)
  (+ n 1))

(:: times (-> Int Int Int))
(fn (times n k)
  (* n k))

(:: subtract (-> Int Int Int))
(fn (subtract a b)
  (- a b))

(:: identity (-> a a))
(fn (identity value)
  value)

(macro (twice value) (+ value value))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let log vecNew)
    (let mark
      (lambda (n)
        {
          (vecPush log n)
          n
        }
      ))
    (let _pipe 700)
    (let answer (|> (mark 5) (mark) inc (times 3) (subtract 100 _)))
    (let text (|> "hello" strDup identity strDup))
    (let length
      (region r
        (|> (strDup text) strLen)))
    (let floating (|> 1.5 identity (lambda (n) (+ n 0.5))))
    (let macroValue (|> (mark 7) (twice)))
    {
      (println answer)
      (println (vecLen log))
      (println (vecGet log 0))
      (println (vecGet log 1))
      (println (vecGet log 2))
      (println length)
      (println (strEq text "hello"))
      (println floating)
      (println macroValue)
      (println _pipe)
    }
  })
