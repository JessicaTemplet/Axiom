; An `if` or a `match` whose value is thrown away answers `()`
; whatever its branches answer, so a branch that is there for what it
; does needs no filler to agree with the others. `tally` records what
; ran; each dropped form has branches of different types - a `set` of
; a Bool beside a `set` of an Int, a String beside an Int - and runs
; both ways. The same form in a position whose value is read still
; needs agreeing branches (tests/diagnostics/1304-branches-read.ax).
(import IO)
(import Str)
(import Vec)

(:: step (-> (Vec String) Int Int))
(fn (step tally n)
  (let (
    (mut ok false)
    (mut acc 0)
  )
    {
      (if (> n 0)
        { (set ok true) }
        { (set acc (+ acc n)) })
      (if (> n 5)
        (vecPush tally "big")
        (vecLen tally))
      (match n
        (0 (vecPush tally "zero"))
        (1 "one")
        (_ { (set acc (* n 2)) }))
      (while (< acc 3)
        (if (== (% acc 2) 0)
          (set acc (+ acc 1))
          { (set ok (! ok)) (set acc (+ acc 2)) }))
      (vecPush tally (if ok "ok" "no"))
      ; Nested: the one-armed `if` drops its branch, so the `let`'s
      ; body, and the `if` in it, are dropped too, and the inner
      ; branches - a Bool `set` and an Int `set` - need not agree.
      (if (> n -5)
        (let ((d (* n 3)))
          (if (> d 100)
            { (set ok false) }
            { (set acc (+ acc 1)) })))
      acc
    }))

(:: main ())
;@axiom:effect(io)
(fn (main)
  (let ((t vecNew))
    {
      (println (step t 7))
      (println (step t 0))
      (println (step t -2))
      (for s in t (println s))
    }))
