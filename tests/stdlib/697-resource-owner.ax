; Counted callbacks close at the last share, including captured parents.
(import IO)
(import Vec)

(struct Owner sealed
  (handle : Handle))

; A data result can carry cleanup in any constructor, even when its
; first constructor contains only words.
(data DataOwner
  (DataOwner Int)
  (ResourceOwner Handle))

(:: makeDataOwner (-> Int DataOwner))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (makeDataOwner n)
  (ResourceOwner
    (__resource_new
      (lambda (v)
        {
          (println v)
          0
        }
      )
      n)))

(:: useDataOwner (-> DataOwner Int))
;@axiom:effect(unsafe)
(fn (useDataOwner o)
  (match o
    ((DataOwner n) n)
    ((ResourceOwner h) (__resource_get h))))

(:: makeOwner (-> (Vec Int) Int Owner))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (makeOwner hits n)
  (Owner
    (__resource_new
      (lambda (v)
        {
          (vecPush hits v)
          0
        }
      )
      n)))

(:: useOwner (-> Owner Int))
;@axiom:effect(unsafe)
(fn (useOwner o)
  (__resource_get o.handle))

(:: scoped (-> (Vec Int) Int))
;@axiom:effect(io)
(fn (scoped hits)
  (let (
    (a (makeOwner hits 7))
    (alias a)
  )
    (+ (useOwner a) (useOwner alias))))

(:: closed (-> (Vec Int) Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (closed hits)
  (let ((a (makeOwner hits 8)))
    {
      (__resource_close a.handle)
      (__resource_close a.handle)
      0
    }))

(:: disarmed (-> (Vec Int) Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (disarmed hits)
  (let ((a (makeOwner hits 99)))
    (__resource_disarm a.handle)))

; A region's owner reports by printing, not by storing: the callback
; runs as the region is reclaimed, and a store from it into anything
; outside the region is read as an escape (AX3060) - a `vecPush` would
; grow the outer vector with a block from the region's arena, and a
; parameter's value is taken as fresh in the region.
(:: makeLoudOwner (-> Int Owner))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (makeLoudOwner n)
  (Owner
    (__resource_new
      (lambda (v)
        {
          (println v)
          0
        }
      )
      n)))

(:: regionDrop Int)
;@axiom:effect(io)
(fn (regionDrop)
  {
    (region r
      (let ((a (makeLoudOwner 9)))
        (useOwner a)))
    0
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  (let ((hits vecNew))
    {
      (println (scoped hits))
      (println (vecGet hits 0))
      (closed hits)
      (disarmed hits)
      (println (vecLen hits))
      (println (vecGet hits 1))
      (println regionDrop)
      (println
        (region r
          (useDataOwner (makeDataOwner 10))))
      (println
        (region r
          (let ((a (makeDataOwner 11)))
            (useDataOwner a))))
    }))
