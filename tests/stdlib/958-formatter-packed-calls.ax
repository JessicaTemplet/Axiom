  (f45 : Int)
  (f46 : Int)
  (f47 : Int))

(:: ordered (-> Many Bool))
(fn (ordered value)
  (&& (== value.f1 1)
    (&& (== value.f2 2)
      (&& (== value.f3 3)
        (&& (== value.f4 4)
          (&& (== value.f5 5)
            (&& (== value.f6 6)
              (&& (== value.f7 7)
                (&& (== value.f8 8)
                  (&& (== value.f9 9)
                    (&& (== value.f10 10)
                      (&& (== value.f11 11)
                        (&& (== value.f12 12)
                          (&& (== value.f13 13)
                            (&& (== value.f14 14)
                              (&& (== value.f15 15)
                                (&& (== value.f16 16)
                                  (&& (== value.f17 17)
                                    (&& (== value.f18 18)
                                      (&& (== value.f19 19)
                                        (&& (== value.f20 20)
                                          (&& (== value.f21 21)
                                            (&& (== value.f22 22)
                                              (&& (== value.f23 23)
                                                (&& (== value.f24 24)
                                                  (&& (== value.f25 25)
                                                    (&& (== value.f26 26)
                                                      (&& (== value.f27 27)
                                                        (&& (== value.f28 28)
                                                          (&& (== value.f29 29)
                                                            (&& (== value.f30 30)
                                                              (&& (== value.f31 31)
                                                                (&& (== value.f32 32)
                                                                  (&& (== value.f33 33)
                                                                    (&& (== value.f34 34)
                                                                      (&& (== value.f35 35)
                                                                        (&& (== value.f36 36)
                                                                          (&& (== value.f37 37)
                                                                            (&& (== value.f38 38)
                                                                              (&& (== value.f39 39)
                                                                                (&&
                                                                                  (== value.f40 40)
                                                                                  (&&
                                                                                    (== value.f41
                                                                                      41)
                                                                                    (&&
                                                                                      (== value.f42
                                                                                        42)
                                                                                      (&&
                                                                                        (==
                                                                                          value.f43
                                                                                          43)
                                                                                        (&&
                                                                                          (==
                                                                                            value.f44
                                                                                            44)
                                                                                          (&&
                                                                                            (==
                                                                                              value.f45
                                                                                              45)
                                                                                            (&&
                                                                                              (==
                                                                                                value.f46
                                                                                                46)
                                                                                              (&&
                                                                                                (==
                                                                                                  value.f47
                                                                                                  47)
                                                                                                true))))))))))))))))))))))))))))))))))))))))))))))))

(:: main ())
;@axiom:effect(io)
(fn (main)
  (println
    (if (ordered
          (Many
            :f1 1
            :f2 2
            :f3 3
            :f4 4
            :f5 5
            :f6 6
            :f7 7
            :f8 8
            :f9 9
