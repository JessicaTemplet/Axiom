; Long applications preserve complete arguments and their order.
(import IO)

(struct Many
  (f1 : Int)
  (f2 : Int)
  (f3 : Int)
  (f4 : Int)
  (f5 : Int)
  (f6 : Int)
  (f7 : Int)
  (f8 : Int)
  (f9 : Int)
  (f10 : Int)
  (f11 : Int)
  (f12 : Int)
  (f13 : Int)
