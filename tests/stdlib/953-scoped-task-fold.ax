(import IO)
(import Str)
(import Task)

(type TextStep = (-> String Int))

(struct Counter
  (mut count : Int))

; A checked forwarding boundary is independent of Task's spelling.
(:: invoke (-> String TextStep Int))
;@axiom:scoped(step)
(fn (invoke text step)
  (step text))

(:: forward (-> String (-> String Int) Int))
;@axiom:scoped(step)
(fn (forward text step)
  (invoke text step))

(:: measure (-> String Int))
(fn (measure text)
  (strLen text))

(:: foldAgain (-> (-> Int Int (Result String Error) Int) Int))
;@axiom:scoped(step)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (foldAgain step)
  (taskFold (lambda (i) (strAlloc (+ i 1))) 12 (taskOpts 3 64) 0 step))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  {
    (println (forward "abc" (lambda (text) (strLen (strDup text)))))
    (println (invoke "abcd" measure))
    (println
      (invoke
        "abcde"
        (if true
          (lambda (text) (strLen text))
          (lambda (text) 0))))
    (println
      (foldAgain
        (lambda (acc i result)
          (let ((scratch (strDup "temporary")))
            (match result
              ((Ok text) (+ acc (strLen text)))
              ((Err error) acc)))
        )))
    (let ((counter (Counter 0)))
      {
        (println
          (taskFold
            (lambda (i) "x")
            4
            (taskOpts 2 16)
            0
            (lambda (acc i result)
              {
                (set counter.count acc)
                (+ acc 1)
              }
            )))
        (println counter.count)
      })
    0
  })
