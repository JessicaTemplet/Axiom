; Explicit task grain covers every index once, including a short tail.
; Large counts and grains must not overflow range arithmetic.
(import IO)
(import Fmt)
(import Vec)
(import Str)
(import Err)
(import Task)

(:: rangeName (-> Int Int String))
(fn (rangeName start end)
  (concat (fmtInt start) (concat ".." (fmtInt end))))

(:: showRanges (-> Int Int Int Int))
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (showRanges count grain width)
  {
    (let rs
      (taskMapRanges (lambda (start end) (rangeName start end)) count grain (taskOpts width 64)))
    {
      (println (vecLen rs))
      (for i in 0..(vecLen rs)
        (match (vecGet rs i)
          ((Ok s) (println s))
          ((Err e) (println e.code))))
      0
    }
  })

;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  {
    (showRanges 11 4 3)
    (showRanges 3 0 2)
    (showRanges 2 (- 0 3) 0)
    (showRanges 0 1 8)
    (showRanges (- 0 1) 1 8)
    (showRanges 9223372036854775807 9223372036854775807 8)
    (showRanges 9223372036854775807 9223372036854775806 8)
    (showRanges 3 9 9223372036854775807)
    {
      (let state vecNew)
      {
        (vecPush state 7)
        {
          (let rs
            (taskMapRanges
              (lambda (start end)
                {
                  (vecSet state 0 (+ (vecGet state 0) start))
                  (fmtInt (vecGet state 0))
                }
              )
              11 4 (taskOpts 2 64)))
          (for i in 0..(vecLen rs)
            (match (vecGet rs i)
              ((Ok s) (println s))
              ((Err e) (println e.code))))
        }
        (println (vecGet state 0))
      }
    }
    0
  })
