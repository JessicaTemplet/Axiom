; One macro, two kinds of rule: `limit` declares a named constant at
; the top level and clamps a value in an expression. Each rule's
; template is declarations or one expression, and where the macro is
; invoked picks which it needs (MAC-LANG-14).
(import IO)

(macro limit
  ((limit name value) (:: name Int) (fn (name) value))
  ((limit lo hi x) (if (< x lo) lo (> x hi) hi x)))

(limit ceiling 10)

; A rule whose template is one call reads both ways: here it expands to
; a call, and at the top level it would invoke `twice` as a macro.
(macro twiceOf ((twiceOf x) (twice x)))

(:: twice (-> Int Int))
(fn (twice n)
  (* 2 n))

; A rule with no parameters, invoked as `(five)`.
(macro five
  ((five) 5)
  ((five x) (+ 5 x)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println "ceiling is {ceiling}")
    (println (limit 0 ceiling 42))
    (println (limit 0 ceiling -3))
    (println (limit 0 ceiling 7))
    (println (twiceOf 21))
    (println (five))
    (println (five 2))
  })
