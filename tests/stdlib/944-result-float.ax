; Register-pair matches keep the checked Float type of their payload.
(import Err)
(import IO)

(:: result (-> Float (Result Float Error)))
(fn (result x)
  (if (< x 0.0)
    (Err (mkError 2000 "negative"))
    (Ok x)))

(:: generic (-> a (Result a Error)))
(fn (generic x)
  (Ok x))

(:: optional (-> Float (Option Float)))
(fn (optional x)
  (if (< x 0.0)
    None
    (Some x)))

(:: integer (-> Int (Result Int Error)))
(fn (integer x)
  (Ok x))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println
      (if (match (result 2.0)
        ((Ok n) (== (+ n 1.0) 3.0))
        ((Err _) false))
        "Result Float pair: correct"
        "wrong Result Float"))
    (println
      (if (match (generic 2.0)
        ((Ok n) (== (+ n 1.0) 3.0))
        ((Err _) false))
        "generic Float pair: correct"
        "wrong generic Float"))
    (println
      (if (match (optional 2.0)
        ((Some n) (== (+ n 1.0) 3.0))
        ((None) false))
        "Option Float pair: correct"
        "wrong Option Float"))
    (let ((boxed (result 2.0)))
      (println
        (if (match boxed
          ((Ok n) (== (+ n 1.0) 3.0))
          ((Err _) false))
          "boxed Float match: correct"
          "wrong boxed Float")))
    (println
      (if (match (integer 2)
        ((Ok n) (== (+ n 1) 3))
        ((Err _) false))
        "Int pair control: correct"
        "wrong Int pair"))
  })
