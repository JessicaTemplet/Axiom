; Exact conversion checks values before rounding or saturation can hide loss.
(import Float)
(import Err)
(import IO)
(import Str)

(:: intExact (-> Int Float Bool))
(fn (intExact n expected)
  (match (floatFromIntExact n)
    ((Ok value) (== value expected))
    ((Err _) false)))

(:: intRefused (-> Int Bool))
(fn (intRefused n)
  (match (floatFromIntExact n)
    ((Ok _) false)
    ((Err e) (&& (== e.code floatConversionFailed) (strEq e.context "floatFromIntExact")))))

(:: floatExact (-> Float Int Bool))
(fn (floatExact x expected)
  (match (floatToIntExact x)
    ((Ok value) (== value expected))
    ((Err _) false)))

(:: floatRefused (-> Float String Bool))
(fn (floatRefused x message)
  (match (floatToIntExact x)
    ((Ok _) false)
    ((Err e)
      (&& (== e.code floatConversionFailed)
        (&& (strEq e.context "floatToIntExact") (strEq e.message message)))
    )))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println
      (if (&& (intExact 0 0.0) (&& (intExact 42 42.0) (intExact -42 -42.0)))
        "small integer conversion: exact"
        "wrong small integer"))
    (println
      (if (&& (intExact 9007199254740992 9007199254740992.0)
            (&& (intExact 9007199254740994 9007199254740994.0)
              (&& (intRefused 9007199254740993) (intRefused -9007199254740993))))
        "53-bit precision boundary: checked"
        "wrong precision boundary"))
    (println
      (if (&& (intExact 18014398509481982 18014398509481982.0)
            (&& (intRefused 18014398509481983) (intRefused -18014398509481983)))
        "rounded exponent boundary: checked"
        "wrong exponent boundary"))
    (println
      (if (&& (intExact 4611686018427388928 4611686018427388928.0)
            (&& (intRefused 4611686018427388416) (intRefused -4611686018427388416)))
        "large integer low bits: checked"
        "wrong low bits"))
    (println
      (if (&& (intRefused 9223372036854775807)
            (&& (intRefused 9223372036854775806)
              (&& (intExact intMin -9223372036854775808.0)
                (&& (intRefused -9223372036854775807)
                  (intExact -9223372036854774784 -9223372036854774784.0)))))
        "Int bounds: checked before saturation"
        "wrong Int bounds"))
    (println
      (if (&& (floatExact 0.0 0)
            (&& (floatExact -0.0 0) (&& (floatExact 42.0 42) (floatExact -42.0 -42))))
        "integral Float and signed zero: exact"
        "wrong integral Float"))
    (println
      (if (&& (floatRefused 3.75 "Float has a fractional part")
            (&& (floatRefused -3.75 "Float has a fractional part")
              (floatRefused (floatFromBits 1) "Float has a fractional part")))
        "fraction and subnormal: refused"
        "wrong fraction"))
    (println
      (if (&& (floatRefused floatInfinity "non-finite Float cannot be converted to Int")
            (&& (floatRefused (- 0.0 floatInfinity) "non-finite Float cannot be converted to Int")
              (&& (floatRefused floatNan "non-finite Float cannot be converted to Int")
                (floatRefused (floatFromBits -1) "non-finite Float cannot be converted to Int"))))
        "non-finite Float: refused"
        "wrong non-finite Float"))
    (println
      (if (&& (floatExact -9223372036854775808.0 intMin)
            (&& (floatExact 9223372036854774784.0 9223372036854774784)
              (&& (floatRefused 9223372036854775808.0 "Float is outside the Int range")
                (&& (floatRefused -9223372036854777856.0 "Float is outside the Int range")
                  (floatRefused (floatFromBits 9094988921128908188)
                    "Float is outside the Int range")))))
        "Float range: checked before conversion"
        "wrong Float range"))
  })
