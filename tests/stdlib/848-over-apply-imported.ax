; A call that supplies more arguments than its callee declares applies
; the surplus to the closure the callee answers. That held for a
; function of this file (tests/stdlib/140-function-values.ax) and not
; for an imported one, whose arity was looked up under its bare name:
; `((vecGet v 0) 41)` passed 41 to `vecGet` and printed an address.
; Each line below must print the same as its let-bound twin.
(import IO)
(import Vec)

(:: inc (-> Int Int))
(fn (inc x)
  (+ x 1))

(:: twice (-> (-> Int Int) Int Int))
(fn (twice f)
  (lambda (x) (f (f x))))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let v (vecPush vecNew inc))
    {
      (println (vecGet v 0 41))
      {
        (let g (vecGet v 0))
        (println (g 41))
      }
      (println (twice (vecGet v 0) 40))
      (println (vecGet (vecPush vecNew (twice inc)) 0 40))
    }
  })
