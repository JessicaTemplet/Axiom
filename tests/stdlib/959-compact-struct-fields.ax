; Native fields, aligned reference maps and measured allocation costs.
(import IO)
(import Str)
(import Vec)
(import Mem)
(import PackedA)
(import PackedB)

(type Octet = UInt8)

(struct Scalars
  (mut i8 : Int8)
  (mut u8 : Octet)
  (mut i16 : Int16)
  (mut u16 : UInt16)
  (mut i32 : Int32)
  (mut u32 : UInt32)
  (mut u64 : UInt64))

(struct Bracket
  (pos : Int)
  (open : UInt8)
  (family : UInt8)
  (partner : Int)
  (span : Int))

(struct FormatFlags
  (align : UInt8)
  (zero : UInt8)
  (width : Int)
  (precision : Int)
  (kind : UInt8)
  (ok : UInt8))

(struct Mixed
  (mut first : UInt8)
  (mut second : Int8)
  (mut text : String)
  (mut tiny : UInt16)
  (mut callback : (-> Int String))
  (mut word : UInt32))

(struct Generic (a)
  (prefix : UInt8)
  (payload : a)
  (suffix : UInt16))

(struct MutableGeneric (a)
  (prefix : UInt8)
  (mut value : a)
  (suffix : UInt16))

(struct MapBoundary
  (f0 : Int)
  (f1 : Int)
  (f2 : Int)
  (f3 : Int)
  (f4 : Int)
  (f5 : Int)
  (f6 : Int)
  (f7 : Int)
  (f8 : Int)
  (f9 : Int)
  (f10 : Int)
  (f11 : Int)
  (f12 : Int)
  (f13 : Int)
  (f14 : Int)
  (f15 : Int)
  (f16 : Int)
  (f17 : Int)
  (f18 : Int)
  (f19 : Int)
  (f20 : Int)
  (f21 : Int)
  (f22 : Int)
  (f23 : Int)
  (f24 : Int)
  (f25 : Int)
  (f26 : Int)
  (f27 : Int)
  (f28 : Int)
  (f29 : Int)
  (f30 : Int)
  (f31 : Int)
  (f32 : Int)
  (f33 : Int)
  (f34 : Int)
  (f35 : Int)
  (f36 : Int)
  (f37 : Int)
  (f38 : Int)
  (f39 : Int)
  (f40 : Int)
  (f41 : Int)
  (f42 : Int)
  (f43 : Int)
  (f44 : Int)
  (f45 : Int)
  (mut last : String))

(struct Ticket word shared
  (slot : Int))

(data Message
  (Message UInt8 Int16 String))

(:: liveBytes Int)
(fn (liveBytes)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: scalars Scalars)
(fn (scalars)
  (Scalars
    :i8 (as 128 Int8)
    :u8 (as 255 UInt8)
    :i16 (as 32768 Int16)
    :u16 (as 65535 UInt16)
    :i32 (as 2147483648 Int32)
    :u32 (as (- 0 1) UInt32)
    :u64 (as (- 0 1) UInt64)))

(:: scalarBytes Int)
(fn (scalarBytes)
  {
    (let warm scalars)
    (let before liveBytes)
    (let value scalars)
    (let bytes (- liveBytes before))
    (if (&& (== (as warm.i8 Int) -128) (== (as value.u64 Int) -1))
      bytes
      -1)
  })

(:: bracketBytes Int)
(fn (bracketBytes)
  {
    (let warm (Bracket :pos 7 :open (as 1 UInt8) :family (as 2 UInt8) :partner -1 :span 99))
    (let before liveBytes)
    (let value (Bracket :pos 8 :open (as 0 UInt8) :family (as 1 UInt8) :partner 7 :span 100))
    (let bytes (- liveBytes before))
    (if (&& (== warm.pos 7) (== value.span 100))
      bytes
      -1)
  })

(:: formatBytes Int)
(fn (formatBytes)
  {
    (let warm
      (FormatFlags
        :align (as 2 UInt8)
        :zero (as 1 UInt8)
        :width 20
        :precision 6
        :kind (as 102 UInt8)
        :ok (as 1 UInt8)))
    (let before liveBytes)
    (let value
      (FormatFlags
        :align (as 1 UInt8)
        :zero (as 0 UInt8)
        :width 100
        :precision 12
        :kind (as 120 UInt8)
        :ok (as 1 UInt8)))
    (let bytes (- liveBytes before))
    (if (&& (== warm.width 20) (== value.precision 12))
      bytes
      -1)
  })

(:: scalarValues Bool)
(fn (scalarValues)
  {
    (let s scalars)
    (&& (== (as s.i8 Int) -128)
      (&& (== (as s.u8 Int) 255)
        (&& (== (as s.i16 Int) -32768)
          (&& (== (as s.u16 Int) 65535)
            (&& (== (as s.i32 Int) -2147483648)
              (&& (== (as s.u32 Int) 4294967295) (== s.u64 (as (- 0 1) UInt64))))))))
  })

(:: scalarMutation Bool)
(fn (scalarMutation)
  {
    (let s scalars)
    {
      (set s.i8 (as 127 Int8))
      (set s.u8 (as 1 UInt8))
      (set s.i16 (as 32767 Int16))
      (set s.u16 (as 2 UInt16))
      (set s.i32 (as 2147483647 Int32))
      (set s.u32 (as 3 UInt32))
      (set s.u64 (as 4 UInt64))
      (&& (== (as s.i8 Int) 127)
        (&& (== (as s.u8 Int) 1)
          (&& (== (as s.i16 Int) 32767)
            (&& (== (as s.u16 Int) 2)
              (&& (== (as s.i32 Int) 2147483647)
                (&& (== (as s.u32 Int) 3) (== (as s.u64 Int) 4)))))))
    }
  })

(:: mixed Mixed)
(fn (mixed)
  {
    (let captured (concat "closure" " kept"))
    (Mixed
      :first (as 255 UInt8)
      :second (as 128 Int8)
      :text (concat "record" " kept")
      :tiny (as 65535 UInt16)
      :callback
        (lambda (n)
          (if (> n 0)
            captured
            "unused")
        )
      :word (as (- 0 1) UInt32))
  })

(:: pressure Int)
(fn (pressure)
  {
    (for i in 0..200
      (concat "unrelated allocation "
        "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"))
    0
  })

(:: mixedValues Bool)
(fn (mixedValues)
  {
    (let m mixed)
    {
      pressure
      (&& (== (as m.first Int) 255)
        (&& (== (as m.second Int) -128)
          (&& (strEq m.text "record kept")
            (&& (== (as m.tiny Int) 65535)
              (&& (strEq (m.callback 1) "closure kept") (== (as m.word Int) 4294967295))))))
    }
  })

(:: mixedMutation Bool)
(fn (mixedMutation)
  {
    (let m mixed)
    (let replacement (concat "new closure" " kept"))
    {
      (set m.first (as 1 UInt8))
      (set m.second (as 127 Int8))
      (set m.tiny (as 7 UInt16))
      (set m.word (as 42 UInt32))
      (set m.text m.text)
      (set m.text (concat "new record" " kept"))
      (set m.callback (lambda (n)
        (if (> n 0)
          replacement
          "unused")
      ))
      pressure
      (&& (== (as m.first Int) 1)
        (&& (== (as m.second Int) 127)
          (&& (strEq m.text "new record kept")
            (&& (== (as m.tiny Int) 7)
              (&& (strEq (m.callback 1) "new closure kept") (== (as m.word Int) 42))))))
    }
  })

(:: mixedMap Bool)
;@axiom:effect(unsafe)
(fn (mixedMap)
  {
    (let m mixed)
    (let shape (__load64 (- (as m Int) 8) 0))
    (&& (== (& shape 32767) 12) (== (>> shape 16) 10))
  })

(:: stringCount (-> String Int))
;@axiom:effect(unsafe)
(fn (stringCount value)
  (__load64 (- (as value Int) 16) 0))

(:: callbackCount (-> (-> Int String) Int))
;@axiom:effect(unsafe)
(fn (callbackCount value)
  (__load64 (- (as value Int) 16) 0))

(:: retainsInside (-> String (-> Int String) Int Int Bool))
(fn (retainsInside text callback beforeText beforeCallback)
  {
    (let m
      (Mixed
        :first (as 1 UInt8)
        :second (as 2 Int8)
        :text text
        :tiny (as 3 UInt16)
        :callback callback
        :word (as 4 UInt32)))
    (&& (strEq m.text (m.callback 1))
      (&& (> (stringCount text) beforeText) (> (callbackCount callback) beforeCallback)))
  })

(:: referencesBalanced Bool)
(fn (referencesBalanced)
  {
    (let text (concat "balanced" " references"))
    (let callback
      (as (lambda (n)
        (if (> n 0)
          text
          "unused")
      ) (-> Int String)))
    (let beforeText (stringCount text))
    (let beforeCallback (callbackCount callback))
    (let retained (retainsInside text callback beforeText beforeCallback))
    (&& retained
      (&& (== (stringCount text) beforeText) (== (callbackCount callback) beforeCallback)))
  })

(:: moduleFields Bool)
(fn (moduleFields)
  {
    (let a (packedA 42))
    (let b (packedB 1000))
    {
      (packedASet a (as 17 UInt8))
      (&& (== (packedARead a) 27) (== (packedBRead b) 1011))
    }
  })

(:: genericFields Bool)
(fn (genericFields)
  {
    (let value (Generic :prefix (as 7 UInt8) :payload (as 65535 UInt16) :suffix (as 32768 UInt16)))
    (&& (== (as value.prefix Int) 7)
      (&& (== (as value.payload Int) 65535) (== (as value.suffix Int) 32768)))
  })

(:: genericRead (-> (MutableGeneric a) a))
(fn (genericRead cell)
  cell.value)

(:: replaceGeneric (-> (MutableGeneric a) a ()))
(fn (replaceGeneric cell value)
  {
    (set cell.value value)
    ()
  })

; A generic field occupies a full word. Changing a signed byte from
; negative to positive must replace every high byte of that word.
(:: genericMutation Bool)
(fn (genericMutation)
  {
    (let cell
      (MutableGeneric :prefix (as 255 UInt8) :value (as (- 0 1) Int8) :suffix (as 65535 UInt16)))
    {
      (set cell.value (as 1 Int8))
      {
        (let positive (== (as (genericRead cell) Int) 1))
        {
          (replaceGeneric cell (as (- 0 128) Int8))
          {
            (let minimum (== (as (genericRead cell) Int) -128))
            {
              (set cell.value (as 127 Int8))
              {
                (let maximum (== (as (genericRead cell) Int) 127))
                {
                  (replaceGeneric cell (as (- 0 1) Int8))
                  (&& positive
                    (&& minimum
                      (&& maximum
                        (&& (== (as (genericRead cell) Int) -1)
                          (&& (== (as cell.prefix Int) 255) (== (as cell.suffix Int) 65535))))))
                }
              }
            }
          }
        }
      }
    }
  })

(:: intCallbackCount (-> (-> Int Int) Int))
;@axiom:effect(unsafe)
(fn (intCallbackCount value)
  (__load64 (- (as value Int) 16) 0))

(:: genericReferencesInside (-> String String (-> Int Int) (-> Int Int) Int Int Int Int Bool))
(fn (genericReferencesInside oldText nextText oldCallback nextCallback oldCount nextCount
      oldCallbackCount nextCallbackCount)
  {
    (let textCell (MutableGeneric :prefix (as 1 UInt8) :value oldText :suffix (as 65535 UInt16)))
    (let callbackCell
      (MutableGeneric :prefix (as 2 UInt8) :value oldCallback :suffix (as 32768 UInt16)))
    {
      (set textCell.value textCell.value)
      (replaceGeneric callbackCell callbackCell.value)
      (set textCell.value nextText)
      (replaceGeneric callbackCell nextCallback)
      pressure
      (&& (strEq (genericRead textCell) "next text")
        (&& (== (genericRead callbackCell 1) 10)
          (&& (== (stringCount oldText) oldCount)
            (&& (> (stringCount nextText) nextCount)
              (&& (== (intCallbackCount oldCallback) oldCallbackCount)
                (&& (> (intCallbackCount nextCallback) nextCallbackCount)
                  (&& (== (as textCell.suffix Int) 65535)
                    (== (as callbackCell.suffix Int) 32768))))))))
    }
  })

(:: genericReferences Bool)
(fn (genericReferences)
  {
    (let oldText (concat "old" " text"))
    (let nextText (concat "next" " text"))
    (let oldCallback (as (lambda (n) (+ n (strLen oldText))) (-> Int Int)))
    (let nextCallback (as (lambda (n) (+ n (strLen nextText))) (-> Int Int)))
    (let oldCount (stringCount oldText))
    (let nextCount (stringCount nextText))
    (let oldCallbackCount (intCallbackCount oldCallback))
    (let nextCallbackCount (intCallbackCount nextCallback))
    (let inside
      (genericReferencesInside oldText nextText oldCallback nextCallback oldCount nextCount
        oldCallbackCount nextCallbackCount))
    (&& inside
      (&& (== (stringCount oldText) oldCount)
        (&& (== (stringCount nextText) nextCount)
          (&& (== (intCallbackCount oldCallback) oldCallbackCount)
            (== (intCallbackCount nextCallback) nextCallbackCount)))))
  })

(:: boundaryInside (-> String Int Bool))
(fn (boundaryInside text before)
  {
    (let record
      (MapBoundary
        :f0 0
        :f1 1
        :f2 2
        :f3 3
        :f4 4
        :f5 5
        :f6 6
        :f7 7
        :f8 8
        :f9 9
        :f10 10
        :f11 11
        :f12 12
        :f13 13
        :f14 14
        :f15 15
        :f16 16
        :f17 17
        :f18 18
        :f19 19
        :f20 20
        :f21 21
        :f22 22
        :f23 23
        :f24 24
        :f25 25
        :f26 26
        :f27 27
        :f28 28
        :f29 29
        :f30 30
        :f31 31
        :f32 32
        :f33 33
        :f34 34
        :f35 35
        :f36 36
        :f37 37
        :f38 38
        :f39 39
        :f40 40
        :f41 41
        :f42 42
        :f43 43
        :f44 44
        :f45 45
        :last text))
    {
      (set record.last record.last)
      pressure
      (&& (strEq record.last "boundary text") (&& (== record.f45 45) (> (stringCount text) before)))
    }
  })

(:: bitmapBoundary Bool)
(fn (bitmapBoundary)
  {
    (let text (concat "boundary" " text"))
    (let before (stringCount text))
    (let inside (boundaryInside text before))
    (&& inside (== (stringCount text) before))
  })

(:: wordAndData Bool)
(fn (wordAndData)
  {
    (let ticket (Ticket :slot 255))
    (let message (Message (as 255 UInt8) (as 32768 Int16) "data kept"))
    (let v (vecPush vecNew (as 255 UInt8)))
    (&& (== (as ticket.slot Int) 255)
      (&& (== (as (vecGet v 0) Int) 255)
        (match message
          ((Message byte signed text)
            (&& (== (as byte Int) 255) (&& (== (as signed Int) -32768) (strEq text "data kept")))
          ))))
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let bytes scalarBytes)
    (let brackets bracketBytes)
    (let formats formatBytes)
    (let values scalarValues)
    (let mutation scalarMutation)
    (let mixedOK mixedValues)
    (let mixedSet mixedMutation)
    (let mapOK mixedMap)
    (let balance referencesBalanced)
    (let modules moduleFields)
    (let generics genericFields)
    (let genericSet genericMutation)
    (let genericRc genericReferences)
    (let boundary bitmapBoundary)
    (let others wordAndData)
    {
      (println bytes)
      (println brackets)
      (println formats)
      (println values)
      (println mutation)
      (println mixedOK)
      (println mixedSet)
      (println mapOK)
      (println balance)
      (println modules)
      (println generics)
      (println genericSet)
      (println genericRc)
      (println boundary)
      (println others)
      (if (&& (== bytes 48)
            (&& (== brackets 48)
              (&& (== formats 48)
                (&& values
                  (&& mutation
                    (&& mixedOK
                      (&& mixedSet
                        (&& mapOK
                          (&& balance
                            (&& modules
                              (&& generics
                                (&& genericSet (&& genericRc (&& boundary others))))))))))))))
        42
        1)
    }
  })
