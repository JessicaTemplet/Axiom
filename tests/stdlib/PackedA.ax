(import Str)

(pub type Octet = UInt8)

(pub struct Frame
  (mut first : Octet)
  (second : UInt8)
  (value : String))

(pub :: packedA (-> Int Frame))
(pub fn (packedA n)
  (Frame (as n Octet) (as 7 UInt8) (concat "left" " frame")))

(pub :: packedARead (-> Frame Int))
(pub fn (packedARead frame)
  (+ (as frame.first Int) (strLen frame.value)))

(pub :: packedASet (-> Frame UInt8 Int))
(pub fn (packedASet frame byte)
  (set frame.first byte))
