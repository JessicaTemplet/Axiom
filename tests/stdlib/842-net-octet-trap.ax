; `ipV4` takes `Byte`s, so an octet outside 0..255 stops the program
; with status 80 where it is passed, the way Rust's `u8` refuses it at
; compile time. Text from outside the program goes through `ipParse`,
; which answers `Err` instead.
(import IO)
(import Str)
(import Net)

(:: octet Int)
(fn (octet)
  256)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println "before")
    (let ((a (ipV4 127 0 0 octet)))
      (println (ipText a)))
    (println "after")
    0
  })
