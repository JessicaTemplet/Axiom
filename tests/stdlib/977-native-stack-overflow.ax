; exit 86 (see .exit)
; Native entry runs on a guarded stack and reports the interrupted code.
(import IO)

(:: deep (-> Int Int))
(fn (deep n)
  (if (== n 0)
    0
    {
      (let r (deep (- n 1)))
      (if (> r n)
        r
        (+ r 1))
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (println "about to overflow")
    (deep 1000000)
  })
