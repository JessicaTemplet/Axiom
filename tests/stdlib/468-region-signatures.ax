; Inferred result origins, field stores and generic containers.
; Every call uses ordinary types and the same lexical scope.
(import IO)
(import Vec)
(import Str)

(struct Cell
  (mut s : String))

;@axiom:restrict(no-escape)
(:: lookup (-> (Vec String) Int String))
(fn (lookup t i)
  (vecGet t i))

(data Pair
  (Pair String String))

(:: left (-> Pair String))
(fn (left p)
  (match p
    ((Pair a b) a)))

(:: longest (-> (Vec String) String))
(fn (longest t)
  {
    (let a (vecGet t 0))
    (let b (vecGet t 1))
    (if (> (strLen a) (strLen b))
      a
      b)
  })

;@axiom:restrict(no-escape)
(:: count (-> (Vec String) Int))
(fn (count t)
  (vecLen t))

(:: keep (-> Cell String Int))
(fn (keep c s)
  {
    (set c.s s)
    0
  })

(:: describe (-> (Vec String) Cell Int))
;@axiom:effect(io)
(fn (describe t c)
  {
    (keep c (lookup t 2))
    (println (count t))
    (println c.s)
    0
  })

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let t vecNew)
    (let c (Cell :s "none"))
    {
      (vecPush t "alpha")
      (vecPush t "be")
      (vecPush t "gamma")
      (println (lookup t 1))
      (println (left (Pair (lookup t 0) "zed")))
      (println (longest t))
      (describe t c)
    }
  })
