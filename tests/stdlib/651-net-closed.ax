; A closed listener's handle is dead: the next use stops the program
; with status 85 before the descriptor number is used, so it can never
; reach a file the kernel has since given that number to
; (docs/reference.md, "Connect over TCP"; MM-PAR-8).
(import IO)
(import Err)
(import Net)

(:: main ())
;@axiom:effect(io)
(fn (main)
  (match (tcpListen "127.0.0.1:0")
    ((Ok lsn)
      {
        (println "listening")
        {
          (let _ (tcpListenerClose lsn))
          (println "closed")
        }
        (match (tcpListenerLocalAddr lsn)
          ((Ok a) (println "UNREACHABLE: a closed listener answered"))
          ((Err e) (println "UNREACHABLE: a closed listener answered an error")))
      }
    )
    ((Err e) (die (errorText e) 1))))
