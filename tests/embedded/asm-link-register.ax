; Linux AArch64 can allocate x18 and the link register. These explicit
; clobbers leave only x18 for two distinct inputs. LLVM must reject the
; allocation; removing the link-register clobber makes it assemble.
; scripts/check-embedded.sh checks both outcomes at the same template.
(:: explicitPressure (-> Int Int))
;@axiom:effect(unsafe)
(fn (explicitPressure x)
  (asm (aarch64 "add {r}, {a}, {b}" (out r "x0") (in a x) (in b (+ x 1))
         (clobber "x1" "x2" "x3" "x4" "x5" "x6" "x7" "x8" "x9" "x10" "x11" "x12" "x13" "x14" "x15"
           "x16" "x17" "x19" "x20" "x21" "x22" "x23" "x24" "x25" "x26" "x27" "x28" "x30"))))

(:: main Int)
(fn (main)
  (explicitPressure 3))
