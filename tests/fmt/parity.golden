### 267-if-chain-comments.axp (exit 0)
(fn (classify n)
  (if (== n 0)  ; first test
      ; first branch
      10  ; first result
    (== n 1)  ; second test
      ; second branch
      20  ; second result
    ; fallback
    30))

(fn (completePairs n)
  (if (== n 0)
      {
        (let result 10)
        result
      }
    (== n 1)
      {
        (let result 20)
        result
      }))
