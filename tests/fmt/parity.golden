### 265-long-named-patterns.axp (exit 0)
(data Packet
  (Packet { first : Int, second : Int, third : Int, fourth : Int, fifth : Int, sixth : Int,
    seventh : Int, eighth : Int, ninth : Int }))

(:: checksum (-> Packet Int))
(fn (checksum packet)
  (match packet
    ((Packet {first = firstPayloadValue,  ; first field stays here
       second = secondPayloadValue,
       third = thirdPayloadValue,
       fourth = fourthPayloadValue,
       fifth = fifthPayloadValue,
       sixth = sixthPayloadValue,
       seventh = seventhPayloadValue,
       eighth = eighthPayloadValue,
       ninth = ninthPayloadValue}) ninthPayloadValue)))

(data Marker
  (Marker { value : Int, enabled : Bool }))

(:: marker (-> Marker Bool))
(fn (marker value)
  (match value
    ((Marker {value = -1, enabled = enabled}) enabled)
    (_ false)))

(:: main Int)
(fn (main)
  (if (marker (Marker -1 true))
    (checksum (Packet 1 2 3 4 5 6 7 8 42))
    1))
