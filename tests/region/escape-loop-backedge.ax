; A short-lived origin reaches the store after several loop back edges.
(import Str)

(struct Cell
  (mut s : String))

(:: delayStore (-> Cell String String Int Int))
(fn (delayStore c outer inner count)
  {
    (let mut x outer)
    (let mut y outer)
    (let mut z outer)
    (let mut n 0)
    {
      (while (< n count)
        {
          (set c.s x)
          (set x y)
          (set y z)
          (set z inner)
          (set n (+ n 1))
        })
      0
    }
  })

(:: main Int)
(fn (main)
  {
    (let c (Cell :s "outer"))
    {
      (region inner
        (delayStore c "outer" (strDup "short") 4))
      (strLen c.s)
    }
  })
