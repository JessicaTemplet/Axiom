; Every reference in the loop belongs to the same extent.
(import Str)

(struct Cell
  (mut s : String))

(:: delayStore (-> Cell String String Int Int))
(fn (delayStore c outer inner count)
  {
    (let mut x outer)
    (let mut y outer)
    (let mut z outer)
    (let mut n 0)
    {
      (while (< n count)
        {
          (set c.s x)
          (set x y)
          (set y z)
          (set z inner)
          (set n (+ n 1))
        })
      0
    }
  })

(:: main Int)
(fn (main)
  (region local
    {
      (let c (Cell :s "outer"))
      {
        (delayStore c "outer" (strDup "short") 4)
        (if (strEq c.s "short")
          0
          1)
      }
    }))
