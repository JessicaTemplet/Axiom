; An ablated origin pass permits a callee to store reclaimed memory.
(import IO)
(import Mem)
(import Str)

(struct Cell
  (mut s : String))

(:: put (-> Cell String Int))
(fn (put c x)
  {
    (set c.s x)
    0
  })

(:: burn (-> Int Int))
(fn (burn n)
  (if (<= n 0)
    0
    {
      (memAlloc 65536)
      (burn (- n 1))
    }))

(:: main ())
;@axiom:effect(io)
(fn (main)
  (let ((c (Cell "empty")))
    {
      (region short
        (put c (concat "hel" "lo")))
      (burn 64)
      (println c.s)
    }))
