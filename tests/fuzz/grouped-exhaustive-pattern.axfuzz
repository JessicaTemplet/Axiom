; expect 2
; Grouped whole patterns, constructor heads, nullary tests and binders.
(data Color
  (Red)
  (Green))

(data Item
  (Wrap Color))

(:: choose (-> Item Int))
(fn (choose item)
  (match item
    (((Wrap ((Red)))) 1)
    (((Wrap) ((Green))) 2)))

(:: groupedBinder (-> Int Int))
(fn (groupedBinder value)
  (match value
    (((bound)) bound)))

(:: main Int)
(fn (main)
  (+ (choose (Wrap Green)) (- (groupedBinder 7) 7)))
