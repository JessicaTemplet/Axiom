; A declaration-macro invocation hands its AXTAGs to the first
; declaration it generates. One that generates nothing has nowhere to
; put them, so the claim is refused rather than dropped. The same
; invocation without the tag, and a tagged one that does generate, are
; the controls: neither draws anything.
(struct Empty)

(struct One
  (x : Int))

(macro getters ((getters S)
   (syntax/for (f (syntax/fields S))
     (fn ((syntax/join get f) s) 30))))

;@axiom:restrict(no-io)
(getters Empty)

(getters Empty)

;@axiom:restrict(no-io)
(getters One)

(:: main Int)
(fn (main)
  (getX 0))
