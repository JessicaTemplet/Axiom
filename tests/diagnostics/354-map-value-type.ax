; A default can't choose what `mapGet` answers.
;
; `(mapGet m key dflt)` answers the table's value type `v`, and `dflt`
; is a `v` too, so over a `(Map Int)` the default `"absent"` is an
; `AX3004` at the argument: the default is an `Int` and `"absent"` is
; not. When the table carried no value type, this checked and the
; binary read 100000000 as a String's header (exit 139).
;
; `honest` is the control: the same lookup with an `Int` default, and it
; must draw nothing. tests/diagnostics/483-map-handle-not-int.ax is
; where a non-`Map` handle is refused.
(import Map)
(import Str)

(:: mixed (-> (Map Int) Int))
(fn (mixed n)
  {
    (mapInsert n 1 100000000)
    (strLen (mapGet n 1 "absent"))
  })

(:: honest (-> (Map Int) Int))
(fn (honest n)
  {
    (mapInsert n 1 100000000)
    (mapGet n 1 (- 0 1))
  })

(:: main ())
(fn (main)
  ())
