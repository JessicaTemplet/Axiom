(import Task)
(import Vec)
(import Str)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  {
    (let saved (vecWithCapacity 4))
    {
      (taskFold (lambda (i) "answer") 1 (taskOpts 1 32) 0
        (lambda (acc i result)
          (match result
            ((Ok text)
              {
                (vecPush saved text)
                acc
              }
            )
            ((Err error) acc))
        ))
      (taskFold (lambda (i) "answer") 1 (taskOpts 1 32) 0
        (lambda (acc i result)
          {
            (vecPush saved (strDup "fresh"))
            acc
          }
        ))
      0
    }
  })
