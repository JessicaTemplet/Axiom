; AX3043: a reference smuggled through a field declared `Int`.
; Two errors - a struct field and a data payload: the `cast` launders
; the operand's type while the operand stays a `String`, and the
; release walk follows declared types, so the word is invisible to
; reclamation and leaks. The
; direct shape (a `String` where an `Int` stands) is `AX3004`, owned
; by that error rather than doubled here; a cast of an `Int` draws
; nothing, since there is no reference to hide.
(struct Box
  (v : Int))

(data E
  (Err Int))

(:: main ())
(fn (main)
  (let ((s "x"))
    {
      (let ((b
        (Box (as s Int))))
        ())
      (let ((e
        (Err (as s Int))))
        ())
      (let ((n
        (Box (as 5 Int))))
        ())
    }))
