; Different argument origins are legal until a callee stores inner into outer.
(import Str)

(struct Cell
  (mut s : String))

(:: pair (-> Cell String Int))
(fn (pair c x)
  {
    (set c.s x)
    0
  })

(:: main Int)
(fn (main)
  {
    (let outer (Cell :s "outer"))
    {
      (region local
        {
          (let inner (Cell :s "inner"))
          (let s (strDup "local"))
          {
            (pair inner s)
            0
          }
        })
      (region escaping
        (pair outer (strDup "short")))
      0
    }
  })
