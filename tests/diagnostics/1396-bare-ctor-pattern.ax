; A bare constructor name in a pattern is a test, so it covers only
; its own constructor. Both matches below miss a case: `(None 0)`
; doesn't catch `(Some 3)`, and `(A 1)` doesn't catch `C`.
(data T
  (A)
  (B)
  (C))

(:: opt (-> (Option Int) Int))
(fn (opt o)
  (match o
    ((Some 1) 10)
    ((Some 2) 20)
    (None 0)))

(:: pick (-> T Int))
(fn (pick t)
  (match t
    (A 1)
    (B 2)))

(:: main Int)
(fn (main)
  0)
