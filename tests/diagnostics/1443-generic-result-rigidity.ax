; A caller's type parameter remains rigid inside every result shape.
(import Vec)

(data Pair (a b)
  (Paired a b))

(struct Record (a)
  (value : a))

(type Optional a = (Option a))

(:: forgedOption (-> a (Option a)))
(fn (forgedOption witness)
  (Some 42))

(:: forgedAlias (-> a (Optional a)))
(fn (forgedAlias witness)
  (Some 42))

(:: forgedVector (-> a (Vec a)))
(fn (forgedVector witness)
  (vecPush vecNew 42))

(:: forgedRecord (-> a (Record a)))
(fn (forgedRecord witness)
  (Record 42))

(:: swapped (-> a b (Pair a b)))
(fn (swapped left right)
  (Paired right left))

(:: wrongConcrete (-> a (Pair a Int)))
(fn (wrongConcrete witness)
  (Paired witness "not an integer"))

(:: bump (-> Int Int))
(fn (bump n)
  (+ n 1))

(:: forgedCallback (-> a (Option (-> a Int))))
(fn (forgedCallback witness)
  (Some bump))

(subtype Small is Int range 0..10)

(:: boundedOnly (-> Small Int))
(fn (boundedOnly n)
  n)

(:: forgedRangeCallback (-> Int Int))
(fn (forgedRangeCallback)
  boundedOnly)

(:: main Int)
(fn (main)
  0)
