; A `nolint(all)` above an `import` is the file's: it quiets every
; warning and hint below it, and never an error. The undefined name
; is the control: it stays, while the warning on `pure` is gone.
;@axiom:nolint(all)
(import Str)

(struct Box
  (f : (-> Int Int)))

(:: pure (-> Box Int))
;@axiom:effect(pure)
(fn (pure b)
  (b.f 1))

(:: main Int)
(fn (main)
  nosuch)
