; Nested blocks and loop tails must report each discarded Result once.
(import Err)

(:: fallible (-> Int (Result Int Error)))
(fn (fallible value)
  (Ok value))

(:: nested ())
(fn (nested)
  {
    {
      (let value 1)
      (fallible value)
    }
    ()
  })

(:: unitBody ())
(fn (unitBody)
  {
    (let value 2)
    (fallible value)
  })

(:: loopBody ())
(fn (loopBody)
  (while false
    {
      (let value 3)
      (fallible value)
    }))

(:: branchBody ())
(fn (branchBody)
  (if false
    {
      (let value 4)
      (fallible value)
    }
    ()))

(:: main ())
(fn (main)
  ())
