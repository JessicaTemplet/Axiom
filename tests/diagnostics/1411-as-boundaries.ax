(type Step = (-> Int Int))

(:: inc (-> Int Int))
(fn (inc n)
  (+ n 1))

; An annotation checks its operand; it cannot convert it.
(:: annotated Float)
(fn (annotated)
  (:: 1 Float))

; Applying an explicitly typed function still checks each argument.
(:: badCall Int)
(fn (badCall)
  ((as inc Step) 1.0))

; A converted scalar cannot be called as a function.
(:: scalarCall Float)
(fn (scalarCall)
  ((as 1 Float) 2))

; A rigid type variable does not grant numeric operations.
(:: genericCast (-> a Float))
(fn (genericCast value)
  (as value Float))

; Restrictions see numeric conversions after their primitive lowering.
;@axiom:restrict(no-cast)
(:: restricted (-> Int Float))
(fn (restricted value)
  (as value Float))

(:: main Int)
(fn (main)
  0)
