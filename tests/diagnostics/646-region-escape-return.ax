; A callee's result origins do not let a reference leave a lexical scope.
(import Str)

(:: pick (-> String String String))
(fn (pick a b)
  a)

(:: fresh (-> String String))
(fn (fresh a)
  (concat a "x"))

(:: same (-> String String))
(fn (same a)
  a)

(:: main Int)
(fn (main)
  {
    (region picked
      (pick (strDup "inner") "outer"))
    (region allocated
      (fresh "inner"))
    (region borrowed
      (strLen (same "outer")))
    0
  })
