; Expected types never insert numeric conversions, including inside ADTs.
(data Wrapped a
  (Wrap a))

(:: takesFloat (-> Float Float))
(fn (takesFloat x)
  x)

(:: callBoundary Float)
(fn (callBoundary)
  (takesFloat 1))

(:: returnBoundary Float)
(fn (returnBoundary)
  1)

(:: assignmentBoundary Float)
(fn (assignmentBoundary)
  {
    (let mut x 1.0)
    {
      (set x 1)
      x
    }
  })

(:: branchBoundary Float)
(fn (branchBoundary)
  (if true
    1.0
    1))

(:: payloadBoundary (Wrapped Float))
(fn (payloadBoundary)
  (Wrap 1))

(:: takesWrapped (-> (Wrapped Float) Int))
(fn (takesWrapped x)
  0)

(:: integerBox (Wrapped Int))
(fn (integerBox)
  (Wrap 1))

(:: adtBoundary Int)
(fn (adtBoundary)
  (takesWrapped integerBox))

(:: identity (-> a a))
(fn (identity x)
  x)

(:: genericBoundary Int)
(fn (genericBoundary)
  (takesWrapped (identity integerBox)))

(:: takesOption (-> (Option Float) Int))
(fn (takesOption x)
  0)

(:: optionBoundary Int)
(fn (optionBoundary)
  (takesOption (Some 1)))

(:: takesInt (-> Int Int))
(fn (takesInt x)
  x)

(:: narrowingCall Int)
(fn (narrowingCall)
  (takesInt 1.0))

(:: narrowingReturn Int)
(fn (narrowingReturn)
  1.0)

(:: takesIntWrapped (-> (Wrapped Int) Int))
(fn (takesIntWrapped x)
  0)

(:: narrowingAdt Int)
(fn (narrowingAdt)
  (takesIntWrapped (Wrap 1.0)))

(:: main ())
(fn (main)
  ())
