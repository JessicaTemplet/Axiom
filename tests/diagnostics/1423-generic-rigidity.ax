; Generic bodies support every declared type; each call constrains repeats.
(type Identity a = a)

(type Endo a = (-> a a))

(:: fabricated (-> (Identity a) a))
(fn (fabricated x)
  42)

(:: numeric (-> a Int))
(fn (numeric x)
  (+ x 1))

(:: choose (-> a a a))
(fn (choose x y)
  x)

(:: different Int)
(fn (different)
  (choose 1 "wrong"))

(:: apply (-> (Endo a) a a))
(fn (apply f x)
  (f x))

(:: next (-> Int Int))
(fn (next x)
  (+ x 1))

(:: wrongCallback Int)
(fn (wrongCallback)
  (apply next 1.0))

(:: main Int)
(fn (main)
  0)
