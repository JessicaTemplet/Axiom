; Alias parameters are unique, lowercase and closed over the target.
(type Repeated (a a) a)
(type WrongName (a B) a)
(type Missing a (Option b))
(type NestedFree a (-> (Option a) (Option c)))
(type Unbound (-> a Int))
(type Unused a Int)
(type PartUnused a b (Option a))
(data Duplicate a a (Dup a))
(data FreeField a (Contains b))
(struct BadStruct (a a) (value : a))
(struct FreeStruct (a) (value : b))
(:: main Int)
(fn (main) 0)
