; `try` was removed (AX2004): the postfix `?` propagates an error in
; place, and `(try x e body)` is `(let ((x e?)) body)`. The word stays
; reserved so old source gets that rewrite instead of a call to an
; undefined `try`; `axiom explain AX2004` carries it.
(import Err)

(:: twice (-> Int (Result Int Error)))
(fn (twice n)
  (try a (divChecked n 2)
    (Ok (* a 2))))

(:: main Int)
(fn (main)
  0)
