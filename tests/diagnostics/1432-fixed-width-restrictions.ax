(:: wraps (-> UInt8 UInt8 UInt8))
;@axiom:restrict(no-wrap)
(fn (wraps x y)
  (+ x y))

(:: narrows (-> Int UInt8))
;@axiom:restrict(no-cast)
(fn (narrows x)
  (as x UInt8))

(:: divides (-> Int8 Int8 Int8))
;@axiom:restrict(no-trap)
(fn (divides x y)
  (/ x y))

(:: shifts (-> UInt8 UInt8 UInt8))
;@axiom:restrict(no-trap)
(fn (shifts x y)
  (<< x y))

(:: shiftedWrap (-> UInt8 UInt8 UInt8))
;@axiom:restrict(no-wrap)
(fn (shiftedWrap x y)
  (<< x y))

(:: main ())
(fn (main)
  ())
