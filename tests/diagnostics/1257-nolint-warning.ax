; `;@axiom:nolint(AX3037)` quiets that warning on the declaration it
; sits on, and `nolint(warnings)` every warning there, in `axiom check`
; as in the editor. `loud` is the control that keeps its AX3037.
(struct Box
  (f : (-> Int Int)))

;@axiom:nolint(AX3037)
(:: quietCode (-> Box Int))
;@axiom:effect(pure)
(fn (quietCode b)
  (b.f 1))

(:: quietGroup (-> Box Int))
;@axiom:effect(pure)
;@axiom:nolint(warnings)
(fn (quietGroup b)
  (b.f 2))

(:: loud (-> Box Int))
;@axiom:effect(pure)
(fn (loud b)
  (b.f 3))

(:: main ())
(fn (main)
  ())
