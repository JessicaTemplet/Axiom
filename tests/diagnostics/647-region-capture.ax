; A closure cannot store an inner capture into an older object.
(import Str)

(struct Hook
  (mut f : (-> Int Int)))

(:: initial (-> Int Int))
(fn (initial n)
  n)

(:: keepFn (-> Hook (-> Int Int) Int))
(fn (keepFn h f)
  {
    (set h.f f)
    0
  })

(:: main Int)
(fn (main)
  (let ((h (Hook initial)))
    {
      (region captured
        (let ((s (strDup "inner")))
          {
            (keepFn h (lambda (n) (+ n (strLen s))))
            0
          }))
      0
    }))
