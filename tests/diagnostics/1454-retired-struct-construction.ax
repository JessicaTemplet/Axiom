; Field labels are required, including when making a callable constructor.
(struct Point
  (x : Int)
  (y : Int))

(:: positional Point)
(fn (positional)
  (Point 10 20))

(:: callable (-> Int Int Point))
(fn (callable)
  Point)

(:: aliased (-> Int Int Point))
(fn (aliased x y)
  {
    (let factory Point)
    (factory x y)
  })

(:: nullary Point)
(fn (nullary)
  (Point))
