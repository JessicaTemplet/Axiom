; Handler values are called in the installation's outer scope.
; Each unhandled operation must reach main, including through a local
; lambda, a handler parameter and a named function.
(effect Trigger
  (trigger :: (-> Int Int)))

(effect Local
  (local :: (-> Int Int)))

(effect Param
  (param :: (-> Int Int)))

(effect Named
  (named :: (-> Int Int)))

(:: viaLocal Int)
(fn (viaLocal)
  (let ((h
    (lambda (n) (local n))))
    (handle
      (trigger 2)
      (Trigger Alloc)
      h)))

(:: install (-> (-> Int Int) Int))
(fn (install h)
  (handle
    (trigger 3)
    (Trigger Alloc)
    h))

(:: namedHandler (-> Int Int))
(fn (namedHandler n)
  (named n))

(:: viaNamed Int)
(fn (viaNamed)
  (handle
    (trigger 4)
    (Trigger Alloc)
    namedHandler))

(:: main Int)
(fn (main)
  (+ viaLocal (+ (install (lambda (n) (param n))) viaNamed)))
