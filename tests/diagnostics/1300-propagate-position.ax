; AX3123: a `?` with no tail to propagate to. Axiom has no early
; return, so `?` makes the rest of the body its `Ok` arm, which works
; from the body's tail and from anything evaluated on the way there,
; and not from a branch, a `let` body or a loop whose value an
; expression around it still uses. `fine` is the control.
(import Str)

(:: get (-> Int (Result Int String)))
(fn (get n)
  (if (> n 0)
    (Ok n)
    (Err "negative")))

(:: inBranch (-> Int (Result Int String)))
(fn (inBranch n)
  (Ok
    (+
      1
      (if (> n 0)
        (get n)?
        0))))

(:: inLetBody (-> Int (Result Int String)))
(fn (inLetBody n)
  (Ok
    (+
      1
      (let ((m (+ n 1)))
        (get m)?))))

(:: inLoop (-> Int (Result Int String)))
(fn (inLoop n)
  (let ((mut i 0))
    {
      (while (< i n)
        {
          (get i)?
          (set i (+ i 1))
        })
      (Ok i)
    }))

(:: fine (-> Int (Result Int String)))
(fn (fine n)
  (Ok (+ 1 (get n)?)))

(:: main ())
(fn (main)
  ())
