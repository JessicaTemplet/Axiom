(import tests.stdlib.NominalA)
(import tests.stdlib.NominalB)

(struct NamedFields
  (left : Int)
  (right : Int))

(:: unknown NamedFields)
(fn (unknown)
  (NamedFields :left 1 :oops 2))

(:: duplicate NamedFields)
(fn (duplicate)
  (NamedFields :left 1 :left 2 :right 3))

(:: missing NamedFields)
(fn (missing)
  (NamedFields :left 1))

(:: identity (-> Int Int))
(fn (identity value)
  value)

(:: ordinaryCall Int)
(fn (ordinaryCall)
  (identity :value 1))

(:: localShadow Int)
(fn (localShadow)
  {
    (let NamedFields (lambda (value) value))
    (NamedFields :left 1 :right 2)
  })

(:: main Int)
(fn (main)
  0)

; Two visible structs have equal lookup priority.
(:: ambiguous Int)
(fn (ambiguous)
  (Config :pad 0 :item (aMake 1)))
