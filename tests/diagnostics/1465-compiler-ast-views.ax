; Compiler views keep syntax nodes, names and raw words distinct.
(import core)
(import expand)
(import typecheck)
(import codegen)

(:: macroNames (-> Int Names))
(fn (macroNames env)
  (expMacrosVec env))

(:: declarationNames (-> Int Names))
(fn (declarationNames env)
  (expDeclsVec env))

(:: checkedNames (-> Int Names))
(fn (checkedNames tc)
  (tcAllDeclsVec tc))

(:: bareNodes (-> Int Nodes))
(fn (bareNodes env)
  (expBaresVec env))

(:: fullNodes (-> Int Nodes))
(fn (fullNodes env)
  (expFullsVec env))

(:: macroWord (-> MEnv Int))
(fn (macroWord env)
  env.macros)

(:: structWords (-> MEnv (Vec (Vec Int))))
(fn (structWords env)
  env.structBuckets)

(:: argumentWords (-> CG Ints))
(fn (argumentWords cg)
  cg.argVec)

(:: declarationWord (-> CG Int))
(fn (declarationWord cg)
  cg.decls)

(:: currentWord (-> CG Int))
(fn (currentWord cg)
  cg.curDeclNode)
