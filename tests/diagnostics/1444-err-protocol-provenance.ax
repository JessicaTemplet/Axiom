; Matching short names do not satisfy Err's nominal protocol.
(import Err)

(data Result (a b)
  (Err a)
  (Ok b))

(struct Error word shared
  (code : Int))

(:: localError (-> Error Int))
(fn (localError e)
  e.code)

(:: localResult (-> (Result Int Error) Int))
(fn (localResult value)
  0)

(:: standardResult (-> (Err::Result Int Err::Error) Int))
(fn (standardResult value)
  0)

(:: main Int)
(fn (main)
  {
    (Err::errorText (Error 100000000))
    (localError (Err::mkError 7 "standard error"))
    (standardResult (Ok (Error 100000000)))
    (localResult (Err::Ok 42))
    0
  })
