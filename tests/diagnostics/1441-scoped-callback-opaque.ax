(import Str)
(import Vec)

(:: invoke (-> String (-> String Int) Int))
;@axiom:scoped(step)
(fn (invoke text step)
  (step text))

(:: unary (-> (-> String Int) Int))
;@axiom:scoped(step)
(fn (unary step)
  (invoke "input" step))

(:: opaque (-> (-> String Int) Int))
(fn (opaque step)
  (invoke "input" step))

(:: factory (-> String Int))
(fn (factory)
  (let ((saved (vecWithCapacity 4)))
    (lambda (text)
      {
        (vecPush saved text)
        0
      }
    )))

(:: main Int)
(fn (main)
  (let ((callback
    (lambda (text) (strLen text))))
    {
      (invoke "input" callback)
      (invoke "input" factory)
      (let ((erased unary))
        (erased callback))
      (let ((partial (invoke "input")))
        (partial callback))
      0
    }))
