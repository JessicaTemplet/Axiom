; Different declarations stay distinct across calls, aliases and containers.
(import Vec)
(import tests.stdlib.NominalA)
(import tests.stdlib.NominalB)

(type Selected = tests.stdlib.NominalB::Thing)

(:: selected (-> Selected Int))
(fn (selected value)
  (bRead value))

(:: nested (-> (Option tests.stdlib.NominalB::Thing) Int))
(fn (nested value)
  0)

(:: vector (-> (Vec tests.stdlib.NominalB::Thing) Int))
(fn (vector value)
  0)

(:: repeated (-> a a Bool))
(fn (repeated a b)
  true)

(:: main Int)
(fn (main)
  {
    (bRead (aMake 100000000))
    (selected (aMake 7))
    (bConfigRead (aConfig 9))
    (bUnbox (aBox 11))
    (nested (Some (aMake 13)))
    (vector (vecPush vecNew (aMake 15)))
    (repeated (aMake 17) (bMake "different"))
    0
  })
