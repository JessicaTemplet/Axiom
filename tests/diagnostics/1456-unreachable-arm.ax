; An arm an earlier arm already covers can never match. AX3134.
; The `"b"` arm repeats the catch-all's coverage, `0` repeats `x`,
; and the second `(Some y)` repeats the first.
(:: f (-> String Int))
(fn (f s)
  (match s
    ("a" 1)
    (_ 2)
    ("b" 3)))

(:: g (-> Int Int))
(fn (g n)
  (match n
    (x 1)
    (0 2)))

(:: h (-> (Option Int) Int))
(fn (h o)
  (match o
    ((Some x) x)
    ((Some y) y)
    ((None) 0)))

(:: main Int)
(fn (main)
  (+ (+ (f "a") (g 1)) (h (Some 1))))
