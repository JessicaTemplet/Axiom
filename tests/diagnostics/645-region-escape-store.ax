; Interprocedural field and vector stores cannot cross a lexical reset.
(import Vec)
(import Str)

(struct Cell
  (mut s : String))

(:: putField (-> Cell String Int))
(fn (putField c x)
  {
    (set c.s x)
    0
  })

(:: putVec (-> (Vec String) String Int))
(fn (putVec v x)
  {
    (vecPush v x)
    0
  })

(:: main Int)
(fn (main)
  (let (
    (c (Cell "old"))
    (v vecNew)
  )
    {
      (region field
        (putField c (strDup "short")))
      (region vector
        (putVec v (strDup "short")))
      0
    }))
