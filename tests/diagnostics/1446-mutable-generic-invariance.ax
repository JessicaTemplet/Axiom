; Generic stores substitute the receiver's invariant type arguments.
(struct Cell (a)
  (mut value : a))

(:: wrongScalar Int)
(fn (wrongScalar)
  {
    (let cell (Cell :value (as (- 0 1) Int8)))
    (set cell.value (as 255 UInt8))
  })

(:: wrongNested Int)
(fn (wrongNested)
  {
    (let cell (Cell :value (Cell :value (as (- 0 1) Int8))))
    (set cell.value (Cell :value (as 255 UInt8)))
  })

(:: wrongReference Int)
(fn (wrongReference)
  {
    (let cell (Cell :value "reference"))
    (set cell.value (as 1 UInt8))
  })

