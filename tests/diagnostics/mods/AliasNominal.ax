(import Str)

(pub data Token
  (NamedToken String))

(pub type PublicToken = Token)

(pub struct Envelope
  (item : Token))

(pub :: makeEnvelope (-> String Envelope))
(pub fn (makeEnvelope text)
  (Envelope :item (NamedToken text)))

(pub :: envelopeSize (-> Envelope Int))
(pub fn (envelopeSize value)
  (match value.item
    ((NamedToken text) (strLen text))))
