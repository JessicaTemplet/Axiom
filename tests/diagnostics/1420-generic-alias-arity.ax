; Type uses supply exactly the alias's declared arguments.
(type Items a = (Option a))

(type Plain = Int)

(type BadTarget = Items)

(type Unknown = NotDeclared)

(:: missing (-> Items Int))
(fn (missing x)
  0)

(:: extra (-> (Items Int Float) Int))
(fn (extra x)
  0)

(:: plainExtra (-> (Plain Int) Int))
(fn (plainExtra x)
  0)

(struct BadField
  (item : Items))

(data BadPayload
  (Payload (Items Int Float)))

(data Box a
  (Boxed a))

(struct Holder (a)
  (value : a))

(:: bareBox (-> Box Int))
(fn (bareBox x)
  0)

(:: extraBox (-> (Box Int String) Int))
(fn (extraBox x)
  0)

