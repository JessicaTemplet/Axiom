; Generic ADT arguments and patterns retain their declaring module.
(import tests.stdlib.NominalA)
(import tests.stdlib.NominalB)

(type Promised a = (tests.stdlib.NominalA::Box a))

(:: wrong (-> Int (tests.stdlib.NominalA::Box Int)))
(fn (wrong value)
  (bBox value))

(:: wrongNested (-> Int (Option (tests.stdlib.NominalA::Box Int))))
(fn (wrongNested value)
  (Some (bBox value)))

(:: wrongAlias (-> Int (Promised Int)))
(fn (wrongAlias value)
  (bBox value))

(:: wrongPattern (-> tests.stdlib.NominalA::Thing Int))
(fn (wrongPattern value)
  (match value
    ((TextThing text) 0)))

(:: main Int)
(fn (main)
  0)
