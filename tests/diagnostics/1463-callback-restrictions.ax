(import IO)

(:: apply (-> (-> Int Int) Int Int))
;@axiom:restrict(no-io)
(fn (apply f x)
  (f x))

(:: forward (-> (-> Int Int) Int Int))
(fn (forward f x)
  {
    (let alias f)
    (apply alias x)
  })

(:: captured (-> (-> Int Int) Int Int))
(fn (captured f x)
  (apply (lambda (n) (f n)) x))

(:: loud (-> Int Int))
;@axiom:effect(io)
(fn (loud n)
  {
    (println n)
    n
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (+
    (apply
      (lambda (n)
        {
          (println n)
          n
        }
      )
      1)
    (+ (forward loud 2) (captured loud 3))))
