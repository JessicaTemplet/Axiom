; An `if` without an else answers `()`, the unit value, and so does
; any `if` with a `()` branch. Reading that value where an `Int` is
; wanted is a type error, so a branch's dropped value can't be read by
; mistake: `x` here would otherwise be 5 or nothing.
(:: f (-> Bool Int))
(fn (f c)
  {
    (let x
      (if c
        5))
    (+ x 1)
  })

(:: main ())
(fn (main)
  ())
