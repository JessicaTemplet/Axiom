; The divergence oracle assumes a constant-true loop cannot exit early.
; These names have no special grammar and are undefined ordinary names.
(struct Resource
  (name : String))

(:: whileBreak Resource)
(fn (whileBreak)
  (as {
    (while true
      (break))
    1
  } Resource))

(:: whileContinue Resource)
(fn (whileContinue)
  (as {
    (while true
      (continue))
    1
  } Resource))

(:: rangeBreak Int)
(fn (rangeBreak)
  (for i in 0..3
    (break)))

(:: rangeContinue Int)
(fn (rangeContinue)
  (for i in 0..3
    (continue)))

; An actual constant-true loop still makes the forging cast unreachable.
(:: forever Resource)
(fn (forever)
  (as {
    (while true
      0)
    1
  } Resource))

(:: main ())
(fn (main)
  ())
