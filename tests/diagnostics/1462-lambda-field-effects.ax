(import IO)

(struct Box
  (send : (-> Int Int)))

(:: sneaky (-> Box Int))
(fn (sneaky box)
  (box.send 1))

(:: loud (-> Int Int))
;@axiom:effect(io)
(fn (loud n)
  {
    (println n)
    n
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let printer loud)
    (+
      (sneaky
        (Box
          :send
            (lambda (n)
              {
                (println n)
                n
              }
            )))
      (sneaky (Box :send (lambda (n) (printer n)))))
  })
