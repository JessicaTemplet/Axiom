; An `if` whose value is read still needs branches of one type: the
; dropped-branch rule (tests/stdlib/892-dropped-branches.ax) applies
; only where nobody reads the answer. Here `let` reads it.
(:: f (-> Int Int))
(fn (f n)
  {
    (let v
      (if (> n 0)
        "yes"
        0))
    v
  })

(:: main Int)
(fn (main)
  (f 1))
