; An alias cannot erase ambiguity between imported type declarations.
(import AliasAmbA)
(import AliasAmbB)

(type Ambiguous a = (Shared a))

(type Exact a = (AliasAmbA::Shared a))

(:: rejected (-> (Ambiguous Int) Int))
(fn (rejected x)
  0)

(:: accepted (-> (Exact Int) Int))
(fn (accepted value)
  (match value
    ((Some n) n)
    ((None) 0)))

(:: main Int)
(fn (main)
  (accepted (Some 42)))
