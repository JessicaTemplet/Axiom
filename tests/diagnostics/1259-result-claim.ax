; AX3116: a `result(...)` claim the compiler cannot read. The one value
; is `owned`, and it is accepted only beside `effect(unsafe)`: `first`
; is a safe function whose result ownership is inferred, so its claim
; is refused, and `top`'s value is not one the key takes. `popLike` is
; the control: a raw load behind `effect(unsafe)`, claiming `owned`.
(import Vec)
(import Mem)

;@axiom:result(lent)
(:: top (-> (Vec a) a))
(fn (top v)
  (vecGet v 0))

;@axiom:result(owned)
(:: first (-> (Vec a) a))
(fn (first v)
  (vecGet v 0))

;@axiom:result(owned)
;@axiom:effect(unsafe)
(:: popLike (-> (Vec a) a))
(fn (popLike v)
  (cast a (memGetWord (memGetWord (cast Int v) 2) 0)))

(:: main Int)
(fn (main)
  (let ((v vecNew))
    {
      (vecPush v 1)
      (+ (top v) (+ (first v) (popLike v)))
    }))
