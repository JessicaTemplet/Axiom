; The file-wide opt-out: a `nolint` tag above an `import` is the
; file's, so every hint and every warning below is quiet. This file
; draws nothing; its shapes are the ones 070 and 100 to 102 draw for.
;@axiom:nolint(all)
(import Str)

(struct Box
  (thunk : (-> Int Int)))

(:: pure (-> Box Int))
;@axiom:effect(pure)
(fn (pure b)
  (b.thunk 1))

(:: deadIf (-> Int Int))
(fn (deadIf n)
  (if true
    n
    0))

(:: wasted (-> Int Int))
(fn (wasted n)
  (let ((waste n))
    0))

(:: main Int)
(fn (main)
  0)
