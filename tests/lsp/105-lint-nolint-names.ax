; What `nolint(...)` takes on one declaration: a warning code quiets
; that warning, `warnings` quiets every warning there, and a name
; nothing answers to draws `lint-unknown-nolint` at the tag and quiets
; nothing, so the dead branch under it still shows. `loud` is the
; control whose warning stays.
(struct Box
  (thunk : (-> Int Int)))

;@axiom:nolint(AX3037)
(:: quietCode (-> Box Int))
;@axiom:effect(pure)
(fn (quietCode b)
  (b.thunk 1))

(:: quietGroup (-> Box Int))
;@axiom:effect(pure)
;@axiom:nolint(warnings)
(fn (quietGroup b)
  (b.thunk 2))

(:: loud (-> Box Int))
;@axiom:effect(pure)
(fn (loud b)
  (b.thunk 3))

;@axiom:nolint(bogus)
(:: misspelt (-> Int Int))
(fn (misspelt n)
  (if true
    n
    0))

(:: main ())
(fn (main)
  ())
