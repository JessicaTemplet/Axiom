; The entry's types and aliases keep their identity in host bindings.
(import Str)
(import Err)
(import NominalImported)

(pub data Thing
  (LocalThing Int))

(pub data Result (a b)
  (LocalError b)
  (LocalOk a))

(pub type Wrapped (Option Thing))

(pub type Standard (Err::Result Int String))

(pub :: makeThing (-> Int Thing))
(pub fn (makeThing n)
  (LocalThing n))

(pub :: readThing (-> Thing Int))
(pub fn (readThing value)
  (match value
    ((LocalThing n) n)))

(pub :: makeWrapped (-> Int Wrapped))
(pub fn (makeWrapped n)
  (Some (LocalThing n)))

(pub :: makeLocal (-> Int (Result Int String)))
(pub fn (makeLocal n)
  (if (< n 0)
    (LocalError (concat "local " "error"))
    (LocalOk n)))

(pub :: makeStandard (-> Int Standard))
(pub fn (makeStandard n)
  (if (< n 0)
    (Err::Err (concat "standard " "error"))
    (Err::Ok n)))
