; Integer ascriptions such as `(as value Int)` reuse the value's
; register. The probes exercise them under operators, nested, and
; around calls without changing the integer MIR.
;
; Floating arithmetic remains outside this MIR subset. `floatKept`
; combines an explicit numeric conversion with a Float literal, and
; the golden pins its refusal alongside `emit`'s IO refusal.
;
; And `probeSub` is not commutative on purpose: every other probe
; here adds or multiplies, so a lowering that swapped a binary
; operator's operands would print the same twenty lines through both
; sides of the differential - the hole `100-callargs` exists for.
;
(import IO)

(:: probeId (-> Int Int))
(fn (probeId k)
  (as k Int))

(:: probeAdd (-> Int Int))
(fn (probeAdd k)
  (+ (as k Int) (* k 2)))

(:: probeNest (-> Int Int))
(fn (probeNest k)
  (as (as (+ k 3) Int) Int))

(:: probeCall (-> Int Int))
(fn (probeCall k)
  (as (probeId k) Int))

(:: probeSub (-> Int Int Int))
(fn (probeSub a b)
  (- (* (as a Int) 100) b))

(:: probe (-> Int Int))
(fn (probe k)
  (+ (probeSub k (+ k 1)) (+ (probeId k) (+ (probeAdd k) (+ (probeNest k) (probeCall k))))))

(:: floatKept (-> Int Float))
(fn (floatKept k)
  (+ (as k Float) 0.5))

(:: emit (-> Int Int))
;@axiom:effect(io)
(fn (emit k)
  (if (>= k 20)
    0
    {
      {
        (let v (probe k))
        (println "{v}")
      }
      (emit (+ k 1))
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (emit 0))
