; expect 0
; Generated patterns must be validated even when their source spans are absent.
(import core)
(import parser)
(import typecheck)
(import diag)
(import Vec)
(import Str)
(import Test)

(:: assertInvalidHead (-> Int Int))
;@axiom:effect(io)
(fn (assertInvalidHead span)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (let head (mkEInt 1))
    (let binder (mkEVarAt "bound" (mkSpan 8 13)))
    (let pat (nodeBuildEApp head binder nilWords span))
    (checkPatternTyped tc pat mkIntTy mkIntTy)
    (assertEq "one invalid-head diagnostic" 1 (vecLen (tcOutVec tc)))
    (let diagnostic (vecGet (tcOutVec tc) 0))
    (assertEq "invalid head is an error" SEV_ERROR (diagSev diagnostic))
    (assertTrue "invalid head is AX3003" (strEq (diagCode diagnostic) "AX3003"))
    (assertEq "missing head span falls back to pattern" span (diagSpan diagnostic))
    (let binding (scopeFindFrame tc "bound"))
    (assertTrue "invalid pattern still binds its argument" (!= binding 0))
    (assertEq "argument binding is poison" 1 (tyIsErr (sEntTy binding)))
    (assertEq "reading argument propagates poison" 1 (tyIsErr (checkVar tc binder 0)))
    (assertEq "reading poison adds no diagnostic" 1 (vecLen (tcOutVec tc)))
    0
  })

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (assertInvalidHead 0)
    (assertInvalidHead (mkSpan 2 7))
    (let tc (tcNew vecNew vecNew vecNew))
    (checkPatternTyped tc (mkEInt 1) mkIntTy mkIntTy)
    (assertEq "direct literal remains valid" 0 (vecLen (tcOutVec tc)))
    (let optionTy (mkTCon "Option" (vecPush nodesNew mkIntTy)))
    (let binder (mkEVarAt "value" (mkSpan 20 25)))
    (checkPatternTyped tc (mkEApp (mkEVar "Some") binder) optionTy optionTy)
    (assertEq "constructor application remains valid" 0 (vecLen (tcOutVec tc)))
    (let binding (scopeFindFrame tc "value"))
    (assertTrue "constructor field binds" (!= binding 0))
    (assertTrue "constructor field keeps its type" (strEq (tyRender (sEntTy binding)) "Int"))
    0
  })
