; expect 42
; A handle's effect list contains spanned syntax nodes.
(import core)
(import parser)
(import expand)
(import Vec)

(:: handled (-> String ASTNode))
(fn (handled effect)
  (nodeBuildEHandle (mkEInt 1) (vecPush vecNew (mkEVar effect)) (mkEInt 2) 0))

(:: main Int)
(fn (main)
  (if (&& (== (expSyntaxSame (handled "IO") (handled "IO")) 1)
        (== (expSyntaxSame (handled "IO") (handled "Net")) 0))
    42
    1))
