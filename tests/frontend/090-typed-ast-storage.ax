; expect 0
(import core)
(import parser)
(import Mem)
(import Str)
(import Vec)
(import Test)

; The returned node outlives both the builder's locals and its parent.
(:: detached (-> String ASTNode))
(fn (detached spelling)
  (nodeBChild (mkEApp (mkEVar "callee") (mkEVar (strDup spelling)))))

; Cloning copies the reference map as well as the packed words.
(:: cloned ASTNode)
(fn (cloned)
  (nodeClone (mkEApp (mkEVar "callee") (detached "cloned"))))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (assertEq "null tag" (nodeTag nilNode) TAG_NIL)
    (assertEq "null span" (nodeSpan nilNode) 0)
    (assertTrue "null clone" (nodeSame (nodeClone nilNode) nilNode))
    (let parent (cloned))
    (let held (nodeBChild parent))
    (writeNodeChild parent 2 (detached "replacement"))
    (assertTrue "replacement keeps borrowed child" (strEq (nodeAName held) "cloned"))
    (assertTrue "replacement owns new child" (strEq (nodeAName (nodeBChild parent)) "replacement"))
    (writeNodeChild parent 2 (nodeBChild parent))
    (assertTrue "self replacement retains before release"
      (strEq (nodeAName (nodeBChild parent)) "replacement"))
    (writeNodeWord parent 2 17)
    (assertEq "scalar replacement" (nodeB parent) 17)
    (writeNodeChild parent 2 held)
    (let children (vecPush nodesNew (nodeBChild parent)))
    (writeNodeChild parent 2 (detached "last"))
    (assertTrue "typed vector owns child" (strEq (nodeAName (vecGet children 0)) "cloned"))
    (let copy (nodeClone parent))
    (writeNodeChild parent 2 (detached "changed"))
    (assertTrue "cloned child survives overwrite" (strEq (nodeAName (nodeBChild copy)) "last"))
    (let mut i 0)
    (while (< i 1000)
      {
        (let leaf (detached "still alive"))
        (let churn (detached "churn"))
        (assertTrue "getter returns an owned handle" (strEq (nodeAName leaf) "still alive"))
        (assertTrue "distinct live nodes" (! (nodeSame leaf churn)))
        (set i (+ i 1))
      })
    0
  })
