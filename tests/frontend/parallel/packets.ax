(import frontpack)
(import parser)
(import core)
(import Mem)
(import Str)
(import Vec)
(import IO)
(import Test)

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (main)
  {
    (let source
      "(pub struct Cell word shared (value : Int))\n(:: id (-> Float Float))\n;@axiom:effect(pure)\n(fn (id x) x)\n")
    (match (frontParse source)
      ((None) (assertTrue "packet invariant" false))
      ((Some original)
        {
          (let packet (frontEncode original))
          (assertTrue "packet invariant" (> (strLen packet) 0))
          (match (frontDecode packet)
            ((None) (assertTrue "packet invariant" false))
            ((Some copied)
              {
                (assertTrue "packet invariant" (strEq source copied.source))
                (assertEq "parsed field" (vecLen copied.decls) 3)
                (let cell (vecGet copied.decls 0))
                (assertEq "parsed field" (nodeTag cell) TAG_D_STRUCT)
                (assertEq "parsed field" (nodeVis cell) 1)
                (assertTrue "packet invariant" (strEq (nodeAName cell) "Cell"))
                (assertTrue "packet invariant" (structIsWord cell))
                (assertTrue "packet invariant" (structIsShared cell))
                (let signature (vecGet copied.decls 1))
                (assertEq "parsed field" (nodeTag (nodeTyChild signature)) TAG_T_ARR)
                (assertEq "parsed field" (vecGet (nodeBWords signature) 0) 1)
                (let function (vecGet copied.decls 2))
                (assertEq "parsed field" (vecLen (nodeAxtagsWords function)) 1)
                (assertTrue "packet invariant"
                  (strEq (memGetWordStr (vecGet (nodeAxtagsWords function) 0) 1) "effect(pure)"))
                (assertTrue "packet invariant" (strEq packet (frontEncode copied)))
              }
            ))
          (let mut cut 0)
          (while (< cut (strLen packet))
            {
              (assertTrue "packet invariant" (isNone (frontDecode (strSlice packet 0 cut))))
              (set cut (+ cut 8))
            })
          (let corrupt (strDup packet))
          (__store64 (strData corrupt) 0 0)
          (assertTrue "packet invariant" (isNone (frontDecode corrupt)))
          (assertTrue "packet invariant" (isNone (frontDecode (concat packet "extra"))))
          (let invalid (strAlloc 24))
          (__store64 (strData invalid) 0 (__load64 (strData packet) 0))
          (__store64 (strData invalid) 1 9223372036854775807)
          (assertTrue "packet invariant" (isNone (frontDecode invalid)))
        }
      ))
    (assertTrue "packet invariant" (isNone (frontDecode "")))
    (assertTrue "packet invariant" (isNone (frontParse "(fn (main)")))
    (println "parsed fields, truncation and invalid lengths: OK")
    0
  })
