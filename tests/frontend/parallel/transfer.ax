; Rebuild every parsed field after the packet's worker has exited.
(import frontpack)
(import frontjobs)
(import IO)
(import Err)
(import Task)
(import Sys)
(import Str)
(import Fmt)
(import Vec)
(import core)

(:: packet (-> String String))
;@axiom:effect(io)
(fn (packet file)
  (match (readFile file)
    ((Err e) "")
    ((Ok source)
      (match (frontParse source)
        ((None) "")
        ((Some parsed) (frontEncode parsed)))
    )))

(:: inspect (-> String Bool String))
(fn (inspect bytes digest)
  (match (frontDecode bytes)
    ((None) "fallback")
    ((Some parsed)
      (if (&& digest (! (strEq bytes (frontEncode parsed))))
        "changed"
        {
          (let mut hash (if digest 1469598103934665603 0))
          (let mut i 0)
          (while (&& digest (< i (strLen bytes)))
            {
              (set hash (* (^ hash (strByte bytes i)) 1099511628211))
              (set i (+ i 1))
            })
          (concat "ok "
            (concat (fmtInt (vecLen parsed.decls))
              (concat " "
                (concat
                  (fmtInt
                    (if digest
                      (strLen bytes)
                      (strLen parsed.source)))
                  (concat " " (fmtInt hash))))))
        })
    )))

; Normal serial parsing has no encoding or decoding work. Keep that
; baseline honest when deciding whether workers should be the default.
(:: serial (-> String Bool String))
;@axiom:effect(io)
(fn (serial file encode)
  (match (readFile file)
    ((Err e) "fallback")
    ((Ok source)
      (match (frontParse source)
        ((None) "fallback")
        ((Some parsed)
          (concat "ok "
            (concat (fmtInt (vecLen parsed.decls))
              (concat " "
                (concat
                  (fmtInt
                    (if encode
                      (strLen (frontEncode parsed))
                      (strLen source)))
                  " 0"))))
        ))
    )))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(spawn)
;@axiom:effect(block)
(fn (main)
  {
    (let width (strToInt (sysArg 1)))
    (let digest (strEq (sysArg 2) "verify"))
    (let roundtrip (strEq (sysArg 2) "roundtrip"))
    (let count (- sysArgc 3))
    (if (<= width 1)
      {
        (let mut i 0)
        (while (< i count)
          {
            (println
              (if (|| digest roundtrip)
                (inspect (packet (sysArg (+ i 3))) digest)
                (serial (sysArg (+ i 3)) (strEq (sysArg 2) "encode"))))
            (set i (+ i 1))
          })
      }
      {
        (let paths vecNew)
        (let mut i 0)
        (while (< i count)
          {
            (vecPush paths (sysArg (+ i 3)))
            (set i (+ i 1))
          })
        (let results (frontParseFiles paths (frontFileSizes paths) width))
        (set i 0)
        (while (< i (vecLen results))
          {
            (match (vecGet results i)
              ((None) (println "fallback"))
              ((Some parsed)
                (println
                  (if digest
                    (inspect (frontEncode parsed) true)
                    (concat "ok " (concat (fmtInt (vecLen parsed.decls))
                      (concat " " (concat (fmtInt (strLen parsed.source)) " 0"))))))))
            (set i (+ i 1))
          })
      })
    0
  })
