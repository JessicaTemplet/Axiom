; Binding identity must survive both template and argument forwarding.
(pub :: op (-> Int Int))
(pub fn (op x)
  (+ x 10))

(pub macro isLib (literals op)
  ((isLib op) 1)
  ((isLib other) 0))

(pub macro (forward x) (isLib x))

(pub macro (libraryOp) (isLib op))

(pub macro emitLib (literals op)
  ((emitLib nm op) (:: nm Int) (fn (nm) 1))
  ((emitLib nm other) (:: nm Int) (fn (nm) 2)))

(pub macro emitForward ((emitForward nm x) (emitLib nm x)))

(pub data MarkerType (Marker))

(pub macro isMarker (literals Marker)
  ((isMarker Marker) 1)
  ((isMarker other) 0))

(pub macro (markerWord) 99)

(pub macro isKeyword (literals markerWord)
  ((isKeyword markerWord) 1)
  ((isKeyword other) 0))

(pub macro (ownKeyword) (isKeyword markerWord))
