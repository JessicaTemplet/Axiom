; expect 153
; Rule-form macros over EXPRESSION templates (MAC-LANG-14), selected by
; a match in rule order like declaration rules are. Each rule's template
; here is one expression, so each invocation in expression position
; instantiates it.
;
;   t1  40  literal dispatch: `(+ a 0)` rewrites to `a`
;   t2  2   literal dispatch: `(* a 1)` rewrites to `a`
;   t3  0   fallback: anything else rewrites to itself
;   t4  10  ellipsis: `(call4 v ...)` splices into `(sum4 v ...)`
;   t5  101 hygiene: the template's `tmp` cannot capture the caller's
(macro simp (literals + *)
  ((simp (+ a 0)) a)
  ((simp (* a 1)) a)
  ((simp other) other))

(:: sum4 (-> Int Int Int Int Int))
(fn (sum4 a b c d)
  (+ a (+ b (+ c d))))

(macro call4 ((call4 v ...) (sum4 v ...)))

(macro addTo ((addTo x) (let ((tmp 100)) (+ tmp x))))

(:: main Int)
(fn (main)
  (+
    (+ (+ (simp (+ 40 0)) (+ (simp (* 2 1)) (simp 0))) (call4 1 2 3 4))
    (let ((tmp 1))
      (addTo tmp))))
