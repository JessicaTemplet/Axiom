; expect 6
; A bare constructor name in pattern position tests that constructor's
; tag, exactly as the parenthesised `(Nil2)` does, so the first arm
; matches only `Nil2` and `(Cons2 1 Nil2)` reaches the second arm.
(data L2
  (Nil2)
  (Cons2 Int L2))

(:: f (-> L2 Int))
(fn (f l)
  (match l
    (Nil2 5)
    ((Cons2 h t) 6)))

(:: main Int)
(fn (main)
  (f (Cons2 1 Nil2)))
