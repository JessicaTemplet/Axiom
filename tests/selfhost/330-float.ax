; expect 52
; Floats end to end: a literal decoded to its bit pattern, `fmul` and
; `fdiv` chosen by signature-driven float-ness (nothing about the value
; itself says it is a float), an ordered `fcmp`, and both numeric
; conversions. 10 + 40 + 2.
(:: scale (-> Float Float))
(fn (scale x)
  (* x 4.0))

(:: main Int)
(fn (main)
  (+
    (as (scale 2.5) Int)
    (+
      (if (< 1.5 2.5)
        40
        0)
      (as (/ (as 4 Float) (as 2 Float)) Int))))
