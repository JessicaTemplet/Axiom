; expect 42
; Check physical offsets independently of the emitted field accessors.
; Every supported target is little-endian; each load stays word-aligned.
(struct CompactProbe
  (mut signedByte : Int8)
  (mut byte : UInt8)
  (signedShort : Int16)
  (short : UInt16)
  (signedWord : Int32)
  (word : UInt32)
  (wide : UInt64))

(:: main Int)
;@axiom:effect(unsafe)
(fn (main)
  (let (
    (value (CompactProbe (as 128 Int8) (as 255 UInt8) (as 32768 Int16) (as 65535 UInt16)
             (as 2147483648 Int32) (as (- 0 1) UInt32) (as (- 0 1) UInt64)))
    (address (as value Int))
    (first (__load64 address 0))
    (second (__load64 address 1))
    (third (__load64 address 2))
    (padding (__load64 address 3))
  )
    {
      (set value.signedByte (as 127 Int8))
      (set value.byte (as 7 UInt8))
      (if (&& (== first 281472829292416)
            (&& (! (== first 281472829292417))
              (&& (== second -2147483648)
                (&& (== third -1)
                  (&& (== padding 0)
                    (&& (== (__load8 address 0) 127)
                      (&& (== (__load8 address 1) 7)
                        (&& (== (__load8 address 2) 0)
                          (&& (== (__load8 address 3) 128)
                            (&& (== (as value.signedShort Int) -32768)
                              (== (as value.short Int) 65535)))))))))))
        42
        1)
    }))
