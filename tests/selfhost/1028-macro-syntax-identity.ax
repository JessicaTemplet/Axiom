; expect 255
(import MacroScopeLib)

(data LocalMarker (Marker))

(macro (markerWord) 77)

(macro keyword (literals otherwise)
  ((keyword otherwise) 1)
  ((keyword other) 0))

(macro same ((same x x) 1)
  ((same x y) 0))

(macro bindName ((bindName name body) {
  (let name 7)
  body
}))

(macro (duplicated x) (same x x))

(struct Row
  (x : Int)
  (y : Int))

(:: main Int)
(fn (main)
  {
    (let a
      (if (== (MacroScopeLib::isMarker Marker) 0)
        1
        0))
    (let b
      (if (== (MacroScopeLib::isMarker MacroScopeLib::Marker) 1)
        2
        0))
    (let c
      (if (== (MacroScopeLib::isKeyword markerWord) 0)
        4
        0))
    (let d
      (if (== MacroScopeLib::ownKeyword 1)
        8
        0))
    (let e
      (if (== (bindName otherwise (keyword otherwise)) 0)
        16
        0))
    (let f
      (if (&& (== (same (Row :x 1 :y 2) (Row :x 1 :y 2)) 1)
            (== (same (Row :x 1 :y 2) (Row :y 1 :x 2)) 0))
        32
        0))
    (let g
      (if (&& (== (same 'a' 'a') 1) (== (same 'a' 'b') 0))
        64
        0))
    (let h
      (if (== (same (lambda (x) x) (lambda (x) x)) 0)
        128
        0))
    (+ a (+ b (+ c (+ d (+ e (+ f (+ g h)))))))
  })
