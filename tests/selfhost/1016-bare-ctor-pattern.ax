; expect 35
; A bare constructor name in a pattern tests that constructor, as the
; parenthesised spelling does. `(None 0)` as the first arm answers 0
; only for `None`, `(A 1)` doesn't catch `C`, a bare constructor
; nested in a fieldful pattern is a test too, and a bare name that
; names no constructor still binds.
(data T
  (A)
  (B)
  (C))

(data W
  (Wrap T))

(:: opt (-> (Option Int) Int))
(fn (opt o)
  (match o
    (None 0)
    ((Some x) x)))

(:: pick (-> T Int))
(fn (pick t)
  (match t
    (A 1)
    (B 2)
    (C 3)))

(:: inner (-> W Int))
(fn (inner w)
  (match w
    ((Wrap A) 10)
    ((Wrap B) 20)
    ((Wrap C) 30)))

(:: bind (-> T Int))
(fn (bind t)
  (match t
    (other 7)))

(fn (main)
  (+ (opt (Some 5)) (+ (pick C) (+ (inner (Wrap B)) (bind A)))))
