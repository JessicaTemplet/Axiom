; expect 42
; Repeated checks of canonical types must not retain a fresh tree per use.
(import core)
(import parser)
(import typecheck)
(import Mem)

(:: main Int)
(fn (main)
  {
    (let tc (tcNew vecNew vecNew vecNew))
    (let canonical (mkTArr mkIntTy mkVecIntTy))
    (let before memStats)
    (let mut last canonical)
    {
      (for i in 0..4000
        (set last (tyExpandAliases tc canonical 0)))
      {
        (let after memStats)
        (if (&& (< (- after.heldBytes before.heldBytes) 65536)
              (&& (== (nodeTag last) TAG_T_ARR)
                (&& (strEq (nodeAName (nodeA last)) "Int") (strEq (nodeAName (nodeB last)) "Vec"))))
          42
          1)
      }
    }
  })
