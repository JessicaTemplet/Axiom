; expect 37
; A declaration macro may generate no declarations at all, and the
; invocation then leaves nothing behind. Both routes to an empty
; expansion are here: a `syntax/for` over the fields of a struct with
; none, and a `decl ...` splice over an empty tail, which MAC-LANG-16
; allows ("an empty tail matches, with empty sequences"). Each used to
; stop the compiler with status 77, indexing the first of no generated
; declarations. Beside each empty invocation sits one that generates,
; so the round still splices what it builds.
(struct Empty)

(struct One
  (x : Int))

(macro getters ((getters S)
   (syntax/for (f (syntax/fields S))
     (:: (syntax/join get f) (-> S Int)))
   (syntax/for (f (syntax/fields S))
     (fn ((syntax/join get f) s) 30))))

(getters Empty)

(getters One)

(macro gen ((gen (c v) ...)
  (:: (syntax/join code c) (-> Int Int))
  ...
  (fn ((syntax/join code c) x) (+ x v))
  ...))

(gen)

(gen (A 5))

(:: main Int)
(fn (main)
  (+ (getX (One :x 7)) (codeA 2)))
