; expect 42
; Actual compiler records save allocation space and retain exact flag values.
(import IO)
(import replhl)
(import expand)

(:: liveBytes Int)
(fn (liveBytes)
  (- (__axiom_mem_stat 0) (__axiom_mem_stat 1)))

(:: blockCount (-> Int Int))
;@axiom:effect(unsafe)
(fn (blockCount handle)
  (__load64 (- handle 16) 0))

(:: bracketBytes Int)
(fn (bracketBytes)
  (let (
    (warm (mkHlBrk 7 1 2 -1 99))
    (before liveBytes)
    (value (mkHlBrk 8 0 1 7 100))
    (bytes (- liveBytes before))
  )
    (if (&& (== (hlBrkPos warm) 7) (== (hlBrkSpan value) 100))
      bytes
      -1)))

(:: formatBytes Int)
(fn (formatBytes)
  (let (
    (warm (mkFmtSpec 62 1 20 -1 0 1))
    (before liveBytes)
    (value (mkFmtSpec 60 0 100 12 120 1))
    (bytes (- liveBytes before))
  )
    (if (&& (== (fmtSpecWidth warm) 20) (== (fmtSpecPrec value) 12))
      bytes
      -1)))

(:: bracketValues Bool)
(fn (bracketValues)
  (let ((value (mkHlBrk 1099511627776 1 2 -1 2199023255552)))
    (&& (== (hlBrkPos value) 1099511627776)
      (&& (== (hlBrkOpen value) 1)
        (&& (== (hlBrkFam value) 2)
          (&& (== (hlBrkPartner value) -1) (== (hlBrkSpan value) 2199023255552)))))))

(:: formatValues Bool)
(fn (formatValues)
  (let ((value (mkFmtSpec 94 1 1099511627776 2199023255552 88 0)))
    (&& (== (fmtSpecAlign value) 94)
      (&& (== (fmtSpecZero value) 1)
        (&& (== (fmtSpecWidth value) 1099511627776)
          (&& (== (fmtSpecPrec value) 2199023255552)
            (&& (== (fmtSpecType value) 88) (== (fmtSpecOk value) 0))))))))

(:: absentValues Bool)
(fn (absentValues)
  (let ((value (mkFmtSpec 62 0 0 -1 0 1)))
    (&& (== (fmtSpecAlign value) 62)
      (&& (== (fmtSpecZero value) 0)
        (&& (== (fmtSpecWidth value) 0)
          (&& (== (fmtSpecPrec value) -1)
            (&& (== (fmtSpecType value) 0) (== (fmtSpecOk value) 1))))))))

(:: stableViews Bool)
(fn (stableViews)
  (let (
    (bracket (mkHlBrk 7 1 2 -1 99))
    (spec (mkFmtSpec 62 1 20 6 120 1))
    (bracketCount (blockCount bracket))
    (specCount (blockCount spec))
    (mut exact true)
  )
    {
      (for i in 0..1000
        {
          (set exact (&& exact
                       (&& (== (hlBrkPos bracket) 7)
                         (&& (== (hlBrkOpen bracket) 1)
                           (&& (== (hlBrkFam bracket) 2)
                             (&& (== (hlBrkPartner bracket) -1) (== (hlBrkSpan bracket) 99)))))))
          (set exact (&& exact
                       (&& (== (fmtSpecAlign spec) 62)
                         (&& (== (fmtSpecZero spec) 1)
                           (&& (== (fmtSpecWidth spec) 20)
                             (&& (== (fmtSpecPrec spec) 6)
                               (&& (== (fmtSpecType spec) 120) (== (fmtSpecOk spec) 1))))))))
        })
      (&& exact
        (&& (> bracketCount 0)
          (&& (> specCount 0)
            (&& (== (blockCount bracket) bracketCount) (== (blockCount spec) specCount)))))
    }))

(:: invalidFlag (-> Int Int))
(fn (invalidFlag k)
  (if (== k 0)
    (mkHlBrk 0 -1 0 -1 0)
    (== k 1)
    (mkHlBrk 0 2 0 -1 0)
    (== k 2)
    (mkHlBrk 0 256 0 -1 0)
    (== k 3)
    (mkHlBrk 0 0 -1 -1 0)
    (== k 4)
    (mkHlBrk 0 0 3 -1 0)
    (== k 5)
    (mkHlBrk 0 0 256 -1 0)
    (== k 6)
    (mkFmtSpec -1 0 0 -1 0 1)
    (== k 7)
    (mkFmtSpec 0 0 0 -1 0 1)
    (== k 8)
    (mkFmtSpec 256 0 0 -1 0 1)
    (== k 9)
    (mkFmtSpec 62 -1 0 -1 0 1)
    (== k 10)
    (mkFmtSpec 62 2 0 -1 0 1)
    (== k 11)
    (mkFmtSpec 62 256 0 -1 0 1)
    (== k 12)
    (mkFmtSpec 62 0 0 -1 -1 1)
    (== k 13)
    (mkFmtSpec 62 0 0 -1 121 1)
    (== k 14)
    (mkFmtSpec 62 0 0 -1 256 1)
    (== k 15)
    (mkFmtSpec 62 0 0 -1 0 -1)
    (== k 16)
    (mkFmtSpec 62 0 0 -1 0 2)
    (mkFmtSpec 62 0 0 -1 0 256)))

(:: guardedFlags Bool)
(fn (guardedFlags)
  (let ((mut exact true))
    {
      (for k in 0..18
        (let ((status
          (__axiom_recover __axiom_arena_mark (lambda (ignored) (invalidFlag k)))))
          (set exact (&& exact (== status 80)))))
      exact
    }))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let (
    (bracket bracketBytes)
    (spec formatBytes)
    (bracketOK bracketValues)
    (specOK formatValues)
    (absentOK absentValues)
    (stable stableViews)
    (guarded guardedFlags)
  )
    {
      (println bracket)
      (println spec)
      (println bracketOK)
      (println specOK)
      (println absentOK)
      (println stable)
      (println guarded)
      (if (&& (== bracket 48)
            (&& (== spec 48) (&& bracketOK (&& specOK (&& absentOK (&& stable guarded))))))
        42
        1)
    }))
