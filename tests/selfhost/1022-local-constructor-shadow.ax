; expect 42
; Value bindings shadow constructors in direct, generated and higher-order calls.
(struct Pair
  (left : Int)
  (right : Int))

(macro (applyTwo function first second) (function first second))

(:: run (-> (-> Int Int Int) Int))
(fn (run Pair)
  (Pair 19 23))

(:: top (-> Int Int))
(fn (top value)
  (+ value 1))

(:: call (-> (-> Int Int) Int))
(fn (call function)
  (function 41))

(macro (callDefinition) (call top))

(:: withShadow (-> (-> Int Int) Int))
(fn (withShadow top)
  callDefinition)

(:: main Int)
(fn (main)
  {
    (let Pair (lambda (first second) (+ first second)))
    (let direct (Pair 19 23))
    (let generated (applyTwo Pair 19 23))
    (let forwarded (run Pair))
    (let hygienic (withShadow (lambda (value) 0)))
    (if (&& (== direct 42) (&& (== generated 42) (&& (== forwarded 42) (== hygienic 42))))
      42
      1)
  })
