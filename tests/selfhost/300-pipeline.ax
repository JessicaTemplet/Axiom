; expect 42
(import core)
(import diag)
(import expand)
(import Str)
(import Vec)
(import Mem)
(import IO)
(import lexer)
(import parser)
(import typecheck)
(import codegen)

; Emission consumes the resolved, expanded and checked tree.
(:: checkedEmission (-> (Vec Int) String String))
;@axiom:effect(io)
(fn (checkedEmission decls src)
  (let (
    (bares vecNew)
    (fulls vecNew)
    (mods vecNew)
    (units (let ((v vecNew))
      {
        (vecPush v (as (CUnit2 "in.ax" src "") Int))
        v
      }))
    (eds vecNew)
    (frames vecNew)
    (tcode (checkedTargetCode "darwin-aarch64"))
  )
    (let ((allDecls (resolveImports decls bares fulls mods tcode "" units)))
      {
        (expandProgram decls allDecls eds frames units bares fulls mods)
        (if (> (countErrorDiags eds) 0)
          ""
          (if (> (countErrorDiags (checkModule decls allDecls units)) 0)
            ""
            (emitResolved allDecls bares fulls tcode)))
      })))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((src (unwrapOr (readFile "in.ax") "")))
    (if (== (strLen src) 0)
      7
      (let ((pr (parseModuleWith (lex src) (scanAxtags src))))
        (if (== (memGetWord pr 0) 0)
          8
          (let ((out (checkedEmission (memGetWordVec pr 1) src)))
            (if (> (strLen out) 10)
              42
              9)))))))
