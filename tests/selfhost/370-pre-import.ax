; expect 42
; `stdlib/Pre.ax` holds only macros, so importing it contributes no
; symbols of its own: each deriver expands into declarations here.
; eqTone(Low,Low): 30, eqTone(Low,High): 0, arityPair(Pair 1 2): +2,
; and the multi-way `if`'s middle branch: +4, last branch: +6.
(import Pre)

(data Tone
  (Low)
  (High))

(data Pair
  (Pair Int Int))

(deriveEq Tone)

(deriveArity Pair)

(:: main Int)
(fn (main)
  (+
    (+ (if (eqTone Low Low) 30 0) (if (eqTone Low High) 100 0))
    (+
      (arityPair (Pair 1 2))
      (+
        (if (== 1 2)
          100
          (== 1 1)
          4
          200)
        (if (== 1 2)
          100
          (== 3 4)
          200
          (== 5 5)
          6
          300)))))
