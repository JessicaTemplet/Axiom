; expect 42
; An explicitly typed function conversion preserves application typing.
; Both direct and curried closure calls consume their remaining arguments.
(:: via1 (-> Int Int))
(fn (via1 n)
  (let ((f
    (lambda (x) (+ x 1))))
    ((as f (-> Int Int)) n)))

(:: via2 (-> Int Int))
(fn (via2 n)
  (let ((g
    (lambda (x y) (+ x y))))
    ((as g (-> Int Int Int)) n 22)))

(:: plain Int)
(fn (plain)
  (as 42 Int))

(:: main Int)
(fn (main)
  (if (&& (== (via1 41) 42) (&& (== (via2 20) 42) (== plain 42)))
    42
    1))
