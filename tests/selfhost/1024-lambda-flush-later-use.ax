; expect 42
; Discarding a partial application checks its body without grounding its
; remaining parameters. A later application must retain the capture and
; witness the remaining argument after that temporary check completes.
(:: main Int)
(fn (main)
  {
    (let k 2)
    (let f (lambda (x y) (+ k (+ x y))))
    (f 10)
    (f 20 20)
  })
