; expect 9
(import MacroScopeLib)

(:: op (-> Int Int))
(fn (op x)
  x)

(MacroScopeLib::emitForward entryOp op)

(MacroScopeLib::emitForward importedOp MacroScopeLib::op)

(macro equalDecl ((equalDecl nm x x) (:: nm Int) (fn (nm) 2))
  ((equalDecl nm x y) (:: nm Int) (fn (nm) 3)))

(equalDecl equalPair (+ 1 2) (+ 1 2))

(equalDecl unequalPair (+ 1 2) (+ 2 1))

(:: main Int)
(fn (main)
  (+ MacroScopeLib::libraryOp (+ entryOp (+ importedOp (+ equalPair unequalPair)))))
