; expect 0
; Compiler-generated word renderers still validate their source type.
(import core)
(import parser)
(import typecheck)

(:: main Int)
(fn (main)
  (let (
    (tc (tcNew vecNew vecNew vecNew))
    (bad (mkNodeAt TAG_E_FLT (__floatToBits 1.0) 0 0 (mkSpan 0 3)))
    (badResult (checkIntegerWord tc bad "__integer.word.UInt8"))
    (badReference (mkNodeAt TAG_E_STR "\"hello\"" 0 0 (mkSpan 0 7)))
    (badReferenceResult (checkIntegerWord tc badReference "__integer.word.UInt8"))
  )
    (if (&& (== (tyIsErr badResult) 1)
          (&& (== (tyIsErr badReferenceResult) 1) (== (vecLen (tcOutVec tc)) 2)))
      0
      1)))
