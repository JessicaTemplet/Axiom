; expect 6
; A BARE constructor name in pattern position is that constructor's
; test when it names a nullary constructor: `Nil2` below tests the
; tag, it does not bind. The checker retags it before the arms are
; checked (`normCtorPat`), so `(Cons2 1 Nil2)` reaches the second arm.
(data L2
  (Nil2)
  (Cons2 Int L2))

(:: f (-> L2 Int))
(fn (f l)
  (match l
    (Nil2 5)
    ((Cons2 h t) 6)))

(:: main Int)
(fn (main)
  (f (Cons2 1 Nil2)))
