; expect 255
(import MacroScopeLib)

; The equality rule is refutable, so the general rule stays reachable.
(macro same ((same x x) 1)
  ((same x y) 0))

(macro total ((total) 0)
  ((total x xs ...) (+ x (total xs ...))))

; Equality is checked independently inside each repeated element.
(macro pairs ((pairs (x x) ...) (total x ...))
  ((pairs other ...) 100))

(macro (forwardSame x y) (same x y))

(:: op (-> Int Int))
(fn (op x)
  x)

(:: main Int)
(fn (main)
  {
    (let a
      (if (&& (== (same 10 10) 1) (== (same 10 11) 0))
        1
        0))
    (let b
      (if (&& (== (same (+ 1 2) (+ 1 2)) 1) (== (same (+ 1 2) (+ 2 1)) 0))
        2
        0))
    (let c
      (if (&& (== (same "\t" "\t") 1) (== (same () 0) 0))
        4
        0))
    (let d
      (if (&& (== (same + Pre::+) 1) (== (same op MacroScopeLib::op) 0))
        8
        0))
    (let e
      {
        (let x 5)
        (if (&& (== (forwardSame x x) 1) (== (same x 5) 0))
          16
          0)
      })
    (let f
      (if (&& (== (pairs (2 2) (3 3)) 5) (== (pairs (2 2) (3 4)) 100))
        32
        0))
    (let g
      (if (&& (== (pairs) 0)
            (==
              (same
                (if true
                  1
                  2)
                (if true
                  1
                  2))
              1))
        64
        0))
    (let h
      (if (== (same 1.0 1.0) 1)
        128
        0))
    (+ a (+ b (+ c (+ d (+ e (+ f (+ g h)))))))
  })
