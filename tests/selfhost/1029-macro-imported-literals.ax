; expect 3
; Bare imported macros follow last-definition precedence. A literal
; from the earlier module must not match that later binding.
(import MacroScopeLib)
(import MacroScopeOther)

(:: main Int)
(fn (main)
  (+
    (if (== (MacroScopeLib::isKeyword markerWord) 0)
      1
      0)
    (if (== (MacroScopeOther::isOther markerWord) 1)
      2
      0)))
