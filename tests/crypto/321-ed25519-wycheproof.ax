; Wycheproof's Ed25519 verification vectors: truncated, padded and
; compressed signatures, S at or above the group order, R re-encoded
; non-canonically with S recomputed to match, and arithmetic edge cases
; that overflowed other implementations. Each verdict must match
; Wycheproof's, both through the strict decoders and with the
; signature handed to `ed25519Verify` as it stands.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Crypto.Ed25519)
(import Kat)

; The verdict through the strict decoders: false when either refuses.
(:: strict (-> String String String Bool))
(fn (strict pk msg sig)
  (match (ed25519PublicKeyFromBytes pk)
    ((Err _) false)
    ((Ok k)
      (match (ed25519SignatureFromBytes sig)
        ((Err _) false)
        ((Ok s) (ed25519Verify k msg s)))
    )))

; The verdict with both structs built directly, so `ed25519Verify` makes
; every check itself.
(:: direct (-> String String String Bool))
(fn (direct pk msg sig)
  (ed25519Verify (Ed25519PublicKey :bytes pk) msg (Ed25519Signature :bytes sig)))

; Whether two verdicts agree.
(:: agrees (-> Bool Bool Bool))
(fn (agrees a b)
  (if a
    b
    (! b)))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  {
    (let t (tallyNew "wycheproof-ed25519"))
    (let d (tallyNew "wycheproof-ed25519-direct"))
    {
      (for line in (katLines "wycheproof-ed25519.txt")
        {
          (let f (katFields line))
          {
            (let label (concat "tcId " (concat (katText f 0) (concat " " (katText f 2)))))
            (let want (strEq (katText f 1) "valid"))
            (let pk (katBytes f 3))
            (let msg (katBytes f 4))
            (let sig (katBytes f 5))
            {
              (tallyCheck t (agrees (strict pk msg sig) want) label)
              (tallyCheck d (agrees (direct pk msg sig) want) label)
            }
          }
        })
      (+ (tallyReport t) (tallyReport d))
    }
  })
