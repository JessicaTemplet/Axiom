; What a developer reads when something goes wrong: every refusal says
; what failed, says what to do where it can, and names the statement
; and the function that ran it. The messages here are the contract
; docs/axqlite.md and docs/axql.md describe.
(import IO)
(import Str)
(import Vec)
(import Err)
(import Axqlite)
(import Axqlite.Value)
(import AxqlKit)

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (let ((db (kitOpen "errors.db")))
    {
      (kitRun "no tables yet" (axqExec db "SELECT * FROM items"))
      (kitRun "create" (axqExec db "CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price INTEGER CHECK (price >= 0), shelf LINK shelves)"))
      (kitRun "create the linked table first" (axqExec db "CREATE TABLE shelves (id INTEGER PRIMARY KEY, label TEXT)"))
      (kitRun "then the table" (axqExec db "CREATE TABLE items (id INTEGER PRIMARY KEY, name TEXT NOT NULL, price INTEGER CHECK (price >= 0), shelf LINK shelves)"))
      (kitRun "index" (axqExec db "CREATE UNIQUE INDEX itemsByName ON items (name)"))
      (kitRun "shelf" (axqExec db "INSERT INTO shelves VALUES (1, 'top')"))
      (kitRun "insert" (axqExec db "INSERT INTO items (name, price, shelf) VALUES ('tea', 4, 1)"))
      (kitRun "a misspelt statement" (axqExec db "SELEC * FROM items"))
      (kitRun "a misspelt table" (axqExec db "SELECT * FROM item"))
      (kitRun "a misspelt column" (axqExec db "SELECT nmae FROM items"))
      (kitRun "a column list's column" (axqExec db "INSERT INTO items (nmae) VALUES ('x')"))
      (kitRun "TEXT for INTEGER" (axqExec db "INSERT INTO items (name, price) VALUES ('pot', '25')"))
      (kitRun "NULL for NOT NULL" (axqExec db "INSERT INTO items (price) VALUES (1)"))
      (kitRun "a taken rowid" (axqExec db "INSERT INTO items (id, name) VALUES (1, 'cup')"))
      (kitRun "a UNIQUE value" (axqExec db "INSERT INTO items (name) VALUES ('tea')"))
      (kitRun "a CHECK" (axqExec db "UPDATE items SET price = -1"))
      (kitRun "a link to no row" (axqExec db "UPDATE items SET shelf = 5"))
      (kitRun "TEXT in WHERE" (axqExec db "DELETE FROM items WHERE name"))
      (kitRun "a long statement"
        (axqExec db "SELECT id, name, price, shelf, shelf.label, upper(name), lower(name), length(name)\n  FROM items\n  WHERE nope = 1"))
      (match (axqExec db "SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' z")
        ((Ok _) (println "statement excerpts stay at 80 bytes: false"))
        ((Err e)
          (let ((bounded (strEq (errContext e) "running `SELECT 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa' ...` in axqExec")))
            (println "statement excerpts stay at 80 bytes: {bounded}"))))
      (kitRun "parameters" (axqRunOn db (Query "UPDATE items SET price = ? WHERE id = ?" (vec1 (VInt 1)))))
      (kitRun "rows through run" (axqRunOn db (axqlSelect items (name))))
      (kitDone "query with no rows" (axqQueryOn db (axqlDelete items (where (= id (int 999))))))
      (match (axqQueryOn db (axqlSelect items (name price)))
        ((Ok rs)
          (let ((r (vecGet rs.rows 0)))
            {
              (kitRun "a column a row lacks" (rowIntNamed r "prise"))
              (kitRun "TEXT read as INTEGER" (rowInt r 0))
              (kitDone "a column number past the end" (rowText r 5))
            }))
        ((Err e) (println (kitErrText e))))
      (match (axqOpen "errors.db" openOptions)
        ((Ok other)
          {
            (kitRun "begin" (axqExec db "BEGIN"))
            (kitRun "write" (axqExec db "INSERT INTO items (name) VALUES ('cup')"))
            (kitRun "another connection writes" (axqExec other "INSERT INTO items (name) VALUES ('mug')"))
            (kitRun "rollback" (axqExec db "ROLLBACK"))
            (kitRun "close other" (axqClose other))
          })
        ((Err e) (println (kitErrText e))))
      (kitDone "a file that isn't there" (axqOpen "missing.db" (OpenOptions false false 16)))
      (kitDone "a directory that isn't there" (axqOpen "nowhere/new.db" openOptions))
      (let ((_ (makeDir "adir"))) 0)
      (kitDone "a directory" (axqOpen "adir" openOptions))
      (kitRun "close" (axqClose db))
      0
    }))
