; The parser's budgets: parentheses nest at most 200 deep, a statement
; holds at most 3000 operators, refused before it is parsed, and a run
; of operators or NOTs up to that costs no stack while it parses.
(import IO)
(import Str)
(import Err)
(import Mem)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)

(:: repeat (-> String Int String))
(fn (repeat s n)
  ; These fixed inputs fit in Int. Allocate their bytes once so input
  ; construction stays linear and the test measures the parser's budgets.
  (let (
    (len (strLen s))
    (out (strAlloc (* (strLen s) n)))
  )
    {
      (for i in 0..n
        (memCopy (+ (strData out) (* i len)) (strData s) len))
      out
    }))

(:: outcome (-> String String))
(fn (outcome text)
  (match (axqlParse text)
    ((Ok p) (concat "ok params=" (format p.paramCount)))
    ((Err e) (concat "error: " (errMessage e)))))

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (println (outcome (concat "SELECT " (concat (repeat "(" 200) (concat "1" (repeat ")" 200))))))
    (println (outcome (concat "SELECT " (concat (repeat "(" 201) (concat "1" (repeat ")" 201))))))
    (println
      (outcome (concat "SELECT " (concat (repeat "lower(" 200) (concat "'A'" (repeat ")" 200))))))
    (println
      (outcome (concat "SELECT " (concat (repeat "lower(" 201) (concat "'A'" (repeat ")" 201))))))
    (println
      (outcome (concat "SELECT " (concat (repeat "1 IN (" 200) (concat "1" (repeat ")" 200))))))
    (println
      (outcome (concat "SELECT " (concat (repeat "1 IN (" 201) (concat "1" (repeat ")" 201))))))
    (println (outcome (concat "SELECT " (concat (repeat "NOT " 3000) "1"))))
    (println (outcome (concat "SELECT " (concat (repeat "NOT " 3001) "1"))))
    (println (outcome (concat "SELECT " (concat (repeat "- " 100000) "1"))))
    (println (outcome (concat "SELECT 1" (repeat " + 1" 3000))))
    (println (outcome (concat "SELECT 1" (repeat " + 1" 3001))))
    (println (outcome (concat "SELECT ?" (repeat ", ?" 32765))))
    (println (outcome (concat "SELECT ?" (repeat ", ?" 32766))))
  })
