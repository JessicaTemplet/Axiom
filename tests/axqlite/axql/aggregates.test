# Aggregates, GROUP BY and HAVING: what each aggregate answers, how
# NULL and empty tables count, the order groups come in, and what a
# grouped SELECT refuses. Expected results follow docs/axql.md.

statement ok
CREATE TABLE sales (id INTEGER PRIMARY KEY, region TEXT, amount INTEGER, price REAL)

query
SELECT count(*), count(amount), sum(amount), avg(amount), min(region), max(price) FROM sales
----
0,0,NULL,NULL,NULL,NULL

query
SELECT region, count(*) FROM sales GROUP BY region
----

statement ok
INSERT INTO sales (region, amount, price) VALUES ('north', 10, 1.5), ('south', 5, 2.0), ('north', 20, NULL), (NULL, 7, 0.5), ('south', NULL, 3.0), ('east', 1, 1.0)

query
SELECT count(*), count(amount), count(region), sum(amount), avg(amount), min(amount), max(amount)
FROM sales
----
6,5,5,43,8.6,1,20

query
SELECT sum(price), avg(price), min(price), max(region) FROM sales
----
8.0,1.6,0.5,'south'

query
SELECT region, count(*), sum(amount) FROM sales GROUP BY region
----
NULL,1,7
'east',1,1
'north',2,30
'south',2,5

query
SELECT region, count(*) AS n FROM sales GROUP BY region ORDER BY n DESC, region
----
'north',2
'south',2
NULL,1
'east',1

query
SELECT region, sum(amount) FROM sales GROUP BY region HAVING sum(amount) > 5 ORDER BY 2
----
NULL,7
'north',30

query
SELECT region FROM sales WHERE amount IS NOT NULL GROUP BY region HAVING count(*) = 1
----
NULL
'east'
'south'

query
SELECT count(*) * 2 + 1, max(amount) - min(amount) FROM sales WHERE region = 'north'
----
5,10

query
SELECT upper(region) AS r, count(*) FROM sales GROUP BY upper(region) LIMIT 2 OFFSET 1
----
'EAST',1
'NORTH',2

query
SELECT amount > 6, count(*) FROM sales GROUP BY amount > 6
----
NULL,1
0,2
1,3

query
SELECT region, count(*) FROM sales GROUP BY region, amount > 6 ORDER BY region, 2
----
NULL,1
'east',1
'north',2
'south',1
'south',1

query
SELECT count(*) FROM sales WHERE amount > 100
----
0

query
SELECT count(*) FROM sales GROUP BY region HAVING count(*) > 5
----

statement ok
CREATE TABLE big (v INTEGER)

statement ok
INSERT INTO big VALUES (9223372036854775807), (1)

statement error axqArithmetic integer overflow in sum
SELECT sum(v) FROM big

query
SELECT avg(v) > 4.0e18 FROM big
----
1

statement error axqSchema amount isn't a GROUP BY term or inside an aggregate
SELECT region, amount FROM sales GROUP BY region

statement error axqSchema amount is read outside an aggregate
SELECT amount, count(*) FROM sales

statement error axqSyntax an aggregate can't be used here; WHERE picks rows
SELECT region FROM sales WHERE count(*) > 1

statement error axqSyntax an aggregate can't be used here
SELECT region, count(*) FROM sales GROUP BY count(*)

statement error axqSyntax sum can't hold another aggregate
SELECT sum(count(*)) FROM sales

statement error axqType sum needs numbers, not TEXT
SELECT sum(region) FROM sales

statement error axqSyntax count takes one argument, or * to count rows
SELECT count() FROM sales

statement error axqSyntax HAVING needs a GROUP BY
SELECT count(*) FROM sales HAVING count(*) > 1

statement error axqSyntax an aggregate can't be used here
UPDATE sales SET amount = count(*)

statement error axqSyntax an aggregate can't be used here
INSERT INTO sales (amount) VALUES (max(1))
