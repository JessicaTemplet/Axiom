; AxqlPrint - a parsed statement written out as a tree, for the parser
; tests.
;
;     (axqlPrintParse "SELECT a + 1 FROM t WHERE b = ?")
;         ; "(SELECT (+ a 1) FROM t WHERE (= b ?1)) params=1"
;
; Every operator is written in prefix form with its operands in
; parentheses, so the tree shows precedence and associativity exactly
; as the parser built them. A literal is written as `axqValueText`
; writes it, a name as the statement spelled it (quoted when it must
; be), and a parameter as `?` and its number from 1.
(import Str)
(import Vec)
(import Err)
(import Fmt)
(import Axqlite)
(import Axqlite.Value)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)

(:: joinWith (-> (Vec String) String String))
(fn (joinWith parts sep)
  (let ((mut out ""))
    {
      (for (p i) in parts
        (set out (if (== i 0)
          p
          (concat out (concat sep p)))))
      out
    }))

; An expression as a tree.
(pub :: axqlPrintExpr (-> Expr String))
(pub fn (axqlPrintExpr e)
  (match e
    ((ELit v) (axqValueText v))
    ((EName n _) (axqlQuoteName n))
    ((ECol i) (concat "#" (fmtInt i)))
    ((EParam i _) (concat "?" (fmtInt (+ i 1))))
    ((ENeg x _) (concat "(- " (concat (axqlPrintExpr x) ")")))
    ((ENot x) (concat "(NOT " (concat (axqlPrintExpr x) ")")))
    ((EIsNull x neg)
      (concat
        (if neg
          "(IS NOT NULL "
          "(IS NULL ")
        (concat (axqlPrintExpr x) ")"))
    )
    ((EBin op l r _) (concat (concat (concat "(" (opText op)) " ") (concat (concat (axqlPrintExpr l) " ") (concat (axqlPrintExpr r) ")"))))
    ((EFun name args _) (concat (concat "(" name) (concat (printArgs args) ")")))
    ((EAgg k arg _)
      (concat
        (concat "(" (aggName k))
        (match arg
          ((Some x) (concat (concat " " (axqlPrintExpr x)) ")"))
          ((None) " *)")))
    )
    ((ELike x pat negated _)
      (concat
        (if negated
          "(NOT LIKE "
          "(LIKE ")
        (concat (concat (axqlPrintExpr x) " ") (concat (axqlPrintExpr pat) ")")))
    )
    ((EIn x items negated _)
      (concat
        (if negated
          "(NOT IN "
          "(IN ")
        (concat (axqlPrintExpr x) (concat (printArgs items) ")")))
    )
    ((ELink l c _) (concat (concat (axqlQuoteName l) ".") (if (strEq c "*") "*" (axqlQuoteName c))))))

; Arguments, each after a space.
(:: printArgs (-> (Vec Expr) String))
(fn (printArgs es)
  (let ((mut out ""))
    {
      (for e in es
        (set out (concat out (concat " " (axqlPrintExpr e)))))
      out
    }))

(:: printNames (-> (Vec String) String))
(fn (printNames ns)
  (let ((out vecNew))
    {
      (for n in ns
        (vecPush out (axqlQuoteName n)))
      (concat "(" (concat (joinWith out " ") ")"))
    }))

(:: printExprs (-> (Vec Expr) String))
(fn (printExprs es)
  (let ((out vecNew))
    {
      (for e in es
        (vecPush out (axqlPrintExpr e)))
      (concat "(" (concat (joinWith out " ") ")"))
    }))

(:: printColumn (-> ColumnDef String))
(fn (printColumn c)
  (concat
    (concat
      (concat "(" (axqlQuoteName c.name))
      (concat
        " "
        (if (strIsEmpty c.link)
          (typeName c.ctype)
          (concat "LINK " (axqlQuoteName c.link)))))
    (concat
      (concat
        (concat
          (if c.notNull
            " NOT NULL"
            "")
          (if c.primaryKey
            " PRIMARY KEY"
            ""))
        (concat
          (match c.dflt
            ((Some e) (concat " DEFAULT " (axqlPrintExpr e)))
            ((None) ""))
          (match c.check
            ((Some e) (concat " CHECK " (axqlPrintExpr e)))
            ((None) ""))))
      ")")))

(:: printSelect (-> Select String))
(fn (printSelect s)
  (let ((parts vecNew))
    {
      (vecPush parts "SELECT")
      (if s.star
        {
          (vecPush parts "*")
        })
      (for item in s.items
        (vecPush
          parts
          (if (strIsEmpty item.alias)
            (axqlPrintExpr item.expr)
            (concat (concat "(AS " (axqlPrintExpr item.expr)) (concat (concat " " (axqlQuoteName item.alias)) ")")))))
      (if (strIsEmpty s.from)
        parts
        {
          (vecPush parts "FROM")
          (vecPush parts (axqlQuoteName s.from))
        })
      (match s.where
        ((Some w)
          {
            (vecPush parts "WHERE")
            (vecPush parts (axqlPrintExpr w))
          }
        )
        ((None) parts))
      (if (> (vecLen s.groupBy) 0)
        {
          (vecPush parts "GROUP BY")
          (vecPush parts (printExprs s.groupBy))
        }
        parts)
      (match s.having
        ((Some h)
          {
            (vecPush parts "HAVING")
            (vecPush parts (axqlPrintExpr h))
          }
        )
        ((None) parts))
      (if (> (vecLen s.orderBy) 0)
        {
          (vecPush parts "ORDER BY")
          (for t in s.orderBy
            (vecPush
              parts
              (concat
                (concat "(" (axqlPrintExpr t.expr))
                (if t.desc
                  " DESC)"
                  " ASC)"))))
        })
      (match s.limit
        ((Some e)
          {
            (vecPush parts "LIMIT")
            (vecPush parts (axqlPrintExpr e))
          }
        )
        ((None) parts))
      (match s.offset
        ((Some e)
          {
            (vecPush parts "OFFSET")
            (vecPush parts (axqlPrintExpr e))
          }
        )
        ((None) parts))
      (concat "(" (concat (joinWith parts " ") ")"))
    }))

(:: printInsert (-> String String (Vec String) (Vec (Vec Expr)) String))
(fn (printInsert head table cols rows)
  (let ((rs vecNew))
    {
      (for r in rows
        (vecPush rs (printExprs r)))
      (concat (concat (concat head (axqlQuoteName table)) (concat " " (printNames cols))) (concat (concat " VALUES " (joinWith rs " ")) ")"))
    }))

; A statement as a tree.
(pub :: axqlPrintStmt (-> Stmt String))
(pub fn (axqlPrintStmt s)
  (match s
    ((SCreateTable ine name cols)
      (let ((cs vecNew))
        {
          (for c in cols
            (vecPush cs (printColumn c)))
          (concat
            (concat
              (if ine
                "(CREATE TABLE IF NOT EXISTS "
                "(CREATE TABLE ")
              (axqlQuoteName name))
            (concat (concat " " (joinWith cs " ")) ")"))
        })
    )
    ((SDropTable ie name)
      (concat
        (if ie
          "(DROP TABLE IF EXISTS "
          "(DROP TABLE ")
        (concat (axqlQuoteName name) ")"))
    )
    ((SCreateIndex unique ine name table cols)
      (concat
        (concat
          (concat
            "(CREATE "
            (if unique
              "UNIQUE INDEX "
              "INDEX "))
          (concat
            (if ine
              "IF NOT EXISTS "
              "")
            (axqlQuoteName name)))
        (concat (concat " ON " (axqlQuoteName table)) (concat (concat " " (printNames cols)) ")")))
    )
    ((SDropIndex ie name)
      (concat
        (if ie
          "(DROP INDEX IF EXISTS "
          "(DROP INDEX ")
        (concat (axqlQuoteName name) ")"))
    )
    ((SInsert table cols rows) (printInsert "(INSERT INTO " table cols rows))
    ((SUpsert table cols rows) (printInsert "(UPSERT INTO " table cols rows))
    ((SAlterAdd table c) (concat (concat (concat "(ALTER TABLE " (axqlQuoteName table)) " ADD ") (concat (printColumn c) ")")))
    ((SAlterRename table new) (concat (concat (concat "(ALTER TABLE " (axqlQuoteName table)) " RENAME TO ") (concat (axqlQuoteName new) ")")))
    ((SAlterDrop table column) (concat (concat (concat "(ALTER TABLE " (axqlQuoteName table)) " DROP ") (concat (axqlQuoteName column) ")")))
    ((SAlterRenameColumn table old new) (concat (concat (concat (concat (concat "(ALTER TABLE " (axqlQuoteName table)) " RENAME ") (axqlQuoteName old)) " TO ") (concat (axqlQuoteName new) ")")))
    ((SUpdate table cols exprs w)
      (let ((sets vecNew))
        {
          (for (c i) in cols
            (vecPush sets (concat (concat (concat "(= " (axqlQuoteName c)) " ") (concat (axqlPrintExpr (vecGet exprs i)) ")"))))
          (concat
            (concat (concat "(UPDATE " (axqlQuoteName table)) (concat " SET " (joinWith sets " ")))
            (concat
              (match w
                ((Some e) (concat " WHERE " (axqlPrintExpr e)))
                ((None) ""))
              ")"))
        })
    )
    ((SDelete table w)
      (concat
        (concat "(DELETE FROM " (axqlQuoteName table))
        (concat
          (match w
            ((Some e) (concat " WHERE " (axqlPrintExpr e)))
            ((None) ""))
          ")"))
    )
    ((SSelect sel) (printSelect sel))
    ((SBegin) "(BEGIN)")
    ((SCommit) "(COMMIT)")
    ((SRollback) "(ROLLBACK)")))

; A parsed statement as a tree with its parameter count and names, or
; its refusal as `CODE: message`.
(pub :: axqlPrintParse (-> String String))
(pub fn (axqlPrintParse text)
  (match (axqlParse text)
    ((Ok p)
      (concat
        (concat (axqlPrintStmt p.stmt) (concat " params=" (fmtInt p.paramCount)))
        (if (== (vecLen p.paramNames) 0)
          ""
          (concat " names=" (joinWith p.paramNames ","))))
    )
    ((Err e) (concat "error: " (errMessage e)))))
