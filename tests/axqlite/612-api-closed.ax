; A closed connection used again stops the program with status 85.
(import IO)
(import Err)
(import Axqlite)
(import AxqlKit)

(:: main ())
;@axiom:effect(io)
(fn (main)
  {
    (let db (kitOpen "closed.db"))
    {
      (kitRun "close" (axqClose db))
      (println "using it again")
      (kitRun "again" (axqExec db "SELECT 1"))
      (println "not reached")
    }
  })
