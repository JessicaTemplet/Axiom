; A callback entry is unreachable from main. Its tree recursion still
; needs a machine-code bound when the entry is selected for analysis.
(:: fib (-> Int Int))
(fn (fib n)
  (if (< n 2)
    n
    (+ (fib (- n 1)) (fib (- n 2)))))

(:: later Int)
(fn (later)
  (fib 12))

(:: main Int)
(fn (main)
  0)
