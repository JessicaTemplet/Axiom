; RP-9: a function holding an `asm` form. The report can't see what the
; instructions do, so the restricted profile refuses one unless
; `--allow-asm spin` names it and each selected arm promises nostack.
; It remains a review obligation either way.
(:: spin Int)
;@axiom:effect(unsafe)
(fn (spin)
  (asm
    (aarch64 "yield" (options nostack))
    (x86_64 "pause" (options nostack))))

(:: main Int)
(fn (main)
  (spin))
