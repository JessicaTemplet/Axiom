; The call graph does not retain the syscall-number argument. An
; unknown kernel operation cannot receive a nonblocking clearance.
(:: kernelEntry (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (kernelEntry number)
  (__syscall3 number 0 0 0))

(:: main Int)
;@axiom:effect(io)
(fn (main)
  (kernelEntry 0))
