(import mods.ForeignLeft)
(import mods.ForeignRight)

; This entry-file item shares a source spelling with both imports and
; has a different type and linker symbol. Each declaration must retain
; its own checker identity, source location and foreign effect boundary.
(extern "assurance_demo"
  (add :: (-> Bool Bool Bool) (symbol "assurance_bool_add")))

(:: main Int)
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (main)
  (if (&&
        (add false true)
        (&&
          (== (+ (viaLeft 3 4) (viaRight 5 7)) 42)
          (&& (== (mods.ForeignLeft::add 2 3) 5) (== (mods.ForeignRight::add 3 4) 12))))
    0
    1))
