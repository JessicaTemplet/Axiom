; An allowed body can still use an unreported amount of stack. The
; restricted report must refuse it, including when optimisation could
; remove a pure block with an unused answer.
(:: pushUnknown Int)
;@axiom:effect(unsafe)
(fn (pushUnknown)
  (asm
    (aarch64 "yield")
    (x86_64 "pause")))

(:: erased Int)
;@axiom:effect(unsafe)
(fn (erased)
  {
    (asm
      (aarch64 "mov {r}, #1" (out r) (options pure nomem))
      (x86_64 "movq $1, {r}" (out r) (options pure nomem)))
    0
  })

(:: main Int)
(fn (main)
  (+ (pushUnknown) (erased)))
