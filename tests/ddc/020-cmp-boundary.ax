; expect 42
(:: main Int)
(fn (main)
  {
    (let t1
      (if (> 5 5)
        1
        0))
    (let t2
      (if (< 5 5)
        1
        0))
    (let t3
      (if (>= 5 5)
        0
        1))
    (let t4
      (if (<= 5 5)
        0
        1))
    (let t5
      (if (== 5 5)
        0
        1))
    (let t6
      (if (!= 5 5)
        1
        0))
    (+ 42 (+ t1 (+ t2 (+ t3 (+ t4 (+ t5 t6))))))
  })
