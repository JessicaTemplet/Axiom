; Check the input bounds before clamping, then check the result.
(import IO)

;@axiom:pre((<= lo hi))
;@axiom:post((&& (>= result lo) (<= result hi)))
(:: clamp (-> Int Int Int Int))
(fn (clamp n lo hi)
  (if (< n lo) lo (if (> n hi) hi n)))

(:: main ())
;@axiom:effect(io)
(fn (main)
  (let ((below (clamp -3 0 10))
        (inside (clamp 7 0 10))
        (above (clamp 18 0 10)))
    (println "{below} {inside} {above}")))
