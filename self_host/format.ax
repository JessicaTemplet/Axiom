; format.ax — Axiom's canonical, comment-aware source layout.
;
; The scanner retains comments, separators and source spans that the
; compiler's semantic token stream discards. Identifier boundaries,
; signed integer bounds and the nesting limit come from shared rules.
; Bounded layout trials avoid repeatedly traversing a large expression.
; Verification requires preserved comments and an idempotent result.
(import Mem)
(import Str)
(import Utf8)
(import Vec)
; Identifier boundaries and integer bounds come from the lexer.
; Keeping those rules shared makes check and fmt accept the same values.
(import lexer)
; `pastBom`: a byte order mark is formatted around, not through.
(import core)
; Formatting and compilation use the same nesting limit.
(import parser)

; ------------------------------------------------------------------
; Token kinds.
;
; Nullary constructors would be tidier; plain Ints are used because
; every consumer compares them and a `data` here would cost a match at
; each site for nothing. They are dense from 0 so a table lookup stays
; possible later.
; ------------------------------------------------------------------
(pub :: FT_EOF Int)
(pub fn (FT_EOF)
  0)

(pub :: FT_LPAREN Int)
(pub fn (FT_LPAREN)
  1)

(pub :: FT_RPAREN Int)
(pub fn (FT_RPAREN)
  2)

(pub :: FT_LBRACK Int)
(pub fn (FT_LBRACK)
  3)

(pub :: FT_RBRACK Int)
(pub fn (FT_RBRACK)
  4)

(pub :: FT_LBRACE Int)
(pub fn (FT_LBRACE)
  5)

(pub :: FT_RBRACE Int)
(pub fn (FT_RBRACE)
  6)

(pub :: FT_IDENT Int)
(pub fn (FT_IDENT)
  7)

(pub :: FT_INT Int)
(pub fn (FT_INT)
  8)

(pub :: FT_FLOAT Int)
(pub fn (FT_FLOAT)
  9)

(pub :: FT_STR Int)
(pub fn (FT_STR)
  10)

(pub :: FT_CHAR Int)
(pub fn (FT_CHAR)
  11)

(pub :: FT_COLON Int)
(pub fn (FT_COLON)
  12)

(pub :: FT_DCOLON Int)
(pub fn (FT_DCOLON)
  13)

(pub :: FT_DOT Int)
(pub fn (FT_DOT)
  14)

(pub :: FT_COMMA Int)
(pub fn (FT_COMMA)
  15)

(pub :: FT_QUOTE Int)
(pub fn (FT_QUOTE)
  16)

(pub :: FT_BACKTICK Int)
(pub fn (FT_BACKTICK)
  17)

(pub :: FT_COMMAAT Int)
(pub fn (FT_COMMAAT)
  18)

(pub :: FT_MINUS Int)
(pub fn (FT_MINUS)
  19)

(pub :: FT_AXTAG Int)
(pub fn (FT_AXTAG)
  20)

(pub :: FT_ERROR Int)
(pub fn (FT_ERROR)
  21)

; `?`, the postfix that propagates an error. It joins the form it
; TOUCHES, as `.name` does (`readPostfix`), and prints with no space.
(pub :: FT_QUESTION Int)
(pub fn (FT_QUESTION)
  23)

; A token: its kind and its half-open byte range in the source.
;
; The lexeme is not stored. Every use of a token's text wants a slice of
; the source, and a slice is two words - so storing the range and
; slicing on demand costs the same as storing the slice and keeps one
; representation of "where this came from" rather than two.
(pub struct FTok
  (kind : Int)
  (start : Int)
  (end : Int))

; Constructors declared to return `Int`, the convention `mkNode` in
; parser.ax already uses: every handle in this compiler is one machine
; word, and `vecPush` takes an `Int`, so a struct type in argument
; position is a type error where the same value in return position is
; not.
(pub :: mkFTok (-> Int Int Int Int))
(pub fn (mkFTok k s e)
  (as (FTok :kind k :start s :end e) Int))

(pub :: ftKind (-> Int Int))
(pub fn (ftKind t)
  (memGetWord t 0))

(pub :: ftStart (-> Int Int))
(pub fn (ftStart t)
  (memGetWord t 1))

(pub :: ftEnd (-> Int Int))
(pub fn (ftEnd t)
  (memGetWord t 2))

(pub :: ftText (-> String Int String))
(pub fn (ftText src t)
  (strSlice src (ftStart t) (- (ftEnd t) (ftStart t))))

; A comment recovered from the source, with what the printer needs to
; put it back: its text, where it started, which line it sat on, and
; whether anything but whitespace preceded it on that line.
;
; `ownLine` is the difference between a comment that documents the line
; below it and one that annotates the line it sits on. Emitting a
; trailing note above its expression, or a section heading below its
; section, both preserve every byte and change what the file says.
(pub struct FCom
  (start : Int)
  (end : Int)
  (line : Int)
  (ownLine : Int))

(pub :: mkFCom (-> Int Int Int Int Int))
(pub fn (mkFCom s e l o)
  (as (FCom :start s :end e :line l :ownLine o) Int))

(pub :: fcStart (-> Int Int))
(pub fn (fcStart c)
  (memGetWord c 0))

(pub :: fcEnd (-> Int Int))
(pub fn (fcEnd c)
  (memGetWord c 1))

(pub :: fcLine (-> Int Int))
(pub fn (fcLine c)
  (memGetWord c 2))

(pub :: fcOwnLine (-> Int Int))
(pub fn (fcOwnLine c)
  (memGetWord c 3))

; The comment exactly as written, including its `;` or `#| |#`
; delimiters, with trailing whitespace removed - stage0 trims the end,
; and a comment that keeps its trailing spaces is a line that changes
; every time someone else's editor strips them.
(pub :: fcText (-> String Int String))
(pub fn (fcText src c)
  {
    (let mut e (fcEnd c))
    {
      (while (&& (> e (fcStart c)) (isFSpace (strByte src (- e 1))))
        (set e (- e 1)))
      (strSlice src (fcStart c) (- e (fcStart c)))
    }
  })

; ------------------------------------------------------------------
; Character predicates.
;
; These are stage0's, not this compiler's: `is_operator_char` and the
; identifier rule from `axiom-lexer/src/lib.rs`. Where the two lexers
; disagree, stage0 wins, because the output has to match stage0's.
; ------------------------------------------------------------------
(pub :: isFSpace (-> Int Bool))
; Exactly `lexer.ax`'s `isSpace`, byte for byte. It used to admit
; VT (11) and FF (12) as well, inherited from the retired compiler's
; `char::is_whitespace`, and the lexer never did - so `fmt` rewrote a
; file `check` refuses with AX1001 into one it accepts, silently
; turning an invalid program into a valid one. Two implementations of
; "what is a space" and nothing compared them.
(pub fn (isFSpace ch)
  (strIsSpace ch))

; The width of the whitespace at `i`, or 0 when `i` is not on
; whitespace. stage0 skips anything Rust's `char::is_whitespace`
; accepts - probed with a NBSP, which formats under stage0 - so the
; scan has to skip the same set or refuse files stage0 formats.
(pub :: fpWsWidth (-> String Int Int Int))
(pub fn (fpWsWidth src i len)
  {
    (let b (strByte src i))
    (if (isFSpace b)
      1
      (if (== b 194)  ; C2: NEL, NBSP
        (if (< (+ i 1) len)
          {
            (let c (strByte src (+ i 1)))
            (if (|| (== c 133) (== c 160))
              2
              0)
          }
          0)
        (if (== b 225)  ; E1 9A 80: U+1680
          (if (&& (< (+ i 2) len)
                (&& (== (strByte src (+ i 1)) 154) (== (strByte src (+ i 2)) 128)))
            3
            0)
          (if (== b 226)  ; E2: U+2000-200A etc
            (if (< (+ i 2) len)
              {
                (let c (strByte src (+ i 1)))
                (let d (strByte src (+ i 2)))
                (if (== c 128)
                  (if (|| (&& (>= d 128) (<= d 138)) (|| (== d 168) (|| (== d 169) (== d 175))))
                    3
                    0)
                  (if (&& (== c 129) (== d 159))
                    3
                    0))
              }
              0)
            (if (== b 227)  ; E3 80 80: U+3000
              (if (&& (< (+ i 2) len)
                    (&& (== (strByte src (+ i 1)) 128) (== (strByte src (+ i 2)) 128)))
                3
                0)
              0)))))
  })

(pub :: isFDigit (-> Int Bool))
(pub fn (isFDigit ch)
  (strIsDigit ch))

(pub :: isFAlpha (-> Int Bool))
(pub fn (isFAlpha ch)
  (strIsAlpha ch))

; An identifier may be a run of operator characters (`+`, `<=`, `>>=`)
; or a name; `_` and `'` are name characters, and a digit continues a
; name but cannot start one.
(pub :: isFOperChar (-> Int Bool))
(pub fn (isFOperChar ch)
  (if (== ch 43)  ; +
    true
    (if (== ch 45)  ; -
      true
      (if (== ch 42)  ; *
        true
        (if (== ch 47)  ; /
          true
          (if (== ch 37)  ; %
            true
            (if (== ch 94)  ; ^
              true
              (if (== ch 61)  ; =
                true
                (if (== ch 60)  ; <
                  true
                  (if (== ch 62)  ; >
                    true
                    (if (== ch 33)  ; !
                      true
                      (if (== ch 38)  ; &
                        true
                        (if (== ch 124)  ; |
                          true
                          ; `?` is not an operator character: it is the
                          ; postfix `FT_QUESTION`, its own token, as the
                          ; compiler's lexer has it.
                          (if false
                            true
                            (if (== ch 126)  ; ~
                              true
                              (if (== ch 36)  ; $ - stage0 lexes it as `!`
                                true
                                false))))))))))))))))

(pub :: isFNameStart (-> Int Bool))
(pub fn (isFNameStart ch)
  (if (isFAlpha ch)
    true
    (if (== ch 95)
      true
      false)))

; There is deliberately no `isFNameChar` here. What continues a name is
; `lexer`'s `isIdentChar`, asked directly by `fscanName`; the local copy
; that used to sit at this spot listed letters, digits, `_` and `'` and
; omitted every operator byte, which is how `empty-list` came to be
; three tokens to the formatter and one to the compiler.
; ------------------------------------------------------------------
; The scan.
;
; A `while` loop over the source, pushing tokens into one Vec and
; comments into another. Loops rather than recursion throughout: the
; depth would be the size of the file, and this compiler emits no
; tail-call elimination, so the recursive spelling is a real call chain
; one frame per byte - the failure `stdlib/Mem.ax` records at length.
; ------------------------------------------------------------------
; A line index: the byte offset of the first character of each line.
; Built once, so the comment scan can answer "which line" without
; walking the file again per comment.
(pub :: lineStarts (-> String Ints))
;@axiom:effect(unsafe)
(pub fn (lineStarts src)
  {
    (let starts (vecPush vecNew 0))
    (let mut i 0)
    (let n (strLen src))
    {
      (while (< i n)
        {
          (if (== (strByte src i) 10)
            (vecPush starts (+ i 1))
            (as 0 (Vec Int)))
          (set i (+ i 1))
        })
      starts
    }
  })

; The zero-based line holding `off`, by binary search over the starts.
(pub :: lineAt (-> Ints Int Int))
(pub fn (lineAt starts off)
  {
    (let mut lo 0)
    (let mut hi (- (vecLen starts) 1))
    {
      (while (< lo hi)
        {
          (let mid (/ (+ (+ lo hi) 1) 2))
          (if (<= (vecGet starts mid) off)
            (set lo mid)
            (set hi (- mid 1)))
        })
      lo
    }
  })

; Whether only whitespace precedes `start` on its line.
(pub :: onlySpaceBefore (-> String Int Bool))
(pub fn (onlySpaceBefore src start)
  {
    (let mut i (- start 1))
    (let mut answer true)
    (let mut go 1)
    {
      (while (== go 1)
        (if (< i 0)
          (set go 0)
          {
            (let ch (strByte src i))
            (if (== ch 10)
              (set go 0)
              (if (isFSpace ch)
                (set i (- i 1))
                {
                  (set answer false)
                  (set go 0)
                }))
          }))
      answer
    }
  })

; Past the end of a line comment: the newline itself, not past it, so
; the recorded span stops where stage0's does.
(pub :: scanLineComment (-> String Int Int Int))
(pub fn (scanLineComment src pos len)
  {
    (let mut p pos)
    {
      (while (&& (< p len) (!= (strByte src p) 10))
        (set p (+ p 1)))
      p
    }
  })

; Past the end of a `#| ... |#` block comment, including the closing
; delimiter. Nesting IS supported: stage0's `consume_block_comment`
; tracks depth, probed with `#| a #| b |# c |#`, which stage0 keeps
; as one comment. The earlier claim here that stage0 does not nest
; was wrong.
(pub :: scanBlockComment (-> String Int Int Int))
(pub fn (scanBlockComment src pos len)
  {
    (let mut p pos)
    (let mut depth 1)
    (let mut done 0)
    {
      (while (== done 0)
        (if (>= (+ p 1) len)
          {
            (set p len)
            (set done 1)
          }
          (if (&& (== (strByte src p) 124) (== (strByte src (+ p 1)) 35))
            {
              (set p (+ p 2))
              (set depth (- depth 1))
              (if (== depth 0)
                (set done 1))
            }
            (if (&& (== (strByte src p) 35) (== (strByte src (+ p 1)) 124))
              {
                (set p (+ p 2))
                (set depth (+ depth 1))
              }
              (set p (+ p 1))))))
      p
    }
  })

; Past the closing quote of a string literal. A backslash escapes the
; next byte, so a `\"` does not end it.
(pub :: scanStringLit (-> String Int Int Int))
(pub fn (scanStringLit src pos len)
  {
    (let mut p pos)
    (let mut done 0)
    {
      (while (== done 0)
        (if (>= p len)
          (set done 1)
          {
            (let ch (strByte src p))
            (if (== ch 92)
              (set p (+ p 2))
              (if (== ch 34)
                {
                  (set p (+ p 1))
                  (set done 1)
                }
                (set p (+ p 1))))
          }))
      p
    }
  })

; Past the closing quote of a character literal: quote, one escape or
; one whole UTF-8 sequence, quote.
(pub :: scanCharLit (-> String Int Int Int))
(pub fn (scanCharLit src pos len)
  {
    (let body
      (if (>= pos len)
        pos
        (if (== (strByte src pos) 92)
          (+ pos 2)
          (+ pos (utf8SeqLen (strByte src pos))))))
    (if (&& (< body len) (== (strByte src body) 39))
      (+ body 1)
      body)
  })

; Whether the `;` at `pos` begins an AXTAG (`;@axiom:`), which is a
; token rather than a comment - it is compiler-checked metadata, and
; the one category `fmt` used to delete without even a refusal.
(pub :: isAxtagAt (-> String Int Int Bool))
(pub fn (isAxtagAt src pos len)
  (if (> (+ pos 8) len)
    false
    (if (!= (strByte src (+ pos 1)) 64)  ; @
      false
      (if (!= (strByte src (+ pos 2)) 97)  ; a
        false
        (if (!= (strByte src (+ pos 3)) 120)  ; x
          false
          (if (!= (strByte src (+ pos 4)) 105)  ; i
            false
            (if (!= (strByte src (+ pos 5)) 111)  ; o
              false
              (if (!= (strByte src (+ pos 6)) 109)  ; m
                false
                (if (!= (strByte src (+ pos 7)) 58)  ; :
                  false
                  true)))))))))

; The scan's result: two vectors, held together so a caller gets both
; from one pass.
(pub struct FScan
  (toks : (Vec Int))
  (coms : (Vec Int)))

(pub :: mkFScan (-> Ints Ints Int))
(pub fn (mkFScan t c)
  (as (FScan :toks t :coms c) Int))

(pub :: fsToks (-> Int Int))
(pub fn (fsToks s)
  (memGetWord s 0))

; The `Vec` view of the same word. The cast is at the return,
; not the call sites - see `nodeCName`.
(pub :: fsToksVec (-> Int (Vec a)))
;@axiom:effect(unsafe)
(pub fn (fsToksVec s)
  (as (fsToks s) (Vec a)))

(pub :: fsComs (-> Int Int))
(pub fn (fsComs s)
  (memGetWord s 1))

; The `Vec` view of the same word. The cast is at the return,
; not the call sites - see `nodeCName`.
(pub :: fsComsVec (-> Int (Vec a)))
;@axiom:effect(unsafe)
(pub fn (fsComsVec s)
  (as (fsComs s) (Vec a)))

(pub :: fscan (-> String Int))
(pub fn (fscan src)
  {
    (let toks vecNew)
    (let coms vecNew)
    (let starts (lineStarts src))
    (let len (strLen src))
    (let mut p 0)
    {
      (while (< p len)
        {
          (let ch (strByte src p))
          (let ws (fpWsWidth src p len))
          (if (> ws 0)
            (set p (+ p ws))
            (if (== ch 59)  ; ;
              (if (isAxtagAt src p len)
                {
                  (let e (scanLineComment src p len))
                  {
                    (vecPush toks (mkFTok FT_AXTAG p e))
                    (set p e)
                  }
                }
                {
                  (let e (scanLineComment src p len))
                  {
                    (vecPush coms
                      (mkFCom p e (lineAt starts p)
                        (if (onlySpaceBefore src p)
                          1
                          0)))
                    (set p e)
                  }
                })
              (if (&& (== ch 35) (&& (< (+ p 1) len) (== (strByte src (+ p 1)) 124)))
                {
                  (let e (scanBlockComment src (+ p 2) len))
                  {
                    (vecPush coms
                      (mkFCom p e (lineAt starts p)
                        (if (onlySpaceBefore src p)
                          1
                          0)))
                    (set p e)
                  }
                }
                (set p (fscanToken src p len toks)))))
        })
      (vecPush toks (mkFTok FT_EOF len len))
      (mkFScan toks coms)
    }
  })

; One non-trivia token. Returns the position just past it, and is the
; only place that decides what a byte begins.
(pub :: fscanToken (-> String Int Int Ints Int))
(pub fn (fscanToken src p len toks)
  {
    (let ch (strByte src p))
    (if (== ch 40)
      {
        (vecPush toks (mkFTok FT_LPAREN p (+ p 1)))
        (+ p 1)
      }
      (if (== ch 41)
        {
          (vecPush toks (mkFTok FT_RPAREN p (+ p 1)))
          (+ p 1)
        }
        (if (== ch 91)
          {
            (vecPush toks (mkFTok FT_LBRACK p (+ p 1)))
            (+ p 1)
          }
          (if (== ch 93)
            {
              (vecPush toks (mkFTok FT_RBRACK p (+ p 1)))
              (+ p 1)
            }
            (if (== ch 123)
              {
                (vecPush toks (mkFTok FT_LBRACE p (+ p 1)))
                (+ p 1)
              }
              (if (== ch 125)
                {
                  (vecPush toks (mkFTok FT_RBRACE p (+ p 1)))
                  (+ p 1)
                }
                (if (== ch 44)
                  (if (&& (< (+ p 1) len) (== (strByte src (+ p 1)) 64))
                    {
                      (vecPush toks (mkFTok FT_COMMAAT p (+ p 2)))
                      (+ p 2)
                    }
                    {
                      (vecPush toks (mkFTok FT_COMMA p (+ p 1)))
                      (+ p 1)
                    })
                  (if (== ch 96)
                    {
                      (vecPush toks (mkFTok FT_BACKTICK p (+ p 1)))
                      (+ p 1)
                    }
                    (if (== ch 34)
                      {
                        (let e (scanStringLit src (+ p 1) len))
                        {
                          (vecPush toks (mkFTok FT_STR p e))
                          e
                        }
                      }
                      ; `'` is a character literal unless the next byte is a space, `(` or
                      ; `[` - stage0's rule, copied byte for byte, because it is what
                      ; keeps a quoted form distinguishable from a character.
                      (if (== ch 39)
                        (if (&& (< (+ p 1) len)
                              (&& (!= (strByte src (+ p 1)) 32)
                                (&& (!= (strByte src (+ p 1)) 40) (!= (strByte src (+ p 1)) 91))))
                          {
                            (let e (scanCharLit src (+ p 1) len))
                            {
                              (vecPush toks (mkFTok FT_CHAR p e))
                              e
                            }
                          }
                          {
                            (vecPush toks (mkFTok FT_QUOTE p (+ p 1)))
                            (+ p 1)
                          })
                        (if (isFDigit ch)
                          (fscanNumber src p len toks)
                          (if (== ch 58)
                            (if (&& (< (+ p 1) len) (== (strByte src (+ p 1)) 58))
                              {
                                (vecPush toks (mkFTok FT_DCOLON p (+ p 2)))
                                (+ p 2)
                              }
                              {
                                (vecPush toks (mkFTok FT_COLON p (+ p 1)))
                                (+ p 1)
                              })
                            ; `.` is field access, its own token, and NOT in `isFOperChar`: an
                            ; operator run must not swallow it, or `x.y` would lex as one
                            ; identifier and `->` would join a following `.`. Exactly two dots
                            ; are the range of `(for i in lo..hi ...)` and of a subtype, one
                            ; atom, so `0..n` is never read as a field access on `n`. A third
                            ; dot either side leaves them single, as `...` always was.
                            (if (== ch 46)
                              (if (fIsDotDot src p len)
                                {
                                  (vecPush toks (mkFTok FT_IDENT p (+ p 2)))
                                  (+ p 2)
                                }
                                {
                                  (vecPush toks (mkFTok FT_DOT p (+ p 1)))
                                  (+ p 1)
                                })
                              (if (== ch 63)
                                {
                                  (vecPush toks (mkFTok FT_QUESTION p (+ p 1)))
                                  (+ p 1)
                                }
                                (if (isFOperChar ch)
                                  (fscanOperator src p len toks)
                                  (if (isFNameStart ch)
                                    (fscanName src p len toks)
                                    ; An unrecognised byte is a token rather than a skip. A formatter
                                    ; that silently drops what it cannot lex writes a different program
                                    ; and reports success; recorded as an error token, the round-trip
                                    ; check refuses instead.
                                    {
                                      (vecPush toks (mkFTok FT_ERROR p (+ p 1)))
                                      (+ p 1)
                                    }))))))))))))))))
  })

; A number, integer or float. `_` is a digit separator and a `.` makes
; it a float only when a digit follows, so `1.foo` is `1` then `.foo`.
(pub :: fscanNumber (-> String Int Int Ints Int))
(pub fn (fscanNumber src p len toks)
  {
    (let mut e p)
    (let mut isFloat 0)
    (let mut go 1)
    {
      (while (== go 1)
        (if (>= e len)
          (set go 0)
          {
            (let c (strByte src e))
            (if (|| (isFDigit c) (== c 95))
              (set e (+ e 1))
              (if (&& (&& (== c 46) (== isFloat 0))
                    (&& (< (+ e 1) len) (isFDigit (strByte src (+ e 1)))))
                {
                  (set isFloat 1)
                  (set e (+ e 1))
                }
                (set go 0)))
          }))
      (vecPush toks
        (mkFTok
          (if (== isFloat 1)
            FT_FLOAT
            FT_INT)
          p e))
      e
    }
  })

; A run of operator characters. `.` is its own token - field access -
; and `->` is an identifier like any other operator run, which is why
; there is no arrow kind here: stage0 lexes `->` as an operator token
; and the printer only ever re-emits its text.
(pub :: fscanOperator (-> String Int Int Ints Int))
(pub fn (fscanOperator src p len toks)
  {
    (let mut e p)
    {
      (while (&& (< e len) (isFOperChar (strByte src e)))
        (set e (+ e 1)))
      ; An operator run the real lexer would keep reading: `*Int`
      ; is one identifier to `lexTokens` (`isIdentStart` admits the
      ; operator bytes and `skipIdent` continues through letters),
      ; so stopping here splits it and the printer puts the space
      ; back, rewriting an AX3002 program into one that checks. The
      ; run extends through `isIdentChar` exactly as the lexer
      ; does - except `-` against a digit, which the lexer reads as
      ; a negative number while this scanner keeps it split for the
      ; `-5` adjacency rule below. `?`, `~` and `$` never extend:
      ; the lexer does not start an identifier with any of them.
      (if (&& (isIdentStart (strByte src p)) (&& (< e len) (isIdentChar (strByte src e))))
        (if (! (&& (&& (== (- e p) 1) (== (strByte src p) 45)) (isFDigit (strByte src e))))
          (while (&& (< e len) (isIdentChar (strByte src e)))
            (set e (+ e 1)))))
      ; A lone `-` is its own kind, because the printer has to know
      ; whether a `-` touches the literal after it: `(+ x -5)` is
      ; two arguments and `(+ x - 5)` is three, and only adjacency
      ; tells them apart.
      (vecPush toks
        (mkFTok
          (if (&& (== (- e p) 1) (== (strByte src p) 45))
            FT_MINUS
            FT_IDENT)
          p e))
      e
    }
  })

; A name, continued by the LEXER'S rule rather than by a restatement of
; it. `isIdentChar` admits `! % & ' * + - / < > = ^ |` as well as
; letters, digits and `_`, so `empty-list`, `a+b`, `set!`, `foo'` and
; `x-5` are each ONE identifier to `lexTokens`.
;
; This used to stop at the first operator byte, which made each of them
; THREE tokens, and the consequence was not a refusal - it was a
; rewrite. Measured on the compiler as it stood:
;
;   (fn (g) (h empty-list))   ->  (fn (g) (h empty - list))
;   (fn (g) (h a+b))          ->  (fn (g) (h a + b))
;   (fn (g) (h x-5))          ->  (fn (g) (h x -5))
;
; written to disk, exit 0, no warning: a one-argument call turned into
; a three-argument one, which is `fmt` silently destroying a source
; file - the sixfold defect §2.3 of the roadmap exists to record, in a
; seventh way. In DECLARATION position the same split poisoned the
; buffer instead, so `axiom fmt` refused every file that declared a
; kebab-case name.
;
; Nothing in the repository has such a name, which is why 194 files
; formatted byte-identically with this broken: the corpus is written by
; people solving problems, and Axiom's own convention is camelCase.
;
; The dispatch above still routes an operator-INITIAL token to
; `fscanOperator`, because a lone `-` has to stay its own kind for the
; `-5` adjacency rule, and because `? ~ $` are operator bytes here and
; not identifier bytes at all. What that leaves is recorded in
; the self-hosting record rather than guessed at.
(pub :: fscanName (-> String Int Int Ints Int))
(pub fn (fscanName src p len toks)
  {
    (let mut e p)
    {
      (while (&& (< e len) (isIdentChar (strByte src e)))
        (set e (+ e 1)))
      (vecPush toks (mkFTok FT_IDENT p e))
      e
    }
  })

; ------------------------------------------------------------------
; Losslessness.
;
; The scan must account for every byte of the source: each token and
; each comment covers a range, and everything between those ranges must
; be whitespace. A formatter whose scanner silently drops a byte writes
; a different program and reports success - this compiler's own lexer
; skips `[`, `]` and `,` exactly that way - so the property is checked
; rather than assumed, and it is checked here rather than in a test so
; that `fmt` itself can refuse.
;
; Answers 1 when every byte is accounted for, 0 otherwise.
; ------------------------------------------------------------------
(pub :: fscanCovers (-> String Int Int))
(pub fn (fscanCovers src sc)
  {
    (let toks (fsToksVec sc))
    (let coms (fsComsVec sc))
    (let len (strLen src))
    (let mut ti 0)
    (let mut ci 0)
    (let mut prev 0)
    (let mut ok 1)
    {
      (while (&& (== ok 1) (|| (< ti (- (vecLen toks) 1)) (< ci (vecLen coms))))
        {
          ; Whichever of the two comes next in the source.
          (let tstart
            (if (< ti (- (vecLen toks) 1))
              (ftStart (vecGet toks ti))
              len))
          (let cstart
            (if (< ci (vecLen coms))
              (fcStart (vecGet coms ci))
              len))
          (if (<= tstart cstart)
            {
              (let t (vecGet toks ti))
              {
                (if (== (gapIsSpace src prev (ftStart t)) 0)
                  (set ok 0))
                (set prev (ftEnd t))
                (set ti (+ ti 1))
              }
            }
            {
              (let c (vecGet coms ci))
              {
                (if (== (gapIsSpace src prev (fcStart c)) 0)
                  (set ok 0))
                (set prev (fcEnd c))
                (set ci (+ ci 1))
              }
            })
        })
      (if (== ok 1)
        (gapIsSpace src prev len)
        0)
    }
  })

(pub :: gapIsSpace (-> String Int Int Int))
(pub fn (gapIsSpace src from to)
  {
    (let mut i from)
    (let mut ok 1)
    {
      (while (< i to)
        {
          (let w (fpWsWidth src i to))
          (if (> w 0)
            (set i (+ i w))
            {
              (set ok 0)
              (set i to)
            })
        })
      ok
    }
  })

; Whether the scan met a byte it could not classify. `fmt` must refuse
; on one rather than print around it.
(pub :: fscanHasError (-> Int Int))
(pub fn (fscanHasError sc)
  {
    (let toks (fsToksVec sc))
    (let mut i 0)
    (let mut bad 0)
    {
      (while (< i (vecLen toks))
        {
          (if (== (ftKind (vecGet toks i)) FT_ERROR)
            (set bad 1))
          (set i (+ i 1))
        })
      bad
    }
  })

; ------------------------------------------------------------------
; The form tree.
;
; A node is one of: an ATOM (one token), or a GROUP with a delimiter
; kind and a Vec of children. A prefix marker - `'`, backtick, `,`,
; `,@` - is a node whose single child is the form it marks, so the
; printer can re-emit the marker without a special case at every use.
;
; The tree keeps every token, which is the whole reason it exists.
; stage1's AST does not: `type`, `trait` and `impl` are consumed into an
; inert node, and `(:: e T)` and `(- x)` are desugared. A printer over
; that AST would delete declarations and misprint negation, so the
; printer works over this instead.
; ------------------------------------------------------------------
(pub :: FN_ATOM Int)
(pub fn (FN_ATOM)
  0)

(pub :: FN_PAREN Int)
(pub fn (FN_PAREN)
  1)

(pub :: FN_BRACK Int)
(pub fn (FN_BRACK)
  2)

(pub :: FN_BRACE Int)
(pub fn (FN_BRACE)
  3)

(pub :: FN_PREFIX Int)
(pub fn (FN_PREFIX)
  4)

; `a.b` and `Mem::f` are three tokens each, and they are ONE form. Left
; unjoined they would sit as siblings inside their enclosing group and
; give it two extra elements - `(g x.y)` would print as `(g x . y)`, an
; application of three things. Both join only when the tokens TOUCH,
; which is what tells `Mem::memAlloc` apart from a signature's
; `(:: show (-> a String))`, where the same `::` introduces a type
; with spaces around it.
(pub :: FN_FIELD Int)
(pub fn (FN_FIELD)
  5)

(pub :: FN_QUAL Int)
(pub fn (FN_QUAL)
  6)

; `e?`: kid 0 is `e`.
(pub :: FN_TRY Int)
(pub fn (FN_TRY)
  7)

; kind: one of the above. tok: the token for an ATOM or a PREFIX's
; marker, 0 otherwise. kids: a Vec of child nodes, 0 for an ATOM.
; start/end: the node's byte range, which is what anchors comments.
(pub struct FNode
  (kind : Int)
  (tok : Int)
  (kids : (Vec Int))
  (start : Int)
  (end : Int))

(pub :: mkFNode (-> Int Int Ints Int Int Int))
(pub fn (mkFNode k t ks s e)
  (as (FNode :kind k :tok t :kids ks :start s :end e) Int))

(pub :: fnKind (-> Int Int))
(pub fn (fnKind n)
  (memGetWord n 0))

(pub :: fnTok (-> Int Int))
(pub fn (fnTok n)
  (memGetWord n 1))

(pub :: fnKids (-> Int Int))
(pub fn (fnKids n)
  (memGetWord n 2))

; The `Vec` view of the same word. The cast is at the return,
; not the call sites - see `nodeCName`.
(pub :: fnKidsVec (-> Int (Vec a)))
;@axiom:effect(unsafe)
(pub fn (fnKidsVec n)
  (as (fnKids n) (Vec a)))

(pub :: fnStart (-> Int Int))
(pub fn (fnStart n)
  (memGetWord n 3))

(pub :: fnEnd (-> Int Int))
(pub fn (fnEnd n)
  (memGetWord n 4))

(pub :: fnLen (-> Int Int))
(pub fn (fnLen n)
  (if (== (fnKids n) 0)
    0
    (vecLen (fnKidsVec n))))

(pub :: fnKid (-> Int Int Int))
(pub fn (fnKid n i)
  (vecGet (fnKidsVec n) i))

; An atom's source text, and the head atom's text for a group - the two
; questions the printer asks constantly.
(pub :: fnText (-> String Int String))
(pub fn (fnText src n)
  (if (== (fnKind n) FN_ATOM)
    (ftText src (fnTok n))
    ""))

(pub :: fnHeadText (-> String Int String))
(pub fn (fnHeadText src n)
  (if (== (fnKind n) FN_PAREN)
    (if (> (fnLen n) 0)
      {
        (let h (fnKid n 0))
        (if (== (fnKind h) FN_ATOM)
          (ftText src (fnTok h))
          "")
      }
      "")
    ""))

; The reader's result: a node and the token position just past it.
; `ok` is 0 on a syntax the reader cannot pair up - an unbalanced
; delimiter - which makes `fmt` refuse rather than print a guess.
(pub struct FRead
  (ok : Int)
  (node : Int)
  (pos : Int))

(pub :: mkFRead (-> Int Int Int Int))
(pub fn (mkFRead o n p)
  (as (FRead :ok o :node n :pos p) Int))

(pub :: frOk (-> Int Int))
(pub fn (frOk r)
  (memGetWord r 0))

(pub :: frNode (-> Int Int))
(pub fn (frNode r)
  (memGetWord r 1))

(pub :: frPos (-> Int Int))
(pub fn (frPos r)
  (memGetWord r 2))

(pub :: isCloser (-> Int Bool))
(pub fn (isCloser k)
  (if (== k FT_RPAREN)
    true
    (if (== k FT_RBRACK)
      true
      (if (== k FT_RBRACE)
        true
        false))))

(pub :: openerFor (-> Int Int))
(pub fn (openerFor k)
  (if (== k FT_LPAREN)
    FN_PAREN
    (if (== k FT_LBRACK)
      FN_BRACK
      FN_BRACE)))

(pub :: closerFor (-> Int Int))
(pub fn (closerFor k)
  (if (== k FT_LPAREN)
    FT_RPAREN
    (if (== k FT_LBRACK)
      FT_RBRACK
      FT_RBRACE)))

(pub :: isPrefixTok (-> Int Bool))
(pub fn (isPrefixTok k)
  (if (== k FT_QUOTE)
    true
    (if (== k FT_BACKTICK)
      true
      (if (== k FT_COMMA)
        true
        (if (== k FT_COMMAAT)
          true
          false)))))

; ------------------------------------------------------------------
; The nesting cap.
;
; `readForm` below recurses once per level of tree DEPTH - `readGroup`
; for a delimiter, `readForm` again for a prefix token - and `fmtPrint`
; walks the finished tree the same way. Neither has a loop to fall
; back on, so the depth of the input is the depth of the machine
; stack.
;
; This file used to say that needed no guard, on the grounds that a
; source nested a thousand deep "would be unreadable long before it
; were a stack problem". Unreadable is not unreachable. Measured
; 2026-08-23 at `ulimit -s 8192` against a stage1 built from HEAD, on
; a one-line `(fn (main) ((((...))))`: at 40,000 delimiters
; `fmt --check` still answered, at 48,000, 56,000 and 64,000 it died
; of SIGNAL 11. Brackets, braces and 200,000 unbalanced `(` crash the
; same way at 60,000, and so does `x` followed by 100,000 `.a`
; postfixes. `axiom check` answered every one of those inputs in the
; ordinary way - `error[AX2005]: nesting is too deep (limit is 1024)`
; - because `parseModuleWith` runs `nestOverflowTok` before
; `parseDecls`. The crash was the formatter's alone, and what is
; restored here is that the two subcommands refuse the same file.
;
; The LIMIT is imported rather than restated: `parseMaxDepth` is the
; one number, and a second 1024 written down here is a number that
; drifts. The WALK is restated, because `nestOverflowTok` reads the
; shared lexer's `TK_*` kinds and this module deliberately produces
; none of those - see the module header. `fsToks` is already in hand
; at the one place that reads forms, so the guard costs one pass over
; a vector that has just been built.
;
; Three token shapes add a level of tree, and counting only the first
; would leave two of the measured crashes open:
;
;   `(` `[` `{`    a `readGroup` frame, given back by its closer
;   `'` `,@`       `readForm`'s prefix arm - quote, backtick, comma
;                  and comma-at are one frame each and have no closer
;   `.name`        the FN_FIELD/FN_QUAL chain `readPostfix` builds:
;                  a loop in the reader, but a 100,000-link tree for
;                  the printer to recurse over
;
; Prefix and postfix levels are added to the running depth and given
; back only when the enclosing group closes, so what is counted at a
; delimiter level is their SUM rather than the longest path through
; them. That over-counts, and the over-count was measured before it
; was accepted: over all 463 `.ax` files under `stdlib/`,
; `self_host/` and `tests/` this walk reaches exactly the same
; maximum as a delimiter-only walk - 501 in
; `tests/diagnostics/405-macro-depth-limit.ax`, 57 in the deepest
; compiler source - so at a limit of 1024 the over-count costs the
; corpus nothing.
;
; The shape it does over-count was probed rather than argued about:
; `(g x.a x.a ...)` with N bare field accesses as direct siblings is
; the only way to make the sum exceed the longest path. `fmt` flips
; from rewriting to refusing at N=1023, and `check` flips from AX3007
; to AX3024 (`macro expansion nested deeper than the limit of 1024
; forms`) at N=1023 as well - the expander's cap lands on the same
; input - so the over-count does not make `fmt` stricter than `check`
; even where it over-counts.
; ------------------------------------------------------------------
; True when the `.` or `::` at `i` opens a POSTFIX, by the same
; three-part test `readPostfix` applies: it touches the token before
; it, it touches the token after it, and that token is a name. The
; touching is what keeps the corpus out of this: `(pub :: f (-> Int))`
; has spaces around its `::` and adds no depth.
;
; `i` is never the last index when the kind matches, because `fscan`
; ends every token vector with an `FT_EOF`, so reading `(+ i 1)` is in
; range whenever it is reached.
; Two dots at `p`, with no dot just before or just after them.
(pub :: fIsDotDot (-> String Int Int Bool))
(pub fn (fIsDotDot src p len)
  (&& (&& (< (+ p 1) len) (== (strByte src (+ p 1)) 46))
    (&& (|| (>= (+ p 2) len) (!= (strByte src (+ p 2)) 46))
      (|| (== p 0) (!= (strByte src (- p 1)) 46)))))

(pub :: fIsPostfixAt (-> Ints Int Bool))
(pub fn (fIsPostfixAt toks i)
  {
    (let k (ftKind (vecGet toks i)))
    (if (&& (> i 0) (|| (== k FT_DOT) (== k FT_DCOLON)))
      {
        (let t (vecGet toks i))
        (let prev (vecGet toks (- i 1)))
        (let next (vecGet toks (+ i 1)))
        (&& (== (ftKind next) FT_IDENT)
          (&& (== (ftStart t) (ftEnd prev)) (== (ftEnd t) (ftStart next))))
      }
      false)
  })

; The index of the token that first takes tree depth past `limit`, or
; -1 when nothing does. One walk answers both of the questions the
; guard asks, as `nestOverflowTok` does.
;
; The saved depths are a stack rather than a counter because a closer
; has to give back the prefix and postfix levels opened inside its
; group as well as the group's own, and a single `(- d 1)` gives back
; only the group's. Without that, `(a.b c.d e.f)` would leak a level
; per field access to every enclosing form.
;
; A closer with nothing on the stack is unbalanced input, which the
; reader reports on its own terms; depth is floored at 0 here rather
; than allowed to go negative, so a stray `)` early in a file cannot
; mask real depth after it.
(pub :: fNestOverflow (-> Ints Int Int))
(pub fn (fNestOverflow toks limit)
  {
    (let mut i 0)
    (let mut d 0)
    (let mut hit (- 0 1))
    (let st vecNew)
    (let n (vecLen toks))
    {
      (while (&& (< i n) (< hit 0))
        {
          {
            (let k (ftKind (vecGet toks i)))
            (if (|| (== k FT_LPAREN) (|| (== k FT_LBRACK) (== k FT_LBRACE)))
              {
                (vecPush st d)
                (set d (+ d 1))
              }
              (if (isCloser k)
                (if (> (vecLen st) 0)
                  (set d (vecPop st))
                  (set d 0))
                (if (|| (isPrefixTok k) (fIsPostfixAt toks i))
                  (set d (+ d 1)))))
          }
          (if (> d limit)
            (set hit i))
          (set i (+ i 1))
        })
      hit
    }
  })

; Read one form at token position `pos`.
;
; Recursion here is over the DEPTH of the tree, not the size of the
; file, so it needs no loop - but it does need a bound, and the bound
; is `fNestOverflow` above, applied by `fmtOnce` before this function
; is ever entered. Nothing here re-checks it.
(pub :: readForm (-> String Ints Int Int))
;@axiom:effect(unsafe)
(pub fn (readForm src toks pos)
  {
    (let t (vecGet toks pos))
    (let k (ftKind (vecGet toks pos)))
    (if (== k FT_EOF)
      (mkFRead 0 0 pos)
      (if (isCloser k)
        (mkFRead 0 0 pos)
        (if (isPrefixTok k)
          {
            (let inner (readForm src toks (+ pos 1)))
            (if (== (frOk inner) 0)
              inner
              (mkFRead 1
                (mkFNode FN_PREFIX t (vecPush vecNew (frNode inner)) (ftStart t)
                  (fnEnd (frNode inner)))
                (frPos inner)))
          }
          (if (|| (== k FT_LPAREN) (|| (== k FT_LBRACK) (== k FT_LBRACE)))
            (readPostfix toks (readGroup src toks pos))
            (readPostfix toks
              (mkFRead 1 (mkFNode FN_ATOM t (as 0 (Vec Int)) (ftStart t) (ftEnd t)) (+ pos 1)))))))
  })

; Absorb any `.name` and `::name` that TOUCH what was just read.
(pub :: readPostfix (-> Ints Int Int))
;@axiom:effect(unsafe)
(pub fn (readPostfix toks r)
  (if (== (frOk r) 0)
    r
    {
      (let mut cur r)
      (let mut go 1)
      {
        (while (== go 1)
          {
            (let p (frPos cur))
            (let node (frNode cur))
            {
              (let k (ftKind (vecGet toks p)))
              (if (&& (== k FT_QUESTION) (== (ftStart (vecGet toks p)) (fnEnd node)))
                (set cur (mkFRead 1
                           (mkFNode FN_TRY (vecGet toks p) (vecPush vecNew node) (fnStart node)
                             (ftEnd (vecGet toks p)))
                           (+ p 1)))
                (if (&& (|| (== k FT_DOT) (== k FT_DCOLON))
                      (&& (== (ftStart (vecGet toks p)) (fnEnd node))
                        (== (ftEnd (vecGet toks p)) (ftStart (vecGet toks (+ p 1))))))
                  {
                    (let nameTok (vecGet toks (+ p 1)))
                    (if (!= (ftKind nameTok) FT_IDENT)
                      (set go 0)
                      {
                        (let name
                          (mkFNode FN_ATOM nameTok (as 0 (Vec Int)) (ftStart nameTok)
                            (ftEnd nameTok)))
                        (let kids (vecPush vecNew node))
                        {
                          (vecPush kids name)
                          (set cur (mkFRead 1
                                     (mkFNode
                                       (if (== k FT_DOT)
                                         FN_FIELD
                                         FN_QUAL)
                                       (vecGet toks p) kids (fnStart node) (ftEnd nameTok))
                                     (+ p 2)))
                        }
                      })
                  }
                  (set go 0)))
            }
          })
        cur
      }
    }))

(pub :: readGroup (-> String Ints Int Int))
(pub fn (readGroup src toks pos)
  {
    (let open (vecGet toks pos))
    (let want (closerFor (ftKind (vecGet toks pos))))
    (let kids vecNew)
    (let mut p (+ pos 1))
    (let mut ok 1)
    (let mut done 0)
    {
      (while (== done 0)
        {
          (let k (ftKind (vecGet toks p)))
          (if (== k FT_EOF)
            {
              (set ok 0)
              (set done 1)
            }
            (if (== k want)
              {
                (set p (+ p 1))
                (set done 1)
              }
              (if (isCloser k)
                ; A closer that does not match the opener. Printing past
                ; it would re-nest the file silently, so this refuses.
                {
                  (set ok 0)
                  (set done 1)
                }
                {
                  (let r (readForm src toks p))
                  (if (== (frOk r) 0)
                    {
                      (set ok 0)
                      (set done 1)
                    }
                    {
                      (vecPush kids (frNode r))
                      (set p (frPos r))
                    })
                })))
        })
      (if (== ok 0)
        (mkFRead 0 0 p)
        (mkFRead 1
          (mkFNode (openerFor (ftKind open)) 0 kids (ftStart open) (ftEnd (vecGet toks (- p 1))))
          p))
    }
  })

; Every top-level form in the file, in source order.
(pub :: readForms (-> String Ints Ints))
;@axiom:effect(unsafe)
(pub fn (readForms src toks)
  {
    (let forms vecNew)
    (let mut p 0)
    (let mut ok 1)
    {
      (while (&& (== ok 1) (!= (ftKind (vecGet toks p)) FT_EOF))
        {
          (let r (readForm src toks p))
          (if (== (frOk r) 0)
            (set ok 0)
            {
              (vecPush forms (frNode r))
              (set p (frPos r))
            })
        })
      (if (== ok 1)
        forms
        (as 0 (Vec Int)))
    }
  })

; ------------------------------------------------------------------
; The output buffer.
;
; Fragments in a Vec, joined once at the end. `out.push_str` in stage0
; appends three to five fragments per token - the indent, the name, a
; space, each paren - and a `concat` per fragment would copy the
; whole output each time: 200 KB of formatted source over 100,000
; appends is 10 GB of copying, which is the law `renderCG` was just
; rescued from. Appending to a Vec is O(1) amortised and the join is one
; pass.
;
; `nl` is a running count of the newlines emitted. It stands in for
; stage0's `out[mark..].contains('\n')`: a trailing comment may only be
; re-attached to a construct that stayed on one line, and comparing a
; newline count against a mark answers that without materialising the
; string.
; ------------------------------------------------------------------
(pub struct FOut
  (frags : (Vec String))
  (nl : Int)
  (indent : Int)
  (bad : Int)
  (trial : Int)
  (bytes : Int))

(pub :: mkFOut (-> Int Int))
(pub fn (mkFOut _u)
  (as (FOut :frags vecNew :nl 0 :indent 0 :bad 0 :trial 0 :bytes 0) Int))

(pub :: foFrags (-> Int Int))
(pub fn (foFrags o)
  (memGetWord o 0))

; The `Vec` view of the same word. The cast is at the return,
; not the call sites - see `nodeCName`.
(pub :: foFragsVec (-> Int Strings))
;@axiom:effect(unsafe)
(pub fn (foFragsVec o)
  (as (foFrags o) (Vec String)))

(pub :: foNl (-> Int Int))
(pub fn (foNl o)
  (memGetWord o 1))

(pub :: foIndent (-> Int Int))
(pub fn (foIndent o)
  (memGetWord o 2))

; The refusal flag. A printer that meets a shape stage0's parser would
; refuse cannot return an error - it is many calls deep in a walk - so
; it marks the buffer poisoned and the driver refuses to write. This is
; the mechanism that keeps stage1's exit status equal to stage0's: the
; shapes stage0 cannot parse are the shapes this printer will not print.
(pub :: foBad (-> Int Int))
(pub fn (foBad o)
  (memGetWord o 3))

(pub :: foSetBad (-> Int Int))
(pub fn (foSetBad o)
  {
    (memSetWord o 3 1)
    o
  })

(pub :: foTrial (-> Int Int))
(pub fn (foTrial o)
  (memGetWord o 4))

; Remove layout padding before a line break. Literal newlines are
; escaped by fpStrLit, so this never trims the contents of a string.
(pub :: foTrimPadding (-> Int ()))
(pub fn (foTrimPadding o)
  {
    (let v (foFragsVec o))
    (let mut more true)
    {
      (while (&& more (> (vecLen v) 0))
        {
          (let i (- (vecLen v) 1))
          {
            (let s (vecGet v i))
            (let mut end (strLen (vecGet v i)))
            {
              (while (&& (> end 0) (|| (== (strByte s (- end 1)) 32) (== (strByte s (- end 1)) 9)))
                (set end (- end 1)))
              (memSetWord o 5 (- (memGetWord o 5) (- (strLen s) end)))
              (if (== end 0)
                (vecPop v)
                {
                  (if (< end (strLen s))
                    (vecSet v i (strSlice s 0 end)))
                  (set more false)
                })
            }
          }
        })
      ()
    }
  })

(pub :: foPush (-> Int String Int))
(pub fn (foPush o s)
  {
    (if (&& (> (strLen s) 0) (== (strByte s 0) 10))
      (foTrimPadding o))
    (vecPush (foFragsVec o) s)
    (memSetWord o 5 (+ (memGetWord o 5) (strLen s)))
    (if (&& (== (foTrial o) 1) (> (memGetWord o 5) fmtWidth))
      (foSetBad o))
    (memSetWord o 1 (+ (foNl o) (countNewlines s)))
    o
  })

(pub :: countNewlines (-> String Int))
(pub fn (countNewlines s)
  {
    (let mut i 0)
    (let mut n 0)
    {
      (while (< i (strLen s))
        {
          (if (== (strByte s i) 10)
            (set n (+ n 1)))
          (set i (+ i 1))
        })
      n
    }
  })

(pub :: foNewline (-> Int Int))
(pub fn (foNewline o)
  (foPush o "\n"))

; The indent is a column. A nested construct indents two columns past
; the one it sits in; a broken call hangs its arguments two columns past
; its own opening paren (`foSetIndent`).
(pub :: foPushIndent (-> Int Int))
(pub fn (foPushIndent o)
  {
    (memSetWord o 2 (+ (foIndent o) 2))
    o
  })

(pub :: foPopIndent (-> Int Int))
(pub fn (foPopIndent o)
  {
    (memSetWord o 2
      (if (> (foIndent o) 1)
        (- (foIndent o) 2)
        0))
    o
  })

(pub :: foSetIndent (-> Int Int Int))
(pub fn (foSetIndent o col)
  {
    (memSetWord o 2 col)
    o
  })

(pub :: foIndentStr (-> Int String))
(pub fn (foIndentStr o)
  (strRepeatSpace (foIndent o)))

; `n` spaces.
(pub :: strRepeatSpace (-> Int String))
(pub fn (strRepeatSpace n)
  {
    (let mut i 0)
    (let mut s "")
    {
      (while (< i n)
        {
          (set s (concat s " "))
          (set i (+ i 1))
        })
      s
    }
  })

(pub :: foEmitIndent (-> Int Int))
(pub fn (foEmitIndent o)
  (foPush o (foIndentStr o)))

; The widest line the printer lays a form out on: a form that fits stays
; on one line, and one that doesn't breaks. rustfmt's default, for the
; same reason - wide enough that a call with a handful of arguments
; stays whole, narrow enough to read beside a second file.
(pub :: fmtWidth Int)
(pub fn (fmtWidth)
  100)

; The column the next fragment lands at: the bytes written since the
; last newline.
(pub :: foColumn (-> Int Int))
(pub fn (foColumn o)
  {
    (let v (foFragsVec o))
    (let mut i (- (vecLen v) 1))
    (let mut col 0)
    (let mut go true)
    {
      (while (&& go (>= i 0))
        {
          (let s (vecGetStr v i))
          {
            (let nl (strLastNewline s (- (strLen s) 1)))
            (if (>= nl 0)
              {
                (set col (+ col (- (strLen s) (+ nl 1))))
                (set go false)
              }
              {
                (set col (+ col (strLen s)))
                (set i (- i 1))
              })
          }
        })
      col
    }
  })

; The offset of the last newline in `s` at or before `i`, or -1.
(pub :: strLastNewline (-> String Int Int))
(pub fn (strLastNewline s i)
  (if (< i 0)
    (- 0 1)
    (if (== (strByte s i) 10)
      i
      (strLastNewline s (- i 1)))))

; Join the fragments: measure, allocate once, copy - the same shape
; `renderCG` uses, and for the same reason.
(pub :: foFinish (-> Int String))
(pub fn (foFinish o)
  {
    (let v (foFragsVec o))
    (let mut i 0)
    (let mut total 0)
    {
      (while (< i (vecLen v))
        {
          (set total (+ total (strLen (vecGetStr v i))))
          (set i (+ i 1))
        })
      {
        (let out (strAlloc total))
        (let mut j 0)
        (let mut off 0)
        {
          (while (< j (vecLen v))
            {
              (let f (vecGetStr v j))
              {
                (memCopy (+ (strData out) off) (strData f) (strLen f))
                (set off (+ off (strLen f)))
                (set j (+ j 1))
              }
            })
          out
        }
      }
    }
  })

; ------------------------------------------------------------------
; The comment queue.
;
; Comments are not in the form tree - they are trivia the scan collects
; beside it - so the printer walks the tree and the comment list
; together in source order, emitting each comment when it reaches the
; construct that followed it. `next` is the whole cursor: comments are
; emitted in order and never revisited.
; ------------------------------------------------------------------
(pub struct FCq
  (coms : Int)
  (next : Int))

(pub :: mkFCq (-> Int Int))
(pub fn (mkFCq coms)
  (as (FCq :coms coms :next 0) Int))

(pub :: fqComs (-> Int Int))
(pub fn (fqComs q)
  (memGetWord q 0))

; The `Vec` view of the same word. The cast is at the return,
; not the call sites - see `nodeCName`.
(pub :: fqComsVec (-> Int (Vec a)))
;@axiom:effect(unsafe)
(pub fn (fqComsVec q)
  (as (fqComs q) (Vec a)))

(pub :: fqNext (-> Int Int))
(pub fn (fqNext q)
  (memGetWord q 1))

(pub :: fqAdvance (-> Int Int))
(pub fn (fqAdvance q)
  {
    (memSetWord q 1 (+ (fqNext q) 1))
    q
  })

(pub :: fqPending (-> Int Bool))
(pub fn (fqPending q)
  (< (fqNext q) (vecLen (fqComsVec q))))

(pub :: fqHead (-> Int Int))
(pub fn (fqHead q)
  (vecGet (fqComsVec q) (fqNext q)))

; Emit every pending comment starting before `before`, each on its own
; line at the current indent, leaving the cursor at the start of a fresh
; line. Call it immediately BEFORE writing a construct's indent; it
; writes its own.
;
; A trailing comment reaches the front of the queue here when the
; construct it trailed was not one of the sites that calls
; `flushTrailing`. Moving it to its own line is a formatting change;
; dropping it is data loss, and only one of those is recoverable by
; whoever reads the file next.
(pub :: flushLeading (-> String Int Int Int Int))
(pub fn (flushLeading src q o before)
  {
    (while (&& (fqPending q) (< (fcStart (fqHead q)) before))
      {
        (let c (fqHead q))
        {
          (foEmitIndent o)
          (foPush o (fcText src c))
          (foNewline o)
          (fqAdvance q)
        }
      })
    o
  })

; Emit a pending trailing comment onto the current line, if the next one
; belongs to the construct just written. `mark` is `foNl` from
; immediately before the construct, which is how this tells whether the
; construct was laid out on a single line.
;
; That condition is what makes formatting idempotent. A trailing comment
; can only stay trailing across a second pass if the thing it trails
; still ends on the line it starts on; when the printer breaks a
; one-line source construct across several lines, the comment would land
; after the closing paren and the next pass would move it again. Such a
; comment stays in the queue and goes on its own line instead - it moves
; once, and then it is stable.
(pub :: flushTrailing (-> String Int Int Ints Int Int Int))
(pub fn (flushTrailing src q o starts anchor mark)
  (if (!= (foNl o) mark)
    o
    (if (&& (fqPending q)
          (&& (== (fcOwnLine (fqHead q)) 0) (== (fcLine (fqHead q)) (lineAt starts anchor))))
      {
        (foPush o "  ")
        (foPush o (fcText src (fqHead q)))
        (fqAdvance q)
        o
      }
      o)))

; Comments after the last declaration - a trailing footnote, or a
; commented-out block at the end of a file - have no following construct
; to attach to, and would otherwise be dropped.
(pub :: flushRemaining (-> String Int Int Int))
(pub fn (flushRemaining src q o)
  (flushLeading src q o 2147483647))

; ------------------------------------------------------------------
; `is_simple_expr`, transliterated.
;
; This one predicate drives every line break in the output. stage0
; defines it over AST node kinds: a variable or literal is simple, an
; application/infix/tuple/list/field is simple when its children are,
; and everything else is not. Over the form tree the same question is
; "is this a group whose head is not a keyword, all of whose children
; are simple" - with `{ }` never simple, since stage0's `EBegin` is not.
; ------------------------------------------------------------------
(pub :: isKeywordHead (-> String Bool))
(pub fn (isKeywordHead name)
  (if (strEq name "fn")
    true
    (if (strEq name "define")
      true
      (if (strEq name "lambda")
        true
        (if (strEq name "let")
          true
          (if (strEq name "if")
            true
            (if (strEq name "match")
              true
              (if (strEq name "cond")
                true
                (if (|| (strEq name "while") (strEq name "region"))
                  true
                  (if (|| (strEq name "for") (strEq name "parallel"))
                    true
                    (if (strEq name "set")
                      true
                      (if (strEq name "struct")
                        true
                        (if (strEq name "consume")
                          true
                          (if (strEq name "alloc")
                            true
                            (if (strEq name "handle")
                              true
                              (if (strEq name "as")
                                true
                                (if (strEq name "sizeof")
                                  true
                                  (if (strEq name "alignof")
                                    true
                                    (if (strEq name "::")
                                      true
                                      false)))))))))))))))))))

(pub :: isSimpleForm (-> String Int Bool))
(pub fn (isSimpleForm src n)
  (if (== (fnKind n) FN_TRY)
    (isSimpleForm src (fnKid n 0))
    (if (== (fnKind n) FN_ATOM)
      true
      ; A singleton brace block parses to its inner expression - `{e}` IS
      ; `e` to stage0's parser - so its simplicity is the inner's. A
      ; multi-expression block is `EBegin`, never simple.
      (if (== (fnKind n) FN_BRACE)
        (if (== (fnLen n) 1)
          (isSimpleForm src (fnKid n 0))
          false)
        (if (== (fnKind n) FN_PREFIX)
          false
          ; A qualified name is a name. `EQualified` was NOT in stage0's
          ; `is_simple_expr` list - probed then: `(Q::Inner::only 1)`
          ; broke across four lines under stage0's fmt while `(p.x 1)`
          ; stayed on one - and this printer transliterated the omission,
          ; so `(println (Vec::vecLen v))` exploded to five lines while
          ; `(println (vecLen v))` stayed on one, for no reason the
          ; language has. `fpQualLeft` refuses anything but an
          ; ident-rooted chain, so the only shape that reaches the printer
          ; is atoms joined by `::`, which is as simple as the atoms.
          ; Parity case 222 pins it.
          (if (== (fnKind n) FN_QUAL)
            true
            (if (== (fnKind n) FN_BRACK)
              (allSimple src n 0)
              (if (isKeywordHead (fnHeadText src n))
                false
                (allSimple src n 0)))))))))

(pub :: allSimple (-> String Int Int Bool))
(pub fn (allSimple src n i)
  {
    (let mut j i)
    (let mut ok 1)
    {
      (while (< j (fnLen n))
        {
          (if (! (isSimpleForm src (fnKid n j)))
            (set ok 0))
          (set j (+ j 1))
        })
      (== ok 1)
    }
  })

; ==================================================================
; The printer.
;
; The printer keeps structural layouts for declarations and control flow.
; Applications use width-bounded trials and complete argument rows.
; Comment placement follows source spans rather than trial output.
; ==================================================================
; The printer context: the source, the line index, the comment queue,
; and the output buffer, threaded as one word.
(pub struct FPr
  (src : String)
  (starts : Int)
  (q : Int)
  (out : Int)
  (suffixWidth : Int))

(pub :: mkFPr (-> String Int Int Int Int))
(pub fn (mkFPr src starts q out)
  (as (FPr :src src :starts starts :q q :out out :suffixWidth 0) Int))

(pub :: fpSrc (-> Int String))
(pub fn (fpSrc p)
  (memGetWordStr p 0))

(pub :: fpStarts (-> Int Int))
(pub fn (fpStarts p)
  (memGetWord p 1))

; The `Vec` view of the same word. The cast is at the return,
; not the call sites - see `nodeCName`.
(pub :: fpStartsVec (-> Int (Vec a)))
;@axiom:effect(unsafe)
(pub fn (fpStartsVec p)
  (as (fpStarts p) (Vec a)))

(pub :: fpQ (-> Int Int))
(pub fn (fpQ p)
  (memGetWord p 2))

(pub :: fpOut (-> Int Int))
(pub fn (fpOut p)
  (memGetWord p 3))

; Space owed after an expression on its final line. Callers supply
; structural suffixes, without inspecting output text or literal contents.
(pub :: fpSuffixWidth (-> Int Int))
(pub fn (fpSuffixWidth p)
  (memGetWord p 4))

; Ordinary children start a fresh shape. A final child receives the
; parent's suffix and the close its immediate parent will append.
(pub :: fpExprSuffix (-> Int Int Int Int))
(pub fn (fpExprSuffix p n width)
  {
    (let saved (fpSuffixWidth p))
    {
      (memSetWord p 4 width)
      (if (&& (== (foTrial (fpOut p)) 1) (!= (foBad (fpOut p)) 0))
        0
        (fpExprLive p n))
      (memSetWord p 4 saved)
      p
    }
  })

; Canonical type text follows an ascription or conversion on the same
; line. Its width belongs to the value's suffix along with the close.
(pub :: fpTypeWidth (-> Int Int Int))
(pub fn (fpTypeWidth p n)
  {
    (let out (mkFOut 0))
    {
      (let trial (mkFPr (fpSrc p) (fpStarts p) (mkFCq (as vecNew Int)) out))
      {
        (memSetWord out 4 1)
        (fpType trial n)
        (if (|| (!= (foBad out) 0) (> (foNl out) 0))
          0
          (strLen (foFinish out)))
      }
    }
  })

(pub :: fpExprTail (-> Int Int Int Int))
(pub fn (fpExprTail p n width)
  (fpExprSuffix p n (+ (fpSuffixWidth p) width)))

(pub :: fpP (-> Int String Int))
(pub fn (fpP p s)
  {
    (foPush (fpOut p) s)
    p
  })

(pub :: fpByte (-> Int Int Int))
;@axiom:effect(unsafe)
(pub fn (fpByte p b)
  {
    (let s (strAlloc 1))
    {
      (__store8 (strData s) 0 b)
      (fpP p s)
    }
  })

(pub :: fpBad (-> Int Int))
(pub fn (fpBad p)
  {
    (foSetBad (fpOut p))
    p
  })

; Emit a slice of the source verbatim. `strSlice` shares storage, so
; this costs two words however long the run is.
(pub :: fpSlice (-> Int Int Int Int))
(pub fn (fpSlice p from to)
  (if (> to from)
    (fpP p (strSlice (fpSrc p) from (- to from)))
    p))

; ------------------------------------------------------------------
; Literal normalisation.
;
; stage0 lexes a literal into a VALUE and prints the value back, so
; the printed spelling is the normal form, not the written one. These
; reproduce that composition textually: `1_000` and `007` normalise
; because Rust's `{}` on the parsed i64 never prints separators or
; leading zeros, and a float's trailing zeros vanish because `{:?}`
; prints the shortest round-tripping decimal - equal, on every float
; this corpus is allowed to contain (see the zoo), to stripping them.
; ------------------------------------------------------------------
; Digits from `from..to` with `_` dropped and leading zeros dropped,
; keeping at least one digit.
(pub :: fpDigits (-> Int Int Int Int))
(pub fn (fpDigits p from to)
  {
    (let src (fpSrc p))
    (let mut digits 0)
    (let mut j from)
    {
      (while (< j to)
        {
          (if (! (== (strByte src j) 95))
            (set digits (+ digits 1)))
          (set j (+ j 1))
        })
      {
        (let mut skipped 0)
        (let mut emitted 0)
        (let mut i from)
        {
          (while (< i to)
            {
              (let b (strByte src i))
              {
                (if (! (== b 95))
                  (if (&& (== b 48) (&& (== emitted 0) (> (- digits skipped) 1)))
                    (set skipped (+ skipped 1))
                    {
                      (fpByte p b)
                      (set emitted (+ emitted 1))
                    }))
                (set i (+ i 1))
              }
            })
          p
        }
      }
    }
  })

; An integer literal's text, normalised. A leading `-` (a fused
; negative literal) passes through. Digits outside Int's signed range
; poison the output, using the same bound as the compiler.
(pub :: fpInt (-> Int Int Int Int))
(pub fn (fpInt p from to)
  (if (if (fpIntFits (fpSrc p) from to)
    false
    true)
    (fpBad p)
    {
      (let neg (== (strByte (fpSrc p) from) 45))
      {
        (if neg
          (fpP p "-")
          p)
        (fpDigits p
          (if neg
            (+ from 1)
            from)
          to)
      }
    }))

; The fractional digits, verbatim apart from `_` separators.
;
; NOT `fpDigits`, which drops LEADING zeros. That is right for an
; integer part, where `007` and `7` are the same number, and it
; changes the VALUE of a fraction, where `05` and `5` are not: `fmt`
; rewrote `0.05` into `0.5` and `0.0583` into `0.583`, at exit 0, with
; the round-trip check satisfied because both spellings are valid
; floats and the re-scan sees only that a float is there.
;
; No `.ax` file in this repository contains such a literal outside a
; comment - the only two occurrences are in prose in `codegen.ax` and
; `Fmt.ax` - which is why formatting the whole corpus and re-running
; every suite could not see it. `tests/selfhost/940-float-literal.ax`
; is the corpus entry that makes it visible, since `check-fmt.sh`
; formats a copy of the repository and re-runs `check-self-host.sh`
; against it.
(pub :: fpFracDigits (-> Int Int Int Int))
(pub fn (fpFracDigits p from to)
  {
    (let src (fpSrc p))
    (let mut i from)
    {
      (while (< i to)
        {
          (let b (strByte src i))
          {
            (if (! (== b 95))
              (fpByte p b))
            (set i (+ i 1))
          }
        })
      p
    }
  })

; A float literal's text: integer part like an integer, fractional
; part with trailing zeros dropped, keeping one digit.
(pub :: fpFloat (-> Int Int Int Int))
(pub fn (fpFloat p from to)
  {
    (let src (fpSrc p))
    (let neg (== (strByte (fpSrc p) from) 45))
    {
      (let s
        (if neg
          (+ from 1)
          from))
      (let mut dot from)
      {
        (if neg
          (fpP p "-")
          p)
        (set dot s)
        (while (!= (strByte src dot) 46)
          (set dot (+ dot 1)))
        (fpDigits p s dot)
        (fpP p ".")
        ; The fractional cut: the position after the last non-zero
        ; digit, but at least one digit past the dot.
        {
          (let mut cut (+ dot 1))
          (let mut j (+ dot 1))
          (let mut seen 0)
          {
            (while (< j to)
              {
                (let b (strByte src j))
                {
                  (if (! (== b 95))
                    {
                      (set seen (+ seen 1))
                      (if (!= b 48)
                        (set cut (+ j 1)))
                    })
                  (set j (+ j 1))
                }
              })
            ; No non-zero digit: keep exactly the first digit.
            (if (== cut (+ dot 1))
              {
                (let mut k (+ dot 1))
                {
                  (while (== (strByte src k) 95)
                    (set k (+ k 1)))
                  (fpSlice p k (+ k 1))
                }
              }
              (fpFracDigits p (+ dot 1) cut))
          }
        }
      }
    }
  })

; A string literal, re-escaped from its decoded value. The decode and
; the re-encode compose to the identity for every escape except `\'`,
; which decodes to a quote that needs no escaping, and for raw
; control bytes, which come back escaped. An escape outside the
; lexer's set (`n t r \ " ' 0`) is a lex error in stage0, so it
; poisons the output here.
(pub :: fpStrLit (-> Int Int Int))
(pub fn (fpStrLit p tok)
  {
    (let src (fpSrc p))
    (let s (+ (ftStart tok) 1))
    (let e (- (ftEnd tok) 1))
    (if (|| (> (ftEnd tok) (strLen src)) (|| (< e s) (!= (strByte src e) 34)))
      (fpBad p)
      {
        (fpP p "\"")
        {
          (let mut i s)
          (while (< i e)
            {
              (let run i)
              {
                (while (&& (< i e)
                         {
                           (let b (strByte src i))
                           (&& (!= b 92) (&& (!= b 10) (&& (!= b 13) (&& (!= b 9) (!= b 0)))))
                         })
                  (set i (+ i 1)))
                (fpSlice p run i)
                (if (< i e)
                  {
                    (let b (strByte src i))
                    (if (== b 92)
                      {
                        (let esc
                          (if (< (+ i 1) e)
                            (strByte src (+ i 1))
                            0))
                        {
                          (if (== esc 39)
                            (fpP p "'")
                            (if (|| (== esc 110)
                                  (|| (== esc 116)
                                    (|| (== esc 114)
                                      (|| (== esc 92) (|| (== esc 34) (== esc 48))))))
                              (fpSlice p i (+ i 2))
                              (fpBad p)))
                          (set i (+ i 2))
                        }
                      }
                      {
                        (if (== b 10)
                          (fpP p "\\n")
                          (if (== b 13)
                            (fpP p "\\r")
                            (if (== b 9)
                              (fpP p "\\t")
                              (fpP p "\\0"))))
                        (set i (+ i 1))
                      })
                  }
                  p)
              }
            })
        }
        (fpP p "\"")
      })
  })

; A character literal. The one asymmetry against strings: a `"` in a
; character literal is never escaped, and `\"` written in one decodes
; to a bare `"`.
(pub :: fpCharLit (-> Int Int Int))
(pub fn (fpCharLit p tok)
  {
    (let src (fpSrc p))
    (let s (+ (ftStart tok) 1))
    (let e (- (ftEnd tok) 1))
    (if (|| (> (ftEnd tok) (strLen src)) (|| (< e (+ s 1)) (!= (strByte src e) 39)))
      (fpBad p)
      {
        (fpP p "'")
        {
          (let b (strByte src s))
          (if (== b 92)
            {
              (let esc (strByte src (+ s 1)))
              (if (== esc 39)
                (fpP p "'")
                (if (== esc 34)
                  (fpP p "\"")
                  (if (|| (== esc 110)
                        (|| (== esc 116) (|| (== esc 114) (|| (== esc 92) (== esc 48)))))
                    (fpSlice p s (+ s 2))
                    (fpBad p))))
            }
            (if (== b 10)
              (fpP p "\\n")
              (if (== b 13)
                (fpP p "\\r")
                (if (== b 9)
                  (fpP p "\\t")
                  (if (== b 0)
                    (fpP p "\\0")
                    (fpSlice p s e))))))
        }
        (fpP p "'")
      })
  })

; ------------------------------------------------------------------
; Expressions.
; ------------------------------------------------------------------
; Which identifier heads the printer refuses, and why the list is two
; words long. The lexer reserves nothing (docs/reference.md,
; "Keywords"): a keyword is special only in the position its grammar
; rule claims - the head of a form, `mut` at the head of a `let`
; binding, `else` at the head of a `cond` clause, `where` inside a
; `trait` or `impl` head - and an ordinary identifier everywhere else.
; `parseIdentList` takes `data` as a parameter, `parseArmPattern` binds
; it, `parseEffectNames` takes any identifier as an effect name, and
; `parseInner` reads `(data 1)`, `(type 1)` and `(where 1)` as
; applications of a variable; what such a name MEANS is the checker's
; question (AX3001, AX3004, AX3016), never the parser's. So the printer
; prints every identifier byte for byte, and the heads it refuses are
; exactly the two `parseInner` refuses BY NAME: `consume` and `begin`,
; both AX2004 - removed constructs with no spelling the printer could
; migrate them to, so the two subcommands refuse together, as they do
; for `deriving` in `fpDeriving`.
;
; This replaced `fpIsReservedWord` on 2026-08-28. That function
; reproduced the RETIRED Rust compiler's lexer - thirty-two structural
; words reserved in every position - and refused `(fn (g data) data)`
; while `check` accepted it. check-fmt.sh found it the day
; `self_host/lsp.ax` named a parameter `data` (f0a2fa3), and the parity
; bank had pinned the wrong answer as 070-keyword-in-expr since the day
; it was materialized. Measured on the compiler built from this tree
; before the change: every non-head position - parameter, argument,
; `let` binder, pattern variable, `lambda` and `macro` parameter, `set`
; target, effect atom - was `check` OK (or a checker error) and `fmt`
; "formatter refusal"; and in the other direction `fmt` printed
; `(consume 1)` and `(begin 1)`, which `check` refuses at the parser.
; tests/fmt/parity/190 to 197 pin both directions; 194 pins the one
; binder position that IS a keyword's, `(let ((mut 1)) mut)`, AX2001
; in `check` and refused here.
(pub :: fpIsRefusedHead (-> String Bool))
(pub fn (fpIsRefusedHead t)
  ; `check` refuses every one of these at the parser in expression
  ; position (AX2004), so `fmt` refuses them with it rather than
  ; printing what no compiler accepts. `cond`, `fn` and `struct` stay
  ; keyword heads (see `isKeywordHead`) exactly as `consume` does, so
  ; the refusal - not the application layout - is what they reach.
  (|| (strEq t "import")
    (|| (|| (strEq t "cast") (strEq t "consume"))
      (|| (strEq t "begin")
        (|| (strEq t "cond") (|| (strEq t "alloc") (|| (strEq t "fn") (strEq t "struct"))))))))

; The same rule in DECLARATION position, and the two words it names are
; `trait` and `impl`.
;
; They had printers until 0.6.0, and that was the toolchain disagreeing
; with itself in the direction this file can least afford. Measured on
; the commit that reserved the keywords:
; `(trait (Show a) where (show :: (-> a String)))` was `check` AX2004
; and `fmt --check` "already formatted", exit 0; and
; `(impl (Show Int) where ((show (lambda (x) \"n\"))))` was AX2004 and
; `fmt` REWROTE IT - the formatter tidying a declaration no compiler in
; this tree accepts. The syntax zoo could not have caught it, for the
; reason `check-fmt.sh`'s own header records about `type`, `trait`,
; `impl` and `foreign`: a corpus carries only what someone wrote into
; it, and nobody writes a construct that has just been deleted.
;
; `fpIsDeclHead` still names both, deliberately. That predicate is what
; routes a form to `fpDecl` at all, and a `trait` that stopped being a
; declaration head would reach the EXPRESSION printer instead - which
; prints call-shaped forms, so the refusal would quietly become a
; rewrite again. The two lists answer different questions: this one is
; "may it be printed", that one is "who prints it".
(pub :: fpIsRemovedDeclHead (-> String Bool))
(pub fn (fpIsRemovedDeclHead t)
  (|| (strEq t "trait") (|| (strEq t "impl") (strEq t "emacro"))))

; The operator spellings stage0's parser turned into expression values
; (`parse_expr_at_depth`'s token list). `$` lexes as the `!` token and
; prints as `!`. Any other operator run answers "", and the caller
; prints it as the name this compiler's parser reads it as.
(pub :: fpOperSpelling (-> String String))
(pub fn (fpOperSpelling t)
  (if (strEq t "+")
    t
    (if (strEq t "*")
      t
      (if (strEq t "/")
        t
        (if (strEq t "%")
          t
          (if (strEq t "^")
            t
            (if (strEq t "==")
              t
              (if (strEq t "!=")
                t
                (if (strEq t "<")
                  t
                  (if (strEq t ">")
                    t
                    (if (strEq t "<=")
                      t
                      (if (strEq t ">=")
                        t
                        (if (strEq t "!")
                          t
                          (if (strEq t "&&")
                            t
                            (if (strEq t "||")
                              t
                              (if (strEq t "&")
                                t
                                (if (strEq t "|")
                                  t
                                  (if (strEq t "<<")
                                    t
                                    (if (strEq t ">>")
                                      t
                                      (if (strEq t "$")
                                        "!"
                                        ""))))))))))))))))))))

; Use the compiler's signed decimal bound, including Int minimum.
; The formatter still owns its tokens and layout.
(pub :: fpIntFits (-> String Int Int Bool))
(pub fn (fpIntFits src from to)
  (intLitFits src from to))

; The left side of a qualified reference. A dotted module path prints
; with `::` throughout - `Q.Inner::only` is `Q::Inner::only` - and only
; ident-rooted chains are legal, as in stage0's parser.
(pub :: fpQualLeft (-> Int Int Int))
(pub fn (fpQualLeft p n)
  {
    (let k (fnKind n))
    (let src (fpSrc p))
    (if (== k FN_ATOM)
      (if (== (ftKind (fnTok n)) FT_IDENT)
        (fpP p (fnText src n))
        (fpBad p))
      (if (|| (== k FN_FIELD) (== k FN_QUAL))
        {
          (fpQualLeft p (fnKid n 0))
          ; The separator is the one the node carries, and printing
          ; `::` for both was wrong in the direction that matters: a
          ; DOTTED MODULE PATH is an FN_FIELD here, so `(Q.Inner::label
          ; x)` - the spelling `(import Q.Inner)` implies and
          ; docs/reference.md documents - was rewritten to
          ; `Q::Inner::label`. The compiler resolves that too, so every
          ; behavioural gate stayed green; the tree-sitter grammar does
          ; not, which is what found it, on the day the tree was first
          ; formatted end to end.
          (fpP p
            (if (== k FN_FIELD)
              "."
              "::"))
          (fpP p (fnText src (fnKid n 1)))
        }
        (fpBad p)))
  })

; The body of a form that takes `expr...`: one expression stays
; itself, several are an implicit `{}` block, which is exactly
; stage0's `parse_body_exprs`.
(pub :: fpBodyVecSimple (-> String Ints Int Bool))
(pub fn (fpBodyVecSimple src elems from)
  (if (== (- (vecLen elems) from) 1)
    (isSimpleForm src (vecGet elems from))
    false))

(pub :: fpBodyVecAnchor (-> String Ints Int Int))
(pub fn (fpBodyVecAnchor src elems from)
  (if (> (vecLen elems) from)
    (fpAnchor src (vecGet elems from))
    0))

(pub :: fpBeginVec (-> Int Ints Int Int))
(pub fn (fpBeginVec p elems from)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let mut i from)
    {
      (fpP p "{\n")
      (foPushIndent o)
      (while (< i (vecLen elems))
        {
          (let e (vecGet elems i))
          {
            (if (> i from)
              (fpP p "\n")
              p)
            (flushLeading src (fpQ p) o (fpAnchor src e))
            {
              (let mark (foNl o))
              {
                (foEmitIndent o)
                (if (fpIsLocalLet src e)
                  (fpLocalLet p e)
                  (fpExpr p e))
                (flushTrailing src (fpQ p) o (fpStartsVec p) (fpAnchor src e) mark)
              }
            }
            (set i (+ i 1))
          }
        })
      (foPopIndent o)
      (fpP p "\n")
      (foEmitIndent o)
      (fpP p "}")
    }
  })

(pub :: fpBodyVec (-> Int Ints Int Int))
(pub fn (fpBodyVec p elems from)
  (if (== (- (vecLen elems) from) 1)
    (fpExprTail p (vecGet elems from) 1)
    (if (< (vecLen elems) (+ from 1))
      (fpBad p)
      (fpBeginVec p elems from))))

; The simple-body/broken-body shape shared by fn bodies, lambda
; bodies, match arms and cond clauses: a space and the body inline, or
; the body alone on the next indent level with the closing paren under
; the construct.
(pub :: fpTailBody (-> Int Ints Int Int))
(pub fn (fpTailBody p elems from)
  {
    (let o (fpOut p))
    (if (&& (! (fqAnyWithin (fpQ p) 0 (fpBodyVecAnchor (fpSrc p) elems from)))
          (&& (fpBodyVecSimple (fpSrc p) elems from)
            {
              (let flat (fpExprFlat p (vecGet elems from)))
              (&& (> (strLen flat) 0)
                (<= (+ (+ (+ (foColumn o) 1) (strLen flat)) (+ 1 (fpSuffixWidth p))) fmtWidth))
            }))
      {
        (fpP p " ")
        (fpBodyVec p elems from)
      }
      {
        (fpP p "\n")
        (foPushIndent o)
        (flushLeading (fpSrc p) (fpQ p) o (fpBodyVecAnchor (fpSrc p) elems from))
        (foEmitIndent o)
        (if (== (- (vecLen elems) from) 1)
          (fpExpr p (vecGet elems from))
          (fpBeginVec p elems from))
        (foPopIndent o)
        (fpP p "\n")
        (foEmitIndent o)
      })
  })

(pub :: fpLambda (-> Int Int Int))
(pub fn (fpLambda p n)
  (if (|| (< (fnLen n) 3) (!= (fnKind (fnKid n 1)) FN_PAREN))
    (fpBad p)
    {
      (let params (fnKidsVec (fnKid n 1)))
      {
        (fpP p "(lambda ")
        (fpList p (fnKid n 1) (fpPatItems p params 0) 1 "(" ")")
        (fpTailBody p (fpExprElems n 2) 0)
        (fpP p ")")
      }
    }))

; A local is an entry in a brace block. Its value is formatted as one
; expression, and the surrounding block supplies its lexical scope.
(pub :: fpIsLocalLet (-> String Int Bool))
(pub fn (fpIsLocalLet src n)
  (&& (strEq (fnHeadText src n) "let") (&& (> (fnLen n) 1) (== (fnKind (fnKid n 1)) FN_ATOM))))

(pub :: fpLocalLet (-> Int Int Int))
(pub fn (fpLocalLet p n)
  {
    (let src (fpSrc p))
    {
      (let out (fpOut p))
      {
        (let mutable (fpIsAtomText src (fnKid n 1) "mut"))
        {
          (let nameIndex
            (if mutable
              2
              1))
          {
            (let values (fpExprElems n (+ nameIndex 1)))
            (if (|| (>= nameIndex (fnLen n)) (!= (vecLen values) 1))
              (fpBad p)
              {
                (let name (fnKid n nameIndex))
                (if (! (fpIsIdentAtom name))
                  (fpBad p)
                  {
                    (let value (vecGet values 0))
                    {
                      (let flat (fpExprFlat p value))
                      {
                        (fpP p
                          (if mutable
                            "(let mut "
                            "(let "))
                        (fpP p (fnText src name))
                        (if (&& (> (strLen flat) 0)
                              (&& (! (fqAnyWithin (fpQ p) (fnStart n) (fnEnd value)))
                                (<=
                                  (+ (+ (+ (foColumn out) 1) (strLen flat)) (+ 1 (fpSuffixWidth p)))
                                  fmtWidth)))
                          {
                            (fpP p " ")
                            (fpExprSuffix p value 1)
                          }
                          {
                            (fpP p "\n")
                            (foPushIndent out)
                            (flushLeading src (fpQ p) out (fpAnchor src value))
                            (foEmitIndent out)
                            (fpExprSuffix p value 1)
                            (foPopIndent out)
                          })
                        (fpP p ")")
                      }
                    }
                  })
              })
          }
        }
      }
    }
  })

; One binding pair, decomposed: `(x init)` or `(mut x init)`.
; Answers the kid index where the init begins, or -1 on a shape the
; parser refuses. The init may span two kids - a fused negative
; literal - so the caller validates it as ONE fused expression element,
; not one kid; `(x = init)`, which the parser refuses (AX2003), fails
; that validation and is refused here too.
(pub :: fpBindInit (-> String Int Int))
(pub fn (fpBindInit src b)
  (if (!= (fnKind b) FN_PAREN)
    (- 0 1)
    {
      (let i1
        (if (&& (> (fnLen b) 0) (fpIsAtomText src (fnKid b 0) "mut"))
          2
          1))
      (if (>= i1 (fnLen b))
        (- 0 1)
        i1)
    }))

; The single-binding spelling: the init inline when simple, broken
; below the pattern when not.
(pub :: fpLetBinding (-> Int Int Int))
(pub fn (fpLetBinding p b)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let initIx (fpBindInit (fpSrc p) b))
    (if (|| (< initIx 0)
          (!=
            (vecLen
              (fpExprElems b
                (if (< initIx 0)
                  0
                  initIx)))
            1))
      (fpBad p)
      {
        (let isMut (fpIsAtomText src (fnKid b 0) "mut"))
        (let patIx
          (if (fpIsAtomText src (fnKid b 0) "mut")
            1
            0))
        {
          (let init (vecGet (fpExprElems b initIx) 0))
          {
            (fpP p
              (if isMut
                "(mut "
                "("))
            (fpPat p (fnKid b patIx))
            (fpP p " ")
            (if (isSimpleForm src init)
              (fpExprSuffix p init 2)
              {
                (fpP p "\n")
                (foPushIndent o)
                (foEmitIndent o)
                (fpExprSuffix p init 2)
                (foPopIndent o)
              })
            (fpP p ")")
          }
        }
      })
  })

; A binding in the several-bindings spelling: always inline, with the
; comment flushes stage0 makes at exactly these two points.
(pub :: fpLetBindingBroken (-> Int Int Int))
(pub fn (fpLetBindingBroken p b)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let initIx (fpBindInit (fpSrc p) b))
    (if (|| (< initIx 0)
          (!=
            (vecLen
              (fpExprElems b
                (if (< initIx 0)
                  0
                  initIx)))
            1))
      (fpBad p)
      {
        (let isMut (fpIsAtomText src (fnKid b 0) "mut"))
        (let patIx
          (if (fpIsAtomText src (fnKid b 0) "mut")
            1
            0))
        {
          (let init (vecGet (fpExprElems b initIx) 0))
          {
            (flushLeading src (fpQ p) o (fpAnchor src init))
            {
              (let mark (foNl o))
              {
                (foEmitIndent o)
                (fpP p
                  (if isMut
                    "(mut "
                    "("))
                (fpPat p (fnKid b patIx))
                (fpP p " ")
                (fpExprSuffix p init 1)
                (fpP p ")")
                (flushTrailing src (fpQ p) o (fpStartsVec p) (fpAnchor src init) mark)
              }
            }
          }
        }
      })
  })

(pub :: fpIf (-> Int Int Int))
; `(if test then else)`, and variadically `(if t1 b1 t2 b2 ... els)`:
; one operand per line after the head. Two or three operands share one
; indent. In a chain of two or more pairs, each branch sits two columns
; deeper than its test, and a final else returns to the tests' indent.
; Four or more operands spell the nested chain `parseIfExpr` builds.
; A complete pair may end the chain without an else; an unmatched test
; is refused by both the parser and the printer.
(pub fn (fpIf p n)
  ; A chain that ends on a complete pair has no else and answers
  ; `()` (`parseIfTail`), so two operands and any even count print.
  {
    (let elems (fpExprElems n 1))
    (if (< (vecLen elems) 2)
      (fpBad p)
      (if (== (vecLen elems) 3)
        {
          (let src (fpSrc p))
          (let o (fpOut p))
          (let c (vecGet elems 0))
          (let t (vecGet elems 1))
          (let e (vecGet elems 2))
          {
            (let condMark (foNl o))
            {
              (fpP p "(if ")
              (fpExpr p c)
              (flushTrailing src (fpQ p) o (fpStartsVec p) (fpAnchor src c) condMark)
              (fpP p "\n")
              (foPushIndent o)
              (flushLeading src (fpQ p) o (fpAnchor src t))
              {
                (let thenMark (foNl o))
                {
                  (foEmitIndent o)
                  (fpExpr p t)
                  (flushTrailing src (fpQ p) o (fpStartsVec p) (fpAnchor src t) thenMark)
                }
              }
              (fpP p "\n")
              (flushLeading src (fpQ p) o (fpAnchor src e))
              (foEmitIndent o)
              (fpExprTail p e 1)
              (foPopIndent o)
              (fpP p ")")
            }
          }
        }
        {
          (let src (fpSrc p))
          (let o (fpOut p))
          (let chain (>= (vecLen elems) 4))
          (let mut i 0)
          {
            (fpP p "(if ")
            (fpExpr p (vecGet elems 0))
            (flushTrailing src (fpQ p) o (fpStartsVec p) (fpAnchor src (vecGet elems 0)) (foNl o))
            (foPushIndent o)
            (set i 1)
            (while (< i (vecLen elems))
              {
                (let el (vecGet elems i))
                (let branch (&& chain (== (% i 2) 1)))
                {
                  (fpP p "\n")
                  (if branch
                    (foPushIndent o))
                  (flushLeading src (fpQ p) o (fpAnchor src el))
                  (foEmitIndent o)
                  (if (== i (- (vecLen elems) 1))
                    (fpExprTail p el 1)
                    (fpExpr p el))
                  (flushTrailing src (fpQ p) o (fpStartsVec p) (fpAnchor src el) (foNl o))
                  (if branch
                    (foPopIndent o))
                  (set i (+ i 1))
                }
              })
            (foPopIndent o)
            (fpP p ")")
          }
        }))
  })

(pub :: fpWhile (-> Int Int Int))
(pub fn (fpWhile p n)
  {
    (let elems (fpExprElems n 1))
    (if (< (vecLen elems) 1)
      (fpBad p)
      (if (== (vecLen elems) 1)
        ; A `while` with no body spins on its condition, and the parser
        ; reads one (`parseWhileExpr` takes a body list that may be
        ; empty), so it prints on one line. Refusing it refused, with no
        ; code, a program `check` accepts (`tests/fuzz/while-no-body.axfuzz`).
        {
          (fpP p "(while ")
          (fpExprTail p (vecGet elems 0) 1)
          (fpP p ")")
        }
        {
          (let o (fpOut p))
          {
            (fpP p "(while ")
            (fpExpr p (vecGet elems 0))
            (fpP p "\n")
            (foPushIndent o)
            (foEmitIndent o)
            (fpBodyVec p elems 1)
            (foPopIndent o)
            (fpP p ")")
          }
        }))
  })

; `for` prints like `while`: the head line carries everything the loop
; is controlled by, and the body goes on its own indented line. After
; the binder and its `in`, two elements are the container form
; `(for x in xs body)` - an element-index binder `(for (x i) in xs body)`
; is still one element - three are the range `(for i in lo..hi body)`,
; and four the stepped range `(for i in lo..hi by step body)`. Nothing else
; is a `for`: the parser discriminates the shapes by exactly this arity
; (`self_host/parser.ax`'s `parseForExpr`) and refuses a binder with no
; `in`, so a printer that accepted another shape would print something
; `check` then refuses.
;
; The formatter is a separate grammar that never sees the parser's AST,
; which is why the shape is restated here. Without it a four-operand
; head with a `{ }` body would print in the application layout.
; `tests/fmt/parity/198-for-head-layout` holds the bytes.
(pub :: fpFor (-> Int Int Int))
(pub fn (fpFor p n)
  {
    (let elems (fpExprElems n 1))
    (let src (fpSrc p))
    {
      (let k (vecLen elems))
      (let hasIn
        (if (> (vecLen elems) 1)
          (fpIsAtomText src (vecGet elems 1) "in")
          false))
      {
        (let isRange
          (if (>= k 6)
            (fpIsAtomText src (vecGet elems 3) "..")
            false))
        (if (! hasIn)
          (fpBad p)
          (if isRange
            (if (|| (== k 6)
                  (if (== k 8)
                    (fpIsAtomText src (vecGet elems 5) "by")
                    false))
              {
                (fpP p "(for ")
                (fpExpr p (vecGet elems 0))
                (fpP p " in ")
                (fpExpr p (vecGet elems 2))
                (fpP p "..")
                (fpExpr p (vecGet elems 4))
                (if (== k 8)
                  {
                    (fpP p " by ")
                    (fpExpr p (vecGet elems 6))
                  })
                (fpForBody p elems)
              }
              (fpBad p))
            (if (|| (< k 4) (> k 6))
              (fpBad p)
              {
                (let mut i 1)
                {
                  (fpP p "(for ")
                  (fpExpr p (vecGet elems 0))
                  (while (< i (- k 1))
                    {
                      (fpP p " ")
                      (fpExpr p (vecGet elems i))
                      (set i (+ i 1))
                    })
                  (fpForBody p elems)
                }
              })))
      }
    }
  })

; The body of a `for`, on its own indented line, and the closing paren.
(pub :: fpForBody (-> Int Ints Int))
(pub fn (fpForBody p elems)
  {
    (let o (fpOut p))
    {
      (fpP p "\n")
      (foPushIndent o)
      (foEmitIndent o)
      (fpBodyVec p elems (- (vecLen elems) 1))
      (foPopIndent o)
      (fpP p ")")
    }
  })

; `asm` prints one arm per line under its head when it has more than
; one, so each architecture's template and operands read as a unit
; (MM-FFI-9). One arm stays on the head's line, and so does a form
; with a bare word where an arm belongs, which AX3091 refuses. An arm
; prints as any other form does.
(pub :: fpAnyAtom (-> Ints Int Bool))
(pub fn (fpAnyAtom elems i)
  (if (>= i (vecLen elems))
    false
    (if (== (fnKind (vecGet elems i)) FN_ATOM)
      true
      (fpAnyAtom elems (+ i 1)))))

(pub :: fpAsm (-> Int Int Int))
(pub fn (fpAsm p n)
  {
    (let elems (fpExprElems n 1))
    (let o (fpOut p))
    (let mut i 0)
    {
      (fpP p "(asm")
      (if (|| (< (vecLen elems) 2) (fpAnyAtom elems 0))
        (while (< i (vecLen elems))
          {
            (fpP p " ")
            (fpExpr p (vecGet elems i))
            (set i (+ i 1))
          })
        {
          (foPushIndent o)
          (while (< i (vecLen elems))
            {
              (fpP p "\n")
              (foEmitIndent o)
              (fpExpr p (vecGet elems i))
              (set i (+ i 1))
            })
          (foPopIndent o)
        })
      (fpP p ")")
    }
  })

; `region` prints like `while`: the name on the head line, the one
; body on its own indented line. Two elements after the head and
; nothing else is a `region` - the parser takes exactly one body
; (`self_host/parser.ax`'s `parseRegionExpr`), and a printer that
; accepted a third would print something `check` then refuses.
;
; This exists because the formatter is a SEPARATE grammar that never
; sees the parser's AST. Measured before it was written: a two-operand
; unknown head printed as the APPLICATION layout, `(region r\n  { ... })`
; hanging off the name - idempotent and re-checkable, and wrong for
; every `region` in the tree. `tests/fmt/parity/210-region-head-layout`
; holds the bytes.
(pub :: fpRegion (-> Int Int Int))
(pub fn (fpRegion p n)
  {
    (let elems (fpExprElems n 1))
    (if (!= (vecLen elems) 2)
      (fpBad p)
      {
        (let o (fpOut p))
        {
          (fpP p "(region ")
          (fpExpr p (vecGet elems 0))
          (fpP p "\n")
          (foPushIndent o)
          (foEmitIndent o)
          (fpBodyVec p elems 1)
          (foPopIndent o)
          (fpP p ")")
        }
      })
  })

; `parallel` prints as `let` does, with the region name on the head
; line: `(parallel p (` then the bindings, one per line when there are
; several, then `)` and the body indented under it. Three elements
; after the head at least - the name, the binding list, one body
; expression - and each binding exactly `(name expr)`: `mut` is refused
; here because the parser refuses it (`parseParBindings`), and a
; printer that accepted it would print something `check` then rejects.
; The formatter is a separate grammar and never sees the parser's AST,
; which is why this arm exists at all: without it a `parallel` printed
; as an application, which is idempotent and wrong.
; `tests/fmt/parity/200-parallel-layout` holds the bytes.
(pub :: fpParallel (-> Int Int Int))
(pub fn (fpParallel p n)
  (if (|| (< (fnLen n) 4) (|| (!= (fnKind (fnKid n 1)) FN_ATOM) (!= (fnKind (fnKid n 2)) FN_PAREN)))
    (fpBad p)
    {
      (let o (fpOut p))
      (let binds (fnKid n 2))
      (let body (fpExprElems n 3))
      (if (|| (== (fnLen binds) 0) (== (fpParBindingsOK (fpSrc p) binds 0) 0))
        (fpBad p)
        {
          (fpP p "(parallel ")
          (fpExpr p (fnKid n 1))
          (fpP p " (")
          (if (== (fnLen binds) 1)
            (fpLetBinding p (fnKid binds 0))
            {
              (let mut i 0)
              {
                (fpP p "\n")
                (foPushIndent o)
                (while (< i (fnLen binds))
                  {
                    (if (> i 0)
                      (fpP p "\n")
                      p)
                    (fpLetBindingBroken p (fnKid binds i))
                    (set i (+ i 1))
                  })
                (foPopIndent o)
                (fpP p "\n")
                (foEmitIndent o)
              }
            })
          (fpP p ")")
          (fpP p "\n")
          (foPushIndent o)
          (foEmitIndent o)
          (fpBodyVec p body 0)
          (foPopIndent o)
          (fpP p ")")
        })
    }))

; Every binding is `(name expr)`: a paren of exactly two elements whose
; first is an atom that is not `mut`.
(pub :: fpParBindingsOK (-> String Int Int Int))
(pub fn (fpParBindingsOK src binds i)
  (if (>= i (fnLen binds))
    1
    {
      (let b (fnKid binds i))
      (if (|| (!= (fnKind b) FN_PAREN)
            (|| (< (fnLen b) 2)
              (|| (!= (fnKind (fnKid b 0)) FN_ATOM)
                (|| (fpIsAtomText src (fnKid b 0) "mut") (!= (vecLen (fpExprElems b 1)) 1)))))
        0
        (fpParBindingsOK src binds (+ i 1)))
    }))

(pub :: fpSet (-> Int Int Int))
(pub fn (fpSet p n)
  {
    (let src (fpSrc p))
    (let vals (fpExprElems n 2))
    (if (|| (< (fnLen n) 3) (!= (vecLen vals) 1))
      (fpBad p)
      {
        (let target (fnKid n 1))
        {
          (let rootOk
            (if (== (fnKind target) FN_ATOM)
              (if (== (ftKind (fnTok target)) FT_IDENT)
                (if (isFOperChar (strByte src (fnStart target)))
                  false
                  true)
                false)
              (== (fnKind target) FN_FIELD)))
          (if rootOk
            {
              (fpP p "(set ")
              (fpExpr p target)
              (fpP p " ")
              (fpExprTail p (vecGet vals 0) 1)
              (fpP p ")")
            }
            (fpBad p))
        }
      })
  })

(pub :: fpMatch (-> Int Int Int))
(pub fn (fpMatch p n)
  {
    (let elems (fpExprElems n 1))
    (if (< (vecLen elems) 1)
      (fpBad p)
      {
        (let src (fpSrc p))
        (let o (fpOut p))
        (let mut i 1)
        {
          (fpP p "(match ")
          (fpExpr p (vecGet elems 0))
          (fpP p "\n")
          (foPushIndent o)
          (while (< i (vecLen elems))
            {
              (let arm (vecGet elems i))
              (if (|| (!= (fnKind arm) FN_PAREN) (< (fnLen arm) 2))
                {
                  (fpBad p)
                  (set i (vecLen elems))
                }
                ; The arm's pattern may occupy TWO kids - `C (h t)`
                ; fuses into a constructor pattern - and the body is
                ; whatever remains. A fusion that swallows the last
                ; kid leaves no body, which stage0 refuses.
                {
                  (let patEnd (fpPatWidth src (fnKidsVec arm) 0))
                  {
                    (let armBody (fpExprElems arm patEnd))
                    (if (== (vecLen armBody) 0)
                      {
                        (fpBad p)
                        (set i (vecLen elems))
                      }
                      {
                        (if (> i 1)
                          (fpP p "\n")
                          p)
                        (flushLeading src (fpQ p) o (fnStart arm))
                        (foEmitIndent o)
                        (fpP p "(")
                        (fpPatVecAt p (fnKidsVec arm) 0)
                        {
                          (let saved (fpSuffixWidth p))
                          {
                            (memSetWord p 4
                              (if (== i (- (vecLen elems) 1))
                                (+ saved 1)
                                0))
                            (fpTailBody p armBody 0)
                            (memSetWord p 4 saved)
                          }
                        }
                        (fpP p ")")
                        (set i (+ i 1))
                      })
                  }
                })
            })
          (foPopIndent o)
          (fpP p ")")
        }
      })
  })

(pub :: fpHandle (-> Int Int Int))
(pub fn (fpHandle p n)
  ; Exactly `body handler` or `body (effects) handler`: with three
  ; elements the middle must be the effect list (stage0 would have
  ; consumed a paren there as one), and with two the second must
  ; not be a paren the parser would have eaten as effects.
  {
    (let elems (fpExprElems n 1))
    {
      (let hasFx
        (if (== (vecLen elems) 3)
          (== (fnKind (vecGet elems 1)) FN_PAREN)
          false))
      (if (|| (< (vecLen elems) 2)
            (|| (> (vecLen elems) 3)
              (||
                (&& (== (vecLen elems) 3)
                  (if hasFx
                    false
                    true))
                (&& (== (vecLen elems) 2) (== (fnKind (vecGet elems 1)) FN_PAREN)))))
        (fpBad p)
        ; The head stands alone and every operand takes its own
        ; line: the body, the effect list, the handler. Short
        ; operands do not pack onto the head line.
        {
          (let o (fpOut p))
          {
            (fpP p "(handle\n")
            (foPushIndent o)
            (foEmitIndent o)
            (fpExpr p (vecGet elems 0))
            (fpP p "\n")
            (foEmitIndent o)
            (if hasFx
              {
                (fpP p "(")
                (fpEffectAtoms p (vecGet elems 1))
                (fpP p ")\n")
                (foEmitIndent o)
              }
              p)
            (fpExprTail p
              (vecGet elems
                (if hasFx
                  2
                  1))
              1)
            (foPopIndent o)
            (fpP p ")")
          }
        })
    }
  })

; Whether a paren form would parse as an application spine - the
; condition under which stage0's `format_app` splices it into its
; caller's spine. A keyword form, the unary-minus form, a singleton
; and the empty tuple all parse to non-`EApp` nodes and stay whole.
(pub :: fpIsAppForm (-> String Int Bool))
(pub fn (fpIsAppForm src n)
  (if (!= (fnKind n) FN_PAREN)
    false
    (if (< (fnLen n) 2)
      false
      {
        (let h (fnHeadText src n))
        (if (isKeywordHead h)
          false
          ; A refused head stays whole, so `((consume 1) 2)` reaches
          ; the refusal in `fpExpr` instead of being spliced past it
          ; into `(consume 1 2)`.
          (if (fpIsRefusedHead h)
            false
            {
              (let elems (fpExprElems n 0))
              (if (== (vecLen elems) 2)
                (if (fpIsMinusAtom (vecGet elems 0))
                  false
                  true)
                true)
            }))
      })))

; The application `elems` printed on one line, or "" when it can't be:
; an element breaks across lines, or the printer refused a shape. A
; comment inside the form keeps it broken, so the comment keeps its
; line. The trial prints into its own buffer with an empty comment
; queue, so it takes nothing from the real one.
; Whether a pending comment starts inside `[from, to)`. The queue is in
; source order, so the walk stops at the first comment past `to`; one
; pending BEFORE `from` belongs to an enclosing construct and says
; nothing about this one.
(pub :: fqAnyWithin (-> Int Int Int Bool))
(pub fn (fqAnyWithin q from to)
  {
    (let coms (fqComsVec q))
    (let mut i (fqNext q))
    (let mut found false)
    (let mut go true)
    {
      (while (&& go (< i (vecLen coms)))
        {
          (let c (fcStart (vecGet coms i)))
          (if (>= c to)
            (set go false)
            {
              (if (>= c from)
                {
                  (set found true)
                  (set go false)
                })
              (set i (+ i 1))
            })
        })
      found
    }
  })

(pub :: fpAppFlat (-> Int Int Ints String))
(pub fn (fpAppFlat p n elems)
  {
    (let q (fpQ p))
    (if (fqAnyWithin q (fnStart n) (fnEnd n))
      ""
      {
        (let o2 (mkFOut 0))
        {
          (let p2 (mkFPr (fpSrc p) (fpStarts p) (mkFCq (as vecNew Int)) o2))
          {
            (memSetWord o2 4 1)
            (fpP p2 "(")
            (fpExpr p2 (vecGet elems 0))
            {
              (let mut j 1)
              (while (< j (vecLen elems))
                {
                  (fpP p2 " ")
                  (fpExpr p2 (vecGet elems j))
                  (set j (+ j 1))
                })
            }
            (fpP p2 ")")
            (if (|| (!= (foBad o2) 0) (> (foNl o2) 0))
              ""
              (foFinish o2))
          }
        }
      })
  })

; A bounded trial for one argument. Comments stay with the original
; printer, and a multiline form keeps its own structural layout.
(pub :: fpExprFlat (-> Int Int String))
(pub fn (fpExprFlat p n)
  {
    (let out (mkFOut 0))
    {
      (let trial (mkFPr (fpSrc p) (fpStarts p) (mkFCq (as vecNew Int)) out))
      {
        (memSetWord out 4 1)
        (fpExpr trial n)
        (if (|| (!= (foBad out) 0) (> (foNl out) 0))
          ""
          (foFinish out))
      }
    }
  })

; Pack complete arguments up to the line width. A structural multiline
; argument starts a fresh row and the following argument starts another.
(pub :: fpAppPacked (-> Int Ints Int))
(pub fn (fpAppPacked p elems)
  {
    (let out (fpOut p))
    (let saved (foIndent (fpOut p)))
    (let column (foColumn (fpOut p)))
    (let startLine (foNl (fpOut p)))
    (let mut previousBroken false)
    (let mut i 1)
    {
      (fpP p "(")
      (fpExpr p (vecGet elems 0))
      (set previousBroken (> (foNl out) startLine))
      (foSetIndent out (+ column 2))
      (while (< i (vecLen elems))
        {
          (let arg (vecGet elems i))
          (let flat (fpExprFlat p (vecGet elems i)))
          (let suffix
            (if (== i (- (vecLen elems) 1))
              (fpSuffixWidth p)
              0))
          {
            (if (|| (== (strLen flat) 0)
                  (> (+ (+ (+ (foIndent out) (strLen flat)) 1) suffix) fmtWidth))
              {
                (fpP p "\n")
                (foEmitIndent out)
                (if (== i (- (vecLen elems) 1))
                  (fpExprTail p arg 1)
                  (fpExpr p arg))
                (set previousBroken true)
              }
              {
                (if (|| previousBroken
                      (> (+ (+ (+ (foColumn out) (strLen flat)) 2) suffix) fmtWidth))
                  {
                    (fpP p "\n")
                    (foEmitIndent out)
                  }
                  (fpP p " "))
                (fpP p flat)
                (set previousBroken false)
              })
            (set i (+ i 1))
          }
        })
      (foSetIndent out saved)
      (fpP p ")")
    }
  })

; A trailing comment belongs to this argument only when it follows the
; argument's complete source span and precedes the next argument. Line
; equality alone can steal a comment from inside a later argument.
(pub :: fpAppTrailing (-> Int Int Int Int Bool))
(pub fn (fpAppTrailing p arg before mark)
  {
    (let q (fpQ p))
    (if (fqPending q)
      {
        (let comment (fqHead q))
        (let next (fqNext q))
        (if (&& (>= (fcStart comment) (fnEnd arg)) (< (fcStart comment) before))
          {
            (flushTrailing (fpSrc p) q (fpOut p) (fpStartsVec p) (fpAnchor (fpSrc p) arg) mark)
            (!= (fqNext q) next)
          }
          false)
      }
      false)
  })

; Comments remain inside their call, beside the argument they describe.
(pub :: fpAppComments (-> Int Int Ints Int))
(pub fn (fpAppComments p n elems)
  {
    (let out (fpOut p))
    (let src (fpSrc p))
    (let saved (foIndent (fpOut p)))
    (let column (foColumn (fpOut p)))
    (let mut lastTrailing false)
    (let mut i 1)
    {
      (fpP p "(")
      (fpExpr p (vecGet elems 0))
      (foSetIndent out (+ column 2))
      (while (< i (vecLen elems))
        {
          (let arg (vecGet elems i))
          {
            (fpP p "\n")
            (flushLeading src (fpQ p) out (fpAnchor src arg))
            {
              (let mark (foNl out))
              {
                (foEmitIndent out)
                (if (== i (- (vecLen elems) 1))
                  (fpExprTail p arg 1)
                  (fpExpr p arg))
                (set lastTrailing (fpAppTrailing p arg
                                    (if (< (+ i 1) (vecLen elems))
                                      (fnStart (vecGet elems (+ i 1)))
                                      (fnEnd n))
                                    mark))
              }
            }
            (set i (+ i 1))
          }
        })
      (if (|| lastTrailing (fqAnyWithin (fpQ p) (fnStart n) (fnEnd n)))
        {
          (fpP p "\n")
          (flushLeading src (fpQ p) out (fnEnd n))
          (foSetIndent out saved)
          (foEmitIndent out)
        }
        (foSetIndent out saved))
      (fpP p ")")
    }
  })

; Named fields are complete label/value pairs. Keeping their source order
; preserves evaluation order even when it differs from declaration order.
(pub :: fpHasNamedFields (-> Int Bool))
(pub fn (fpHasNamedFields n)
  {
    (let mut found false)
    {
      (let mut i 1)
      {
        (while (< i (fnLen n))
          {
            (let child (fnKid n i))
            {
              (if (&& (== (fnKind child) FN_ATOM) (== (ftKind (fnTok child)) FT_COLON))
                (set found true))
              (set i (+ i 1))
            }
          })
        found
      }
    }
  })

(pub :: fpNamedFieldsValid (-> Ints Bool))
(pub fn (fpNamedFieldsValid elems)
  {
    (let mut valid (&& (>= (vecLen elems) 4) (== (% (- (vecLen elems) 1) 3) 0)))
    {
      (let mut i 1)
      {
        (while (&& valid (< i (vecLen elems)))
          {
            (let colon (vecGet elems i))
            {
              (if (|| (!= (fnKind colon) FN_ATOM)
                    (|| (!= (ftKind (fnTok colon)) FT_COLON)
                      (! (fpIsIdentAtom (vecGet elems (+ i 1))))))
                (set valid false))
              (set i (+ i 3))
            }
          })
        valid
      }
    }
  })

(pub :: fpNamedInline (-> Int Ints Int))
(pub fn (fpNamedInline p elems)
  {
    (fpP p "(")
    (fpExpr p (vecGet elems 0))
    {
      (let mut i 1)
      {
        (while (< i (vecLen elems))
          {
            (fpP p " :")
            (fpP p (fnText (fpSrc p) (vecGet elems (+ i 1))))
            (fpP p " ")
            (fpExpr p (vecGet elems (+ i 2)))
            (set i (+ i 3))
          })
        (fpP p ")")
      }
    }
  })

(pub :: fpNamedFlat (-> Int Int Ints String))
(pub fn (fpNamedFlat p n elems)
  (if (fqAnyWithin (fpQ p) (fnStart n) (fnEnd n))
    ""
    {
      (let out (mkFOut 0))
      {
        (let trial (mkFPr (fpSrc p) (fpStarts p) (mkFCq (as vecNew Int)) out))
        {
          (memSetWord out 4 1)
          (fpNamedInline trial elems)
          (if (|| (!= (foBad out) 0) (> (foNl out) 0))
            ""
            (foFinish out))
        }
      }
    }))

(pub :: fpNamedBroken (-> Int Int Ints Int))
(pub fn (fpNamedBroken p n elems)
  {
    (let out (fpOut p))
    {
      (let src (fpSrc p))
      {
        (let saved (foIndent out))
        {
          (let column (foColumn out))
          {
            (let mut trailing false)
            {
              (fpP p "(")
              (fpExpr p (vecGet elems 0))
              (foSetIndent out (+ column 2))
              {
                (let mut i 1)
                {
                  (while (< i (vecLen elems))
                    {
                      (let colon (vecGet elems i))
                      {
                        (let name (vecGet elems (+ i 1)))
                        {
                          (let value (vecGet elems (+ i 2)))
                          {
                            (let flat (fpExprFlat p value))
                            {
                              (fpP p "\n")
                              (flushLeading src (fpQ p) out (fnStart colon))
                              (foEmitIndent out)
                              {
                                (let mark (foNl out))
                                {
                                  (fpP p ":")
                                  (fpP p (fnText src name))
                                  (if (&& (> (strLen flat) 0)
                                        (&&
                                          (! (fqAnyWithin (fpQ p) (fnStart colon) (fnStart value)))
                                          (<=
                                            (+ (+ (+ (foColumn out) 1) (strLen flat))
                                              (+ 1 (fpSuffixWidth p)))
                                            fmtWidth)))
                                    {
                                      (fpP p " ")
                                      (fpExprSuffix p value 1)
                                    }
                                    {
                                      (fpP p "\n")
                                      (foPushIndent out)
                                      (flushLeading src (fpQ p) out (fpAnchor src value))
                                      (foEmitIndent out)
                                      (fpExprSuffix p value 1)
                                      (foPopIndent out)
                                    })
                                  (set trailing (fpAppTrailing p value
                                                  (if (< (+ i 3) (vecLen elems))
                                                    (fnStart (vecGet elems (+ i 3)))
                                                    (fnEnd n))
                                                  mark))
                                  (set i (+ i 3))
                                }
                              }
                            }
                          }
                        }
                      }
                    })
                  (if (|| trailing (fqAnyWithin (fpQ p) (fnStart n) (fnEnd n)))
                    {
                      (fpP p "\n")
                      (flushLeading src (fpQ p) out (fnEnd n))
                      (foSetIndent out saved)
                      (foEmitIndent out)
                    }
                    (foSetIndent out saved))
                  (fpP p ")")
                }
              }
            }
          }
        }
      }
    }
  })

(pub :: fpNamedConstruction (-> Int Int Int))
(pub fn (fpNamedConstruction p n)
  {
    (let elems (fpExprElems n 0))
    {
      (let out (fpOut p))
      (if (! (fpNamedFieldsValid elems))
        (fpBad p)
        (if (== (foTrial out) 1)
          (fpNamedInline p elems)
          {
            (let flat (fpNamedFlat p n elems))
            (if (&& (> (strLen flat) 0)
                  (<= (+ (+ (foColumn out) (strLen flat)) (fpSuffixWidth p)) fmtWidth))
              (fpP p flat)
              (fpNamedBroken p n elems))
          }))
    }
  })

(pub :: fpApp (-> Int Int Int))
(pub fn (fpApp p n)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let mut elems (fpExprElems n 0))
    (if (&& (== (vecLen elems) 2) (fpIsMinusAtom (vecGet elems 0)))
      ; Literal negation prints with its sign; other operands keep unary form.
      {
        (let arg (vecGet elems 1))
        (if (&& (== (fnKind arg) FN_ATOM) (== (ftKind (fnTok arg)) FT_INT))
          {
            (fpP p "-")
            (fpInt p (fnStart arg) (fnEnd arg))
          }
          (if (&& (== (fnKind arg) FN_ATOM) (== (ftKind (fnTok arg)) FT_FLOAT))
            {
              (fpP p "-")
              (fpFloat p (fnStart arg) (fnEnd arg))
            }
            ; Adding an integer zero would change the type of Float negation.
            {
              (fpP p "(- ")
              (fpExprTail p arg 1)
              (fpP p ")")
            }))
      }
      ; The parser flattens application spines without reordering arguments.
      {
        {
          (let mut go 1)
          (while (== go 1)
            {
              (let h (vecGet elems 0))
              (if (&& (== (fnKind h) FN_PAREN) (== (fnLen h) 1))
                (vecSet elems 0 (fnKid h 0))
                (if (fpIsAppForm src h)
                  {
                    (let hElems (fpExprElems h 0))
                    (let merged vecNew)
                    (let mut j 1)
                    {
                      {
                        (let mut k 0)
                        (while (< k (vecLen hElems))
                          {
                            (vecPush merged (vecGet hElems k))
                            (set k (+ k 1))
                          })
                      }
                      (while (< j (vecLen elems))
                        {
                          (vecPush merged (vecGet elems j))
                          (set j (+ j 1))
                        })
                      (set elems merged)
                    }
                  }
                  (set go 0)))
            })
        }
        ; Parentheses preserve a nullary call around a bare name.
        ; Other singleton expression groups unwrap as the parser does.
        (if (== (vecLen elems) 1)
          (if (fpIsIdentAtom (vecGet elems 0))
            {
              (fpP p "(")
              (fpExpr p (vecGet elems 0))
              (fpP p ")")
            }
            (fpExprTail p (vecGet elems 0) 0))
          ; Keep a call whole when it fits. Longer calls pack complete
          ; arguments into rows; structural arguments keep their layout.
          {
            (let flat
              (if (== (foTrial o) 1)
                ""
                (fpAppFlat p n elems)))
            (if (&& (> (strLen flat) 0)
                  (<= (+ (+ (foColumn o) (strLen flat)) (fpSuffixWidth p)) fmtWidth))
              (fpP p flat)
              (if (== (foTrial o) 1)
                {
                  (let mut i 1)
                  {
                    (fpP p "(")
                    (fpExpr p (vecGet elems 0))
                    (while (< i (vecLen elems))
                      {
                        (fpP p " ")
                        (fpExpr p (vecGet elems i))
                        (set i (+ i 1))
                      })
                    (fpP p ")")
                  }
                }
                (if (fqAnyWithin (fpQ p) (fnStart n) (fnEnd n))
                  (fpAppComments p n elems)
                  (fpAppPacked p elems))))
          })
      })
  })

(pub :: fpExpr (-> Int Int Int))
; A failed width trial stops descending immediately. Trial applications
; print directly, so asking whether a nested call fits never starts
; another speculative layout of that call.
(pub fn (fpExpr p n)
  (if (&& (== (foTrial (fpOut p)) 1) (!= (foBad (fpOut p)) 0))
    0
    (fpExprSuffix p n 0)))

; Signed literals occupy two reader nodes and one expression. Both
; conversions and ascriptions use the same canonical expression list.
(pub :: fpTypedExpr (-> Int Int String Int))
(pub fn (fpTypedExpr p n head)
  {
    (let elems (fpExprElems n 1))
    (if (!= (vecLen elems) 2)
      (fpBad p)
      {
        (fpP p "(")
        (fpP p head)
        (fpP p " ")
        {
          (let width (fpTypeWidth p (vecGet elems 1)))
          (if (> width 0)
            (fpExprTail p (vecGet elems 0) (+ 2 width))
            (fpExpr p (vecGet elems 0)))
        }
        (fpTypeAfter p (vecGet elems 1) (+ 1 (fpSuffixWidth p)))
        (fpP p ")")
      })
  })

(pub :: fpExprLive (-> Int Int Int))
(pub fn (fpExprLive p n)
  {
    (let k (fnKind n))
    (let src (fpSrc p))
    (if (== k FN_ATOM)
      {
        (let tk (ftKind (fnTok n)))
        (if (== tk FT_IDENT)
          {
            (let t (fnText src n))
            (if (isFOperChar (strByte src (fnStart n)))
              ; Any other operator run is a name to this compiler's
              ; parser, so it prints as itself. `check` resolves it
              ; like any name, and a macro template, which `check`
              ; doesn't resolve until it expands, may hold one.
              {
                (let s (fpOperSpelling t))
                (if (== (strLen s) 0)
                  (fpP p t)
                  (fpP p s))
              }
              ; A bare name prints as itself whatever it spells:
              ; `data`, `match` and `where` are identifiers here, not
              ; keywords - see `fpIsRefusedHead`, and the parity
              ; cases beside 070-keyword-in-expr.
              (fpP p t))
          }
          (if (== tk FT_INT)
            (fpInt p (fnStart n) (fnEnd n))
            (if (== tk FT_FLOAT)
              (fpFloat p (fnStart n) (fnEnd n))
              (if (== tk FT_STR)
                (fpStrLit p (fnTok n))
                (if (== tk FT_CHAR)
                  (fpCharLit p (fnTok n))
                  (if (== tk FT_MINUS)
                    (fpP p "-")
                    (fpBad p)))))))
      }
      (if (== k FN_FIELD)
        {
          (let base (fnKid n 0))
          {
            (let baseOk
              (if (== (fnKind base) FN_ATOM)
                (== (ftKind (fnTok base)) FT_IDENT)
                (== (fnKind base) FN_FIELD)))
            (if baseOk
              {
                (fpExpr p base)
                (fpP p ".")
                (fpP p (fnText src (fnKid n 1)))
              }
              (fpBad p))
          }
        }
        (if (== k FN_TRY)
          {
            (fpExprTail p (fnKid n 0) 1)
            (fpP p "?")
          }
          (if (== k FN_QUAL)
            {
              (fpQualLeft p (fnKid n 0))
              (fpP p "::")
              (fpP p (fnText src (fnKid n 1)))
            }
            (if (== k FN_PREFIX)
              ; All four prefix markers are refused: stage0 refuses each
              ; in every position - the backtick with AX1001, `'`, `,`
              ; and `,@` with AX2001 - so printing any of them would
              ; accept a program stage0 refuses (MAC-TOOL-6). `,@` was
              ; the first, refused here since the self-hosted printer
              ; was written (probed, `,@c` is "expected expression,
              ; found `@`"); the backtick and the bare comma reached
              ; the printer the same way until 2026-09-18, and the
              ; quote reached it before a paren (`'(f x)` formatted
              ; while `'x` refused only by the fixed-point accident of
              ; rescanning as a char literal). `tests/fmt/parity/230`,
              ; `231` and `232` pin one refusal each.
              (fpBad p)
              (if (== k FN_BRACK)
                (if (== (fnLen n) 0)
                  (fpP p "[]")
                  {
                    (let elems (fpExprElems n 0))
                    (let o (fpOut p))
                    (if (allSimple src n 0)
                      {
                        (let mut i 0)
                        {
                          (fpP p "[")
                          (while (< i (vecLen elems))
                            {
                              (if (> i 0)
                                (fpP p " ")
                                p)
                              (if (== i (- (vecLen elems) 1))
                                (fpExprTail p (vecGet elems i) 1)
                                (fpExpr p (vecGet elems i)))
                              (set i (+ i 1))
                            })
                          (fpP p "]")
                        }
                      }
                      {
                        (let mut i 0)
                        {
                          (fpP p "[\n")
                          (foPushIndent o)
                          (while (< i (vecLen elems))
                            {
                              (foEmitIndent o)
                              (fpExpr p (vecGet elems i))
                              (set i (+ i 1))
                            })
                          (foPopIndent o)
                          (fpP p "\n")
                          (foEmitIndent o)
                          (fpP p "]")
                        }
                      })
                  })
                (if (== k FN_BRACE)
                  (if (== (fnLen n) 0)
                    ; The parser refuses an empty block, so the formatter must
                    ; too - it wrote `{}` back out and reported OK on a file the
                    ; compiler cannot compile. Refusal parity is the contract
                    ; the `.axp` bank pins.
                    (fpBad p)
                    (if (&& (== (fnLen n) 1) (! (fpIsLocalLet src (fnKid n 0))))
                      (fpExprTail p (fnKid n 0) 0)
                      (fpBeginVec p (fpExprElems n 0) 0)))
                  ; FN_PAREN.
                  (if (== (fnLen n) 0)
                    ; `()`, the unit value.
                    (fpP p "()")
                    {
                      (let h (fnHeadText src n))
                      (if (strEq h "lambda")
                        (fpLambda p n)
                        (if (strEq h "let")
                          (fpBad p)
                          (if (strEq h "if")
                            (fpIf p n)
                            (if (|| (strEq h "while") (strEq h "region"))
                              (if (strEq h "region")
                                (fpRegion p n)
                                (fpWhile p n))
                              (if (|| (strEq h "for") (strEq h "asm"))
                                (if (strEq h "for")
                                  (fpFor p n)
                                  (fpAsm p n))
                                (if (strEq h "parallel")
                                  (fpParallel p n)
                                  (if (strEq h "set")
                                    (fpSet p n)
                                    ; `cond` is AX2004: no arm prints one.
                                    ; A `(cond ...)` reaches `fpIsRefusedHead`
                                    ; below, like `consume` and `begin`.
                                    (if (strEq h "match")
                                      (fpMatch p n)
                                      (if (strEq h "handle")
                                        (fpHandle p n)
                                        ; `consume`, `begin` and now `cond` are the
                                        ; identifier heads `parseInner` refuses by
                                        ; name (AX2004), so the printer refuses
                                        ; them with it. It used to print
                                        ; `(consume e)` and `(begin e)` - output
                                        ; `check` cannot read, which is the one thing
                                        ; `fmt` may never emit.
                                        (if (fpIsRefusedHead h)
                                          (fpBad p)
                                          (if (strEq h "sizeof")
                                            (if (== (fnLen n) 2)
                                              {
                                                (fpP p "(sizeof")
                                                (fpTypeAfter p (fnKid n 1) (+ 1 (fpSuffixWidth p)))
                                                (fpP p ")")
                                              }
                                              (fpBad p))
                                            (if (strEq h "alignof")
                                              (if (== (fnLen n) 2)
                                                {
                                                  (fpP p "(alignof")
                                                  (fpTypeAfter p (fnKid n 1)
                                                    (+ 1 (fpSuffixWidth p)))
                                                  (fpP p ")")
                                                }
                                                (fpBad p))
                                              (if (strEq h "as")
                                                (fpTypedExpr p n "as")
                                                (if (strEq h "::")
                                                  (fpTypedExpr p n "::")
                                                  ; Any other identifier head is an
                                                  ; application, as `parseInner` falls
                                                  ; through to `parseAppForm`: `(data 1)`
                                                  ; calls whatever `data` is bound to,
                                                  ; and the checker says what that is.
                                                  (if (fpHasNamedFields n)
                                                    (fpNamedConstruction p n)
                                                    (fpApp p n))))))))))))))))
                    }))))))))
  })

; ------------------------------------------------------------------
; Anchors: `Expr::span()` as a byte offset.
;
; Comment placement keys on the span stage0's AST carries for each
; expression, and that span recurses to a LEAF: a `let`'s span is its
; body's, an `if`'s is its condition's, a `cast`'s is its inner
; expression's, an application's is its head's. This is the same
; recursion over the form tree.
; ------------------------------------------------------------------
; ------------------------------------------------------------------
; Negative-literal fusion.
;
; The reader keeps `-` and `5` as two atoms (the scan test pins that),
; but the parser reads an adjacent pair as one literal, in expression
; position - `(+ x -5)` is two arguments - and in a pattern: the arm
; `(-5 1)` and the constructor pattern `(Some -5)` test for minus
; five (`fpPatWidth`). The printer fuses them where the parser would.
; Types refuse a bare `-`.
; ------------------------------------------------------------------
(pub :: fpIsMinusAtom (-> Int Bool))
(pub fn (fpIsMinusAtom n)
  (if (== (fnKind n) FN_ATOM)
    (== (ftKind (fnTok n)) FT_MINUS)
    false))

(pub :: fpFusesWith (-> Int Int Bool))
(pub fn (fpFusesWith m d)
  (if (== (fnKind d) FN_ATOM)
    (if (|| (== (ftKind (fnTok d)) FT_INT) (== (ftKind (fnTok d)) FT_FLOAT))
      (== (fnEnd m) (fnStart d))
      false)
    false))

; One atom spanning a minus and the number it fuses with, of the
; number's kind. A null kid list is how this file spells an atom's.
(pub :: fpFusedAtom (-> Int Int Int))
;@axiom:effect(unsafe)
(pub fn (fpFusedAtom m d)
  (mkFNode FN_ATOM (mkFTok (ftKind (fnTok d)) (fnStart m) (fnEnd d)) (as 0 (Vec Int)) (fnStart m)
    (fnEnd d)))

; The expression elements of `n` from index `from`, with adjacent
; minus+number pairs fused into synthetic literal atoms.
(pub :: fpExprElems (-> Int Int Ints))
;@axiom:effect(unsafe)
(pub fn (fpExprElems n from)
  {
    (let v vecNew)
    (let mut i from)
    {
      (while (< i (fnLen n))
        {
          (let kid (fnKid n i))
          (if (&& (fpIsMinusAtom kid)
                (if (< (+ i 1) (fnLen n))
                  (fpFusesWith kid (fnKid n (+ i 1)))
                  false))
            {
              (let d (fnKid n (+ i 1)))
              {
                (vecPush v
                  (mkFNode FN_ATOM (mkFTok (ftKind (fnTok d)) (fnStart kid) (fnEnd d))
                    (as 0 (Vec Int)) (fnStart kid) (fnEnd d)))
                (set i (+ i 2))
              }
            }
            {
              (vecPush v kid)
              (set i (+ i 1))
            })
        })
      v
    }
  })

; ------------------------------------------------------------------
; Width-aware lists.
; ------------------------------------------------------------------
; Typed lists share the call layout: keep complete items on a row,
; reserve the enclosing suffix and place comments by source ownership.
; Modes: 0 type, 1 pattern, 2 name, 3 pattern field, 4 type field.
(pub :: fpListItem (-> Int Int Int Int))
(pub fn (fpListItem p n mode)
  (if (== mode 0)
    (fpType p n)
    (if (== mode 1)
      (fpPat p n)
      (if (|| (== mode 3) (== mode 4))
        (fpFieldItem p n mode)
        (if (fpIsIdentAtom n)
          (fpP p (fnText (fpSrc p) n))
          (fpBad p))))))

(pub :: fpListItemSuffix (-> Int Int Int Int Int))
(pub fn (fpListItemSuffix p n mode width)
  {
    (let saved (fpSuffixWidth p))
    {
      (memSetWord p 4 width)
      (fpListItem p n mode)
      (memSetWord p 4 saved)
      p
    }
  })

; A comma belongs to its field, before any trailing comment.
(pub :: fpListItemEnd (-> Int Int Int Int Int Int))
(pub fn (fpListItemEnd p n mode suffix comma)
  {
    (fpListItemSuffix p n mode (+ suffix comma))
    (if (== comma 1)
      (fpP p ","))
    p
  })

(pub :: fpListItemFlat (-> Int Int Int String))
(pub fn (fpListItemFlat p n mode)
  {
    (let out (mkFOut 0))
    {
      (let trial (mkFPr (fpSrc p) (fpStarts p) (mkFCq (as vecNew Int)) out))
      {
        (memSetWord out 4 1)
        (fpListItem trial n mode)
        (if (|| (!= (foBad out) 0) (> (foNl out) 0))
          ""
          (foFinish out))
      }
    }
  })

(pub :: fpListTrial (-> Int Ints Int String String Int))
(pub fn (fpListTrial p elems mode open close)
  {
    (let mut i 0)
    {
      (fpP p open)
      (while (&& (< i (vecLen elems)) (== (foBad (fpOut p)) 0))
        {
          (if (> i 0)
            (fpP p " "))
          (fpListItemEnd p (vecGet elems i) mode 0
            (if (&& (>= mode 3) (< (+ i 1) (vecLen elems)))
              1
              0))
          (set i (+ i 1))
        })
      (fpP p close)
    }
  })

(pub :: fpListFlat (-> Int Int Ints Int String String String))
(pub fn (fpListFlat p n elems mode open close)
  (if (fqAnyWithin (fpQ p) (fnStart n) (fnEnd n))
    ""
    {
      (let out (mkFOut 0))
      {
        (let trial (mkFPr (fpSrc p) (fpStarts p) (mkFCq (as vecNew Int)) out))
        {
          (memSetWord out 4 1)
          (fpListTrial trial elems mode open close)
          (if (|| (!= (foBad out) 0) (> (foNl out) 0))
            ""
            (foFinish out))
        }
      }
    }))

(pub :: fpList (-> Int Int Ints Int String String Int))
(pub fn (fpList p n elems mode open close)
  (if (== (foTrial (fpOut p)) 1)
    (fpListTrial p elems mode open close)
    {
      (let flat (fpListFlat p n elems mode open close))
      (if (&& (> (strLen flat) 0)
            (<= (+ (+ (foColumn (fpOut p)) (strLen flat)) (fpSuffixWidth p)) fmtWidth))
        (fpP p flat)
        (fpListRows p n elems mode open close))
    }))

(pub :: fpListRows (-> Int Int Ints Int String String Int))
(pub fn (fpListRows p n elems mode open close)
  {
    (let out (fpOut p))
    (let src (fpSrc p))
    (let saved (foIndent (fpOut p)))
    (let column (foColumn (fpOut p)))
    (let comments (fqAnyWithin (fpQ p) (fnStart n) (fnEnd n)))
    (let mut previousBroken false)
    (let mut lastTrailing false)
    (let mut i 0)
    {
      (fpP p open)
      (foSetIndent out (+ column 2))
      (while (< i (vecLen elems))
        {
          (let item (vecGet elems i))
          (let comma
            (if (&& (>= mode 3) (< (+ i 1) (vecLen elems)))
              1
              0))
          (let suffix
            (if (== i (- (vecLen elems) 1))
              (+ (strLen close) (fpSuffixWidth p))
              0))
          (let rowSuffix
            (if (== i (- (vecLen elems) 1))
              (+ (strLen close) (fpSuffixWidth p))
              (strLen close)))
          {
            (if comments
              {
                (if (|| (> i 0) (fqAnyWithin (fpQ p) (fnStart n) (fnStart item)))
                  {
                    (fpP p "\n")
                    (flushLeading src (fpQ p) out (fnStart item))
                    (foEmitIndent out)
                  })
                {
                  (let mark (foNl out))
                  {
                    (fpListItemEnd p item mode suffix comma)
                    (set lastTrailing (fpAppTrailing p item
                                        (if (< (+ i 1) (vecLen elems))
                                          (fnStart (vecGet elems (+ i 1)))
                                          (fnEnd n))
                                        mark))
                  }
                }
              }
              (if (== i 0)
                {
                  (let mark (foNl out))
                  {
                    (fpListItemEnd p item mode suffix comma)
                    (set previousBroken (> (foNl out) mark))
                  }
                }
                {
                  (let flat (fpListItemFlat p item mode))
                  (if (|| (== (strLen flat) 0)
                        (> (+ (+ (foIndent out) (strLen flat)) (+ rowSuffix comma)) fmtWidth))
                    {
                      (fpP p "\n")
                      (foEmitIndent out)
                      (fpListItemEnd p item mode suffix comma)
                      (set previousBroken true)
                    }
                    {
                      (if (|| previousBroken
                            (> (+ (+ (+ (foColumn out) 1) (strLen flat)) (+ rowSuffix comma))
                              fmtWidth))
                        {
                          (fpP p "\n")
                          (foEmitIndent out)
                        }
                        (fpP p " "))
                      (fpP p flat)
                      (if (== comma 1)
                        (fpP p ","))
                      (set previousBroken false)
                    })
                }))
            (set i (+ i 1))
          }
        })
      (if (|| lastTrailing (fqAnyWithin (fpQ p) (fnStart n) (fnEnd n)))
        {
          (fpP p "\n")
          (flushLeading src (fpQ p) out (fnEnd n))
          (foSetIndent out saved)
          (foEmitIndent out)
        }
        (foSetIndent out saved))
      (fpP p close)
    }
  })

; A declaration places a type beside its name when it fits, otherwise
; on a fresh indented line. Trial text is canonical, without comments.
(pub :: fpTypeAfter (-> Int Int Int Int))
(pub fn (fpTypeAfter p n suffix)
  {
    (let flat (fpListItemFlat p n 0))
    (if (&& (> (strLen flat) 0)
          (&& (! (fqAnyWithin (fpQ p) 0 (fnEnd n)))
            (<= (+ (+ (+ (foColumn (fpOut p)) 1) (strLen flat)) suffix) fmtWidth)))
      {
        (fpP p " ")
        (fpP p flat)
      }
      {
        (let out (fpOut p))
        {
          (fpP p "\n")
          (foPushIndent out)
          (flushLeading (fpSrc p) (fpQ p) out (fnStart n))
          (foEmitIndent out)
          (fpListItemSuffix p n 0 suffix)
          (foPopIndent out)
        }
      })
  })

; ------------------------------------------------------------------
; Types.
;
; Tuple and application types share the same `(head rest...)` layout.
; An arrow flattens its right spine: `(-> a (-> b c))` becomes
; `(-> a b c)`. An arrow used as an argument keeps its parentheses.
; ------------------------------------------------------------------
(pub :: fpTypeUnwrap (-> Int Int))
(pub fn (fpTypeUnwrap n)
  (if (&& (== (fnKind n) FN_PAREN) (== (fnLen n) 1))
    (fpTypeUnwrap (fnKid n 0))
    n))

(pub :: fpArrow (-> Int Int Int))
(pub fn (fpArrow p n)
  (if (< (fnLen n) 3)
    (fpBad p)
    {
      (let elems vecNew)
      (let mut i 1)
      (let mut go 1)
      {
        (while (< i (fnLen n))
          {
            (vecPush elems (fnKid n i))
            (set i (+ i 1))
          })
        ; Splice a trailing arrow group, repeatedly: the parser
        ; right-associates, and the printer flattens the right spine.
        (while (== go 1)
          {
            (let last (fpTypeUnwrap (vecGet elems (- (vecLen elems) 1))))
            (if (&& (== (fnKind last) FN_PAREN)
                  (&& (> (fnLen last) 0) (strEq (fnHeadText (fpSrc p) last) "->")))
              (if (< (fnLen last) 3)
                {
                  (fpBad p)
                  (set go 0)
                }
                {
                  (let mut j 1)
                  {
                    (vecSet elems (- (vecLen elems) 1) (fnKid last 1))
                    (set j 2)
                    (while (< j (fnLen last))
                      {
                        (vecPush elems (fnKid last j))
                        (set j (+ j 1))
                      })
                  }
                })
              (set go 0))
          })
        {
          (let all (vecPush vecNew (fnKid n 0)))
          (let mut k 0)
          {
            (while (< k (vecLen elems))
              {
                (vecPush all (vecGet elems k))
                (set k (+ k 1))
              })
            (fpList p n all 0 "(" ")")
          }
        }
      }
    }))

(pub :: fpType (-> Int Int Int))
(pub fn (fpType p n)
  (if (&& (== (foTrial (fpOut p)) 1) (!= (foBad (fpOut p)) 0))
    p
    (fpTypeLive p n)))

(pub :: fpTypeLive (-> Int Int Int))
(pub fn (fpTypeLive p n)
  {
    (let k (fnKind n))
    (if (== k FN_ATOM)
      (if (== (ftKind (fnTok n)) FT_IDENT)
        (fpP p (fnText (fpSrc p) n))
        (fpBad p))
      (if (== k FN_BRACK)
        (if (== (fnLen n) 1)
          {
            (fpP p "[")
            (fpListItemSuffix p (fnKid n 0) 0 (+ 1 (fpSuffixWidth p)))
            (fpP p "]")
          }
          (fpBad p))
        (if (== k FN_PAREN)
          (if (== (fnLen n) 0)
            (fpP p "()")
            {
              (let h (fnHeadText (fpSrc p) n))
              (if (strEq h "->")
                (fpArrow p n)
                (if (strEq h "*")
                  (if (== (fnLen n) 2)
                    (fpList p n (fnKidsVec n) 0 "(" ")")
                    (fpBad p))
                  (if (strEq h "linear")
                    (if (== (fnLen n) 2)
                      (fpList p n (fnKidsVec n) 0 "(" ")")
                      (fpBad p))
                    (if (== (fnLen n) 1)
                      (fpType p (fnKid n 0))
                      (fpList p n (fnKidsVec n) 0 "(" ")")))))
            })
          ; `Mod::Name`, and `Mod.Sub::Name`, where a type stands: the
          ; reader builds the same FN_QUAL chain expressions build, so
          ; the printer answers the same way - the module path on the
          ; left, `::`, the name. Without this arm a file using the
          ; spelling was refused outright, though every other tool
          ; already read it.
          (if (== k FN_QUAL)
            {
              (fpQualLeft p (fnKid n 0))
              (fpP p "::")
              (fpP p (fnText (fpSrc p) (fnKid n 1)))
            }
            (fpBad p)))))
  })

; ------------------------------------------------------------------
; Patterns.
; ------------------------------------------------------------------
; Expand `,`-prefix nodes back into their inner forms. Inside braces
; the scan reads `, h` as an unquote prefix - context it cannot have -
; so the field walkers flatten the node and treat the comma as the
; separator it was.
(pub :: fpPushExpanded (-> Ints Int Ints))
(pub fn (fpPushExpanded v kid)
  (if (&& (== (fnKind kid) FN_PREFIX) (== (ftKind (fnTok kid)) FT_COMMA))
    (fpPushExpanded v (fnKid kid 0))
    (vecPush v kid)))

(pub :: fpFlattenCommas (-> Int Ints))
(pub fn (fpFlattenCommas n)
  {
    (let v vecNew)
    (let mut i 0)
    {
      (while (< i (fnLen n))
        {
          (fpPushExpanded v (fnKid n i))
          (set i (+ i 1))
        })
      v
    }
  })

(pub :: fpIsUpperIdent (-> String Int Bool))
(pub fn (fpIsUpperIdent src n)
  (if (== (fnKind n) FN_ATOM)
    (if (== (ftKind (fnTok n)) FT_IDENT)
      {
        (let b (strByte src (fnStart n)))
        (if (>= b 65)
          (<= b 90)
          false)
      }
      false)
    false))

(pub :: fpIsAtomText (-> String Int String Bool))
(pub fn (fpIsAtomText src n t)
  (if (== (fnKind n) FN_ATOM)
    (strEq (fnText src n) t)
    false))

; How many kids one pattern occupies at position `i` of vec `v`: two
; when a bare uppercase ident is followed by a paren group - stage0's
; `parse_pattern` fuses `C (h t)` into the constructor pattern
; `(C h t)` in every pattern position - and two for a negative literal,
; `-` against its digits, which the lexer reads as one token. One
; otherwise.
;
; The negative literal was refused until 2026-09-29, though `check`
; accepted it and the program ran: the fuzzer's P4 turned `(2 7)` in
; `tests/selfhost/380-literal-patterns.ax` into `(-00 7)`, and `fmt`
; refused with no code. `tests/selfhost/1013-negative-literal-pattern.ax`
; holds both spellings.
(pub :: fpPatWidth (-> String Ints Int Int))
(pub fn (fpPatWidth src v i)
  (if (||
        (&& (fpIsUpperIdent src (vecGet v i))
          (if (< (+ i 1) (vecLen v))
            (== (fnKind (vecGet v (+ i 1))) FN_PAREN)
            false))
        (&& (fpIsMinusAtom (vecGet v i))
          (if (< (+ i 1) (vecLen v))
            (fpFusesWith (vecGet v i) (vecGet v (+ i 1)))
            false)))
    2
    1))

; The number of patterns a fused walk reads from `v` starting at
; `from` - the count stage0's pattern loops see.
(pub :: fpPatVecCount (-> String Ints Int Int))
(pub fn (fpPatVecCount src v from)
  {
    (let mut i from)
    (let mut n 0)
    {
      (while (< i (vecLen v))
        {
          (set i (+ i (fpPatWidth src v i)))
          (set n (+ n 1))
        })
      n
    }
  })

; Canonicalise the parser's two-token pattern spellings before layout.
; The synthetic group retains the complete original source span.
(pub :: fpPatItem (-> Int Ints Int Int))
(pub fn (fpPatItem p v i)
  (if (== (fpPatWidth (fpSrc p) v i) 1)
    (vecGet v i)
    (if (fpIsMinusAtom (vecGet v i))
      (fpFusedAtom (vecGet v i) (vecGet v (+ i 1)))
      {
        (let group (vecGet v (+ i 1)))
        (let kids (vecPush vecNew (vecGet v i)))
        (let mut j 0)
        {
          (while (< j (fnLen group))
            {
              (vecPush kids (fnKid group j))
              (set j (+ j 1))
            })
          (mkFNode FN_PAREN (fnTok group) kids (fnStart (vecGet v i)) (fnEnd group))
        }
      })))

(pub :: fpPatItems (-> Int Ints Int Ints))
(pub fn (fpPatItems p v from)
  {
    (let items vecNew)
    (let mut i from)
    {
      (while (< i (vecLen v))
        {
          (vecPush items (fpPatItem p v i))
          (set i (+ i (fpPatWidth (fpSrc p) v i)))
        })
      items
    }
  })

; A function or constructor name is the head, rather than a pattern
; that can fuse with the following parameter.
(pub :: fpHeadPatItems (-> Int Int Ints))
(pub fn (fpHeadPatItems p n)
  {
    (let items (vecPush vecNew (fnKid n 0)))
    (let args (fpPatItems p (fnKidsVec n) 1))
    (let mut i 0)
    {
      (while (< i (vecLen args))
        {
          (vecPush items (vecGet args i))
          (set i (+ i 1))
        })
      items
    }
  })

; Print one pattern starting at `v[i]`, answering the index past it.
(pub :: fpPatVecAt (-> Int Ints Int Int))
(pub fn (fpPatVecAt p v i)
  {
    (fpPat p (fpPatItem p v i))
    (+ i (fpPatWidth (fpSrc p) v i))
  })

; A named-field pattern group's fields: `(Name { w = p, h })`.
(pub :: fpPatNamed (-> Int Int Int Int))
(pub fn (fpPatNamed p name brace)
  (fpList p brace (fpNamedFields p brace 1) 3 (concat (concat "(" (fnText (fpSrc p) name)) " {")
    "})"))

; Canonical field nodes keep their name and complete pattern span.
(pub :: fpNamedFields (-> Int Int Int Ints))
(pub fn (fpNamedFields p brace mode)
  {
    (let flat (fpFlattenCommas brace))
    (let items vecNew)
    (let mut i 0)
    {
      (while (< i (vecLen flat))
        {
          (let name (vecGet flat i))
          (if (! (fpIsIdentAtom name))
            {
              (fpBad p)
              (set i (vecLen flat))
            }
            {
              (let explicit
                (&& (< (+ i 1) (vecLen flat))
                  (fpIsAtomText (fpSrc p) (vecGet flat (+ i 1))
                    (if (== mode 0)
                      ":"
                      "="))))
              (if (|| (&& (== mode 0) (! explicit)) (&& explicit (>= (+ i 2) (vecLen flat))))
                {
                  (fpBad p)
                  (set i (vecLen flat))
                }
                {
                  (let pattern
                    (if explicit
                      (if (== mode 0)
                        (vecGet flat (+ i 2))
                        (fpPatItem p flat (+ i 2)))
                      name))
                  {
                    (vecPush items
                      (mkFNode FN_PAREN (fnTok name) (vecPush (vecPush vecNew name) pattern)
                        (fnStart name) (fnEnd pattern)))
                    (set i (if explicit
                      (+ (+ i 2)
                        (if (== mode 0)
                          1
                          (fpPatWidth (fpSrc p) flat (+ i 2))))
                      (+ i 1)))
                  }
                })
            })
        })
      items
    }
  })

(pub :: fpFieldItem (-> Int Int Int Int))
(pub fn (fpFieldItem p n mode)
  {
    (let out (fpOut p))
    (let name (fnKid n 0))
    (let pattern (fnKid n 1))
    (let childMode
      (if (== mode 4)
        0
        1))
    {
      (fpP p (fnText (fpSrc p) name))
      (fpP p
        (if (== mode 4)
          " :"
          " ="))
      (if (== (foTrial out) 1)
        {
          (fpP p " ")
          (fpListItemSuffix p pattern childMode (fpSuffixWidth p))
        }
        {
          (let flat (fpListItemFlat p pattern childMode))
          (if (&& (> (strLen flat) 0)
                (&& (! (fqAnyWithin (fpQ p) (fnEnd name) (fnEnd pattern)))
                  (<= (+ (+ (+ (foColumn out) 1) (strLen flat)) (fpSuffixWidth p)) fmtWidth)))
            {
              (fpP p " ")
              (fpP p flat)
            }
            {
              (fpP p "\n")
              (foPushIndent out)
              (flushLeading (fpSrc p) (fpQ p) out (fnStart pattern))
              (foEmitIndent out)
              (fpListItemSuffix p pattern childMode (fpSuffixWidth p))
              (foPopIndent out)
            })
        })
      p
    }
  })

(pub :: fpPat (-> Int Int Int))
(pub fn (fpPat p n)
  (if (&& (== (foTrial (fpOut p)) 1) (!= (foBad (fpOut p)) 0))
    p
    (fpPatLive p n)))

(pub :: fpPatLive (-> Int Int Int))
(pub fn (fpPatLive p n)
  {
    (let k (fnKind n))
    (let src (fpSrc p))
    (if (== k FN_ATOM)
      {
        (let tk (ftKind (fnTok n)))
        (if (|| (== tk FT_IDENT) (== tk FT_MINUS))
          ; An operator run is a name to this compiler's parser, in a
          ; pattern as anywhere else: a parameter or a `let` binder
          ; spelled `*` shadows the operator in its scope. A lone `-`
          ; is scanned as its own kind, and binds the same way.
          (fpP p (fnText src n))
          (if (== tk FT_INT)
            (fpInt p (fnStart n) (fnEnd n))
            (if (== tk FT_FLOAT)
              (fpFloat p (fnStart n) (fnEnd n))
              (if (== tk FT_STR)
                (fpStrLit p (fnTok n))
                (if (== tk FT_CHAR)
                  (fpCharLit p (fnTok n))
                  (fpBad p))))))
      }
      (if (== k FN_BRACK)
        (fpList p n (fpPatItems p (fnKidsVec n) 0) 1 "[" "]")
        (if (== k FN_PAREN)
          (if (== (fnLen n) 0)
            ; `(match e (() 0))` - a pattern is parsed by `parseExpr`
            ; (`parseArmPattern`'s fallback), so an empty pattern was
            ; the same crash reached through a different door.
            (fpBad p)
            (if (fpIsUpperIdent src (fnKid n 0))
              ; A constructor pattern: the parens are load-bearing -
              ; `(Red)` is a tag test where `Red` alone would be a
              ; binder - so nullary constructors keep them.
              (if (&& (== (fnLen n) 2) (== (fnKind (fnKid n 1)) FN_BRACE))
                (fpPatNamed p (fnKid n 0) (fnKid n 1))
                (fpList p n (fpHeadPatItems p n) 1 "(" ")"))
              ; Not a constructor head: the group is a paren list of
              ; patterns - one unwraps to itself, several are a
              ; tuple - counted through the constructor fusion, so
              ; `(C (x))` above and `((C x))` here agree with the
              ; parser.
              {
                (let kids (fnKidsVec n))
                (if (== (fpPatVecCount src kids 0) 1)
                  {
                    (fpPatVecAt p kids 0)
                    p
                  }
                  (fpList p n (fpPatItems p kids 0) 1 "(" ")"))
              }))
          (fpBad p))))
  })

(pub :: fpAnchor (-> String Int Int))
(pub fn (fpAnchor src n)
  {
    (let k (fnKind n))
    (if (== k FN_TRY)
      (fpAnchor src (fnKid n 0))
      (if (== k FN_ATOM)
        (fnStart n)
        (if (== k FN_FIELD)
          (fnStart n)
          (if (== k FN_QUAL)
            (fnStart n)
            (if (== k FN_PREFIX)
              (fpAnchor src (fnKid n 0))
              ; A block that PRINTS as a block - two or more statements,
              ; so `fpBeginVec` writes the braces - anchors at its own
              ; `{`, not at its first statement. The recursion below is
              ; stage0's `EBegin` span, and it hoisted every comment
              ; written as the first line inside a `{ }` out past the
              ; brace and past the enclosing `let`: the fn body's flush
              ; runs before the `let`'s anchor, the `let`'s anchor is its
              ; body's, the body's was its first statement's, and the
              ; comment sits before that. `fpBeginVec` flushes before
              ; every statement it prints, so with the anchor at the `{`
              ; the comment lands where it was written, at the block's
              ; indent, and stays there on the second pass. A singleton
              ; block prints as its inner expression with no brace to
              ; keep the comment inside, so it still recurses; so does a
              ; `[ ]` list, whose printer flushes nothing per element.
              ; Parity case 221 pins it.
              (if (&& (== k FN_BRACE) (>= (fnLen n) 2))
                (fnStart n)
                (if (|| (== k FN_BRACK) (== k FN_BRACE))
                  (if (> (fnLen n) 0)
                    (fpAnchor src (fnKid n 0))
                    0)
                  ; FN_PAREN.
                  (if (== (fnLen n) 0)
                    0
                    {
                      (let h (fnHeadText src n))
                      (if (|| (strEq h "let") (|| (strEq h "lambda") (strEq h "fn")))
                        (if (fpIsLocalLet src n)
                          (fnStart n)
                          (if (> (fnLen n) 2)
                            (fpAnchor src (fnKid n 2))
                            0))
                        (if (strEq h "parallel")
                          (if (> (fnLen n) 3)
                            (fpAnchor src (fnKid n 3))
                            0)
                          (if (|| (strEq h "if")
                                (|| (strEq h "while")
                                  (|| (strEq h "for")
                                    (|| (strEq h "region")
                                      (|| (strEq h "match")
                                        (|| (strEq h "handle")
                                          (|| (strEq h "consume") (strEq h "::"))))))))
                            (if (> (fnLen n) 1)
                              (fpAnchor src (fnKid n 1))
                              0)
                            (if (strEq h "as")
                              (fnStart (fnKid n 0))
                              (if (|| (strEq h "sizeof") (strEq h "alignof"))
                                (fnStart (fnKid n 0))
                                (if (|| (strEq h "set") (strEq h "struct"))
                                  (if (> (fnLen n) 1)
                                    (fnStart (fnKid n 1))
                                    0)
                                  (fpAnchor src (fnKid n 0))))))))
                    }))))))))
  })

; ------------------------------------------------------------------
; Declarations.
; ------------------------------------------------------------------
; Whether the declaration opens with `pub`: 1 shifts every index.
(pub :: fpDeclBase (-> String Int Int))
(pub fn (fpDeclBase src n)
  (if (&& (> (fnLen n) 0) (fpIsAtomText src (fnKid n 0) "pub"))
    1
    0))

(pub :: fpDeclHead (-> String Int String))
(pub fn (fpDeclHead src n)
  {
    (let b (fpDeclBase src n))
    (if (> (fnLen n) b)
      (fnText src (fnKid n b))
      "")
  })

(pub :: fpIsDeclHead (-> String Bool))
(pub fn (fpIsDeclHead h)
  (if (strEq h "import")
    true
    (if (strEq h "fn")
      true
      (if (strEq h "define")
        true
        (if (strEq h "::")
          true
          (if (strEq h "data")
            true
            (if (strEq h "newtype")
              true
              (if (strEq h "struct")
                true
                (if (strEq h "type")
                  true
                  (if (strEq h "subtype")
                    true
                    (if (strEq h "trait")
                      true
                      (if (strEq h "impl")
                        true
                        (if (strEq h "effect")
                          true
                          (if (strEq h "macro")
                            true
                            false))))))))))))))

; The offset stage0's `decl_start` answers: the NAME token's start,
; which sits a few tokens into the form. Comments order against it.
(pub :: fpDeclAnchor (-> String Int Int))
(pub fn (fpDeclAnchor src n)
  {
    (let b (fpDeclBase src n))
    (let h (fpDeclHead src n))
    (if (< (fnLen n) (+ b 2))
      (fnStart n)
      {
        (let x (fnKid n (+ b 1)))
        (if (|| (strEq h "fn")
              (|| (strEq h "define")
                (|| (strEq h "macro") (|| (strEq h "trait") (strEq h "impl")))))
          (if (&& (== (fnKind x) FN_PAREN) (> (fnLen x) 0))
            (fnStart (fnKid x 0))
            (fnStart x))
          (fnStart x))
      })
  })

; The declared name for blank-line grouping: the `::` name, or
; the `fn`/`define` name inside the head paren or bare. Anything
; else - imports, macro invocations, nameless shapes - answers
; `""` and never sticks to a neighbour.
(pub :: fpDeclName (-> String Int String))
(pub fn (fpDeclName src n)
  {
    (let b (fpDeclBase src n))
    (let h (fpDeclHead src n))
    (if (strEq h "::")
      (if (> (fnLen n) (+ b 1))
        {
          (let x (fnKid n (+ b 1)))
          (if (fpIsIdentAtom x)
            (fnText src x)
            "")
        }
        "")
      (if (|| (strEq h "fn") (strEq h "define"))
        (if (> (fnLen n) (+ b 1))
          {
            (let x (fnKid n (+ b 1)))
            (if (== (fnKind x) FN_PAREN)
              (if (&& (> (fnLen x) 0) (fpIsIdentAtom (fnKid x 0)))
                (fnText src (fnKid x 0))
                "")
              (if (fpIsIdentAtom x)
                (fnText src x)
                ""))
          }
          "")
        ""))
  })

; `pub ` as spelled: inside the paren, before the keyword.
(pub :: fpVis (-> Int Int Int))
(pub fn (fpVis p n)
  (if (== (fpDeclBase (fpSrc p) n) 1)
    (fpP p "pub ")
    p))

; The end of a tyvar run starting at `from`: consecutive bare
; lowercase idents, or one parenthesised all-lowercase list (empty
; counts), mirroring `parse_tyvars`/`looks_like_tyvar_list`.
(pub :: fpIsLowerIdent (-> String Int Bool))
(pub fn (fpIsLowerIdent src n)
  (if (== (fnKind n) FN_ATOM)
    (if (== (ftKind (fnTok n)) FT_IDENT)
      {
        (let c (strByte src (fnStart n)))
        (if (>= c 97)
          (<= c 122)
          false)
      }
      false)
    false))

(pub :: fpIsTyvarList (-> String Int Bool))
(pub fn (fpIsTyvarList src n)
  (if (!= (fnKind n) FN_PAREN)
    false
    {
      (let mut j 0)
      (let mut ok 1)
      {
        (while (< j (fnLen n))
          {
            (if (! (fpIsLowerIdent src (fnKid n j)))
              (set ok 0))
            (set j (+ j 1))
          })
        (== ok 1)
      }
    }))

(pub :: fpTyvarsEnd (-> String Int Int Int))
(pub fn (fpTyvarsEnd src n from)
  (if (>= from (fnLen n))
    from
    (if (fpIsTyvarList src (fnKid n from))
      (+ from 1)
      {
        (let mut i from)
        {
          (while (&& (< i (fnLen n)) (fpIsLowerIdent src (fnKid n i)))
            (set i (+ i 1)))
          i
        }
      })))

; One type parameter prints bare where the grammar permits it.
; Several parameters, and every struct parameter list, stay parenthesised.
; Long lists continue on an indented line.
(pub :: fpTyvars (-> Int Int Int Int Int Int Int))
(pub fn (fpTyvars p n from to paren suffix)
  {
    (let names vecNew)
    (let mut i from)
    {
      (while (< i to)
        {
          (let kid (fnKid n i))
          {
            (if (== (fnKind kid) FN_PAREN)
              {
                (let mut j 0)
                (while (< j (fnLen kid))
                  {
                    (vecPush names (fnKid kid j))
                    (set j (+ j 1))
                  })
              }
              (vecPush names kid))
            (set i (+ i 1))
          }
        })
      (if (== (vecLen names) 0)
        p
        {
          (let group
            (mkFNode FN_PAREN (fnTok (fnKid n from)) names (fnStart (fnKid n from))
              (fnEnd (fnKid n (- to 1)))))
          (let open
            (if (&& (== (vecLen names) 1) (== paren 0))
              ""
              "("))
          (let close
            (if (&& (== (vecLen names) 1) (== paren 0))
              ""
              ")"))
          (let saved (fpSuffixWidth p))
          {
            (let flat (fpListFlat p group names 2 open close))
            {
              (if (&& (> (strLen flat) 0)
                    (<= (+ (+ (+ (foColumn (fpOut p)) 1) (strLen flat)) suffix) fmtWidth))
                {
                  (fpP p " ")
                  (fpP p flat)
                }
                {
                  (fpP p "\n")
                  (foPushIndent (fpOut p))
                  (flushLeading (fpSrc p) (fpQ p) (fpOut p) (fnStart group))
                  (foEmitIndent (fpOut p))
                  (memSetWord p 4 suffix)
                  (fpList p group names 2 open close)
                  (memSetWord p 4 saved)
                  (foPopIndent (fpOut p))
                })
              p
            }
          }
        })
    }
  })

(pub :: fpIsColonAtom (-> Int Bool))
(pub fn (fpIsColonAtom n)
  (if (== (fnKind n) FN_ATOM)
    (== (ftKind (fnTok n)) FT_COLON)
    false))

(pub :: fpIsDColonAtom (-> Int Bool))
(pub fn (fpIsDColonAtom n)
  (if (== (fnKind n) FN_ATOM)
    (== (ftKind (fnTok n)) FT_DCOLON)
    false))

(pub :: fpIsIdentAtom (-> Int Bool))
(pub fn (fpIsIdentAtom n)
  (if (== (fnKind n) FN_ATOM)
    (== (ftKind (fnTok n)) FT_IDENT)
    false))

; A constructor of a `data` declaration.
(pub :: fpDataCon (-> Int Int Int))
(pub fn (fpDataCon p con)
  {
    (let src (fpSrc p))
    (if (|| (!= (fnKind con) FN_PAREN) (|| (< (fnLen con) 1) (! (fpIsIdentAtom (fnKid con 0)))))
      (fpBad p)
      (if (&& (== (fnLen con) 2) (== (fnKind (fnKid con 1)) FN_BRACE))
        {
          (let brace (fnKid con 1))
          (fpList p brace (fpNamedFields p brace 0) 4
            (concat (concat "(" (fnText src (fnKid con 0))) " { ") " })")
        }
        (fpList p con (fnKidsVec con) 0 "(" ")")))
  })

(pub :: fpDataConSuffix (-> Int Int Int Int))
(pub fn (fpDataConSuffix p con width)
  {
    (let saved (fpSuffixWidth p))
    {
      (memSetWord p 4 (+ saved width))
      (fpDataCon p con)
      (memSetWord p 4 saved)
      p
    }
  })

(pub :: fpDeclData (-> Int Int Int))
(pub fn (fpDeclData p n)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let b (fpDeclBase src n))
    (if (|| (< (fnLen n) (+ b 2))
          (if (fpIsIdentAtom (fnKid n (+ b 1)))
            false
            true))
      (fpBad p)
      {
        (let tvEnd (fpTyvarsEnd src n (+ b 2)))
        {
          (fpP p "(")
          (fpVis p n)
          (fpP p "data ")
          (fpP p (fnText src (fnKid n (+ b 1))))
          (fpTyvars p n (+ b 2) tvEnd 0 1)
          ; A `deriving` clause POISONS the file instead of
          ; printing: the compiler refuses the clause (AX2004,
          ; MAC-CAP-9), and a formatter that accepts and rewrites
          ; what `check` refuses is the MAC-TOOL-6 defect class -
          ; the two grammars must refuse together. `fpDeriving`,
          ; which printed it, is deleted rather than left as a dead
          ; arm: an AST arm without a producer is dead syntax.
          {
            (let mut end (fnLen n))
            (let mut i tvEnd)
            {
              (while (< i (fnLen n))
                {
                  (if (fpIsAtomText src (fnKid n i) "deriving")
                    {
                      (fpBad p)
                      (set i (fnLen n))
                    })
                  (set i (+ i 1))
                })
              {
                (let ctors (- end tvEnd))
                (if (== ctors 0)
                  ; stage0's `format_data_decl` prints `)` the
                  ; moment the constructor list is empty and never
                  ; reaches its deriving clause - a zero-constructor
                  ; `data` loses its `deriving` silently, and
                  ; byte-parity keeps the bug.
                  (fpP p ")")
                  (if (&& (== ctors 1)
                        (&& (== (fnKind (fnKid n tvEnd)) FN_PAREN) (== (fnLen (fnKid n tvEnd)) 1)))
                    {
                      {
                        (let flat
                          (fpListFlat p (fnKid n tvEnd) (fnKidsVec (fnKid n tvEnd)) 0 "(" ")"))
                        (if (&& (> (strLen flat) 0)
                              (<= (+ (+ (foColumn o) (strLen flat)) 2) fmtWidth))
                          (fpP p " ")
                          {
                            (fpP p "\n")
                            (foPushIndent o)
                            (foEmitIndent o)
                            (foPopIndent o)
                          })
                      }
                      (fpDataConSuffix p (fnKid n tvEnd) 1)
                      p
                      (fpP p ")")
                    }
                    {
                      (let mut j tvEnd)
                      {
                        (while (< j end)
                          {
                            (fpP p "\n")
                            (foPushIndent o)
                            (foEmitIndent o)
                            (fpDataConSuffix p (fnKid n j)
                              (if (== j (- end 1))
                                1
                                0))
                            (foPopIndent o)
                            (set j (+ j 1))
                          })
                        p
                        (fpP p ")")
                      }
                    }))
              }
            }
          }
        }
      })
  })

; `newtype` is sugar stage0's parser rewrites into a single-constructor
; `data`, so the printer performs the same rewrite.
(pub :: fpDeclNewtype (-> Int Int Int))
(pub fn (fpDeclNewtype p n)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let b (fpDeclBase src n))
    (if (|| (< (fnLen n) (+ b 2))
          (if (fpIsIdentAtom (fnKid n (+ b 1)))
            false
            true))
      (fpBad p)
      {
        (let tvEnd (fpTyvarsEnd src n (+ b 2)))
        (if (|| (!= (+ tvEnd 3) (fnLen n))
              (||
                (if (fpIsAtomText src (fnKid n tvEnd) "=")
                  false
                  true)
                (if (fpIsIdentAtom (fnKid n (+ tvEnd 1)))
                  false
                  true)))
          (fpBad p)
          {
            (fpP p "(")
            (fpVis p n)
            (fpP p "data ")
            (fpP p (fnText src (fnKid n (+ b 1))))
            (fpTyvars p n (+ b 2) tvEnd 0 0)
            (fpP p "\n")
            (foPushIndent o)
            (foEmitIndent o)
            (fpP p "(")
            (fpP p (fnText src (fnKid n (+ tvEnd 1))))
            (fpP p " ")
            (fpType p (fnKid n (+ tvEnd 2)))
            (fpP p ")")
            (foPopIndent o)
            (fpP p ")")
          })
      })
  })

; The end of a struct declaration's markers: the run of bare names from
; `from`, the position of the first kid that is not one.
(pub :: fpMarkersEnd (-> Int Int Int))
(pub fn (fpMarkersEnd n from)
  {
    (let mut i from)
    {
      (while (&& (< i (fnLen n)) (fpIsIdentAtom (fnKid n i)))
        (set i (+ i 1)))
      i
    }
  })

(pub :: fpDeclStruct (-> Int Int Int))
(pub fn (fpDeclStruct p n)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let b (fpDeclBase src n))
    (if (|| (< (fnLen n) (+ b 2))
          (if (fpIsIdentAtom (fnKid n (+ b 1)))
            false
            true))
      (fpBad p)
      ; REPRESENTATION MARKERS first - every bare name after the
      ; struct's own, as the parser collects them (`collectStructMarkers`)
      ; and the checker judges them (AX3084): `(struct Chan word shared
      ; (slot : Int))`. So a bare name here is a marker and never a type
      ; parameter; only a parenthesised list is one, which is the only
      ; spelling of parameters the parser has ever read for a struct.
      ; Reading bare names as parameters printed `word shared` as `(word
      ; shared)`, a parameter list - a program with another meaning.
      {
        (let mEnd (fpMarkersEnd n (+ b 2)))
        {
          (let tvEnd
            (if (&& (< mEnd (fnLen n)) (fpIsTyvarList src (fnKid n mEnd)))
              (+ mEnd 1)
              mEnd))
          {
            (fpP p "(")
            (fpVis p n)
            (fpP p "struct ")
            (fpP p (fnText src (fnKid n (+ b 1))))
            {
              (let mut k (+ b 2))
              (while (< k mEnd)
                {
                  (fpP p " ")
                  (fpP p (fnText src (fnKid n k)))
                  (set k (+ k 1))
                })
            }
            (fpTyvars p n mEnd tvEnd 1 0)
            ; There is no layout modifier to print. `packed`, `repr(C)`
            ; and `align(N)` were accepted here and by nothing else:
            ; the parser has always answered AX2001 for all three, so
            ; the only programs this arm could format were programs the
            ; compiler refuses. C layout has no meaning in a language
            ; that links no C.
            ; Fields: `({mut }name : Type)`, one per line.
            {
              (let mut i tvEnd)
              {
                (if (< i (fnLen n))
                  (foPushIndent o)
                  o)
                {
                  (let had (< i (fnLen n)))
                  {
                    (while (< i (fnLen n))
                      {
                        (let f (fnKid n i))
                        (if (!= (fnKind f) FN_PAREN)
                          {
                            (fpBad p)
                            (set i (fnLen n))
                          }
                          ; A field is `({mut }name : Type)` or, as the
                          ; parser also reads it, `(name Type)` with no
                          ; colon or a bare `(name)` - the checker refuses
                          ; both (AX3056), and a type it cannot read is
                          ; the same field left at the empty variable, so
                          ; `(name : 5)` parses too. The formatter follows
                          ; the parser: all three print as written, the
                          ; unreadable type through the expression printer
                          ; where the type printer would refuse, and the
                          ; checker keeps the refusal. This used to `fpBad`
                          ; all three, which made the fixture that pins
                          ; AX3056 unformattable - the same shape the
                          ; effect printer above was given for AX3055.
                          {
                            (let fb
                              (if (&& (> (fnLen f) 0) (fpIsAtomText src (fnKid f 0) "mut"))
                                1
                                0))
                            (if (|| (< (fnLen f) (+ fb 1))
                                  (|| (> (fnLen f) (+ fb 3))
                                    (||
                                      (if (fpIsIdentAtom (fnKid f fb))
                                        false
                                        true)
                                      (if (== (fnLen f) (+ fb 3))
                                        (if (fpIsColonAtom (fnKid f (+ fb 1)))
                                          false
                                          true)
                                        false))))
                              {
                                (fpBad p)
                                (set i (fnLen n))
                              }
                              {
                                (fpP p "\n")
                                (foEmitIndent o)
                                (fpP p
                                  (if (== fb 1)
                                    "(mut "
                                    "("))
                                (fpP p (fnText src (fnKid f fb)))
                                (if (== (fnLen f) (+ fb 3))
                                  {
                                    (fpP p " : ")
                                    (fpFieldTy p (fnKid f (+ fb 2)))
                                  }
                                  (if (== (fnLen f) (+ fb 2))
                                    {
                                      (fpP p " ")
                                      (fpFieldTy p (fnKid f (+ fb 1)))
                                    }
                                    p))
                                (fpP p ")")
                                (set i (+ i 1))
                              })
                          })
                      })
                    (if had
                      (foPopIndent o)
                      o)
                  }
                }
              }
            }
            (fpP p ")")
          }
        }
      })
  })

(pub :: fpDeclType (-> Int Int Int))
(pub fn (fpDeclType p n)
  {
    (let src (fpSrc p))
    (let b (fpDeclBase src n))
    (if (|| (< (fnLen n) (+ b 2))
          (if (fpIsIdentAtom (fnKid n (+ b 1)))
            false
            true))
      (fpBad p)
      {
        (let tvEnd (fpTyvarsEnd src n (+ b 2)))
        (let target
          (if (fpIsAtomText src (fnKid n tvEnd) "=")
            (+ tvEnd 1)
            tvEnd))
        (if (!= (+ target 1) (fnLen n))
          (fpBad p)
          {
            (fpP p "(")
            (fpVis p n)
            (fpP p "type ")
            (fpP p (fnText src (fnKid n (+ b 1))))
            (fpTyvars p n (+ b 2) tvEnd 0 2)
            (fpTypeAfter p (fnKid n target) 1)
            (fpP p ")")
          })
      })
  })

; `(subtype Name is Base range LO[..HI])`. Printed structurally:
; the keywords literally, the base through the type printer and the
; bounds through the expression printer. A lower-only range prints
; with no `..`; anything else shaped is a refusal, as a malformed
; `type` is.
;
; The bounds are read as EXPRESSION elements, so a `-` touching the
; number after it is one negative literal, as the parser reads it. The
; reader keeps them two atoms, and counting atoms made `range -1..10`
; one element too long: `check` accepted the declaration and `fmt`
; refused it with no code (P4, scripts/check-fuzz.sh).
(pub :: fpDeclSubtype (-> Int Int Int))
(pub fn (fpDeclSubtype p n)
  {
    (let src (fpSrc p))
    (let b (fpDeclBase src n))
    (if (|| (< (fnLen n) (+ b 6))
          (if (fpIsIdentAtom (fnKid n (+ b 1)))
            false
            true))
      (fpBad p)
      (if (||
            (if (fpIsAtomText src (fnKid n (+ b 2)) "is")
              false
              true)
            (if (fpIsAtomText src (fnKid n (+ b 4)) "range")
              false
              true))
        (fpBad p)
        {
          (let bounds (fpExprElems n (+ b 5)))
          {
            (fpP p "(")
            (fpVis p n)
            (fpP p "subtype ")
            (fpP p (fnText src (fnKid n (+ b 1))))
            (fpP p " is ")
            (fpType p (fnKid n (+ b 3)))
            (fpP p " range ")
            (fpExpr p (vecGet bounds 0))
            (if (== (vecLen bounds) 1)
              (fpP p ")")
              (if (|| (!= (vecLen bounds) 3)
                    (if (fpIsAtomText src (vecGet bounds 1) "..")
                      false
                      true))
                (fpBad p)
                {
                  (fpP p "..")
                  (fpExpr p (vecGet bounds 2))
                  (fpP p ")")
                }))
          }
        }))
  })

(pub :: fpDeclSig (-> Int Int Int))
(pub fn (fpDeclSig p n)
  {
    (let src (fpSrc p))
    (let b (fpDeclBase src n))
    (if (|| (!= (fnLen n) (+ b 3))
          (if (fpIsIdentAtom (fnKid n (+ b 1)))
            false
            true))
      (fpBad p)
      {
        (fpP p "(")
        (fpVis p n)
        (fpP p ":: ")
        (fpP p (fnText src (fnKid n (+ b 1))))
        (fpTypeAfter p (fnKid n (+ b 2)) 1)
        (fpP p ")")
      })
  })

(pub :: fpDeclFn (-> Int Int Int))
(pub fn (fpDeclFn p n)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let b (fpDeclBase src n))
    (if (< (fnLen n) (+ b 2))
      (fpBad p)
      {
        (let x (fnKid n (+ b 1)))
        {
          (fpP p "(")
          (fpVis p n)
          (fpP p "fn ")
          ; Only `(fn (name params) body)` is a function. A bare name
          ; or a `define` head is refused, as the parser refuses it.
          {
            (let bodyFrom
              (if (== (fnKind x) FN_PAREN)
                (if (&& (> (fnLen x) 0) (fpIsIdentAtom (fnKid x 0)))
                  {
                    (fpList p x (fpHeadPatItems p x) 1 "(" ")")
                    (+ b 2)
                  }
                  {
                    (fpBad p)
                    (+ b 2)
                  })
                {
                  (fpBad p)
                  (+ b 2)
                }))
            {
              (let body (fpExprElems n bodyFrom))
              (if (== (vecLen body) 0)
                (fpBad p)
                ; The head stands alone; the body goes on the next
                ; indent level, single or braced. A short body does
                ; not cuddle onto the head line: `(pub fn (name)`
                ; is a landmark, and landmarks do not share. The
                ; closing paren stacks onto the body's last line.
                {
                  (fpP p "\n")
                  (foPushIndent o)
                  (flushLeading src (fpQ p) o (fpBodyVecAnchor src body 0))
                  (foEmitIndent o)
                  (fpBodyVec p body 0)
                  (foPopIndent o)
                  (fpP p ")")
                })
            }
          }
        }
      })
  })

(pub :: fpDeclImport (-> Int Int Int))
(pub fn (fpDeclImport p n)
  {
    (let src (fpSrc p))
    (let b (fpDeclBase src n))
    (if (|| (< (fnLen n) (+ b 2)) (> (fnLen n) (+ b 3)))
      (fpBad p)
      {
        (let path (fnKid n (+ b 1)))
        {
          (fpP p "(import ")
          (fpImportPath p path)
          (if (== (fnLen n) (+ b 3))
            {
              (let names (fnKid n (+ b 2)))
              (if (!= (fnKind names) FN_PAREN)
                (fpBad p)
                ; An EMPTY name list is omitted entirely:
                ; stage0's printer guards on `!names.is_empty()`,
                ; so `(import A.B ())` prints `(import A.B)`.
                (if (== (fnLen names) 0)
                  p
                  {
                    (let flat (fpListFlat p names (fnKidsVec names) 2 "(" ")"))
                    (let out (fpOut p))
                    (if (&& (> (strLen flat) 0)
                          (<= (+ (+ (foColumn out) (strLen flat)) 2) fmtWidth))
                      {
                        (fpP p " ")
                        (fpP p flat)
                      }
                      {
                        (fpP p "\n")
                        (foPushIndent out)
                        (flushLeading src (fpQ p) out (fnStart names))
                        (foEmitIndent out)
                        {
                          (let saved (fpSuffixWidth p))
                          {
                            (memSetWord p 4 1)
                            (fpList p names (fnKidsVec names) 2 "(" ")")
                            (memSetWord p 4 saved)
                          }
                        }
                        (foPopIndent out)
                      })
                  }))
            }
            p)
          (fpP p ")")
        }
      })
  })

; A dotted module path: `Q.Inner` is a FIELD join in the tree and one
; path here.
(pub :: fpImportPath (-> Int Int Int))
(pub fn (fpImportPath p path)
  (if (fpIsIdentAtom path)
    (fpP p (fnText (fpSrc p) path))
    (if (== (fnKind path) FN_FIELD)
      {
        (fpImportPath p (fnKid path 0))
        (fpP p ".")
        (fpP p (fnText (fpSrc p) (fnKid path 1)))
      }
      (fpBad p))))

; Effect atoms print verbatim, because `parseEffectNames` takes ANY
; identifier and the CHECKER decides which names an effect list may
; hold: `(mut)` and `(data)` are AX3016 there unless a declaration
; introduces them, and the printer cannot see declarations in other
; modules. Rewriting a spelling here would hand `check` a different
; program from the one it refused.
(pub :: fpEffectAtoms (-> Int Int Int))
(pub fn (fpEffectAtoms p grp)
  {
    (let src (fpSrc p))
    (let mut j 0)
    {
      (while (< j (fnLen grp))
        (if (fpIsIdentAtom (fnKid grp j))
          {
            (let t (fnText src (fnKid grp j)))
            {
              (if (> j 0)
                (fpP p " ")
                p)
              (fpP p t)
              (set j (+ j 1))
            }
          }
          {
            (fpBad p)
            (set j (fnLen grp))
          }))
      p
    }
  })

; `(extern "lib" (name :: Type (symbol "s")) ...)` - the Rust FFI
; binding block (docs/ffi.md).
;
; Printed on the model of `fpDeclEffect` directly above, because the
; two forms are the same shape: a header followed by a list of typed
; callables, one per line, indented once.
;
; This arm and a zoo case land together, deliberately.
; `check-fmt.sh`'s own header records what happens otherwise - `type`,
; `trait`, `impl` and `foreign` were all formatted into source that did
; not parse, with CI green, because the zoo carries only what someone
; wrote into it. An unformattable `.ax` in the tree is the OTHER half
; of that failure and is what this arm was written to fix: the gate
; sweeps every `.ax` in the repository, so a generated binding module
; is judged the moment it exists.
(pub :: fpDeclExtern (-> Int Int Int))
(pub fn (fpDeclExtern p n)
  ; The library name is an ATOM (a string literal); anything else is
  ; not this form and is refused rather than half-printed.
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let b (fpDeclBase src n))
    (if (|| (< (fnLen n) (+ b 2)) (!= (fnKind (fnKid n (+ b 1))) FN_ATOM))
      (fpBad p)
      {
        (let mut i (+ b 2))
        {
          (fpP p "(")
          (fpVis p n)
          (fpP p "extern ")
          (fpP p (fnText src (fnKid n (+ b 1))))
          (if (< i (fnLen n))
            (foPushIndent o)
            o)
          {
            (let had (< i (fnLen n)))
            {
              (while (< i (fnLen n))
                {
                  (let it (fnKid n i))
                  (if (|| (!= (fnKind it) FN_PAREN)
                        (|| (< (fnLen it) 3)
                          (||
                            (if (fpIsIdentAtom (fnKid it 0))
                              false
                              true)
                            (if (fpIsDColonAtom (fnKid it 1))
                              false
                              true))))
                    {
                      (fpBad p)
                      (set i (fnLen n))
                    }
                    {
                      (fpP p "\n")
                      (foEmitIndent o)
                      (fpExternItem p it
                        (if (== i (- (fnLen n) 1))
                          2
                          1))
                      (set i (+ i 1))
                    })
                })
              (if had
                (foPopIndent o)
                o)
            }
          }
          (fpP p ")")
        }
      })
  })

; Try the complete typed tail once, stopping at the width limit.
(pub :: fpExternFlat (-> Int Int String))
(pub fn (fpExternFlat p it)
  (if (fqAnyWithin (fpQ p) (fnStart it) (fnEnd it))
    ""
    {
      (let out (mkFOut 0))
      {
        (let trial (mkFPr (fpSrc p) (fpStarts p) (mkFCq (as vecNew Int)) out))
        (let mut j 3)
        {
          (memSetWord out 4 1)
          (fpType trial (fnKid it 2))
          (while (&& (< j (fnLen it)) (== (foBad out) 0))
            {
              (fpP trial " ")
              (fpExpr trial (fnKid it j))
              (set j (+ j 1))
            })
          (if (|| (!= (foBad out) 0) (> (foNl out) 0))
            ""
            (foFinish out))
        }
      }
    }))

(pub :: fpExternItem (-> Int Int Int Int))
(pub fn (fpExternItem p it suffix)
  {
    (let out (fpOut p))
    (let flat (fpExternFlat p it))
    {
      (fpP p "(")
      (fpP p (fnText (fpSrc p) (fnKid it 0)))
      (fpP p " ::")
      (if (&& (> (strLen flat) 0) (<= (+ (+ (+ (foColumn out) 1) (strLen flat)) suffix) fmtWidth))
        {
          (fpP p " ")
          (fpP p flat)
        }
        {
          (fpTypeAfter p (fnKid it 2)
            (if (== (fnLen it) 3)
              suffix
              0))
          (fpExternClauses p it 3 suffix)
        })
      (fpP p ")")
    }
  })

; A broken extern tail keeps each clause on an indented line.
(pub :: fpExternClauses (-> Int Int Int Int Int))
(pub fn (fpExternClauses p it from suffix)
  {
    (let out (fpOut p))
    (let mut j from)
    (let mut trailing false)
    {
      (foPushIndent out)
      (while (< j (fnLen it))
        {
          (fpP p "\n")
          (flushLeading (fpSrc p) (fpQ p) out (fnStart (fnKid it j)))
          (foEmitIndent out)
          {
            (let mark (foNl out))
            {
              (fpExprSuffix p (fnKid it j)
                (if (== j (- (fnLen it) 1))
                  suffix
                  0))
              (set trailing (fpAppTrailing p (fnKid it j)
                              (if (< (+ j 1) (fnLen it))
                                (fnStart (fnKid it (+ j 1)))
                                (fnEnd it))
                              mark))
            }
          }
          (set j (+ j 1))
        })
      (foPopIndent out)
      (if (|| trailing (fqAnyWithin (fpQ p) (fnStart it) (fnEnd it)))
        {
          (fpP p "\n")
          (flushLeading (fpSrc p) (fpQ p) out (fnEnd it))
          (foEmitIndent out)
        })
      p
    }
  })

(pub :: fpDeclEffect (-> Int Int Int))
(pub fn (fpDeclEffect p n)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    (let b (fpDeclBase src n))
    (if (|| (< (fnLen n) (+ b 2))
          (if (fpIsIdentAtom (fnKid n (+ b 1)))
            false
            true))
      (fpBad p)
      {
        (let mut i (+ b 2))
        {
          (fpP p "(")
          (fpVis p n)
          (fpP p "effect ")
          (fpP p (fnText src (fnKid n (+ b 1))))
          (if (< i (fnLen n))
            (foPushIndent o)
            o)
          {
            (let had (< i (fnLen n)))
            {
              (while (< i (fnLen n))
                {
                  (let op (fnKid n i))
                  (if (||
                        (!= (fnKind op) FN_PAREN)
                        (||
                          (== (fnLen op) 0)
                          (||
                            (if (fpIsIdentAtom (fnKid op 0))
                              ; An empty `()` has no kid 0 to read: it is refused before
                              ; the name is asked for. Reading it first trapped with 77
                              ; and took `axiom fmt` and the language server's
                              ; `formatting` down with it (scripts/lib/lspfuzz.py).
                              ; An operation is `(name :: TYPE)` or, as the parser also
                              ; reads it, a bare `(name)` - the checker refuses that one
                              ; (AX3055) and a type it cannot read is the same field
                              ; left at 0, so `(name :: 5)` parses too. The formatter
                              ; follows the parser: both print as written, through the
                              ; expression printer where the type printer would refuse,
                              ; and the checker keeps the refusal. This used to `fpBad`
                              ; both shapes, which made the fixture that pins AX3055
                              ; unformattable (check-fmt, 2026-08-29).
                              false
                              true)
                            (if (== (fnLen op) 1)
                              false
                              (|| (!= (fnLen op) 3)
                                (if (fpIsDColonAtom (fnKid op 1))
                                  false
                                  true))))))
                    {
                      (fpBad p)
                      (set i (fnLen n))
                    }
                    {
                      (fpP p "\n")
                      (foEmitIndent o)
                      (fpP p "(")
                      (fpP p (fnText src (fnKid op 0)))
                      (if (== (fnLen op) 3)
                        {
                          (fpP p " :: ")
                          (if (|| (fpIsIdentAtom (fnKid op 2)) (== (fnKind (fnKid op 2)) FN_PAREN))
                            (fpType p (fnKid op 2))
                            (fpExpr p (fnKid op 2)))
                        }
                        p)
                      (fpP p ")")
                      (set i (+ i 1))
                    })
                })
              (if had
                (foPopIndent o)
                o)
            }
          }
          (fpP p ")")
        }
      })
  })

; A field's type slot, printed as written. `fpType` refuses anything
; that is not a type, and the two shapes AX3056 names put something
; else there - so an unreadable slot goes through the expression
; printer instead, exactly as an effect operation's does for AX3055.
(pub :: fpFieldTy (-> Int Int Int))
(pub fn (fpFieldTy p t)
  (if (|| (fpIsIdentAtom t) (== (fnKind t) FN_PAREN))
    (fpType p t)
    (fpExpr p t)))

(pub :: fpDeclMacro (-> Int Int Int))
(pub fn (fpDeclMacro p n)
  ; The RULE form - `(macro name ((name args...) decl...))` and
  ; `(emacro name ((name pat...) expr))` - is a bare identifier where
  ; the head-list form has a paren. Its interior is copied VERBATIM
  ; from the source: a declaration template holds DECLARATIONS and an
  ; expression template holds EXPRESSIONS, and the expression
  ; printer's normalisations are semantically destructive in either -
  ; probed, it rewrote a template `(fn (nm) 42)` into
  ; `(lambda (nm) 42)` and flattened the pattern's parens, turning a
  ; compiling file into a refused one. A formatter region it does not
  ; understand is copied, not normalised; comments inside the template
  ; survive for the same reason.
  {
    (let src (fpSrc p))
    (let b (fpDeclBase src n))
    (if (&& (>= (fnLen n) (+ b 3))
          (&& (fpIsIdentAtom (fnKid n (+ b 1))) (== (fnKind (fnKid n (+ b 2))) FN_PAREN)))
      {
        (let tail (fpExprElems n (+ b 2)))
        (if (< (vecLen tail) 1)
          (fpBad p)
          ; EVERY rule, verbatim and in order (MAC-LANG-14): a
          ; rule-form macro is a list of rules now, and printing
          ; only the first would delete the others from a file the
          ; formatter claims to round-trip. Rules after the first
          ; are laid out one per line at the macro's own indent,
          ; which is the shape the corpus writes them in.
          {
            (let mut ri 0)
            {
              (fpP p "(")
              (fpVis p n)
              (fpP p (concat (fpDeclHead src n) " "))
              (fpP p (fnText src (fnKid n (+ b 1))))
              (while (< ri (vecLen tail))
                {
                  (let rule (vecGet tail ri))
                  {
                    (if (== ri 0)
                      (fpP p " ")
                      (fpP p "\n  "))
                    (fpP p (strSlice src (fnStart rule) (- (fnEnd rule) (fnStart rule))))
                    (set ri (+ ri 1))
                  }
                })
              (fpP p ")")
            }
          })
      }
      {
        (let tmpl (fpExprElems n (+ b 2)))
        (if (|| (< (fnLen n) (+ b 3))
              (|| (!= (vecLen tmpl) 1)
                (|| (!= (fnKind (fnKid n (+ b 1))) FN_PAREN)
                  (|| (< (fnLen (fnKid n (+ b 1))) 1)
                    (if (fpIsIdentAtom (fnKid (fnKid n (+ b 1)) 0))
                      false
                      true)))))
          (fpBad p)
          {
            (let hd (fnKid n (+ b 1)))
            (let mut i 1)
            {
              (fpP p "(")
              (fpVis p n)
              (fpP p "macro (")
              (fpP p (fnText src (fnKid hd 0)))
              (while (< i (fnLen hd))
                {
                  (fpP p " ")
                  (set i (fpPatVecAt p (fnKidsVec hd) i))
                })
              (fpP p ") ")
              (fpExpr p (vecGet tmpl 0))
              (fpP p ")")
            }
          })
      })
  })

(pub :: fpDecl (-> Int Int Int))
(pub fn (fpDecl p n)
  {
    (let h (fpDeclHead (fpSrc p) n))
    (if (strEq h "import")
      (fpDeclImport p n)
      (if (strEq h "define")
        (fpBad p)
        (if (strEq h "fn")
          (fpDeclFn p n)
          (if (strEq h "::")
            (fpDeclSig p n)
            (if (strEq h "data")
              (fpDeclData p n)
              (if (strEq h "newtype")
                (fpDeclNewtype p n)
                (if (strEq h "struct")
                  (fpDeclStruct p n)
                  (if (strEq h "type")
                    (fpDeclType p n)
                    (if (strEq h "subtype")
                      (fpDeclSubtype p n)
                      (if (fpIsRemovedDeclHead h)
                        ; A REMOVED declaration keyword: refused, not
                        ; printed. `fpIsRefusedHead` is this rule in
                        ; expression position; this is the declaration
                        ; half, and it arrived four commits late.
                        (fpBad p)
                        (if (strEq h "effect")
                          (fpDeclEffect p n)
                          (if (strEq h "extern")
                            (fpDeclExtern p n)
                            (if (strEq h "macro")
                              (fpDeclMacro p n)
                              ; Any other head is a DECLARATION MACRO INVOCATION (the parser's
                              ; TAG_D_MACROCALL since 2026-08-14), printed through the
                              ; expression printer - which already normalises spacing and glues
                              ; qualified names - because an invocation IS call-shaped. This
                              ; used to be `fpBad`, so every file using the feature was
                              ; unformattable with the least informative refusal in the
                              ; toolchain. A singleton `(m)` keeps its parens here:
                              ; `fpApp`'s singleton unwrap is correct in expression
                              ; position - `(x)` IS `x` - but a bare `m` at top
                              ; level is not a declaration at all, so unwrapping
                              ; would print a file `check` refuses.
                              (if (&& (== (fnKind n) FN_PAREN) (== (fnLen n) 1))
                                {
                                  (fpP p "(")
                                  (fpExpr p (fnKid n 0))
                                  (fpP p ")")
                                }
                                (fpExpr p n)))))))))))))))
  })

; An AXTAG line, reconstructed the way stage0's parser splits it: the
; key up to the first `(`, the value to the LAST `)`. Text outside
; that shape is normalised away, including an unclosed paren gaining
; its close.
(pub :: fpAxtag (-> Int Int Int))
(pub fn (fpAxtag p tok)
  {
    (let src (fpSrc p))
    (let s (+ (ftStart tok) 8))
    (let e (ftEnd tok))
    {
      (let mut paren e)
      (let mut i s)
      {
        (while (< i e)
          {
            (if (&& (== (strByte src i) 40) (== paren e))
              (set paren i))
            (set i (+ i 1))
          })
        (fpP p ";@axiom:")
        (if (== paren e)
          (fpSlice p s e)
          {
            (let mut close (- e 1))
            {
              (while (&& (> close paren) (!= (strByte src close) 41))
                (set close (- close 1)))
              (fpSlice p s paren)
              (fpP p "(")
              (fpSlice p (+ paren 1)
                (if (== close paren)
                  e
                  close))
              (fpP p ")")
            }
          })
      }
    }
  })

; ------------------------------------------------------------------
; The module printer and the driver's entry points.
; ------------------------------------------------------------------
(pub :: fpIsAxtagAtom (-> Int Bool))
(pub fn (fpIsAxtagAtom n)
  (if (== (fnKind n) FN_ATOM)
    (== (ftKind (fnTok n)) FT_AXTAG)
    false))

; One declaration with stage0's per-declaration choreography: the
; One declaration: the blank-line separator unless this one sticks
; to the previous - an import after an import, or a `fn` after its
; own `::` - then leading comments, the mark for the trailing
; comment taken BEFORE the axtags print, the axtags, the declaration,
; the trailing comment, the newline.
(pub :: fpEmitDecl (-> Int Int Ints Int Int))
(pub fn (fpEmitDecl p stick tags n)
  {
    (let src (fpSrc p))
    (let o (fpOut p))
    {
      (if (== stick 1)
        p
        (fpP p "\n"))
      (flushLeading src (fpQ p) o (fpDeclAnchor src n))
      {
        (let mark (foNl o))
        {
          {
            (let mut t 0)
            (while (< t (vecLen tags))
              {
                (foEmitIndent o)
                (fpAxtag p (vecGet tags t))
                (fpP p "\n")
                (set t (+ t 1))
              })
          }
          (fpDecl p n)
          (flushTrailing src (fpQ p) o (fpStartsVec p) (fpDeclAnchor src n) mark)
        }
      }
      (fpP p "\n")
    }
  })

; Keep declarations in source order so comments and documentation remain
; beside their declarations. Imports must form the module header.
(pub :: fmtPrint (-> String Ints Int Ints Int))
(pub fn (fmtPrint src forms coms starts)
  {
    (let o (mkFOut 0))
    (let q (mkFCq coms))
    {
      (let p (mkFPr src (as starts Int) q o))
      (let declTags vecNew)
      (let declNodes vecNew)
      (let mut pending vecNew)
      (let mut i 0)
      {
        (while (< i (vecLen forms))
          {
            (let f (vecGet forms i))
            {
              (if (fpIsAxtagAtom f)
                (vecPush pending (fnTok f))
                (if (|| (!= (fnKind f) FN_PAREN) (== (fnLen f) 0))
                  (foSetBad o)
                  {
                    (let h (fpDeclHead src f))
                    (if (|| (fpIsDeclHead h)
                          (&& (> (fnLen f) (fpDeclBase src f))
                            {
                              (let hk (fnKid f (fpDeclBase src f)))
                              (|| (fpIsIdentAtom hk) (== (fnKind hk) FN_QUAL))
                            }))
                      {
                        (if (&& (strEq h "import")
                              (&& (> (vecLen declNodes) 0)
                                (!
                                  (strEq
                                    (fpDeclHead src (vecGet declNodes (- (vecLen declNodes) 1)))
                                    "import"))))
                          (foSetBad o))
                        (vecPush declTags (as pending Int))
                        (vecPush declNodes f)
                        (set pending vecNew)
                      }
                      (foSetBad o))
                  }))
              (set i (+ i 1))
            }
          })
        (if (> (vecLen pending) 0)
          (foSetBad o))
        {
          (let mut j 0)
          (let mut prevHead "")
          (let mut prevName "")
          (while (< j (vecLen declNodes))
            {
              (let f (vecGet declNodes j))
              {
                (let h (fpDeclHead src f))
                (let nm (fpDeclName src f))
                {
                  (fpEmitDecl p
                    (if (|| (== j 0)
                          (|| (&& (strEq prevHead "import") (strEq h "import"))
                            (&& (strEq prevHead "::")
                              (&& (strEq h "fn")
                                (&& (!= (strLen prevName) 0) (strEq prevName nm))))))
                      1
                      0)
                    (vecGetVec declTags j) f)
                  (set prevHead h)
                  (set prevName nm)
                  (set j (+ j 1))
                }
              }
            })
        }
        (flushRemaining src q o)
        o
      }
    }
  })

; The result of one formatting pass: `ok` and the text.
(pub struct FRes
  (ok : Int)
  (text : String))

(pub :: fzOk (-> Int Int))
(pub fn (fzOk r)
  (memGetWord r 0))

(pub :: fzText (-> Int String))
(pub fn (fzText r)
  (memGetWordStr r 1))

(pub :: fmtOnce (-> String Int Int))
(pub fn (fmtOnce src allowComplete)
  ; `allowComplete` bounds the missing-closer completion below to ONE
  ; round: the completed text is formatted with 0, so a second failure
  ; refuses instead of completing again. Completion converges when the
  ; only defect is missing closers, but an unterminated string literal
  ; swallows every appended closer into itself - `(fn (main) "abc`
  ; became `(fn (main) "abc)))))...`, one `)` per round, never
  ; balancing - and the loop grew the string until the process died
  ; (measured: `fmt --check` spinning past 90 s on three lines,
  ; SIGKILL under the degenerate bank). A bound, not a shape check,
  ; because any non-converging defect deserves the same refusal.
  {
    (let sc (fscan src))
    (if (== (fscanHasError sc) 1)
      (as (FRes :ok 0 :text "") Int)
      (if (== (fscanCovers src sc) 0)
        (as (FRes :ok 0 :text "") Int)
        ; The depth check runs BEFORE `readForms`, because the failure it
        ; prevents is that call exhausting the stack - the same placement
        ; and the same reason as `parseModuleWith`'s. It routes into the
        ; refusal this function already has for every input it cannot
        ; print, so a file too deep to format is left untouched and
        ; exits 1, where it used to take the process down with SIGNAL 11.
        ; The refusal names AX2005 in its text slot, which a refusal
        ; otherwise leaves empty: counting each `.name` link as a level,
        ; this walk refuses some files `check` accepts, and the driver
        ; says so with the code rather than a bare refusal.
        (if (>= (fNestOverflow (fsToksVec sc) parseMaxDepth) 0)
          (as (FRes :ok 0 :text "AX2005") Int)
          {
            (let forms (readForms src (fsToksVec sc)))
            (if (== (as forms Int) 0)
              (if (== allowComplete 0)
                ; The completed text, failing again: completion had its
                ; round and the file is broken another way. Refuse.
                (as (FRes :ok 0 :text "") Int)
                ; Unclosed groups are completed, everything else is
                ; refused. A file whose only defect is missing closers -
                ; the shape an editor holds mid-function - is finished
                ; with exactly the closers its open groups need, in LIFO
                ; order, and formatted from there; the completed text
                ; goes through the same rescan, comments and fixed-point
                ; verification below as any other input. The closers go
                ; before a line comment that runs to end-of-file, never
                ; inside it - appending past one would leave the groups
                ; open again, recursing without end. A stray closer, a
                ; mismatched one, or a prefix with nothing after it
                ; completes to nothing, so those still refuse - and a
                ; refusal still writes nothing. Inlined loop over the
                ; token vector (which `fscan` already built), nothing
                ; allocated but the stack and the completed string: no
                ; new top-level function moves the effect-distribution
                ; pins. Terminates by construction, not by balance: the
                ; completed text is formatted with completion disallowed
                ; (`allowComplete` above), so a second failure refuses
                ; rather than completing again. Balance alone does not
                ; terminate it - an unterminated string swallows every
                ; appended closer and the stack never empties.
                {
                  (let toks (fsToksVec sc))
                  {
                    (let st vecNew)
                    {
                      (let mut i 0)
                      {
                        (let mut bad 0)
                        {
                          (while (&& (== bad 0) (< i (vecLen toks)))
                            {
                              {
                                (let k (ftKind (vecGet toks i)))
                                (if (|| (== k FT_LPAREN) (|| (== k FT_LBRACK) (== k FT_LBRACE)))
                                  (vecPush st (closerFor k))
                                  (if (isCloser k)
                                    (if (== (vecLen st) 0)
                                      (set bad 1)
                                      (if (!= (vecGet st (- (vecLen st) 1)) k)
                                        (set bad 1)
                                        (vecPop st)))
                                    ; A string literal with no closing quote
                                    ; swallows every closer the completion
                                    ; appends: the `)` scans as string content,
                                    ; the groups are still open, and `fmtOnce`
                                    ; recurses without end (measured: the
                                    ; process never answers, exit 137 under the
                                    ; gate, on `(fn (main) "abc`). The trailing
                                    ; line comment below gets its `ins` for the
                                    ; same reason - its closers would land
                                    ; inside it - but a string has no outside
                                    ; to put them in, so an open one refuses.
                                    (if (== k FT_STR)
                                      {
                                        (let ts (ftStart (vecGet toks i)))
                                        (let te (ftEnd (vecGet toks i)))
                                        (let sl (strLen src))
                                        (if (< te sl)
                                          ()
                                          ; Stopped at a closing quote before
                                          ; end of input: closed.
                                          (if (|| (> te sl) (<= te (+ ts 1)))
                                            ; Past end of input (a backslash ate
                                            ; it), or the quote alone: no
                                            ; closing quote at all.
                                            (set bad 1)
                                            (if (!= (strByte src (- te 1)) 34)
                                              (set bad 1)
                                              ; Ends in a quote that may itself
                                              ; be escaped: `"a\"` is still
                                              ; open. An odd run of backslashes
                                              ; quotes the quote.
                                              {
                                                (let mut j (- te 2))
                                                (let mut bs 0)
                                                {
                                                  (while (&& (> j ts) (== (strByte src j) 92))
                                                    {
                                                      (set bs (+ bs 1))
                                                      (set j (- j 1))
                                                    })
                                                  (if (== (% bs 2) 1)
                                                    (set bad 1))
                                                }
                                              })))
                                      })))
                              }
                              (set i (+ i 1))
                            })
                          (if (|| (== bad 1) (== (vecLen st) 0))
                            (as (FRes :ok 0 :text "") Int)
                            {
                              (let mut ins (strLen src))
                              {
                                (let coms (fsComsVec sc))
                                {
                                  (let mut ci 0)
                                  {
                                    (while (< ci (vecLen coms))
                                      {
                                        {
                                          (let c (vecGet coms ci))
                                          (if (&& (== (fcEnd c) (strLen src))
                                                (&& (== (strByte src (fcStart c)) 59)
                                                  (< (fcStart c) ins)))
                                            (set ins (fcStart c)))
                                        }
                                        (set ci (+ ci 1))
                                      })
                                    {
                                      (let mut out (strSlice src 0 ins))
                                      {
                                        (let mut j (- (vecLen st) 1))
                                        {
                                          (while (>= j 0)
                                            {
                                              {
                                                (let ck (vecGet st j))
                                                (set out (concat out
                                                           (if (== ck FT_RPAREN)
                                                             ")"
                                                             (if (== ck FT_RBRACK)
                                                               "]"
                                                               "}"))))
                                              }
                                              (set j (- j 1))
                                            })
                                          (set out (concat out
                                                     (strSlice src ins (- (strLen src) ins))))
                                          (fmtOnce out 0)
                                        }
                                      }
                                    }
                                  }
                                }
                              }
                            })
                        }
                      }
                    }
                  }
                })
              {
                (let out (fmtPrint src forms (fsComs sc) (lineStarts src)))
                (if (== (foBad out) 1)
                  (as (FRes :ok 0 :text "") Int)
                  (as (FRes :ok 1 :text (foFinish out)) Int))
              })
          })))
  })

; The comment texts of `src`, for the count-and-content check.
(pub :: fmtComTexts (-> String Strings))
(pub fn (fmtComTexts src)
  {
    (let sc (fscan src))
    (let v vecNew)
    {
      (let coms (fsComsVec sc))
      (let mut i 0)
      {
        (while (< i (vecLen coms))
          {
            (vecPush v (fcText src (vecGet coms i)))
            (set i (+ i 1))
          })
        v
      }
    }
  })

; Format with stage0's three-part verification: the output must
; rescan and re-read, must carry exactly the comments the input
; carried, and must be a fixed point of a second pass. Refusal is the
; only alternative to a faithful rewrite - except unclosed groups,
; which are completed first (see `fmtOnce`): the completed text goes
; through this same verification, so what it proves, it proves about
; the file as written plus its missing closers.
;
; A leading byte order mark is lifted off before the scan and put
; back on the result - the one subcommand that still refused a BOM
; file after the lexer learned to skip one (2026-08-21): `fscan` is
; its own scanner, `fscanCovers` asks that every byte be a token or a
; comment, and three bytes that are neither failed it. The mark is
; KEPT rather than dropped because the editor that wrote it expects
; it, and `fmt --check` compares the rewrite against the file as
; read.
(pub :: fmtFormat (-> String Int))
(pub fn (fmtFormat src)
  {
    (let skip (pastBom src 0))
    (if (== skip 0)
      (fmtFormatBody src)
      {
        (let r (fmtFormatBody (strSlice src skip (- (strLen src) skip))))
        (if (== (fzOk r) 0)
          r
          (as (FRes :ok 1 :text (concat (strSlice src 0 skip) (fzText r))) Int))
      })
  })

(pub :: fmtFormatBody (-> String Int))
(pub fn (fmtFormatBody src)
  {
    (let r1 (fmtOnce src 1))
    (if (== (fzOk r1) 0)
      r1
      {
        (let t1 (fzText r1))
        {
          (let r2 (fmtOnce t1 0))
          (if (== (fzOk r2) 0)
            (as (FRes :ok 0 :text "") Int)
            (if (if (strEq (fzText r2) t1)
              false
              true)
              (as (FRes :ok 0 :text "") Int)
              {
                (let before (fmtComTexts src))
                (let after (fmtComTexts t1))
                (if (!= (vecLen before) (vecLen after))
                  (as (FRes :ok 0 :text "") Int)
                  {
                    (let mut i 0)
                    (let mut same 1)
                    {
                      (while (< i (vecLen before))
                        {
                          (if (! (strEq (vecGetStr before i) (vecGetStr after i)))
                            (set same 0))
                          (set i (+ i 1))
                        })
                      (if (== same 1)
                        r1
                        (as (FRes :ok 0 :text "") Int))
                    }
                  })
              }))
        }
      })
  })
