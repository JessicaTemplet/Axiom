;;! What `;@axiom:nolint(...)` quiets: the editor's lint hints, the
;;! checker's warnings, or both, per declaration or for a whole file.
;;! `docs/reference.md` ("nolint: quiet hints and warnings") is the
;;! user's page; this module is the one reading of the tag that the
;;! language server, `axiom check` and the build share.
;
; THE TAG IS READ IN ONE PLACE. The server read `nolint` for its own
; three hints and nothing else read it, so a warning the checker
; drew could not be quieted anywhere, and a user prototyping with an
; `effect(pure)` claim the walk cannot verify saw AX3037 on every
; keystroke with no way to say "I know". Rust's `#[allow(...)]` is the
; shape users expect: a name or a group, on an item or on the whole
; file, and the compiler honours it in the terminal as the editor does.
;
; WHAT IT NEVER QUIETS: an error. A warning is a stated limit of the
; analysis (docs/roadmap.md); an error is a defect, and a tag that
; made one disappear would be the silent-wrong-answer shape this
; repository names most often. `nolintQuietDiags` keeps every
; diagnostic whose severity is not `SEV_WARNING`.
;
; THE FILE-WIDE FORM is a tag above an `import`. A tag belongs to the
; declaration after it (`attachAxtags`), and an import has nothing of
; its own to quiet, so a `nolint` that lands on one is read as the
; file's: Rust's `#![allow]` at the head of a module, in the one
; position Axiom's tags already have.
(import core)
(import Mem)
(import Str)
(import Vec)
(import parser)
(import diag)

;; The names `nolint(...)` accepts: the three editor hints, the
;; groups `hints`, `warnings` and `all`, and a warning code written
;; `AXnnnn`.
(pub :: nolintKnownName (-> String Bool))
(pub fn (nolintKnownName name)
  (if (|| (strEq name "all")
        (|| (strEq name "hints")
          (|| (strEq name "warnings")
            (|| (strEq name "lint-dead-branch")
              (|| (strEq name "lint-bool-if") (strEq name "lint-unused-let"))))))
    true
    (nolintIsCode name)))

;; Whether `name` is spelled like a diagnostic code: `AX` and four
;; digits.
(pub :: nolintIsCode (-> String Bool))
(pub fn (nolintIsCode name)
  (if (!= (strLen name) 6)
    false
    (if (!= (strByte name 0) 65)
      false
      (if (!= (strByte name 1) 88)
        false
        (nolintDigitsFrom name 2)))))

(:: nolintDigitsFrom (-> String Int Bool))
(fn (nolintDigitsFrom s i)
  (if (>= i (strLen s))
    true
    (if (|| (< (strByte s i) 48) (> (strByte s i) 57))
      false
      (nolintDigitsFrom s (+ i 1)))))

;; The names one tag's content lists, as a `Vec` of strings, or an
;; empty one when the content is not a `nolint(...)` tag. `content`
;; is what followed `;@axiom:`, such as `nolint(lint-unused-let, all)`:
;; the key is the bytes before the first `(`, and the value runs to
;; the last `)` (`ctCloseAt`'s rule).
(pub :: nolintNames (-> String Ints))
(pub fn (nolintNames content)
  {
    (let out vecNew)
    {
      (let op
        (match (strFindByte content 40 0)
          ((None) (- 0 1))
          ((Some k) k)))
      (if (< op 0)
        out
        (if (strEq (strSlice content 0 op) "nolint")
          {
            (let parts (strSplit (strSlice content (+ op 1) (- (ctCloseAt content) (+ op 1))) 44))
            {
              (let mut i 0)
              {
                (while (< i (vecLen parts))
                  {
                    {
                      (let t (strTrim (vecGetStr parts i)))
                      (if (! (== (strLen t) 0))
                        (vecPushStr out t))
                    }
                    (set i (+ i 1))
                  })
                out
              }
            }
          }
          out))
    }
  })

;; Whether a set of names quiets `code`. `kind` is 1 for an editor
;; hint and 0 for a checker warning: `all` quiets both, `hints` the
;; hints and `warnings` the warnings, and a name quiets its own code.
(pub :: nolintCovers (-> Ints String Int Bool))
(pub fn (nolintCovers names code kind)
  {
    (let mut i 0)
    (let mut hit false)
    {
      (while (< i (vecLen names))
        {
          {
            (let n (vecGetStr names i))
            (if (|| (strEq n code)
                  (|| (strEq n "all")
                    (if (== kind 1)
                      (strEq n "hints")
                      (strEq n "warnings"))))
              (set hit true))
          }
          (set i (+ i 1))
        })
      hit
    }
  })

; The table: word 0 the file-wide names, word 1 the owners (declaration
; names) and word 2 their name vectors, parallel. Built once per
; document from the tags `attachAxtags` put in word 7 of each
; declaration.
(pub :: nolintTable (-> Ints Int))
(pub fn (nolintTable decls)
  {
    (let t (memAlloc 32))
    {
      (memSetWord t 0 vecNew)
      (memSetWord t 1 vecNew)
      (memSetWord t 2 vecNew)
      {
        (let mut i 0)
        (while (< i (vecLen decls))
          {
            (nolintTableDecl t (vecGet decls i))
            (set i (+ i 1))
          })
      }
      t
    }
  })

(:: nolintTableDecl (-> Int Int Int))
(fn (nolintTableDecl t d)
  (if (== (memGetWord d 7) 0)
    0
    {
      (let tags (memGetWordVec d 7))
      (let mut i 0)
      {
        (while (< i (vecLen tags))
          {
            {
              (let names (nolintNames (memGetWordStr (vecGet tags i) 1)))
              (if (! (== (vecLen names) 0))
                (if (== (nodeTag d) TAG_D_IMPORT)
                  (nolintAppend (memGetWordVec t 0) names)
                  (nolintTableAdd t (nodeAName d) names)))
            }
            (set i (+ i 1))
          })
        0
      }
    }))

(:: nolintAppend (-> Ints Ints Int))
(fn (nolintAppend into names)
  {
    (let mut i 0)
    {
      (while (< i (vecLen names))
        {
          (vecPush into (vecGet names i))
          (set i (+ i 1))
        })
      0
    }
  })

; Merge under an owner: a tag above each half of a `::`/`fn` pair is
; two entries for one declaration.
(:: nolintTableAdd (-> Int String Ints Int))
(fn (nolintTableAdd t owner names)
  {
    (let owners (memGetWordVec t 1))
    (let sets (memGetWordVec t 2))
    (let mut j 0)
    (let mut at (- 0 1))
    {
      (while (< j (vecLen owners))
        {
          (if (strEq (vecGetStr owners j) owner)
            (set at j))
          (set j (+ j 1))
        })
      (if (< at 0)
        {
          (vecPushStr owners owner)
          (vecPushVec sets names)
          0
        }
        (nolintAppend (vecGetVec sets at) names))
    }
  })

;; Whether the table quiets `code` (of `kind`: 1 hint, 0 warning) on
;; the declaration named `owner`: by the file-wide names, or by the
;; owner's own.
(pub :: nolintQuiets (-> Int String String Int Bool))
(pub fn (nolintQuiets t owner code kind)
  (if (nolintCovers (memGetWordVec t 0) code kind)
    true
    {
      (let owners (memGetWordVec t 1))
      (let sets (memGetWordVec t 2))
      (let mut j 0)
      (let mut hit false)
      {
        (while (< j (vecLen owners))
          {
            (if (strEq (vecGetStr owners j) owner)
              (if (nolintCovers (vecGetVec sets j) code kind)
                (set hit true)))
            (set j (+ j 1))
          })
        hit
      }
    }))

; The declaration a byte offset belongs to: the last one whose span
; starts at or before it. Declarations come in source order and a
; `::` and its `fn` share a name, so a warning anywhere in either half
; resolves to the owner both halves' tags were merged under. "" when
; no declaration starts before the offset.
(pub :: nolintOwnerAt (-> Ints Int String))
(pub fn (nolintOwnerAt decls off)
  {
    (let mut i 0)
    (let mut owner "")
    {
      (while (< i (vecLen decls))
        {
          {
            (let d (vecGet decls i))
            (if (!= (nodeSpan d) 0)
              (if (<= (spanStart (nodeSpan d)) off)
                (set owner (nodeAName d))
                owner)
              owner)
          }
          (set i (+ i 1))
        })
      owner
    }
  })

;; The checker's diagnostics for this file with the quieted warnings
;; taken out. Every error stays. A warning goes when the file-wide
;; names cover it, or when the names on the declaration it sits in
;; do. Diagnostics from another unit (an imported module) are left
;; alone: that file's own tags decide for it.
(pub :: nolintQuietDiags (-> Ints Ints Ints))
(pub fn (nolintQuietDiags decls diags)
  {
    (let t (nolintTable decls))
    (if (&& (== (vecLen (memGetWordVec t 0)) 0) (== (vecLen (memGetWordVec t 1)) 0))
      diags
      {
        (let out vecNew)
        (let mut i 0)
        {
          (while (< i (vecLen diags))
            {
              {
                (let d (vecGet diags i))
                (if (! (nolintDropDiag t decls d))
                  (vecPush out d))
              }
              (set i (+ i 1))
            })
          out
        }
      })
  })

(:: nolintDropDiag (-> Int Ints Int Bool))
(fn (nolintDropDiag t decls d)
  (if (!= (diagSev d) SEV_WARNING)
    false
    (if (!= (diagUnit d) 0)
      false
      (if (== (diagSpan d) 0)
        (nolintQuiets t "" (diagCode d) 0)
        (nolintQuiets t (nolintOwnerAt decls (spanStart (diagSpan d))) (diagCode d) 0)))))
