{
  "Function": {
    "prefix": "fn",
    "body": [
      "(:: ${1:name} (-> ${2:Int} ${3:Int}))",
      "(fn (${1:name} ${4:x})",
      "  {",
      "    $0",
      "  })"
    ],
    "description": "A typed function"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "(import IO)",
      "",
      "(:: main ())",
      ";@axiom:effect(io)",
      "(fn (main) (println \"${1:hello}\"))"
    ],
    "description": "A runnable program"
  },
  "Let": {
    "prefix": "let",
    "body": [
      "(let ${1:x} ${2:value})"
    ],
    "description": "A block local"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "(match ${1:value}",
      "  ((${2:Nothing}) ${3:default})",
      "  ((${4:Just} ${5:x}) ${5:x}))"
    ],
    "description": "A pattern match"
  },
  "Data": {
    "prefix": "data",
    "body": [
      "(data ${1:Name} (${2:a})",
      "  (${3:None})",
      "  (${4:Some} ${2:a}))"
    ],
    "description": "An algebraic data type"
  },
  "Import": {
    "prefix": "import",
    "body": [
      "(import ${1:IO})"
    ],
    "description": "An import"
  },
  "Mutable local": {
    "prefix": "letmut",
    "body": [
      "(let mut ${1:x} ${2:value})"
    ],
    "description": "An assignable block local"
  },
  "Struct": {
    "prefix": "struct",
    "body": [
      "(struct ${1:Point}",
      "  (${2:x} : ${3:Int})",
      "  (${4:y} : ${5:Int}))"
    ],
    "description": "A struct with named fields"
  },
  "Struct construction": {
    "prefix": "record",
    "body": [
      "(${1:Point} :${2:x} ${3:value} :${4:y} ${5:value})"
    ],
    "description": "Construct a struct by field name"
  }
}
