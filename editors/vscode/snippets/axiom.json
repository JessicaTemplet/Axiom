{
  "Function": {
    "prefix": "fn",
    "body": [
      "(:: ${1:name} (-> ${2:Int} ${3:Int}))",
      "(fn (${1:name} ${4:x})",
      "  $0)"
    ],
    "description": "A typed function"
  },
  "Main": {
    "prefix": "main",
    "body": [
      "(import IO)",
      "",
      "(:: main ())",
      ";@axiom:effect(io)",
      "(fn (main) (println \"${1:hello}\"))"
    ],
    "description": "A runnable program"
  },
  "Let": {
    "prefix": "let",
    "body": [
      "(let ((${1:x} ${2:value}))",
      "  $0)"
    ],
    "description": "A let binding"
  },
  "Match": {
    "prefix": "match",
    "body": [
      "(match ${1:value}",
      "  ((${2:Nothing}) ${3:default})",
      "  ((${4:Just} ${5:x}) ${5:x}))"
    ],
    "description": "A pattern match"
  },
  "Data": {
    "prefix": "data",
    "body": [
      "(data ${1:Name} (${2:a})",
      "  (${3:None})",
      "  (${4:Some} ${2:a}))"
    ],
    "description": "An algebraic data type"
  },
  "Import": {
    "prefix": "import",
    "body": ["(import ${1:IO})"],
    "description": "An import"
  }
}
