{
  "name": "axiom-language",
  "displayName": "Axiom",
  "description": "Axiom language support: highlighting, diagnostics, hover, completion and the other language-server features.",
  "version": "0.7.8",
  "publisher": "axiom-lang",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/chrispaig3/axiom"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./extension.js",
  "activationEvents": [
    "onLanguage:axiom"
  ],
  "contributes": {
    "languages": [
      {
        "id": "axiom",
        "aliases": [
          "Axiom",
          "axiom"
        ],
        "extensions": [
          ".ax"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "axiom",
        "scopeName": "source.axiom",
        "path": "./syntaxes/axiom.tmLanguage.json"
      }
    ],
    "configuration": {
      "title": "Axiom",
      "properties": {
        "axiom.serverPath": {
          "type": "string",
          "default": "axiom",
          "description": "The axiom executable. The extension runs it as `axiom lsp`. A bare name is looked up on PATH; otherwise give the absolute path."
        },
        "axiom.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "description": "Log the messages between VS Code and the Axiom language server in the Axiom output channel."
        }
      }
    },
    "commands": [
      {
        "command": "axiom.run",
        "title": "Axiom: Run file"
      },
      {
        "command": "axiom.expandMacro",
        "title": "Axiom: Expand macro at cursor"
      },
      {
        "command": "axiom.doc",
        "title": "Axiom: Open the documentation"
      },
      {
        "command": "axiom.restartServer",
        "title": "Axiom: Restart the language server"
      }
    ],
    "semanticTokenTypes": [
      {
        "id": "effect",
        "superType": "type",
        "description": "An effect name: a builtin such as IO or Alloc, or one declared with (effect ...)."
      },
      {
        "id": "region",
        "superType": "namespace",
        "description": "A region name: the binder of (region r ...) or (parallel r ...), or an @r annotation in a type."
      }
    ],
    "semanticTokenScopes": [
      {
        "language": "axiom",
        "scopes": {
          "namespace": ["entity.name.namespace.axiom"],
          "type": ["entity.name.type.axiom"],
          "type.declaration": ["entity.name.type.axiom"],
          "type.defaultLibrary": ["support.type.builtin.axiom"],
          "typeParameter": ["entity.name.type.parameter.axiom"],
          "parameter": ["variable.parameter.axiom"],
          "variable": ["variable.other.axiom"],
          "variable.readonly": ["variable.other.constant.axiom"],
          "variable.defaultLibrary": ["support.variable.axiom"],
          "property": ["variable.other.property.axiom"],
          "enumMember": ["entity.name.type.constructor.axiom"],
          "function": ["entity.name.function.call.axiom"],
          "function.declaration": ["entity.name.function.axiom"],
          "function.defaultLibrary": ["support.function.axiom"],
          "function.deprecated": ["invalid.deprecated.axiom"],
          "macro": ["entity.name.function.macro.axiom"],
          "macro.declaration": ["entity.name.function.macro.axiom"],
          "keyword": ["keyword.control.axiom"],
          "keyword.deprecated": ["invalid.deprecated.axiom"],
          "comment": ["comment.line.semicolon.axiom"],
          "comment.documentation": ["comment.block.documentation.axiom"],
          "string": ["string.quoted.double.axiom"],
          "number": ["constant.numeric.axiom"],
          "operator": ["keyword.operator.axiom"],
          "decorator": ["entity.other.attribute-name.axiom"],
          "effect": ["entity.name.type.effect.axiom", "storage.modifier.axiom"],
          "effect.defaultLibrary": ["support.type.effect.axiom", "storage.modifier.axiom"],
          "region": ["entity.name.label.axiom"]
        }
      }
    ]
  },
  "dependencies": {
    "vscode-languageclient": "^9.0.1"
  }
}
