(:: sum (-> (Vec Int) Int))
(fn (sum xs)
  (let ((mut total 0))
    {
      (for i in 0..16 by 2
;      ^^^ keyword
;            ^^ keyword
;               ^ number
;                ^^ operator
;                  ^^ number
;                     ^^ keyword
;                        ^ number
        (set total (+ total i)))
;        ^^^ keyword
;                   ^ operator
      (for x in xs (set total (+ total x)))
;      ^^^ keyword
;            ^^ keyword
      (for (x k) in xs (set total (+ total k)))
;      ^^^ keyword
;                ^^ keyword
      total
    }))

; Contextual keywords remain names outside a loop.
(:: in (-> Int Int))
(fn (in by) by)
;    ^^ function
;       ^^ variable.parameter
;           ^^ variable.parameter
