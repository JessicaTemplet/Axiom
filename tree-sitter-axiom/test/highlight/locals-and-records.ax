(struct Point (x : Int) (y : Int))
(fn (make input)
  {
    (let point (Point :y 20 :x input))
;    ^^^ keyword
;        ^^^^^ variable
;               ^^^^^ constructor
;                      ^ variable.member
;                        ^^ number
;                            ^ variable.member
;                              ^^^^^ variable.parameter
    (let mut total point.x)
;    ^^^ keyword
;        ^^^ keyword
;            ^^^^^ variable
;                        ^ variable.member
    {
      (let input total)
;      ^^^ keyword
;          ^^^^^ variable
      input
;     ^^^^^ variable
    }
    input
;   ^^^^^ variable.parameter
    point.y
;         ^ variable.member
  })

(:: current Int)
(fn (current) 42)
(fn (readCurrent) current)
;                ^^^^^^^ function

(struct Box (handle : Handle))
;                    ^^^^^^ type.builtin

(macro (fields record value)
  (syntax/for (field (syntax/fields record)) value.field))
;              ^^^^^ variable
