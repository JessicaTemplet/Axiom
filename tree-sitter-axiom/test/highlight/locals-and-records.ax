(struct Point (x : Int) (y : Int))
(fn (make input)
  {
    (let point (Point :y 20 :x input))
;    ^^^ keyword
;        ^^^^^ variable
;               ^^^^^ constructor
;                      ^ variable.member
;                        ^^ number
;                            ^ variable.member
;                              ^^^^^ variable.parameter
    (let mut total point.x)
;    ^^^ keyword
;        ^^^ keyword
;            ^^^^^ variable
;                        ^ variable.member
    {
      (let input total)
;      ^^^ keyword
;          ^^^^^ variable
      input
;     ^^^^^ variable
    }
    input
;   ^^^^^ variable.parameter
    point.y
;         ^ variable.member
  })
