;;! The standard prelude: the derivers every program can use.
;;!
;;! Import with `(import Pre (deriveEq deriveArity))`.

;; Derive structural equality for a `data` type with nullary
;; constructors: `(deriveEq Colour)` declares `eqColour`, of type
;; `(-> Colour Colour Bool)`, with one match arm per constructor.
;;
;; The arms come from the declaration list at expansion time
;; (macro-system.md MAC-CAP-5/9). A sum with fields wants the `impl`
;; form written where the `Eq` trait is in scope; see macro-system.md
;; section 10.2.
(pub macro deriveEq ((deriveEq T)
   (pub :: (syntax/join eq T) (-> T T Bool))
   (pub fn ((syntax/join eq T) a b)
     (match a
       (syntax/for (C (syntax/constructors T))
         ((C) (match b ((C) true) (_ false))))))))

;; Derive a function answering how many fields a value's constructor
;; carries: `(deriveArity Shape)` declares `arityShape`, of type
;; `(-> Shape Int)`.
;;
;; The count is `syntax/arity`'s answer, folded to a literal per arm.
;; It is not derivable any other way at run time: a heap block records
;; its tag, never its field count (memory-model.md MM-VAL-6).
(pub macro deriveArity ((deriveArity T)
   (pub :: (syntax/join arity T) (-> T Int))
   (pub fn ((syntax/join arity T) v)
     (match v
       (syntax/for (C (syntax/constructors T))
         ((C (syntax/binders C f)) (syntax/arity C)))))))
