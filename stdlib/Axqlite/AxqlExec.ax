;;! Axqlite.AxqlExec - planning and running one AXQL statement.
;;!
;;!     (axqlPlanSelect ex sel)            ; (Ok <SelectPlan>): bound, typed, planned
;;!     (axqlRunSelect ex plan onRow)      ; calls onRow with each result row
;;!     (axqlRunWrite ex parsed)           ; INSERT, UPDATE, DELETE or DDL
;
; The caller holds the lock a statement needs: a shared lock to read,
; the write transaction to write. This module never takes, commits or
; releases one.
;
; A statement is bound first: every column name becomes a column
; number, and a name the table doesn't have is `axqSchema`. Then its
; types are checked, with the parameters' values known, so a type
; mismatch is `axqType` before any row is read. Then every
; subexpression that names no column is folded to its value.
;
; Planning: the WHERE clause is split into its AND terms. A term
; `rowid = v` (or its INTEGER PRIMARY KEY column) reads one row. An
; equality on an index's leading column reads that index's range,
; UNIQUE indices first. Then ranges on the rowid, then ranges on an
; index's leading column. Anything else scans the table in rowid order.
; Whatever the plan, every term is checked on every row it reads, so
; the plan changes the cost and never the answer.
;
; Order: rows equal on every ORDER BY term come in rowid order. When
; the plan already reads rows in the order ORDER BY asks for, they
; stream; otherwise they are collected and sorted with a stable merge
; sort. The select list is evaluated only for the rows returned.
;
; Writes: UPDATE and DELETE collect the rowids they match before they
; change anything. Every row is checked (types, NOT NULL, each CHECK,
; the rowid, and each UNIQUE index) before it is written, and the links
; of the rows a statement wrote once all of them are written
; (`checkWritten`). A column's DEFAULT is worked out once per statement
; (`prepareRules`). When `ex.logging` is true, each change is recorded
; so a failed statement can be undone inside an explicit transaction.
;
; Links: a TableDef carries its LINK columns' target tables. A path
; `link.column` binds to a column past the table's own, in a row
; widened with each linked row (`widenRow`), and only the links a
; statement reads are fetched. A link to no row widens as NULLs.
;
; Grouping: a SELECT with GROUP BY, HAVING or an aggregate is planned by
; `planGrouped`. Each aggregate is replaced by a parameter past the
; statement's own (`liftAggs`), groups are found by hashing the key
; encoding of their GROUP BY values, and each group's row is worked out
; with its aggregates' values as those parameters.
(import Str)
(import Vec)
(import Map)
(import Err)
(import Fmt)
(import Axqlite.Value)
(import Axqlite.Pager)
(import Axqlite.Btree)
(import Axqlite.Record)
(import Axqlite.AxqlAst)
(import Axqlite.AxqlParse)
(import Axqlite.AxqlEval)
(import Axqlite.AxqlSchema)

; ------------------------------------------------------------------
; The execution context.
; ------------------------------------------------------------------
;; A change to reverse when a statement fails: put back an old value,
;; delete a key the statement added, drop a tree it created, or give up
;; (a dropped tree can't come back).
(pub data Undo
  (UPut Int String String)
  (UDel Int String)
  (UDrop Int)
  (UFatal))

;; One statement's context: the pager, the statement's text (for
;; messages), its parameters, the undo log, what it did, and the rows it
;; wrote to a table with links, whose links are checked when it ends.
(pub struct Exec
  (pager : Pager)
  (src : String)
  (params : (Vec Value))
  (logging : Bool)
  (undo : (Vec Undo))
  (mut changes : Int)
  (mut lastRowid : Int)
  (mut inserted : Bool)
  (written : (Vec RowRef)))

;; A context for running the statement `src` with `params`.
(pub :: axqlExec (-> Pager String (Vec Value) Bool Exec))
(pub fn (axqlExec pager src params logging)
  (Exec pager src params logging vecNew 0 0 false vecNew))

;; Reverse every change `undo` records, newest first. `Err` when one of
;; them can't be reversed; the caller then rolls back the transaction.
(pub :: axqlUndo (-> Pager (Vec Undo) (Result Int Error)))
;@axiom:effect(io)
(pub fn (axqlUndo pager undo)
  (let (
    (mut i (- (vecLen undo) 1))
    (mut failure None)
  )
    {
      (while (&& (isNone failure) (>= i 0))
        {
          (match (undoOne pager (vecGet undo i))
            ((Ok _) ())
            ((Err e)
              (set failure (Some e))
            ))
          (set i (- i 1))
        })
      (match failure
        ((Some e) (Err e))
        ((None) (Ok 0)))
    }))

(:: undoOne (-> Pager Undo (Result Int Error)))
;@axiom:effect(io)
(fn (undoOne pager u)
  (match u
    ((UPut root key old)
      (let ((_ (btreePut pager root key old)?))
        (Ok 0))
    )
    ((UDel root key)
      (let ((_ (btreeDelete pager root key)?))
        (Ok 0))
    )
    ((UDrop root)
      (let ((_ (btreeDrop pager root)?))
        (Ok 0))
    )
    ((UFatal) (axqErr axqMisuse "a dropped table or index can't be restored" "axqlUndo"))))

(:: logUndo (-> Exec Undo Int))
(fn (logUndo ex u)
  (if ex.logging
    {
      (vecPush ex.undo u)
      0
    }
    0))

; Put `key` -> `value` into a tree where the key must be new. `Ok false`
; when it was already there, and then nothing changed.
(:: putNew (-> Exec Int String String (Result Bool Error)))
;@axiom:effect(io)
(fn (putNew ex root key value)
  (let ((fresh (btreeInsertNew ex.pager root key value)?))
    {
      (if fresh
        (logUndo ex (UDel root key)))
      (Ok fresh)
    }))

; Replace the value under an existing key, whose old value is `old`.
(:: putOver (-> Exec Int String String String (Result Int Error)))
;@axiom:effect(io)
(fn (putOver ex root key value old)
  (let ((_ (btreePut ex.pager root key value)?))
    {
      (logUndo ex (UPut root key old))
      (Ok 0)
    }))

; Delete an existing key whose value is `old`.
(:: deleteKey (-> Exec Int String String (Result Int Error)))
;@axiom:effect(io)
(fn (deleteKey ex root key old)
  (let ((_ (btreeDelete ex.pager root key)?))
    {
      (logUndo ex (UPut root key old))
      (Ok 0)
    }))

(:: createTree (-> Exec Int (Result Int Error)))
;@axiom:effect(io)
(fn (createTree ex kind)
  (let ((root (btreeCreate ex.pager kind)?))
    {
      (logUndo ex (UDrop root))
      (Ok root)
    }))

(:: dropTree (-> Exec Int (Result Int Error)))
;@axiom:effect(io)
(fn (dropTree ex root)
  {
    (logUndo ex UFatal)
    (btreeDrop ex.pager root)
  })

; A message with the statement position in front, when there is one.
(:: atPos (-> Exec Int String String))
(fn (atPos ex at msg)
  (if (< at 0)
    msg
    (concat (concat (axqlPosText ex.src at) ": ") msg)))

; ------------------------------------------------------------------
; Binding.
; ------------------------------------------------------------------
; `e` with every name replaced by its column: a column of `t`, or -1 for
; `rowid` when no column has that name. `t` is `None` for a statement
; with no table, where every name is unknown.
(:: bind (-> Exec (Option TableDef) Expr (Result Expr Error)))
(fn (bind ex t e)
  (match e
    ((EName n at) (bindName ex t n at))
    ((ENeg x at)
      (let ((rx (bind ex t x)))
        (let ((bx rx?))
          (Ok (ENeg bx at))))
    )
    ((ENot x)
      (let ((rx (bind ex t x)))
        (let ((bx rx?))
          (Ok (ENot bx))))
    )
    ((EIsNull x neg)
      (let ((rx (bind ex t x)))
        (let ((bx rx?))
          (Ok (EIsNull bx neg))))
    )
    ((EBin op l r at)
      (let (
        (rl (bind ex t l))
        (rr (bind ex t r))
      )
        (let (
          (bl rl?)
          (br rr?)
        )
          (Ok (EBin op bl br at))))
    )
    ((EFun name args at)
      (let ((bs (bindAll ex t args)?))
        (Ok (EFun name bs at)))
    )
    ((EAgg k arg at)
      (match arg
        ((None) (Ok e))
        ((Some x)
          (let ((rx (bind ex t x)))
            (let ((bx rx?))
              (Ok (EAgg k (Some bx) at))))
        ))
    )
    ((ELike x pat negated at)
      (let (
        (rx (bind ex t x))
        (rp (bind ex t pat))
      )
        (let (
          (bx rx?)
          (bp rp?)
        )
          (Ok (ELike bx bp negated at))))
    )
    ((EIn x items negated at)
      (let ((rx (bind ex t x)))
        (let (
          (bx rx?)
          (bs (bindAll ex t items)?)
        )
          (Ok (EIn bx bs negated at))))
    )
    ((ELink l c at) (bindLink ex t l c at))
    (_ (Ok e))))

(:: bindAll (-> Exec (Option TableDef) (Vec Expr) (Result (Vec Expr) Error)))
(fn (bindAll ex t es)
  (let (
    (out vecNew)
    (mut failure None)
  )
    {
      (for e in es
        (if (isNone failure)
          (match (bind ex t e)
            ((Ok b) (vecPush out b))
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }))

; The names of a table's columns.
(:: colNames (-> TableDef (Vec String)))
(fn (colNames t)
  (let ((out vecNew))
    {
      (for c in t.cols
        (vecPush out c.name))
      out
    }))

; "; did you mean ...?" or the list of `t`'s columns, for a name `t`
; doesn't have.
(:: columnHint (-> TableDef String String))
(fn (columnHint t n)
  (axqlHint n (colNames t) (concat "columns of " t.name)))

(:: bindName (-> Exec (Option TableDef) String Int (Result Expr Error)))
(fn (bindName ex t n at)
  (match t
    ((None)
      (axqErr axqSchema
        (atPos ex at (concat (concat "no such column: " n) "; this statement reads no table"))
        "axqlBind")
    )
    ((Some td)
      (let ((ci (axqlColumnIndex td.cols n)))
        (if (>= ci 0)
          (Ok (ECol ci))
          (if (axqlNameEq n "rowid")
            (Ok (ECol -1))
            (axqErr axqSchema
              (atPos ex at (concat (concat "no such column: " n) (columnHint td n))) "axqlBind"))))
    )))

; The position in `t.links` of the link that is column `ci`, if any.
(:: linkNumber (-> TableDef Int (Option Int)))
(fn (linkNumber t ci)
  (let ((mut found None))
    {
      (for (ld k) in t.links
        (if (&& (isNone found) (== ld.col ci))
          (set found (Some k))))
      found
    }))

; Where link `k`'s columns start in a row widened with its linked rows.
(:: linkBase (-> TableDef Int Int))
(fn (linkBase t k)
  (let ((mut at (vecLen t.cols)))
    {
      (for (ld i) in t.links
        (if (< i k)
          (let ((tgt ld.target))
            (set at (+ at (vecLen tgt.cols))))))
      at
    }))

; `link.column`: the column of the row LINK column `l` points at, as a
; column of the widened row.
(:: bindLink (-> Exec (Option TableDef) String String Int (Result Expr Error)))
(fn (bindLink ex t l c at)
  (match t
    ((None)
      (axqErr axqSchema
        (atPos ex at (concat (concat "no such column: " l) "; this statement reads no table"))
        "axqlBind")
    )
    ((Some td)
      (let ((ci (axqlColumnIndex td.cols l)))
        (if (< ci 0)
          (axqErr axqSchema (atPos ex at (concat (concat "no such column: " l) (columnHint td l)))
            "axqlBind")
          (match (linkNumber td ci)
            ((None)
              (axqErr axqSchema
                (atPos ex at
                  (concat (concat l " isn't a LINK column, so ")
                    (concat l (concat "." (concat c " has no row to read")))))
                "axqlBind")
            )
            ((Some k)
              (let (
                (ld (vecGet td.links k))
                (tgt ld.target)
                (tc (axqlColumnIndex tgt.cols c))
              )
                (if (strEq c "*")
                  (axqErr axqSchema (atPos ex at (concat l ".* belongs in a SELECT list"))
                    "axqlBind")
                  (if (>= tc 0)
                    (Ok (ECol (+ (linkBase td k) tc)))
                    (if (axqlNameEq c "rowid")
                      (Ok (ECol ci))
                      (axqErr axqSchema
                        (atPos ex at
                          (concat (concat (concat "no such column: " c) (concat " in " tgt.name))
                            (columnHint tgt c)))
                        "axqlBind")))))
            ))))
    )))

; A widened row's column types: the table's, then each link's.
(:: widenedTypes (-> TableDef (Vec Int)))
(fn (widenedTypes t)
  (let ((out (axqlColumnTypes t)))
    {
      (for ld in t.links
        (let ((tgt ld.target))
          (for c in tgt.cols
            (vecPush out c.ctype))))
      out
    }))

; Which of `t`'s links the bound expressions `es` read through.
(:: linksRead (-> TableDef (Vec Expr) (Vec Bool)))
(fn (linksRead t es)
  (let (
    (cols vecNew)
    (out vecNew)
  )
    {
      (for e in es
        (axqlColumnsRead e cols))
      (for (ld k) in t.links
        (let (
          (lo (linkBase t k))
          (tgt ld.target)
          (hi (+ (linkBase t k) (vecLen tgt.cols)))
          (mut used false)
        )
          {
            (for c in cols
              (if (&& (>= c lo) (< c hi))
                (set used true)))
            (vecPush out used)
          }))
      out
    }))

; The row link `ld` points at from value `v`, or `None` when `v` is
; NULL or the row is gone.
(:: fetchLinked (-> Exec LinkDef Value (Result (Option (Vec Value)) Error)))
;@axiom:effect(io)
(fn (fetchLinked ex ld v)
  (match v
    ((VInt n)
      (let ((tgt ld.target))
        (let ((got (btreeGet ex.pager tgt.root (keyRowid n))?))
          (match got
            ((None) (Ok None))
            ((Some rec)
              (let ((vals (axqlRowValues tgt rec n)?))
                (Ok (Some vals)))
            ))))
    )
    (_ (Ok None))))

; `r` widened with the rows its links point at, for the links `used`
; marks; the others, and links to no row, read as NULL.
(:: widenRow (-> Exec TableDef (Vec Bool) RowRef (Result RowRef Error)))
;@axiom:effect(io)
(fn (widenRow ex t used r)
  (let ((mut any false))
    {
      (for u in used
        (if u
          (set any true)))
      (if (! any)
        (Ok r)
        (let (
          (out vecNew)
          (mut failure None)
        )
          {
            (for v in r.values
              (vecPush out v))
            (for (ld k) in t.links
              (if (! (isSome failure))
                (let ((tgt ld.target))
                  (match (if (vecGet used k)
                    (fetchLinked ex ld (vecGet r.values ld.col))
                    (Ok None))
                    ((Ok got)
                      (match got
                        ((Some vals)
                          (for v in vals
                            (vecPush out v))
                        )
                        ((None)
                          (for c in tgt.cols
                            (vecPush out VNull))
                        ))
                    )
                    ((Err err)
                      (set failure (Some err))
                    )))))
            (match failure
              ((Some err) (Err err))
              ((None) (Ok (RowRef r.rowid out))))
          }))
    }))

; The refusal of an aggregate written where rows aren't grouped.
(:: aggMisplaced (-> Exec Expr String (Result a Error)))
(fn (aggMisplaced ex e why)
  (axqErr axqSyntax (atPos ex (axqlAggPos e) (concat "an aggregate can't be used here; " why))
    "axqlPlan"))

; Bind, type-check and fold one expression. Answers the folded
; expression; its static type is checked against nothing here.
(:: prepareExpr (-> Exec (Option TableDef) Expr (Result Expr Error)))
(fn (prepareExpr ex t e)
  (if (axqlHasAgg e)
    (aggMisplaced ex e "aggregates belong in a SELECT list, HAVING or ORDER BY")
    (prepareAggExpr ex t e)))

; Bind, type-check and fold, aggregates and all.
(:: prepareAggExpr (-> Exec (Option TableDef) Expr (Result Expr Error)))
(fn (prepareAggExpr ex t e)
  (let (
    (b (bind ex t e)?)
    (_ (axqlTypeOf ex.src b (colTypesOf t) ex.params)?)
  )
    (axqlFold b ex.params)))

(:: colTypesOf (-> (Option TableDef) (Vec Int)))
(fn (colTypesOf t)
  (match t
    ((None) vecNew)
    ((Some td) (widenedTypes td))))

; A WHERE clause bound, checked and folded, as its AND terms. It must
; be a number or NULL: the truth values.
(:: prepareWhere (-> Exec (Option TableDef) (Option Expr) (Result (Vec Expr) Error)))
(fn (prepareWhere ex t w)
  (match w
    ((None) (Ok vecNew))
    ((Some e)
      (if (axqlHasAgg e)
        (aggMisplaced ex e "WHERE picks rows before they are grouped, and HAVING picks groups")
        (let (
          (b (bind ex t e)?)
          (ty (typeOfBound ex t b)?)
        )
          (if (|| (== ty typeText) (== ty typeBlob))
            (axqErr axqType (truthHint ex e "WHERE" ty) "axqlPlan")
            (let ((f (axqlFold b ex.params)?))
              (Ok (axqlConjuncts f))))))
    )))

; The refusal of a TEXT or BLOB where a truth value belongs.
(:: truthHint (-> Exec Expr String Int String))
(fn (truthHint ex e clause ty)
  (atPos ex (exprPosOf e)
    (concat (concat (concat clause " needs a truth value, a number, not ") (typeName ty))
      "; compare it with something, as in name = 'x'")))

; The offset an expression starts near, for a message: its own, or its
; first operand's.
(:: exprPosOf (-> Expr Int))
(fn (exprPosOf e)
  (match e
    ((EName _ at) at)
    ((EParam _ at) at)
    ((ENeg _ at) at)
    ((EBin _ l _ at)
      (let ((p (exprPosOf l)))
        (if (>= p 0)
          p
          at))
    )
    ((ENot x) (exprPosOf x))
    ((EIsNull x _) (exprPosOf x))
    ((EFun _ _ at) at)
    ((EAgg _ _ at) at)
    ((ELike x _ _ at) at)
    ((EIn x _ _ at) at)
    ((ELink _ _ at) at)
    (_ -1)))

; The static type of a bound expression.
(:: typeOfBound (-> Exec (Option TableDef) Expr (Result Int Error)))
(fn (typeOfBound ex t e)
  (axqlTypeOf ex.src e (colTypesOf t) ex.params))

; Whether a value of static type `vt` may go into a column of type `ct`.
(:: typeFits (-> Int Int Bool))
(fn (typeFits ct vt)
  (|| (== vt typeNull) (|| (== vt ct) (&& (== ct typeReal) (== vt typeInteger)))))

; `v` as a column of type `ct` stores it: an INTEGER in a REAL column
; becomes the nearest REAL.
(:: coerce (-> Int Value Value))
(fn (coerce ct v)
  (if (== ct typeReal)
    (match v
      ((VInt n)
        (VReal (as n Float))
      )
      (_ v))
    v))

; ------------------------------------------------------------------
; Access paths.
; ------------------------------------------------------------------
;; How a statement finds its rows.
(pub data Access
  (AFull Bool)
  (ARowid Int)
  (ARowidRange (Option Int) (Option Int) Bool)
  (AIndex IndexDef (Option String) (Option String))
  (ANone))

; Every row, in rowid order (forward) or its reverse.
; The one row with this rowid.
; Rows whose rowid is in [lo, hi], either bound absent, forward or not.
; The keys of an index from `lo` (inclusive) to `hi` (exclusive).
; No row can match.
; A comparison term `column op value` in either spelling, normalised so
; the column is on the left: its column (-1 for the rowid), the
; operator, and the constant.
(struct ColTerm
  (col : Int)
  (op : Int)
  (value : Value))

; The operator that means the same with its operands swapped.
(:: flipOp (-> Int Int))
(fn (flipOp op)
  (if (== op opLt)
    opGt
    (== op opLe)
    opGe
    (== op opGt)
    opLt
    (== op opGe)
    opLe
    op))

; `term` as a ColTerm, if it compares a column with a constant.
(:: colTerm (-> Expr (Option ColTerm)))
(fn (colTerm term)
  (match term
    ((EBin op l r _)
      (if (&& (opIsComparison op) (!= op opNe))
        (match l
          ((ECol c)
            (match r
              ((ELit v) (Some (ColTerm c op v)))
              (_ None))
          )
          ((ELit v)
            (match r
              ((ECol c) (Some (ColTerm c (flipOp op) v)))
              (_ None))
          )
          (_ None))
        None)
    )
    (_ None)))

; Whether column `c` of `t` is the rowid: -1, or the primary key.
(:: isRowidCol (-> TableDef Int Bool))
(fn (isRowidCol t c)
  (|| (< c 0) (== c t.pk)))

(:: isNullValue (-> Value Bool))
(fn (isNullValue v)
  (match v
    ((VNull) true)
    (_ false)))

(:: intMax Int)
(fn (intMax)
  9223372036854775807)

; The smallest INTEGER n with n > v (strict) or n >= v, or None when no
; INTEGER is that large.
(:: lowBound (-> Value Bool (Option Int)))
(fn (lowBound v strict)
  (match v
    ((VInt x)
      (if strict
        (if (== x intMax)
          None
          (Some (+ x 1)))
        (Some x))
    )
    ((VReal r)
      (if (>= (axqlCompareIntReal intMax r) 0)
        (if (<= (axqlCompareIntReal intMin r) 0)
          (Some intMin)
          (let ((t
            (as r Int)))
            (firstFrom (- t 1) r strict 3)))
        None)
    )
    (_ None)))

; The first of n, n+1, n+2 ... (up to `tries`) above (strict) or at `r`.
(:: firstFrom (-> Int Float Bool Int (Option Int)))
(fn (firstFrom n r strict tries)
  (if (== tries 0)
    None
    (let ((c (axqlCompareIntReal n r)))
      (if (|| (> c 0) (&& (! strict) (== c 0)))
        (Some n)
        (firstFrom (+ n 1) r strict (- tries 1))))))

; The largest INTEGER n with n < v (strict) or n <= v, or None.
(:: highBound (-> Value Bool (Option Int)))
(fn (highBound v strict)
  (match v
    ((VInt x)
      (if strict
        (if (== x intMin)
          None
          (Some (- x 1)))
        (Some x))
    )
    ((VReal r)
      (if (<= (axqlCompareIntReal intMin r) 0)
        (if (>= (axqlCompareIntReal intMax r) 0)
          (Some intMax)
          (let ((t
            (as r Int)))
            (lastFrom (+ t 1) r strict 3)))
        None)
    )
    (_ None)))

(:: lastFrom (-> Int Float Bool Int (Option Int)))
(fn (lastFrom n r strict tries)
  (if (== tries 0)
    None
    (let ((c (axqlCompareIntReal n r)))
      (if (|| (< c 0) (&& (! strict) (== c 0)))
        (Some n)
        (lastFrom (- n 1) r strict (- tries 1))))))

; The rowid `rowid = v` names, or None when no INTEGER equals v.
(:: exactRowid (-> Value (Option Int)))
(fn (exactRowid v)
  (match v
    ((VInt x) (Some x))
    ((VReal r)
      (match (lowBound v false)
        ((Some n)
          (if (== (axqlCompareIntReal n r) 0)
            (Some n)
            None)
        )
        ((None) None))
    )
    (_ None)))

; The range accumulated over a set of bound terms: lower and upper
; bounds, and whether some term rules out every row.
(struct Range
  (mut lo : (Option Int))
  (mut hi : (Option Int))
  (mut empty : Bool))

(:: tightenRange (-> Range ColTerm Int))
(fn (tightenRange rg ct)
  (let (
    (v ct.value)
    (op ct.op)
  )
    (if (isNullValue v)
      {
        (set rg.empty true)
        0
      }
      (if (|| (== op opGt) (== op opGe))
        (match (lowBound v (== op opGt))
          ((None)
            {
              (set rg.empty true)
              0
            }
          )
          ((Some n)
            {
              (set rg.lo (Some
                           (match rg.lo
                             ((Some m)
                               (if (> n m)
                                 n
                                 m)
                             )
                             ((None) n))))
              0
            }
          ))
        (match (highBound v (== op opLt))
          ((None)
            {
              (set rg.empty true)
              0
            }
          )
          ((Some n)
            {
              (set rg.hi (Some
                           (match rg.hi
                             ((Some m)
                               (if (< n m)
                                 n
                                 m)
                             )
                             ((None) n))))
              0
            }
          ))))))

; Key bounds on an index's leading column, accumulated like `Range`.
(struct KeyRange
  (mut lo : (Option String))
  (mut hi : (Option String))
  (mut empty : Bool))

(:: maxKey (-> (Option String) String (Option String)))
(fn (maxKey cur k)
  (match cur
    ((None) (Some k))
    ((Some c)
      (Some
        (if (> (keyCompare k c) 0)
          k
          c))
    )))

(:: minKey (-> (Option String) (Option String) (Option String)))
(fn (minKey cur k)
  (match k
    ((None) cur)
    ((Some kk)
      (match cur
        ((None) (Some kk))
        ((Some c)
          (Some
            (if (< (keyCompare kk c) 0)
              kk
              c))
        ))
    )))

(:: tightenKeys (-> KeyRange ColTerm (Result Int Error)))
(fn (tightenKeys kr ct)
  (if (isNullValue ct.value)
    {
      (set kr.empty true)
      (Ok 0)
    }
    (let ((p (keyEncodeValue ct.value)?))
      (let ((op ct.op))
        {
          (if (== op opEq)
            {
              (set kr.lo (maxKey kr.lo p))
              (set kr.hi (minKey kr.hi (keyPrefixEnd p)))
            }
            (== op opGt)
            (match (keyPrefixEnd p)
              ((None)
                (set kr.empty true)
              )
              ((Some k)
                (set kr.lo (maxKey kr.lo k))
              ))
            (== op opGe)
            (set kr.lo (maxKey kr.lo p))
            (== op opLt)
            (set kr.hi (minKey kr.hi (Some p)))
            (set kr.hi (minKey kr.hi (keyPrefixEnd p))))
          (Ok 0)
        }))))

; The first key after every NULL: where a range that excludes NULL
; starts.
(:: afterNulls (Result String Error))
(fn (afterNulls)
  (let ((k (keyEncodeValue VNull)?))
    (match (keyPrefixEnd k)
      ((Some e) (Ok e))
      ((None) (axqErr axqCorrupt "the NULL key has no end" "axqlPlan")))))

; The best index access for the terms on each index's leading column:
; an equality on a UNIQUE index, then any equality, then any range.
(:: chooseIndex (-> TableDef (Vec ColTerm) (Result (Option Access) Error)))
(fn (chooseIndex t cts)
  (let ((eqU (indexAccess t cts true true)?))
    (match eqU
      ((Some a) (Ok (Some a)))
      ((None)
        (let ((eqAny (indexAccess t cts true false)?))
          (match eqAny
            ((Some a) (Ok (Some a)))
            ((None) (indexAccess t cts false false))))
      ))))

; The access for the first index (UNIQUE only when `uniqueOnly`) whose
; leading column has an equality term (`wantEq`) or any term.
(:: indexAccess (-> TableDef (Vec ColTerm) Bool Bool (Result (Option Access) Error)))
(fn (indexAccess t cts wantEq uniqueOnly)
  (let (
    (mut chosen None)
    (mut failure None)
  )
    {
      (for ix in t.indexes
        (if (&& (isNone chosen) (isNone failure))
          (if (|| ix.unique (! uniqueOnly))
            (let (
              (lead (vecGet ix.cols 0))
              (mut hasEq false)
              (mut hasAny false)
            )
              {
                (for ct in cts
                  (if (== ct.col lead)
                    {
                      (set hasAny true)
                      (if (== ct.op opEq)
                        (set hasEq true))
                    }))
                (if (if wantEq
                  hasEq
                  hasAny)
                  (match (keyAccess ix lead cts)
                    ((Ok a)
                      (set chosen (Some a))
                    )
                    ((Err e)
                      (set failure (Some e))
                    )))
              }))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok chosen)))
    }))

; The index range the terms on column `lead` describe.
(:: keyAccess (-> IndexDef Int (Vec ColTerm) (Result Access Error)))
(fn (keyAccess ix lead cts)
  (let ((kr (KeyRange None None false)))
    (let ((mut failure None))
      {
        (for ct in cts
          (if (&& (== ct.col lead) (isNone failure))
            (match (tightenKeys kr ct)
              ((Ok _) ())
              ((Err e)
                (set failure (Some e))
              ))))
        (match failure
          ((Some e) (Err e))
          ((None)
            (if kr.empty
              (Ok ANone)
              (let ((lo
                (match kr.lo
                  ((Some k) (Ok k))
                  ((None) (afterNulls)))?))
                (Ok (AIndex ix (Some lo) kr.hi))))
          ))
      })))

; The access path for `terms` over `t`, given the ORDER BY terms that
; might pick an index to read in order.
(:: planAccess (-> TableDef (Vec Expr) (Vec OrderTerm) (Result Access Error)))
(fn (planAccess t terms order)
  (let (
    (cts vecNew)
    (mut noRow false)
  )
    {
      (for term in terms
        {
          (match term
            ((ELit v)
              (match (axqlTruth v)
                ((Ok tv)
                  (if (!= tv tvTrue)
                    (set noRow true))
                )
                ((Err _) ()))
            )
            (_ ()))
          (match (colTerm term)
            ((Some ct) (vecPush cts ct))
            ((None) ()))
        })
      (if noRow
        (Ok ANone)
        (let ((rowEq (findRowidEq t cts)))
          (match rowEq
            ((Some v)
              (Ok
                (match (exactRowid v)
                  ((Some n) (ARowid n))
                  ((None) ANone)))
            )
            ((None)
              (let ((ixEq (indexAccess t cts true false)?))
                (match ixEq
                  ((Some a) (Ok (preferUnique t cts a)))
                  ((None)
                    (let ((rg (Range None None false)))
                      {
                        (for rc in cts
                          (rangeTerm t rg rc))
                        (if rg.empty
                          (Ok ANone)
                          (if (|| (isSome rg.lo) (isSome rg.hi))
                            (Ok (ARowidRange rg.lo rg.hi true))
                            (let ((ixRange (indexAccess t cts false false)?))
                              (match ixRange
                                ((Some a) (Ok a))
                                ((None) (Ok (orderAccess t order)))))))
                      })
                  )))
            ))))
    }))

; Tighten `rg` by `c` when `c` is on the rowid.
(:: rangeTerm (-> TableDef Range ColTerm Int))
(fn (rangeTerm t rg c)
  (if (isRowidCol t c.col)
    (tightenRange rg c)
    0))

; A UNIQUE index's equality access when one exists, else `a`.
(:: preferUnique (-> TableDef (Vec ColTerm) Access Access))
(fn (preferUnique t cts a)
  (match (indexAccess t cts true true)
    ((Ok (Some u)) u)
    (_ a)))

; The value of the first `rowid = v` term.
(:: findRowidEq (-> TableDef (Vec ColTerm) (Option Value)))
(fn (findRowidEq t cts)
  (let ((mut found None))
    {
      (for ct in cts
        (if (&& (isNone found) (&& (isRowidCol t ct.col) (== ct.op opEq)))
          (set found (Some ct.value))))
      found
    }))

; With nothing in WHERE to use: read in the order ORDER BY asks for
; when an access path gives it, else scan forward.
(:: orderAccess (-> TableDef (Vec OrderTerm) Access))
(fn (orderAccess t order)
  (if (== (vecLen order) 0)
    (AFull true)
    (let ((first (vecGet order 0)))
      (match first.expr
        ((ECol c)
          (if (isRowidCol t c)
            (AFull (! first.desc))
            (match (indexInOrder t order)
              ((Some ix) (AIndex ix None None))
              ((None) (AFull true))))
        )
        (_ (AFull true))))))

; An index whose columns, in order and ascending, are exactly the
; ORDER BY terms (a trailing `rowid ASC` allowed).
(:: indexInOrder (-> TableDef (Vec OrderTerm) (Option IndexDef)))
(fn (indexInOrder t order)
  (let ((mut found None))
    {
      (for ix in t.indexes
        (if (&& (isNone found) (orderMatchesIndex t ix order))
          (set found (Some ix))))
      found
    }))

(:: orderMatchesIndex (-> TableDef IndexDef (Vec OrderTerm) Bool))
(fn (orderMatchesIndex t ix order)
  (let (
    (n (vecLen ix.cols))
    (m (vecLen order))
  )
    (if (|| (< m n) (> m (+ n 1)))
      false
      (let ((mut ok true))
        {
          (for (term i) in order
            (if (! (! ok))
              (if term.desc
                (set ok false)
                (match term.expr
                  ((ECol c)
                    (if (< i n)
                      (if (!= c (vecGet ix.cols i))
                        (set ok false))
                      (if (! (isRowidCol t c))
                        (set ok false)))
                  )
                  (_
                    (set ok false)
                  )))))
          ok
        }))))

; Whether rows read through `a` already come in the order `order` asks
; for, ties broken by rowid.
(:: accessSatisfies (-> TableDef Access (Vec OrderTerm) Bool))
(fn (accessSatisfies t a order)
  (if (== (vecLen order) 0)
    true
    (let ((first (vecGet order 0)))
      (match a
        ((ANone) true)
        ((ARowid _) true)
        ((AFull fwd) (rowidFirst t first fwd))
        ((ARowidRange _ _ fwd) (rowidFirst t first fwd))
        ((AIndex ix _ _) (orderMatchesIndex t ix order))))))

; Whether the first ORDER BY term is the rowid in the direction `fwd`
; reads it.
(:: rowidFirst (-> TableDef OrderTerm Bool Bool))
(fn (rowidFirst t first fwd)
  (match first.expr
    ((ECol c)
      (&& (isRowidCol t c)
        (if fwd
          (! first.desc)
          first.desc))
    )
    (_ false)))

; ------------------------------------------------------------------
; Reading rows.
; ------------------------------------------------------------------
;; A row as a scan meets it: its rowid and its values.
(pub struct RowRef
  (rowid : Int)
  (values : (Vec Value)))

; Call `f` with each row `a` reads from `t`, in the access path's order,
; until `f` answers `Ok false` or `Err`.
(:: scanRows (-> Exec TableDef Access (-> RowRef (Result Bool Error)) (Result Int Error)))
;@axiom:effect(io)
(fn (scanRows ex t a f)
  (match a
    ((ANone) (Ok 0))
    ((ARowid n)
      (let ((got (btreeGet ex.pager t.root (keyRowid n))?))
        (match got
          ((None) (Ok 0))
          ((Some rec)
            (let (
              (vals (axqlRowValues t rec n)?)
              (_ (f (RowRef n vals))?)
            )
              (Ok 1))
          )))
    )
    ((AFull fwd) (scanTable ex t None None fwd f))
    ((ARowidRange lo hi fwd)
      (if (match lo
        ((Some l)
          (match hi
            ((Some h) (> l h))
            ((None) false))
        )
        ((None) false))
        (Ok 0)
        (scanTable ex t
          (match lo
            ((Some l) (Some (keyRowid l)))
            ((None) None))
          (match hi
            ((Some h)
              (if (== h intMax)
                None
                (Some (keyRowid (+ h 1))))
            )
            ((None) None))
          fwd f))
    )
    ((AIndex ix lo hi)
      (btreeScan ex.pager ix.root lo hi true
        (lambda (k v)
          (let (
            (rowid (keyIndexRowid k)?)
            (got (btreeGet ex.pager t.root (keyRowid rowid))?)
          )
            (match got
              ((None)
                (axqErr axqCorrupt (concat "an index entry names a missing row of " t.name)
                  "axqlScan")
              )
              ((Some rec)
                (let ((vals (axqlRowValues t rec rowid)?))
                  (f (RowRef rowid vals)))
              )))
        ))
    )))

(:: scanTable
  (-> Exec TableDef (Option String) (Option String) Bool (-> RowRef (Result Bool Error))
    (Result Int Error)))
;@axiom:effect(io)
(fn (scanTable ex t lo hi fwd f)
  (btreeScan ex.pager t.root lo hi fwd
    (lambda (k v)
      (let (
        (rowid (keyRowidOf k)?)
        (vals (axqlRowValues t v rowid)?)
      )
        (f (RowRef rowid vals)))
    )))

; ------------------------------------------------------------------
; SELECT.
; ------------------------------------------------------------------
;; How a grouped SELECT works out its rows: the GROUP BY terms, the
;; aggregates it computes, and its select list, HAVING and ORDER BY with
;; each aggregate replaced by a parameter past the statement's own,
;; which carries the aggregate's value for the group.
(pub struct GroupPlan
  (keys : (Vec Expr))
  (aggs : (Vec Expr))
  (outputs : (Vec Expr))
  (having : (Option Expr))
  (order : (Vec OrderTerm)))

;; A planned SELECT. `fetch` marks the links whose rows it reads, and
;; `group` is there when it groups its rows.
(pub struct SelectPlan
  (table : (Option TableDef))
  (names : (Vec String))
  (outputs : (Vec Expr))
  (terms : (Vec Expr))
  (access : Access)
  (order : (Vec OrderTerm))
  (sorted : Bool)
  (limit : Int)
  (offset : Int)
  (fetch : (Vec Bool))
  (group : (Option GroupPlan)))

;; The column names a SELECT answers.
(pub :: axqlPlanNames (-> SelectPlan (Vec String)))
(pub fn (axqlPlanNames plan)
  plan.names)

;; Bind, check, fold and plan a SELECT. Needs a lock.
(pub :: axqlPlanSelect (-> Exec Schema Select (Result SelectPlan Error)))
(pub fn (axqlPlanSelect ex schema sel)
  (let ((t
    (if (strIsEmpty sel.from)
      (Ok None)
      (match (axqlTableDef schema sel.from)
        ((Err er) (Err er))
        ((Ok td) (Ok (Some td)))))?))
    (if (selectIsGrouped sel)
      (planGrouped ex t sel)
      (let (
        (outs (selectOutputs ex t sel false)?)
        (terms (prepareWhere ex t sel.where)?)
        (order (orderTerms ex t sel outs)?)
        (limit (limitValue ex sel.limit "LIMIT" -1)?)
        (offset (limitValue ex sel.offset "OFFSET" 0)?)
      )
        (match t
          ((None)
            (Ok
              (SelectPlan t outs.names outs.exprs terms (ARowid 0) order false limit offset vecNew
                None))
          )
          ((Some td)
            (let ((a (planAccess td terms order)?))
              (Ok
                (SelectPlan t outs.names outs.exprs terms a order (! (accessSatisfies td a order))
                  limit offset (linksRead td (planExprs outs.exprs terms order)) None)))
          ))))))

; Every expression a plain SELECT evaluates.
(:: planExprs (-> (Vec Expr) (Vec Expr) (Vec OrderTerm) (Vec Expr)))
(fn (planExprs outs terms order)
  (let ((all vecNew))
    {
      (for e in outs
        (vecPush all e))
      (for e in terms
        (vecPush all e))
      (for o in order
        (vecPush all o.expr))
      all
    }))

; The output expressions and their names.
(struct Outputs
  (names : (Vec String))
  (exprs : (Vec Expr)))

; The select list bound, checked and folded, with `*` and `link.*`
; spread into columns. Aggregates are allowed when `allowAgg`.
(:: selectOutputs (-> Exec (Option TableDef) Select Bool (Result Outputs Error)))
(fn (selectOutputs ex t sel allowAgg)
  (let (
    (names vecNew)
    (exprs vecNew)
    (mut failure None)
  )
    {
      (if sel.star
        (match t
          ((None)
            (set failure (Some
                           (errContextOf (mkError axqSyntax "`*` needs a FROM clause") "axqlPlan")))
          )
          ((Some td)
            (for (c i) in td.cols
              {
                (vecPush names c.name)
                (vecPush exprs (ECol i))
              })
          )))
      (for item in sel.items
        (if (isNone failure)
          (match (addOutput ex t item allowAgg names exprs)
            ((Ok _) ())
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok (Outputs names exprs))))
    }))

(:: addOutput
  (-> Exec (Option TableDef) SelectItem Bool (Vec String) (Vec Expr) (Result Int Error)))
(fn (addOutput ex t item allowAgg names exprs)
  (match item.expr
    ((ELink l c at)
      (if (strEq c "*")
        (spreadLink ex t l at names exprs)
        (addPrepared ex t item allowAgg names exprs))
    )
    (_ (addPrepared ex t item allowAgg names exprs))))

(:: addPrepared
  (-> Exec (Option TableDef) SelectItem Bool (Vec String) (Vec Expr) (Result Int Error)))
(fn (addPrepared ex t item allowAgg names exprs)
  (let ((e
    (if allowAgg
      (prepareAggExpr ex t item.expr)
      (prepareExpr ex t item.expr))?))
    {
      (vecPush names (itemName item))
      (vecPush exprs e)
      (Ok 0)
    }))

; `link.*`: every column of the row LINK column `l` points at, named
; `l.column`.
(:: spreadLink (-> Exec (Option TableDef) String Int (Vec String) (Vec Expr) (Result Int Error)))
(fn (spreadLink ex t l at names exprs)
  (match t
    ((None)
      (axqErr axqSchema
        (atPos ex at (concat (concat "no such column: " l) "; this statement reads no table"))
        "axqlPlan")
    )
    ((Some td)
      (let ((ci (axqlColumnIndex td.cols l)))
        (if (< ci 0)
          (axqErr axqSchema (atPos ex at (concat (concat "no such column: " l) (columnHint td l)))
            "axqlPlan")
          (match (linkNumber td ci)
            ((None)
              (axqErr axqSchema
                (atPos ex at (concat l " isn't a LINK column, so .* has no row to spread"))
                "axqlPlan")
            )
            ((Some k)
              (let (
                (ld (vecGet td.links k))
                (tgt ld.target)
                (base (linkBase td k))
              )
                {
                  (for (c j) in tgt.cols
                    {
                      (vecPush names (concat (concat l ".") c.name))
                      (vecPush exprs (ECol (+ base j)))
                    })
                  (Ok 0)
                })
            ))))
    )))

; A result column's name: its alias, a bare column's own name, or the
; expression as written.
(:: itemName (-> SelectItem String))
(fn (itemName item)
  (if (! (strIsEmpty item.alias))
    item.alias
    (match item.expr
      ((EName n _) n)
      (_ item.text))))

; The ORDER BY terms, bound. An integer literal names a result column
; by position, from 1; a bare name that is a result column's alias
; names that column; anything else is an expression over the table.
(:: orderTerms (-> Exec (Option TableDef) Select Outputs (Result (Vec OrderTerm) Error)))
(fn (orderTerms ex t sel outs)
  (let (
    (out vecNew)
    (mut failure None)
  )
    {
      (for term in sel.orderBy
        (if (isNone failure)
          (match (orderExpr ex t sel outs term.expr)
            ((Ok e) (vecPush out (OrderTerm e term.desc)))
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }))

(:: orderExpr (-> Exec (Option TableDef) Select Outputs Expr (Result Expr Error)))
(fn (orderExpr ex t sel outs e)
  (match e
    ((ELit (VInt k))
      (if (|| (< k 1) (> k (vecLen outs.exprs)))
        (axqErr axqSchema
          (concat "ORDER BY "
            (concat (fmtInt k)
              (concat " names no result column; there are " (fmtInt (vecLen outs.exprs)))))
          "axqlPlan")
        (Ok (vecGet outs.exprs (- k 1))))
    )
    ((EName n _)
      (match (aliasIndex sel n)
        ((Some i) (Ok (vecGet outs.exprs i)))
        ((None) (prepareExpr ex t e)))
    )
    (_ (prepareExpr ex t e))))

(:: aliasIndex (-> Select String (Option Int)))
(fn (aliasIndex sel n)
  (let ((mut found None))
    {
      (for (item i) in sel.items
        (if (&& (isNone found) (&& (! (strIsEmpty item.alias)) (axqlNameEq item.alias n)))
          (set found (Some i))))
      found
    }))

; ------------------------------------------------------------------
; Grouped SELECT: planning.
; ------------------------------------------------------------------
; Whether a SELECT groups its rows: it has GROUP BY or HAVING, or an
; aggregate in its select list or ORDER BY.
(:: selectIsGrouped (-> Select Bool))
(fn (selectIsGrouped sel)
  (let ((mut grouped (|| (> (vecLen sel.groupBy) 0) (isSome sel.having))))
    {
      (for item in sel.items
        (if (axqlHasAgg item.expr)
          (set grouped true)))
      (for term in sel.orderBy
        (if (axqlHasAgg term.expr)
          (set grouped true)))
      grouped
    }))

; A column of a widened row as a message names it: `col`, or
; `link.col` for a linked row's column.
(:: colLabel (-> (Option TableDef) Int String))
(fn (colLabel t ci)
  (match t
    ((None) "a column")
    ((Some td)
      (if (< ci 0)
        "rowid"
        (if (< ci (vecLen td.cols))
          (let ((c (vecGet td.cols ci)))
            c.name)
          (let ((mut label "a linked column"))
            {
              (for (ld k) in td.links
                (let (
                  (lo (linkBase td k))
                  (tgt ld.target)
                )
                  (if (&& (>= ci lo) (< ci (+ lo (vecLen tgt.cols))))
                    (let (
                      (lc (vecGet td.cols ld.col))
                      (c (vecGet tgt.cols (- ci lo)))
                    )
                      (set label (concat (concat lc.name ".") c.name)))
                    label)))
              label
            })))
    )))

; Whether `e` is one of the GROUP BY terms.
(:: isGroupKey (-> Expr (Vec Expr) Bool))
(fn (isGroupKey e keys)
  (let ((mut found false))
    {
      (for k in keys
        (if (axqlExprEq e k)
          (set found true)))
      found
    }))

; A column `e` reads outside every aggregate and every GROUP BY term,
; if any.
(:: ungrouped (-> Expr (Vec Expr) (Option Int)))
(fn (ungrouped e keys)
  (if (isGroupKey e keys)
    None
    (match e
      ((ECol i) (Some i))
      ((EAgg _ _ _) None)
      (_
        (let ((mut found None))
          {
            (for c in (axqlChildren e)
              (if (isNone found)
                (set found (ungrouped c keys))
                found))
            found
          })
      ))))

; `e` with each aggregate replaced by the parameter that will carry its
; value, the aggregate itself pushed onto `aggs`.
(:: liftAggs (-> Exec Expr (Vec Expr) Int (Result Expr Error)))
(fn (liftAggs ex e aggs base)
  (match e
    ((EAgg k arg at)
      (if (match arg
        ((Some x) (axqlHasAgg x))
        ((None) false))
        (axqErr axqSyntax (atPos ex at (concat (aggName k) " can't hold another aggregate"))
          "axqlPlan")
        {
          (vecPush aggs e)
          (Ok (EParam (+ base (- (vecLen aggs) 1)) at))
        })
    )
    ((ENeg x at)
      (let ((rx (liftAggs ex x aggs base)))
        (let ((lx rx?))
          (Ok (ENeg lx at))))
    )
    ((ENot x)
      (let ((rx (liftAggs ex x aggs base)))
        (let ((lx rx?))
          (Ok (ENot lx))))
    )
    ((EIsNull x n)
      (let ((rx (liftAggs ex x aggs base)))
        (let ((lx rx?))
          (Ok (EIsNull lx n))))
    )
    ((EBin op l r at)
      (let (
        (rl (liftAggs ex l aggs base))
        (rr (liftAggs ex r aggs base))
      )
        (let (
          (ll rl?)
          (lr rr?)
        )
          (Ok (EBin op ll lr at))))
    )
    ((EFun name args at)
      (let ((ls (liftEach ex args aggs base)?))
        (Ok (EFun name ls at)))
    )
    ((ELike x pat n at)
      (let (
        (rx (liftAggs ex x aggs base))
        (rp (liftAggs ex pat aggs base))
      )
        (let (
          (lx rx?)
          (lp rp?)
        )
          (Ok (ELike lx lp n at))))
    )
    ((EIn x items n at)
      (let ((rx (liftAggs ex x aggs base)))
        (let (
          (lx rx?)
          (ls (liftEach ex items aggs base)?)
        )
          (Ok (EIn lx ls n at))))
    )
    (_ (Ok e))))

(:: liftEach (-> Exec (Vec Expr) (Vec Expr) Int (Result (Vec Expr) Error)))
(fn (liftEach ex es aggs base)
  (let (
    (out vecNew)
    (mut failure None)
  )
    {
      (for e in es
        (if (isNone failure)
          (match (liftAggs ex e aggs base)
            ((Ok l) (vecPush out l))
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }))

; A bound, folded expression of a grouped SELECT, refused when it reads
; a column outside the GROUP BY terms and the aggregates, and lifted.
(:: liftGrouped (-> Exec (Option TableDef) (Vec Expr) (Vec Expr) Expr (Result Expr Error)))
(fn (liftGrouped ex t keys aggs e)
  (match (ungrouped e keys)
    ((Some ci)
      (axqErr axqSchema
        (concat (colLabel t ci)
          (if (== (vecLen keys) 0)
            " is read outside an aggregate, so every row of the group would need the same value; put it in GROUP BY or inside an aggregate such as min"
            " isn't a GROUP BY term or inside an aggregate, so a group has no one value for it"))
        "axqlPlan")
    )
    ((None) (liftAggs ex e aggs (vecLen ex.params)))))

(:: liftGroupedAll
  (-> Exec (Option TableDef) (Vec Expr) (Vec Expr) (Vec Expr) (Result (Vec Expr) Error)))
(fn (liftGroupedAll ex t keys aggs es)
  (let (
    (out vecNew)
    (mut failure None)
  )
    {
      (for e in es
        (if (isNone failure)
          (match (liftGrouped ex t keys aggs e)
            ((Ok l) (vecPush out l))
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }))

; The GROUP BY terms, bound, checked and folded. They are worked out per
; row, so they can't hold an aggregate.
(:: groupKeys (-> Exec (Option TableDef) (Vec Expr) (Result (Vec Expr) Error)))
(fn (groupKeys ex t es)
  (let (
    (out vecNew)
    (mut failure None)
  )
    {
      (for e in es
        (if (isNone failure)
          (match (prepareExpr ex t e)
            ((Ok b) (vecPush out b))
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }))

; HAVING: a truth value per group.
(:: groupHaving (-> Exec (Option TableDef) (Vec Expr) (Vec Expr) Expr (Result Expr Error)))
(fn (groupHaving ex t keys aggs h)
  (let (
    (b (bind ex t h)?)
    (ty (typeOfBound ex t b)?)
  )
    (if (|| (== ty typeText) (== ty typeBlob))
      (axqErr axqType (truthHint ex h "HAVING" ty) "axqlPlan")
      (let ((f (axqlFold b ex.params)?))
        (liftGrouped ex t keys aggs f)))))

; ORDER BY of a grouped SELECT: a position or an alias names a result
; column, and anything else is worked out per group.
(:: groupOrder
  (-> Exec (Option TableDef) Select (Vec Expr) (Vec Expr) (Vec Expr)
    (Result (Vec OrderTerm) Error)))
(fn (groupOrder ex t sel lifted keys aggs)
  (let (
    (out vecNew)
    (mut failure None)
  )
    {
      (for term in sel.orderBy
        (if (isNone failure)
          (let ((r
            (match term.expr
              ((ELit (VInt k))
                (if (|| (< k 1) (> k (vecLen lifted)))
                  (axqErr axqSchema
                    (concat "ORDER BY "
                      (concat (fmtInt k)
                        (concat " names no result column; there are " (fmtInt (vecLen lifted)))))
                    "axqlPlan")
                  (Ok (vecGet lifted (- k 1))))
              )
              ((EName n _)
                (match (aliasIndex sel n)
                  ((Some i) (Ok (vecGet lifted i)))
                  ((None)
                    (match (prepareAggExpr ex t term.expr)
                      ((Err er) (Err er))
                      ((Ok b) (liftGrouped ex t keys aggs b)))
                  ))
              )
              (_
                (match (prepareAggExpr ex t term.expr)
                  ((Err er) (Err er))
                  ((Ok b) (liftGrouped ex t keys aggs b)))
              ))))
            (match r
              ((Ok e) (vecPush out (OrderTerm e term.desc)))
              ((Err err)
                (set failure (Some err))
              )))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok out)))
    }))

; Every expression a grouped SELECT evaluates over rows or groups.
(:: groupExprs (-> GroupPlan (Vec Expr) (Vec Expr)))
(fn (groupExprs gp terms)
  (let ((all vecNew))
    {
      (for e in gp.keys
        (vecPush all e))
      (for e in gp.aggs
        (vecPush all e))
      (for e in gp.outputs
        (vecPush all e))
      (match gp.having
        ((Some h) (vecPush all h))
        ((None) all))
      (for o in gp.order
        (vecPush all o.expr))
      (for e in terms
        (vecPush all e))
      all
    }))

(:: planGrouped (-> Exec (Option TableDef) Select (Result SelectPlan Error)))
(fn (planGrouped ex t sel)
  (let ((aggs vecNew))
    (let (
      (keys (groupKeys ex t sel.groupBy)?)
      (outs (selectOutputs ex t sel true)?)
      (lifted (liftGroupedAll ex t keys aggs outs.exprs)?)
      (having (match sel.having
        ((None) (Ok None))
        ((Some h)
          (match (groupHaving ex t keys aggs h)
            ((Err er) (Err er))
            ((Ok lh) (Ok (Some lh))))
        ))?)
      (order (groupOrder ex t sel lifted keys aggs)?)
      (terms (prepareWhere ex t sel.where)?)
      (limit (limitValue ex sel.limit "LIMIT" -1)?)
      (offset (limitValue ex sel.offset "OFFSET" 0)?)
    )
      (let ((gp (GroupPlan keys aggs lifted having order)))
        (match t
          ((None)
            (Ok
              (SelectPlan t outs.names vecNew terms (ARowid 0) vecNew false limit offset vecNew
                (Some gp)))
          )
          ((Some td)
            (let ((a (planAccess td terms vecNew)?))
              (Ok
                (SelectPlan t outs.names vecNew terms a vecNew false limit offset
                  (linksRead td (groupExprs gp terms)) (Some gp))))
          ))))))

; A LIMIT or OFFSET count: a constant non-negative INTEGER. `absent`
; when the clause isn't there.
(:: limitValue (-> Exec (Option Expr) String Int (Result Int Error)))
(fn (limitValue ex e what absent)
  (match e
    ((None) (Ok absent))
    ((Some x)
      (let ((v (prepareExpr ex None x)?))
        (match v
          ((ELit (VInt n))
            (if (< n 0)
              (axqErr axqType (concat what (concat " is negative: " (fmtInt n))) "axqlPlan")
              (Ok n))
          )
          (_ (axqErr axqType (concat what " needs an INTEGER") "axqlPlan"))))
    )))

; A row kept for sorting: its sort keys, its rowid, and its values.
(struct Keyed
  (keys : (Vec Value))
  (rowid : Int)
  (values : (Vec Value)))

; The running state of a SELECT: how many rows it has skipped and
; returned, and the rows it keeps to sort.
(struct SelState
  (mut skipped : Int)
  (mut returned : Int)
  (kept : (Vec Keyed)))

; A SELECT that doesn't group.
(:: runPlain (-> Exec SelectPlan (-> (Vec Value) (Result Bool Error)) (Result Int Error)))
;@axiom:effect(io)
(fn (runPlain ex plan onRow)
  (let ((st (SelState 0 0 vecNew)))
    (match plan.table
      ((None)
        (let ((keep (axqlKeep plan.terms vecNew 0 ex.params)?))
          (if keep
            (if plan.sorted
              (Ok 0)
              (let ((_ (emitRow ex plan st (RowRef 0 vecNew) onRow)?))
                (Ok st.returned)))
            (Ok 0)))
      )
      ((Some td)
        (if (== plan.limit 0)
          (Ok 0)
          (let ((_
            (scanRows ex td plan.access
              (lambda (r)
                (let ((xr (widenRow ex td plan.fetch r)?))
                  (visitRow ex plan st onRow xr))
              ))?))
            (if plan.sorted
              (emitSorted ex plan st onRow)
              (Ok st.returned))))
      ))))

;; Run a planned SELECT, calling `onRow` with each result row. Stops
;; early when `onRow` answers `Ok false`. Answers the rows returned.
(pub :: axqlRunSelect (-> Exec SelectPlan (-> (Vec Value) (Result Bool Error)) (Result Int Error)))
;@axiom:effect(io)
(pub fn (axqlRunSelect ex plan onRow)
  (match plan.group
    ((Some gp) (runGrouped ex plan gp onRow))
    ((None) (runPlain ex plan onRow))))

; One row a SELECT's scan meets: dropped, kept to sort, or handed on.
(:: visitRow
  (-> Exec SelectPlan SelState (-> (Vec Value) (Result Bool Error)) RowRef (Result Bool Error)))
(fn (visitRow ex plan st onRow r)
  (let ((keep (axqlKeep plan.terms r.values r.rowid ex.params)?))
    (if (! keep)
      (Ok true)
      (if plan.sorted
        (let ((ks (sortKeys ex plan r)?))
          {
            (vecPush st.kept (Keyed ks r.rowid r.values))
            (Ok true)
          })
        (emitRow ex plan st r onRow)))))

; The ORDER BY keys of a row.
(:: sortKeys (-> Exec SelectPlan RowRef (Result (Vec Value) Error)))
(fn (sortKeys ex plan r)
  (let (
    (ks vecNew)
    (mut failure None)
  )
    {
      (for term in plan.order
        (if (isNone failure)
          (match (axqlEval term.expr r.values r.rowid ex.params)
            ((Ok v) (vecPush ks v))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok ks)))
    }))

; Hand one kept row on, after OFFSET and within LIMIT. Answers whether
; to keep reading.
(:: emitRow
  (-> Exec SelectPlan SelState RowRef (-> (Vec Value) (Result Bool Error)) (Result Bool Error)))
(fn (emitRow ex plan st r onRow)
  (if (< st.skipped plan.offset)
    {
      (set st.skipped (+ st.skipped 1))
      (Ok true)
    }
    (let (
      (outs (evalOutputs ex plan r)?)
      (more (onRow outs)?)
    )
      {
        (set st.returned (+ st.returned 1))
        (Ok (&& more (|| (< plan.limit 0) (< st.returned plan.limit))))
      })))

(:: evalOutputs (-> Exec SelectPlan RowRef (Result (Vec Value) Error)))
(fn (evalOutputs ex plan r)
  (let (
    (outs vecNew)
    (mut failure None)
  )
    {
      (for e in plan.outputs
        (if (isNone failure)
          (match (axqlEval e r.values r.rowid ex.params)
            ((Ok v) (vecPush outs v))
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok outs)))
    }))

; Sort the kept rows and hand them on.
(:: emitSorted
  (-> Exec SelectPlan SelState (-> (Vec Value) (Result Bool Error)) (Result Int Error)))
(fn (emitSorted ex plan st onRow)
  (let (
    (sorted (mergeSort st.kept plan.order))
    (n (vecLen sorted))
    (mut i 0)
    (mut going true)
    (mut failure None)
  )
    {
      (while (&& going (< i n))
        (let ((k (vecGet sorted i)))
          {
            (match (emitRow ex plan st (RowRef k.rowid k.values) onRow)
              ((Ok more)
                (set going more)
              )
              ((Err e)
                {
                  (set failure (Some e))
                  (set going false)
                }
              ))
            (set i (+ i 1))
          }))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok st.returned)))
    }))

; -1, 0 or 1 as kept row `a` sorts before, with or after `b`: by each
; term in its direction, then by rowid.
(:: compareKeyed (-> (Vec OrderTerm) Keyed Keyed Int))
(fn (compareKeyed order a b)
  (let (
    (n (vecLen order))
    (mut i 0)
    (mut c 0)
  )
    {
      (while (&& (== c 0) (< i n))
        (let (
          (term (vecGet order i))
          (d (axqlSortCompare (vecGet a.keys i) (vecGet b.keys i)))
        )
          {
            (set c (if term.desc
              (- 0 d)
              d))
            (set i (+ i 1))
          }))
      (if (!= c 0)
        c
        (if (< a.rowid b.rowid)
          -1
          (> a.rowid b.rowid)
          1
          0))
    }))

; A stable merge sort, bottom up, so it needs no recursion.
(:: mergeSort (-> (Vec Keyed) (Vec OrderTerm) (Vec Keyed)))
(fn (mergeSort xs order)
  (let (
    (n (vecLen xs))
    (mut src xs)
    (mut width 1)
  )
    {
      (while (< width n)
        (let ((dst (vecWithCapacity n)))
          {
            (let ((mut lo 0))
              (while (< lo n)
                (let (
                  (mid (if (< (+ lo width) n)
                    (+ lo width)
                    n))
                  (hi (if (< (+ lo (* 2 width)) n)
                    (+ lo (* 2 width))
                    n))
                  (mut i lo)
                  (mut j (if (< (+ lo width) n)
                    (+ lo width)
                    n))
                )
                  {
                    (while (|| (< i mid) (< j hi))
                      (if (&& (< i mid)
                            (|| (>= j hi)
                              (<= (compareKeyed order (vecGet src i) (vecGet src j)) 0)))
                        {
                          (vecPush dst (vecGet src i))
                          (set i (+ i 1))
                        }
                        {
                          (vecPush dst (vecGet src j))
                          (set j (+ j 1))
                        }))
                    (set lo hi)
                  })))
            (set src dst)
            (set width (* width 2))
          }))
      src
    }))

; ------------------------------------------------------------------
; Grouped SELECT: running.
; ------------------------------------------------------------------
; One aggregate's running state over a group: how many values it has
; seen, their sum as an INTEGER or (once a REAL arrives, or an average
; outgrows 64 bits) a REAL, and the least or greatest so far.
(struct Acc
  (mut count : Int)
  (mut isum : Int)
  (mut rsum : Float)
  (mut real : Bool)
  (mut best : Value))

; One group: its GROUP BY values and their encoding, the next group
; whose encoding hashes alike, its first row, and its aggregates.
(struct Group
  (key : String)
  (keyVals : (Vec Value))
  (next : Int)
  (rowid : Int)
  (values : (Vec Value))
  (accs : (Vec Acc)))

; Every group so far, in the order met, and the first group for each
; hash of an encoding.
(struct Groups
  (all : (Vec Group))
  (index : (Map Int)))

(:: newAccs (-> Int (Vec Acc)))
(fn (newAccs n)
  (let ((out vecNew))
    {
      (for i in 0..n
        (vecPush out (Acc 0 0 0.0 false VNull)))
      out
    }))

; FNV-1a over a string's bytes.
(:: hashBytes (-> String Int))
(fn (hashBytes s)
  (let ((mut h -3750763034362895579))
    {
      (for i in 0..(strLen s)
        (set h (* (^ h (strByte s i)) 1099511628211)))
      h
    }))

; A row of NULLs, one per type.
(:: nullRow (-> (Vec Int) (Vec Value)))
(fn (nullRow types)
  (let ((out vecNew))
    {
      (for t in types
        (vecPush out VNull))
      out
    }))

; The group row `r` belongs to, made when it is the first.
(:: findGroup (-> Exec GroupPlan Groups RowRef (Result Group Error)))
(fn (findGroup ex gp gs r)
  (let (
    (kv (axqlEvalAll gp.keys r.values r.rowid ex.params)?)
    (key (keyEncode kv)?)
  )
    (let (
      (h (hashBytes key))
      (head (mapGet gs.index h -1))
      (mut i (mapGet gs.index h -1))
      (mut found -1)
    )
      {
        (while (&& (< found 0) (>= i 0))
          (let ((g (vecGet gs.all i)))
            (if (strEq g.key key)
              (set found i)
              (set i g.next))))
        (if (>= found 0)
          (Ok (vecGet gs.all found))
          (let ((g (Group key kv head r.rowid r.values (newAccs (vecLen gp.aggs)))))
            {
              (mapInsert gs.index h (vecLen gs.all))
              (vecPush gs.all g)
              (Ok g)
            }))
      })))

; Add value `v` to an aggregate's state. NULL is skipped.
(:: addToAcc (-> Int Acc Value (Result Int Error)))
(fn (addToAcc kind acc v)
  (match v
    ((VNull) (Ok 0))
    (_
      {
        (set acc.count (+ acc.count 1))
        (if (|| (== kind aggMin) (== kind aggMax))
          (match acc.best
            ((VNull)
              {
                (set acc.best v)
                (Ok 0)
              }
            )
            (_
              (let ((c (axqlCompare v acc.best)?))
                {
                  (if (if (== kind aggMax)
                    (> c 0)
                    (< c 0))
                    (set acc.best v))
                  (Ok 0)
                })
            ))
          (if (== kind aggCount)
            (Ok 0)
            (match v
              ((VInt n)
                (if acc.real
                  {
                    (set acc.rsum (+ acc.rsum (as n Float)))
                    (Ok 0)
                  }
                  (let (
                    (old acc.isum)
                    (sum (+ acc.isum n))
                  )
                    (if (< (& (^ old sum) (^ n sum)) 0)
                      (if (== kind aggAvg)
                        {
                          (set acc.real true)
                          (set acc.rsum (+ (as old Float) (as n Float)))
                          (Ok 0)
                        }
                        (axqErr axqArithmetic
                          (concat (concat "integer overflow in sum: " (fmtInt old))
                            (concat " + " (fmtInt n)))
                          "axqlGroup"))
                      {
                        (set acc.isum sum)
                        (Ok 0)
                      })))
              )
              ((VReal x)
                {
                  (if (! acc.real)
                    {
                      (set acc.real true)
                      (set acc.rsum (as acc.isum Float))
                    })
                  (set acc.rsum (+ acc.rsum x))
                  (Ok 0)
                }
              )
              (_ (axqErr axqType "sum and avg need numbers" "axqlGroup")))))
      }
    )))

; Add row `r` to every aggregate of group `g`.
(:: accumulate (-> Exec GroupPlan Group RowRef (Result Int Error)))
(fn (accumulate ex gp g r)
  (let ((mut failure None))
    {
      (for (a k) in gp.aggs
        (if (! (isSome failure))
          (match a
            ((EAgg kind arg _)
              (let ((acc (vecGet g.accs k)))
                (match arg
                  ((None)
                    (set acc.count (+ acc.count 1))
                  )
                  ((Some x)
                    (match (axqlEval x r.values r.rowid ex.params)
                      ((Ok v)
                        (match (addToAcc kind acc v)
                          ((Ok _) ())
                          ((Err e)
                            (set failure (Some e))
                          ))
                      )
                      ((Err e)
                        (set failure (Some e))
                      ))
                  )))
            )
            (_ ()))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok 0)))
    }))

; An aggregate's value from its state.
(:: accValue (-> Int Acc Value))
(fn (accValue kind acc)
  (if (== kind aggCount)
    (VInt acc.count)
    (|| (== kind aggMin) (== kind aggMax))
    acc.best
    (== acc.count 0)
    VNull
    (== kind aggSum)
    (if acc.real
      (VReal acc.rsum)
      (VInt acc.isum))
    (VReal
      (/
        (if acc.real
          acc.rsum
          (as acc.isum Float))
        (as acc.count Float)))))

(:: groupRow (-> Exec GroupPlan Groups RowRef (Result Bool Error)))
(fn (groupRow ex gp gs r)
  (let (
    (g (findGroup ex gp gs r)?)
    (_ (accumulate ex gp g r)?)
  )
    (Ok true)))

; The statement's parameters, then group `g`'s aggregate values.
(:: groupParams (-> Exec GroupPlan Group (Vec Value)))
(fn (groupParams ex gp g)
  (let ((out vecNew))
    {
      (for v in ex.params
        (vecPush out v))
      (for (a k) in gp.aggs
        (vecPush out
          (match a
            ((EAgg kind _ _) (accValue kind (vecGet g.accs k)))
            (_ VNull))))
      out
    }))

; Group `g`'s result row with its ORDER BY keys, or `None` when HAVING
; leaves it out.
(:: groupOutput (-> Exec GroupPlan Group Int (Result (Option Keyed) Error)))
(fn (groupOutput ex gp g pos)
  (let ((ps (groupParams ex gp g)))
    (let ((keep
      (match gp.having
        ((None) (Ok true))
        ((Some h)
          (match (axqlEval h g.values g.rowid ps)
            ((Err er1) (Err er1))
            ((Ok v)
              (match (axqlTruth v)
                ((Err er) (Err er))
                ((Ok tv) (Ok (== tv tvTrue))))
            ))
        ))?))
      (if (! keep)
        (Ok None)
        (let ((outs (axqlEvalAll gp.outputs g.values g.rowid ps)?))
          (let ((oes vecNew))
            {
              (for o in gp.order
                (vecPush oes o.expr))
              (let ((ks (axqlEvalAll oes g.values g.rowid ps)?))
                (Ok (Some (Keyed ks pos outs))))
            }))))))

; Hand the result rows on, after OFFSET and within LIMIT.
(:: emitGroups (-> SelectPlan (Vec Keyed) (-> (Vec Value) (Result Bool Error)) (Result Int Error)))
(fn (emitGroups plan rows onRow)
  (let (
    (n (vecLen rows))
    (mut i plan.offset)
    (mut returned 0)
    (mut going true)
    (mut failure None)
  )
    {
      (while (&& going (&& (< i n) (|| (< plan.limit 0) (< returned plan.limit))))
        (let ((k (vecGet rows i)))
          {
            (match (onRow k.values)
              ((Ok more)
                (set going more)
              )
              ((Err e)
                {
                  (set failure (Some e))
                  (set going false)
                }
              ))
            (set returned (+ returned 1))
            (set i (+ i 1))
          }))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok returned)))
    }))

; Every group's result row, in GROUP BY order or ORDER BY's.
(:: finishGroups
  (-> Exec SelectPlan GroupPlan Groups (-> (Vec Value) (Result Bool Error)) (Result Int Error)))
(fn (finishGroups ex plan gp gs onRow)
  {
    (if (&& (== (vecLen gp.keys) 0) (== (vecLen gs.all) 0))
      (vecPush gs.all
        (Group "" vecNew -1 0 (nullRow (colTypesOf plan.table)) (newAccs (vecLen gp.aggs))))
      gs.all)
    (let (
      (byKey vecNew)
      (keyTerms vecNew)
    )
      {
        (for k in gp.keys
          (vecPush keyTerms (OrderTerm k false)))
        (for (g i) in gs.all
          (vecPush byKey (Keyed g.keyVals i vecNew)))
        (let (
          (ordered (mergeSort byKey keyTerms))
          (out vecNew)
          (mut failure None)
        )
          {
            (for (kg pos) in ordered
              (if (! (isSome failure))
                (match (groupOutput ex gp (vecGet gs.all kg.rowid) pos)
                  ((Ok got)
                    (match got
                      ((Some row) (vecPush out row))
                      ((None) ()))
                  )
                  ((Err err)
                    (set failure (Some err))
                  ))))
            (match failure
              ((Some err) (Err err))
              ((None)
                (emitGroups plan
                  (if (> (vecLen gp.order) 0)
                    (mergeSort out gp.order)
                    out)
                  onRow)
              ))
          })
      })
  })

; A grouped SELECT: every row WHERE keeps is added to its group, then
; each group gives one row.
(:: runGrouped
  (-> Exec SelectPlan GroupPlan (-> (Vec Value) (Result Bool Error)) (Result Int Error)))
;@axiom:effect(io)
(fn (runGrouped ex plan gp onRow)
  (let ((gs (Groups vecNew mapNew)))
    (let ((_
      (match plan.table
        ((None)
          (match (axqlKeep plan.terms vecNew 0 ex.params)
            ((Err er1) (Err er1))
            ((Ok keep)
              (if keep
                (match (groupRow ex gp gs (RowRef 0 vecNew))
                  ((Err er) (Err er))
                  ((Ok _) (Ok 1)))
                (Ok 0))
            ))
        )
        ((Some td)
          (scanRows ex td plan.access
            (lambda (r)
              (let (
                (xr (widenRow ex td plan.fetch r)?)
                (keep (axqlKeep plan.terms xr.values xr.rowid ex.params)?)
              )
                (if keep
                  (groupRow ex gp gs xr)
                  (Ok true)))
            ))
        ))?))
      (finishGroups ex plan gp gs onRow))))

; ------------------------------------------------------------------
; Writing rows.
; ------------------------------------------------------------------
; Refuse a row of `t` that breaks a constraint, before anything is
; written: a NULL in a NOT NULL column, a rowid already taken (unless it
; is `self`, the row being rewritten), or a UNIQUE index value already
; held by another row.
; What a table asks of every row written to it: each column's DEFAULT
; value (NULL when it has none), and its CHECK expressions, bound, with
; the column each belongs to.
(struct Rules
  (defaults : (Vec Value))
  (checks : (Vec Expr))
  (checkCols : (Vec Int)))

; Column `c`'s DEFAULT, worked out: a value that names no column.
(:: defaultValue (-> Exec ColumnDef Expr (Result Value Error)))
(fn (defaultValue ex c e)
  (if (|| (! (axqlIsConstant e)) (axqlHasParamOrLink e))
    (axqErr axqSchema
      (concat (concat "the DEFAULT of " c.name)
        " must be a value, not something that names a column or takes a parameter")
      "axqlCreateTable")
    (if (axqlHasAgg e)
      (aggMisplaced ex e "a DEFAULT is one value")
      (let (
        (b (bind ex None e)?)
        (vt (typeOfBound ex None b)?)
      )
        (if (! (typeFits c.ctype vt))
          (axqErr axqType
            (concat
              (concat (concat (concat c.name " is ") (typeName c.ctype)) ", but its DEFAULT is ")
              (typeName vt))
            "axqlCreateTable")
          (let ((f (axqlFold b vecNew)?))
            (match f
              ((ELit v) (Ok (coerce c.ctype v)))
              (_
                (axqErr axqSchema (concat "the DEFAULT of " (concat c.name " isn't a value"))
                  "axqlCreateTable")
              ))))))))

; Column `c`'s CHECK bound against table `t`: a truth value over the
; row's own columns.
(:: bindCheck (-> Exec TableDef ColumnDef Expr (Result Expr Error)))
(fn (bindCheck ex t c e)
  (if (axqlHasParamOrLink e)
    (axqErr axqSchema
      (concat (concat "the CHECK of " c.name) " can't take a parameter or follow a link")
      "axqlCreateTable")
    (if (axqlHasAgg e)
      (aggMisplaced ex e "a CHECK looks at one row")
      (let (
        (b (bind ex (Some t) e)?)
        (ty (typeOfBound ex (Some t) b)?)
      )
        (if (|| (== ty typeText) (== ty typeBlob))
          (axqErr axqType
            (concat (concat (concat "the CHECK of " c.name) " needs a truth value, not ")
              (typeName ty))
            "axqlCreateTable")
          (axqlFold b vecNew))))))

(:: prepareRules (-> Exec TableDef (Result Rules Error)))
(fn (prepareRules ex t)
  (let (
    (defaults vecNew)
    (checks vecNew)
    (checkCols vecNew)
    (mut failure None)
  )
    {
      (for (c i) in t.cols
        (if (! (isSome failure))
          {
            (match c.dflt
              ((None) (vecPush defaults VNull))
              ((Some e)
                (match (defaultValue ex c e)
                  ((Ok v) (vecPush defaults v))
                  ((Err err)
                    {
                      (set failure (Some err))
                      defaults
                    }
                  ))
              ))
            (match c.check
              ((None) ())
              ((Some e)
                (match (bindCheck ex t c e)
                  ((Ok b)
                    {
                      (vecPush checks b)
                      (vecPush checkCols i)
                    }
                  )
                  ((Err err)
                    (set failure (Some err))
                  ))
              ))
          }))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok (Rules defaults checks checkCols))))
    }))

; Refuse a row of `t` that a CHECK finds FALSE. NULL passes.
(:: checkRules (-> Exec TableDef Rules (Vec Value) Int (Result Int Error)))
(fn (checkRules ex t rules values rowid)
  (let ((mut failure None))
    {
      (for (e k) in rules.checks
        (if (! (isSome failure))
          (match (axqlEval e values rowid vecNew)
            ((Ok v)
              (match (axqlTruth v)
                ((Ok tv)
                  (if (== tv tvFalse)
                    (let ((c (vecGet t.cols (vecGet rules.checkCols k))))
                      (set failure (Some
                                     (errContextOf
                                       (mkError axqConstraint
                                         (concat
                                           (concat
                                             (concat (concat "a row of " t.name)
                                               " breaks the CHECK on ")
                                             c.name)
                                           (concat ": " c.text)))
                                       "axqlWrite")))))
                )
                ((Err err)
                  (set failure (Some err))
                ))
            )
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok 0)))
    }))

; Refuse a row whose LINK column names a row its table doesn't have.
; A row may link to itself.
(:: checkLinks (-> Exec TableDef (Vec Value) Int (Result Int Error)))
;@axiom:effect(io)
(fn (checkLinks ex t values rowid)
  (let ((mut failure None))
    {
      (for ld in t.links
        (if (! (isSome failure))
          (match (vecGet values ld.col)
            ((VInt n)
              (let ((tgt ld.target))
                (if (! (&& (== n rowid) (axqlNameEq tgt.name t.name)))
                  (match (btreeGet ex.pager tgt.root (keyRowid n))
                    ((Ok got)
                      (if (! (isSome got))
                        (let ((c (vecGet t.cols ld.col)))
                          (set failure (Some
                                         (errContextOf
                                           (mkError axqConstraint
                                             (concat
                                               (concat
                                                 (concat (concat (concat t.name ".") c.name) " is ")
                                                 (fmtInt n))
                                               (concat (concat ", but " tgt.name)
                                                 (concat " has no row " (fmtInt n)))))
                                           "axqlWrite")))))
                    )
                    ((Err err)
                      (set failure (Some err))
                    ))))
            )
            (_ ()))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok 0)))
    }))

(:: checkRow (-> Exec TableDef Rules (Vec Value) Int Int (Result Int Error)))
;@axiom:effect(io)
(fn (checkRow ex t rules values rowid self)
  (let (
    (_ (checkNotNull t values)?)
    (_ (checkRules ex t rules values rowid)?)
    (taken (if (== rowid self)
      (Ok false)
      (match (btreeGet ex.pager t.root (keyRowid rowid))
        ((Err er) (Err er))
        ((Ok got) (Ok (isSome got)))))?)
  )
    (if taken
      (axqErr axqConstraint
        (concat
          (concat (concat "a row with rowid " (fmtInt rowid)) (concat " already exists in " t.name))
          "; UPSERT updates a row that is there")
        "axqlWrite")
      (let ((_ (checkUnique ex t values rowid self)?))
        {
          (if (> (vecLen t.links) 0)
            (vecPush ex.written (RowRef rowid values))
            ex.written)
          (Ok 0)
        }))))

; Check the links of every row the statement wrote, once all of them
; are written, so rows of one statement may link to each other.
(:: checkWritten (-> Exec TableDef (Result Int Error)))
;@axiom:effect(io)
(fn (checkWritten ex t)
  (let ((mut failure None))
    {
      (for r in ex.written
        (if (! (isSome failure))
          (match (checkLinks ex t r.values r.rowid)
            ((Ok _) ())
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok ex.changes)))
    }))

(:: checkNotNull (-> TableDef (Vec Value) (Result Int Error)))
(fn (checkNotNull t values)
  (let ((mut bad ""))
    {
      (for (c i) in t.cols
        (if (&& (strIsEmpty bad) (&& c.notNull (&& (!= i t.pk) (isNullValue (vecGet values i)))))
          (set bad c.name)))
      (if (strIsEmpty bad)
        (Ok 0)
        (axqErr axqConstraint
          (concat (concat (concat t.name ".") (concat bad " may not be NULL"))
            "; give it a value, or declare it with a DEFAULT")
          "axqlWrite"))
    }))

; Refuse `values` when a UNIQUE index of `t` already holds them for a
; row other than `self` (or `rowid`, the row's own new rowid).
(:: checkUnique (-> Exec TableDef (Vec Value) Int Int (Result Int Error)))
;@axiom:effect(io)
(fn (checkUnique ex t values rowid self)
  (let (
    (n (vecLen t.indexes))
    (mut i 0)
    (mut failure None)
  )
    {
      (while (&& (isNone failure) (< i n))
        (let ((ix (vecGet t.indexes i)))
          {
            (if (&& ix.unique (! (axqlIndexHasNull ix values)))
              (match (uniqueHolder ex ix values)
                ((Ok holder)
                  (if (&& (>= holder 0) (&& (!= holder self) (!= holder rowid)))
                    (set failure (Some
                                   (mkError axqConstraint
                                     (concat
                                       (concat (concat "the UNIQUE index " ix.name)
                                         (concat " on " (indexColText t ix)))
                                       (concat " already holds that value for another row of "
                                         t.name))))))
                )
                ((Err e)
                  (set failure (Some e))
                )))
            (set i (+ i 1))
          }))
      (match failure
        ((Some e) (Err (errContextOf e "axqlWrite")))
        ((None) (Ok 0)))
    }))

; An index's columns as a message writes them: `(a, b)`.
(:: indexColText (-> TableDef IndexDef String))
(fn (indexColText t ix)
  (let ((mut out "("))
    {
      (for (ci i) in ix.cols
        (let ((c (vecGet t.cols ci)))
          (set out (concat out
                     (concat
                       (if (== i 0)
                         ""
                         ", ")
                       c.name)))))
      (concat out ")")
    }))

; The rowid of some row `ix` holds `values` for, or -1. A UNIQUE index
; holds at most one row per value, and the rewrite in progress may be
; that row.
(:: uniqueHolder (-> Exec IndexDef (Vec Value) (Result Int Error)))
;@axiom:effect(io)
(fn (uniqueHolder ex ix values)
  (let ((prefix (axqlIndexPrefix ix values)?))
    (let ((found (Holder -1)))
      (let ((_
        (btreeScan ex.pager ix.root (Some prefix) (keyPrefixEnd prefix) true
          (lambda (k v) (holderFound found k)))?))
        (Ok found.rowid)))))

(struct Holder
  (mut rowid : Int))

(:: holderFound (-> Holder String (Result Bool Error)))
(fn (holderFound h k)
  (let ((r (keyIndexRowid k)?))
    {
      (set h.rowid r)
      (Ok false)
    }))

; Write a new row of `t` under `rowid`, with its index entries.
(:: writeRow (-> Exec TableDef (Vec Value) Int (Result Int Error)))
;@axiom:effect(io)
(fn (writeRow ex t values rowid)
  (let (
    (rec (axqlRowRecord t values)?)
    (fresh (putNew ex t.root (keyRowid rowid) rec)?)
  )
    (if (! fresh)
      (axqErr axqConstraint
        (concat (concat "a row with rowid " (fmtInt rowid)) (concat " already exists in " t.name))
        "axqlWrite")
      (writeIndexEntries ex t values rowid))))

(:: writeIndexEntries (-> Exec TableDef (Vec Value) Int (Result Int Error)))
;@axiom:effect(io)
(fn (writeIndexEntries ex t values rowid)
  (let (
    (n (vecLen t.indexes))
    (mut i 0)
    (mut failure None)
  )
    {
      (while (&& (isNone failure) (< i n))
        {
          (match (writeIndexEntry ex (vecGet t.indexes i) values rowid)
            ((Ok _) ())
            ((Err e)
              (set failure (Some e))
            ))
          (set i (+ i 1))
        })
      (match failure
        ((Some e) (Err e))
        ((None) (Ok 0)))
    }))

(:: writeIndexEntry (-> Exec IndexDef (Vec Value) Int (Result Int Error)))
;@axiom:effect(io)
(fn (writeIndexEntry ex ix values rowid)
  (let ((prefix (axqlIndexPrefix ix values)?))
    (let ((key (keyWithRowid prefix rowid)))
      (if (> (strLen key) btreeMaxKey)
        (axqErr axqTooBig
          (concat
            (concat (concat "the index " ix.name)
              (concat " can't hold this row: its entry would be " (fmtInt (strLen key))))
            (concat " bytes, and an index entry holds at most " (fmtInt btreeMaxKey)))
          "axqlWrite")
        (let ((_ (putNew ex ix.root key "")?))
          (Ok 0))))))

; Remove row `rowid` of `t`, whose values and record are given, with
; its index entries.
(:: removeRow (-> Exec TableDef (Vec Value) Int String (Result Int Error)))
;@axiom:effect(io)
(fn (removeRow ex t values rowid rec)
  (let ((_ (removeIndexEntries ex t values rowid)?))
    (deleteKey ex t.root (keyRowid rowid) rec)))

(:: removeIndexEntries (-> Exec TableDef (Vec Value) Int (Result Int Error)))
;@axiom:effect(io)
(fn (removeIndexEntries ex t values rowid)
  (let (
    (n (vecLen t.indexes))
    (mut i 0)
    (mut failure None)
  )
    {
      (while (&& (isNone failure) (< i n))
        {
          (match (removeIndexEntry ex (vecGet t.indexes i) values rowid)
            ((Ok _) ())
            ((Err e)
              (set failure (Some e))
            ))
          (set i (+ i 1))
        })
      (match failure
        ((Some e) (Err e))
        ((None) (Ok 0)))
    }))

(:: removeIndexEntry (-> Exec IndexDef (Vec Value) Int (Result Int Error)))
;@axiom:effect(io)
(fn (removeIndexEntry ex ix values rowid)
  (let ((prefix (axqlIndexPrefix ix values)?))
    (deleteKey ex ix.root (keyWithRowid prefix rowid) "")))

; The rowid a new row gets when it names none: one more than the
; largest, or 1 in an empty table.
(:: nextRowid (-> Exec TableDef (Result Int Error)))
;@axiom:effect(io)
(fn (nextRowid ex t)
  (let ((last (btreeLastKey ex.pager t.root)?))
    (match last
      ((None) (Ok 1))
      ((Some k)
        (let ((r (keyRowidOf k)?))
          (if (== r intMax)
            (axqErr axqTooBig
              (concat "every rowid of " (concat t.name " up to 9223372036854775807 is taken"))
              "axqlWrite")
            (Ok (+ r 1))))
      ))))

; ------------------------------------------------------------------
; INSERT.
; ------------------------------------------------------------------
; The column each position of an INSERT's column list fills: a column
; number, with the rowid (when no column is called `rowid`) as the
; primary key's number, or -1 when the table has none.
(:: insertTargets (-> Exec TableDef (Vec String) (Result (Vec Int) Error)))
(fn (insertTargets ex t names)
  (let (
    (out vecNew)
    (mut failure None)
  )
    {
      (if (== (vecLen names) 0)
        (for (c i) in t.cols
          (vecPush out i))
        (for n in names
          (if (isSome failure)
            out
            (let ((ci (axqlColumnIndex t.cols n)))
              (let ((target
                (if (>= ci 0)
                  ci
                  (if (axqlNameEq n "rowid")
                    (if (>= t.pk 0)
                      t.pk
                      -2)
                    -3))))
                (if (== target -3)
                  {
                    (set failure (Some
                                   (mkError axqSchema
                                     (concat
                                       (concat (concat "table " t.name)
                                         (concat " has no column named " n))
                                       (columnHint t n)))))
                    out
                  }
                  (if (vecHasInt out target)
                    {
                      (set failure (Some
                                     (mkError axqSchema
                                       (concat (concat "column " n) " is named twice"))))
                      out
                    }
                    (vecPush out target))))))))
      (match failure
        ((Some e) (Err (errContextOf e "axqlInsert")))
        ((None) (Ok out)))
    }))

(:: vecHasInt (-> (Vec Int) Int Bool))
(fn (vecHasInt v x)
  (let ((mut found false))
    {
      (for y in v
        (if (== y x)
          (set found true)))
      found
    }))

(:: runInsert (-> Exec Schema String (Vec String) (Vec (Vec Expr)) (Result Int Error)))
;@axiom:effect(io)
(fn (runInsert ex schema table names rows)
  (let (
    (t (axqlTableDef schema table)?)
    (targets (insertTargets ex t names)?)
    (rules (prepareRules ex t)?)
    (prepared (prepareRows ex t targets rows)?)
    (_ (insertRows ex t rules targets prepared 0)?)
  )
    (checkWritten ex t)))

; Every row's values folded, in the order the column list names, each
; checked against its column's type. A row of the wrong width is
; `axqSchema`.
(:: prepareRows (-> Exec TableDef (Vec Int) (Vec (Vec Expr)) (Result (Vec (Vec Value)) Error)))
(fn (prepareRows ex t targets rows)
  (let (
    (out vecNew)
    (mut failure None)
  )
    {
      (for row in rows
        (if (isNone failure)
          (match (prepareRow ex t targets row)
            ((Ok vals) (vecPush out vals))
            ((Err e)
              (set failure (Some e))
            ))))
      (match failure
        ((Some e) (Err e))
        ((None) (Ok out)))
    }))

(:: prepareRow (-> Exec TableDef (Vec Int) (Vec Expr) (Result (Vec Value) Error)))
(fn (prepareRow ex t targets row)
  (if (!= (vecLen row) (vecLen targets))
    (axqErr axqSchema
      (concat (concat "a row of VALUES holds " (countOf (vecLen row) "value"))
        (concat " for " (countOf (vecLen targets) "column")))
      "axqlInsert")
    (let (
      (out vecNew)
      (mut failure None)
    )
      {
        (for (e i) in row
          (if (isNone failure)
            (match (prepareValue ex t (vecGet targets i) e)
              ((Ok v) (vecPush out v))
              ((Err err)
                (set failure (Some err))
              ))))
        (match failure
          ((Some err) (Err err))
          ((None) (Ok out)))
      })))

; One value bound for column `target` of `t` (-2 is the rowid of a table
; with no primary key column): checked against the column's type and
; folded. VALUES names no column, so the expression binds to none.
(:: prepareValue (-> Exec TableDef Int Expr (Result Value Error)))
(fn (prepareValue ex t target e)
  (if (axqlHasAgg e)
    (aggMisplaced ex e "VALUES gives one row at a time")
    (prepareOneValue ex t target e)))

(:: prepareOneValue (-> Exec TableDef Int Expr (Result Value Error)))
(fn (prepareOneValue ex t target e)
  (let (
    (b (bind ex None e)?)
    (vt (typeOfBound ex None b)?)
  )
    (let ((ct
      (if (< target 0)
        typeInteger
        (let ((c (vecGet t.cols target)))
          c.ctype))))
      (if (! (typeFits ct vt))
        (axqErr axqType
          (concat
            (concat (concat (concat "column " (targetName t target)) (concat " is " (typeName ct)))
              (concat ", not " (typeName vt)))
            (convertHint ct vt))
          "axqlInsert")
        (let ((f (axqlFold b ex.params)?))
          (match f
            ((ELit v) (Ok (coerce ct v)))
            (_ (axqErr axqSchema "VALUES can't name a column" "axqlInsert"))))))))

; A hint naming the function that converts a value of type `vt` to
; type `ct`, when there is one.
(:: convertHint (-> Int Int String))
(fn (convertHint ct vt)
  (if (&& (== ct typeInteger) (|| (== vt typeText) (== vt typeReal)))
    "; asInt converts the value"
    (&& (== ct typeReal) (== vt typeText))
    "; asReal converts the value"
    (&& (== ct typeText) (|| (== vt typeInteger) (|| (== vt typeReal) (== vt typeBlob))))
    "; asText converts the value"
    ""))

; `n` and a noun, plural unless `n` is 1.
(:: countOf (-> Int String String))
(fn (countOf n noun)
  (concat (concat (fmtInt n) " ")
    (if (== n 1)
      noun
      (concat noun "s"))))

(:: targetName (-> TableDef Int String))
(fn (targetName t target)
  (if (< target 0)
    "rowid"
    (let ((c (vecGet t.cols target)))
      c.name)))

; Insert each prepared row in turn.
(:: insertRows (-> Exec TableDef Rules (Vec Int) (Vec (Vec Value)) Int (Result Int Error)))
;@axiom:effect(io)
(fn (insertRows ex t rules targets rows i)
  (if (>= i (vecLen rows))
    (Ok ex.changes)
    (let ((_ (insertOne ex t rules targets (vecGet rows i))?))
      (insertRows ex t rules targets rows (+ i 1)))))

(:: insertOne (-> Exec TableDef Rules (Vec Int) (Vec Value) (Result Int Error)))
;@axiom:effect(io)
(fn (insertOne ex t rules targets given)
  (let (
    (values vecNew)
    (mut explicit VNull)
  )
    {
      (for (c i) in t.cols
        (vecPush values (vecGet rules.defaults i)))
      (for (target i) in targets
        (if (< target 0)
          (set explicit (vecGet given i))
          {
            (vecSet values target (vecGet given i))
            (if (== target t.pk)
              (set explicit (vecGet given i)))
          }))
      (let ((rowid
        (match explicit
          ((VInt n) (Ok n))
          (_ (nextRowid ex t)))?))
        {
          (if (>= t.pk 0)
            (vecSet values t.pk (VInt rowid))
            values)
          (let (
            (_ (checkRow ex t rules values rowid -1)?)
            (_ (writeRow ex t values rowid)?)
          )
            {
              (set ex.changes (+ ex.changes 1))
              (set ex.lastRowid rowid)
              (set ex.inserted true)
              (Ok 0)
            })
        })
    }))

; ------------------------------------------------------------------
; UPSERT.
; ------------------------------------------------------------------
; The rowid a row of an INSERT or UPSERT gives, through the rowid or the
; INTEGER PRIMARY KEY, if it gives one.
(:: givenRowid (-> TableDef (Vec Int) (Vec Value) (Option Int)))
(fn (givenRowid t targets given)
  (let ((mut found None))
    {
      (for (target i) in targets
        (if (|| (< target 0) (== target t.pk))
          (match (vecGet given i)
            ((VInt n)
              (set found (Some n))
            )
            (_ ()))))
      found
    }))

; One row of an UPSERT: when its rowid names a row that exists, that
; row's columns the statement lists are set and the rest kept;
; otherwise the row is inserted.
(:: upsertOne (-> Exec TableDef Rules (Vec Int) (Vec Value) (Result Int Error)))
;@axiom:effect(io)
(fn (upsertOne ex t rules targets given)
  (match (givenRowid t targets given)
    ((None) (insertOne ex t rules targets given))
    ((Some n)
      (let ((got (btreeGet ex.pager t.root (keyRowid n))?))
        (match got
          ((None) (insertOne ex t rules targets given))
          ((Some rec)
            (let ((old (axqlRowValues t rec n)?))
              (let ((values vecNew))
                {
                  (for v in old
                    (vecPush values v))
                  (for (target i) in targets
                    (if (>= target 0)
                      (vecSet values target (vecGet given i))
                      values))
                  (let (
                    (_ (checkRow ex t rules values n n)?)
                    (newRec (axqlRowRecord t values)?)
                    (_ (removeIndexEntries ex t old n)?)
                    (_ (putOver ex t.root (keyRowid n) newRec rec)?)
                    (_ (writeIndexEntries ex t values n)?)
                  )
                    {
                      (set ex.changes (+ ex.changes 1))
                      (set ex.lastRowid n)
                      (set ex.inserted true)
                      (Ok 0)
                    })
                }))
          )))
    )))

(:: upsertRows (-> Exec TableDef Rules (Vec Int) (Vec (Vec Value)) Int (Result Int Error)))
;@axiom:effect(io)
(fn (upsertRows ex t rules targets rows i)
  (if (>= i (vecLen rows))
    (Ok ex.changes)
    (let ((_ (upsertOne ex t rules targets (vecGet rows i))?))
      (upsertRows ex t rules targets rows (+ i 1)))))

(:: runUpsert (-> Exec Schema String (Vec String) (Vec (Vec Expr)) (Result Int Error)))
;@axiom:effect(io)
(fn (runUpsert ex schema table names rows)
  (let (
    (t (axqlTableDef schema table)?)
    (targets (insertTargets ex t names)?)
    (rules (prepareRules ex t)?)
    (prepared (prepareRows ex t targets rows)?)
    (_ (upsertRows ex t rules targets prepared 0)?)
  )
    (checkWritten ex t)))

; ------------------------------------------------------------------
; UPDATE and DELETE.
; ------------------------------------------------------------------
; The rows a WHERE matches, collected before any is changed.
(struct Matches
  (rows : (Vec RowRef)))

(:: collectMatches (-> Exec TableDef (Option Expr) (Result (Vec RowRef) Error)))
;@axiom:effect(io)
(fn (collectMatches ex t w)
  (let (
    (terms (prepareWhere ex (Some t) w)?)
    (a (planAccess t terms vecNew)?)
  )
    (let (
      (m (Matches vecNew))
      (used (linksRead t terms))
    )
      (let ((_
        (scanRows ex t a
          (lambda (r)
            (let ((xr (widenRow ex t used r)?))
              (matchRow ex terms m r xr))
          ))?))
        (Ok m.rows)))))

; Keep `r` when WHERE holds for it, read as `xr`, its widened row.
(:: matchRow (-> Exec (Vec Expr) Matches RowRef RowRef (Result Bool Error)))
(fn (matchRow ex terms m r xr)
  (let ((keep (axqlKeep terms xr.values xr.rowid ex.params)?))
    {
      (if keep
        (vecPush m.rows r)
        m.rows)
      (Ok true)
    }))

(:: runDelete (-> Exec Schema String (Option Expr) (Result Int Error)))
;@axiom:effect(io)
(fn (runDelete ex schema table w)
  (let (
    (t (axqlTableDef schema table)?)
    (rows (collectMatches ex t w)?)
  )
    (deleteRows ex t rows 0)))

(:: deleteRows (-> Exec TableDef (Vec RowRef) Int (Result Int Error)))
;@axiom:effect(io)
(fn (deleteRows ex t rows i)
  (if (>= i (vecLen rows))
    (Ok ex.changes)
    (let ((r (vecGet rows i)))
      (let (
        (rec (axqlRowRecord t r.values)?)
        (_ (removeRow ex t r.values r.rowid rec)?)
      )
        {
          (set ex.changes (+ ex.changes 1))
          (deleteRows ex t rows (+ i 1))
        }))))

; The SET list bound: each target column and its folded expression.
(struct Sets
  (cols : (Vec Int))
  (exprs : (Vec Expr)))

(:: prepareSets (-> Exec TableDef (Vec String) (Vec Expr) (Result Sets Error)))
(fn (prepareSets ex t names exprs)
  (let (
    (cols vecNew)
    (out vecNew)
    (mut failure None)
  )
    {
      (for (n i) in names
        (if (isNone failure)
          (let ((ci (axqlColumnIndex t.cols n)))
            (let ((target
              (if (>= ci 0)
                ci
                (if (axqlNameEq n "rowid")
                  (if (>= t.pk 0)
                    t.pk
                    -1)
                  -3))))
              (if (== target -3)
                (set failure (Some
                               (mkError axqSchema
                                 (concat (concat "table " t.name)
                                   (concat " has no column named " n)))))
                (if (vecHasInt cols target)
                  (set failure (Some
                                 (mkError axqSchema (concat (concat "column " n) " is set twice"))))
                  (match (prepareSet ex t target (vecGet exprs i))
                    ((Ok e)
                      {
                        (vecPush cols target)
                        (vecPush out e)
                      }
                    )
                    ((Err err)
                      (set failure (Some err))
                    ))))))))
      (match failure
        ((Some e) (Err (errContextOf e "axqlUpdate")))
        ((None) (Ok (Sets cols out))))
    }))

(:: prepareSet (-> Exec TableDef Int Expr (Result Expr Error)))
(fn (prepareSet ex t target e)
  (if (axqlHasAgg e)
    (aggMisplaced ex e "SET works out one row at a time")
    (prepareOneSet ex t target e)))

; Whether a bound expression reads a linked row's column.
(:: readsLink (-> TableDef Expr Bool))
(fn (readsLink t e)
  (let (
    (cols vecNew)
    (mut found false)
  )
    {
      (axqlColumnsRead e cols)
      (for c in cols
        (if (>= c (vecLen t.cols))
          (set found true)))
      found
    }))

(:: prepareOneSet (-> Exec TableDef Int Expr (Result Expr Error)))
(fn (prepareOneSet ex t target e)
  (let ((b (bind ex (Some t) e)?))
    (if (readsLink t b)
      (axqErr axqSchema
        (atPos ex (exprPosOf e)
          "SET can't read through a link; read the linked value with a SELECT first")
        "axqlUpdate")
      (let ((vt (typeOfBound ex (Some t) b)?))
        (let ((ct
          (if (< target 0)
            typeInteger
            (let ((c (vecGet t.cols target)))
              c.ctype))))
          (if (! (typeFits ct vt))
            (axqErr axqType
              (concat
                (concat
                  (concat (concat "column " (targetName t target)) (concat " is " (typeName ct)))
                  (concat ", not " (typeName vt)))
                (convertHint ct vt))
              "axqlUpdate")
            (axqlFold b ex.params)))))))

(:: runUpdate (-> Exec Schema String (Vec String) (Vec Expr) (Option Expr) (Result Int Error)))
;@axiom:effect(io)
(fn (runUpdate ex schema table names exprs w)
  (let (
    (t (axqlTableDef schema table)?)
    (sets (prepareSets ex t names exprs)?)
    (rules (prepareRules ex t)?)
    (rows (collectMatches ex t w)?)
    (_ (updateRows ex t rules sets rows 0)?)
  )
    (checkWritten ex t)))

(:: updateRows (-> Exec TableDef Rules Sets (Vec RowRef) Int (Result Int Error)))
;@axiom:effect(io)
(fn (updateRows ex t rules sets rows i)
  (if (>= i (vecLen rows))
    (Ok ex.changes)
    (let ((_ (updateOne ex t rules sets (vecGet rows i))?))
      (updateRows ex t rules sets rows (+ i 1)))))

; Rewrite one row: evaluate every SET expression over the old values,
; check the new row, then move or overwrite it and its index entries.
(:: updateOne (-> Exec TableDef Rules Sets RowRef (Result Int Error)))
;@axiom:effect(io)
(fn (updateOne ex t rules sets r)
  (let (
    (nr (newRow ex t sets r)?)
    (_ (checkRow ex t rules nr.values nr.rowid r.rowid)?)
    (oldRec (axqlRowRecord t r.values)?)
    (newRec (axqlRowRecord t nr.values)?)
    (_ (removeIndexEntries ex t r.values r.rowid)?)
    (_ (if (== nr.rowid r.rowid)
      (putOver ex t.root (keyRowid r.rowid) newRec oldRec)
      (match (deleteKey ex t.root (keyRowid r.rowid) oldRec)
        ((Err er1) (Err er1))
        ((Ok _)
          (match (putNew ex t.root (keyRowid nr.rowid) newRec)
            ((Err er) (Err er))
            ((Ok fresh)
              (if fresh
                (Ok 0)
                (axqErr axqConstraint
                  (concat (concat "a row with rowid " (fmtInt nr.rowid))
                    (concat " already exists in " t.name))
                  "axqlUpdate"))
            ))
        )))?)
    (_ (writeIndexEntries ex t nr.values nr.rowid)?)
  )
    {
      (set ex.changes (+ ex.changes 1))
      (Ok 0)
    }))

; A rewritten row: its values and the rowid it will live under.
(struct NewRow
  (values : (Vec Value))
  (mut rowid : Int))

(:: newRow (-> Exec TableDef Sets RowRef (Result NewRow Error)))
(fn (newRow ex t sets r)
  (let (
    (out vecNew)
    (nr (NewRow out r.rowid))
    (mut failure None)
  )
    {
      (for v in r.values
        (vecPush out v))
      (for (target i) in sets.cols
        (if (isNone failure)
          (match (axqlEval (vecGet sets.exprs i) r.values r.rowid ex.params)
            ((Ok v)
              (if (>= target 0)
                (let ((c (vecGet t.cols target)))
                  (vecSet out target (coerce c.ctype v)))
                (match v
                  ((VInt n)
                    (set nr.rowid n)
                  )
                  (_
                    (set failure (Some
                                   (mkError axqConstraint
                                     (concat "the rowid of " (concat t.name " may not be NULL")))))
                  )))
            )
            ((Err e)
              (set failure (Some e))
            ))))
      (if (&& (isNone failure) (>= t.pk 0))
        (match (vecGet out t.pk)
          ((VInt n)
            (set nr.rowid n)
          )
          (_
            (set failure (Some
                           (mkError axqConstraint
                             (concat t.name "'s INTEGER PRIMARY KEY may not be NULL"))))
          )))
      (match failure
        ((Some e) (Err (errContextOf e "axqlUpdate")))
        ((None) (Ok nr)))
    }))

; ------------------------------------------------------------------
; DDL.
; ------------------------------------------------------------------
;; The most columns a table may have.
(pub :: axqlMaxColumns Int)
(pub fn (axqlMaxColumns)
  1000)

; Add a schema entry under the next schema rowid.
(:: addEntry (-> Exec String String String Int String (Result Int Error)))
;@axiom:effect(io)
(fn (addEntry ex kind name table root text)
  (let (
    (last (btreeLastKey ex.pager btreeSchemaRoot)?)
    (rowid (match last
      ((None) (Ok 1))
      ((Some k)
        (match (keyRowidOf k)
          ((Err er) (Err er))
          ((Ok r) (Ok (+ r 1))))
      ))?)
    (rec (axqlEntryRecord kind name table root text)?)
    (_ (putNew ex btreeSchemaRoot (keyRowid rowid) rec)?)
  )
    (Ok rowid)))

(:: removeEntry (-> Exec SchemaEntry (Result Int Error)))
;@axiom:effect(io)
(fn (removeEntry ex e)
  (let ((rec (axqlEntryRecord e.kind e.name e.table e.root e.text)?))
    (deleteKey ex btreeSchemaRoot (keyRowid e.rowid) rec)))

; Refuse a column's LINK, DEFAULT or CHECK that can't work: a link to a
; table that doesn't exist or from a PRIMARY KEY, or a DEFAULT or CHECK
; of the wrong type or shape.
(:: checkConstraints (-> Exec Schema String (Vec ColumnDef) (Result Int Error)))
(fn (checkConstraints ex schema table cols)
  (let (
    (self (TableDef table 0 cols (axqlPrimaryKey cols) vecNew vecNew))
    (mut failure None)
  )
    {
      (for c in cols
        (if (! (isSome failure))
          (let ((r
            (match (if (strIsEmpty c.link)
              (Ok 0)
              (if c.primaryKey
                (axqErr axqSchema (concat c.name " can't be both a LINK and the PRIMARY KEY")
                  "axqlCreateTable")
                (if (axqlNameEq c.link table)
                  (Ok 0)
                  (match (axqlFindEntry schema c.link)
                    ((Some e)
                      (if (strEq e.kind kindTable)
                        (Ok 0)
                        (axqErr axqSchema
                          (concat (concat (concat c.name " links to ") c.link)
                            ", which is an index, not a table")
                          "axqlCreateTable"))
                    )
                    ((None)
                      (axqErr axqSchema
                        (concat
                          (concat (concat (concat c.name " links to ") c.link)
                            ", which doesn't exist")
                          (axqlHint c.link (axqlTableNames schema) "tables"))
                        "axqlCreateTable")
                    )))))
              ((Err er2) (Err er2))
              ((Ok _)
                (match (match c.dflt
                  ((None) (Ok 0))
                  ((Some e)
                    (if c.primaryKey
                      (axqErr axqSchema
                        (concat c.name
                          " is the PRIMARY KEY, which takes the next rowid, so it can't have a DEFAULT")
                        "axqlCreateTable")
                      (match (defaultValue ex c e)
                        ((Err er) (Err er))
                        ((Ok v)
                          (match v
                            ((VNull)
                              (if c.notNull
                                (axqErr axqSchema
                                  (concat c.name " is NOT NULL, so its DEFAULT can't be NULL")
                                  "axqlCreateTable")
                                (Ok 0))
                            )
                            (_ (Ok 0)))
                        )))
                  ))
                  ((Err er1) (Err er1))
                  ((Ok _)
                    (match c.check
                      ((None) (Ok 0))
                      ((Some e)
                        (match (bindCheck ex self c e)
                          ((Err er) (Err er))
                          ((Ok _) (Ok 0)))
                      ))
                  ))
              ))))
            (match r
              ((Ok _) ())
              ((Err err)
                (set failure (Some err))
              )))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok 0)))
    }))

; Refuse a CREATE TABLE's columns: a duplicate name, a PRIMARY KEY on a
; column that isn't INTEGER, or more than one.
(:: checkColumns (-> String (Vec ColumnDef) (Result Int Error)))
(fn (checkColumns table cols)
  (let (
    (mut failure "")
    (mut pks 0)
  )
    {
      (if (> (vecLen cols) axqlMaxColumns)
        (set failure (concat "a table may have at most "
                       (concat (fmtInt axqlMaxColumns) " columns")))
        "")
      (for (c i) in cols
        (if (! (! (strIsEmpty failure)))
          {
            (for j in 0..i
              (let ((d (vecGet cols j)))
                (if (&& (strIsEmpty failure) (axqlNameEq c.name d.name))
                  (set failure (concat (concat "column " c.name) " is declared twice")))))
            (if c.primaryKey
              {
                (set pks (+ pks 1))
                (if (!= c.ctype typeInteger)
                  (set failure (concat
                                 (concat "PRIMARY KEY is allowed only on an INTEGER column, and "
                                   c.name)
                                 (concat " is " (typeName c.ctype))))
                  (if (> pks 1)
                    (set failure (concat table " has more than one PRIMARY KEY"))))
              })
          }))
      (if (strIsEmpty failure)
        (Ok 0)
        (axqErr axqSchema failure "axqlCreateTable"))
    }))

; "there is already a table named t", or "an index".
(:: alreadyNamed (-> SchemaEntry String))
(fn (alreadyNamed e)
  (concat
    (if (strEq e.kind kindTable)
      "there is already a table named "
      "there is already an index named ")
    e.name))

(:: runCreateTable (-> Exec Schema Bool String (Vec ColumnDef) String (Result Int Error)))
;@axiom:effect(io)
(fn (runCreateTable ex schema ifNotExists name cols text)
  (match (axqlFindEntry schema name)
    ((Some e)
      (if (&& ifNotExists (strEq e.kind kindTable))
        (Ok 0)
        (axqErr axqSchema (alreadyNamed e) "axqlCreateTable"))
    )
    ((None)
      (let (
        (_ (checkColumns name cols)?)
        (_ (checkConstraints ex schema name cols)?)
        (root (createTree ex btreeTable)?)
        (_ (addEntry ex kindTable name name root text)?)
        (_ (pagerBumpSchemaVersion ex.pager)?)
      )
        (Ok 0))
    )))

; An empty vector of schema entries, its element type fixed where it
; is made.
(:: entryVec (Vec SchemaEntry))
(fn (entryVec)
  vecNew)

(:: runDropTable (-> Exec Schema Bool String (Result Int Error)))
;@axiom:effect(io)
(fn (runDropTable ex schema ifExists name)
  (match (axqlFindEntry schema name)
    ((None)
      (if ifExists
        (Ok 0)
        (axqErr axqSchema
          (concat (concat "no such table: " name) (axqlHint name (axqlTableNames schema) "tables"))
          "axqlDropTable"))
    )
    ((Some e)
      (if (! (strEq e.kind kindTable))
        (axqErr axqSchema
          (concat (concat "no such table: " name) " (it names an index; use DROP INDEX)")
          "axqlDropTable")
        (let ((links (axqlLinksTo schema e.name)?))
          (if (> (vecLen links) 0)
            (axqErr axqSchema
              (concat (concat (concat (concat "can't drop " e.name) ": ") (vecGet links 0))
                (concat " links to it; drop " (concat (linkOwner (vecGet links 0)) " first")))
              "axqlDropTable")
            (let (
              (doomed (entryVec))
              (mut failure None)
            )
              {
                (for x in schema.entries
                  (if (&& (strEq x.kind kindIndex) (axqlNameEq x.table e.name))
                    (vecPush doomed x)
                    doomed))
                (vecPush doomed e)
                (for y in doomed
                  (if (isNone failure)
                    (match (removeEntry ex y)
                      ((Ok _) ())
                      ((Err err)
                        (set failure (Some err))
                      ))))
                (for z in doomed
                  (if (isNone failure)
                    (match (dropTree ex z.root)
                      ((Ok _) ())
                      ((Err err)
                        (set failure (Some err))
                      ))))
                (match failure
                  ((Some err) (Err err))
                  ((None)
                    (let ((_ (pagerBumpSchemaVersion ex.pager)?))
                      (Ok 0))
                  ))
              }))))
    )))

; The table of a `table.column` name.
(:: linkOwner (-> String String))
(fn (linkOwner tc)
  (match (strFindByte tc 46 0)
    ((Some k) (strSlice tc 0 k))
    ((None) tc)))

; Refuse an index's column list: a column the table lacks, or one
; named twice. Answers the column numbers.
(:: indexColumns (-> TableDef (Vec String) (Result (Vec Int) Error)))
(fn (indexColumns t names)
  (let (
    (out vecNew)
    (mut failure "")
  )
    {
      (for n in names
        (if (strIsEmpty failure)
          (let ((ci (axqlColumnIndex t.cols n)))
            (if (< ci 0)
              (set failure (concat (concat "table " t.name) (concat " has no column named " n)))
              (if (vecHasInt out ci)
                (set failure (concat (concat "column " n) " is named twice"))
                {
                  (vecPush out ci)
                  ""
                })))
          ""))
      (if (strIsEmpty failure)
        (Ok out)
        (axqErr axqSchema failure "axqlCreateIndex"))
    }))

(:: runCreateIndex (-> Exec Schema Bool Bool String String (Vec String) String (Result Int Error)))
;@axiom:effect(io)
(fn (runCreateIndex ex schema unique ifNotExists name table cols text)
  (match (axqlFindEntry schema name)
    ((Some e)
      (if (&& ifNotExists (strEq e.kind kindIndex))
        (Ok 0)
        (axqErr axqSchema (alreadyNamed e) "axqlCreateIndex"))
    )
    ((None)
      (let (
        (t (axqlTableDef schema table)?)
        (nums (indexColumns t cols)?)
        (root (createTree ex btreeIndex)?)
      )
        (let ((ix (IndexDef name root unique nums)))
          (let (
            (_ (scanTable ex t None None true (lambda (r) (indexOneRow ex t ix r)))?)
            (_ (addEntry ex kindIndex name t.name root text)?)
            (_ (pagerBumpSchemaVersion ex.pager)?)
          )
            (Ok 0))))
    )))

; Add one existing row to a new index, refusing a duplicate in a UNIQUE
; one.
(:: indexOneRow (-> Exec TableDef IndexDef RowRef (Result Bool Error)))
;@axiom:effect(io)
(fn (indexOneRow ex t ix r)
  (let ((holder
    (if (&& ix.unique (! (axqlIndexHasNull ix r.values)))
      (uniqueHolder ex ix r.values)
      (Ok -1))?))
    (if (>= holder 0)
      (axqErr axqConstraint
        (concat (concat "can't create the UNIQUE index " ix.name)
          (concat ": " (concat t.name " holds duplicate values")))
        "axqlCreateIndex")
      (let ((_ (writeIndexEntry ex ix r.values r.rowid)?))
        (Ok true)))))

(:: runDropIndex (-> Exec Schema Bool String (Result Int Error)))
;@axiom:effect(io)
(fn (runDropIndex ex schema ifExists name)
  (match (axqlFindEntry schema name)
    ((None)
      (if ifExists
        (Ok 0)
        (axqErr axqSchema (concat "no such index: " name) "axqlDropIndex"))
    )
    ((Some e)
      (if (! (strEq e.kind kindIndex))
        (axqErr axqSchema
          (concat (concat "no such index: " name) " (it names a table; use DROP TABLE)")
          "axqlDropIndex")
        (let (
          (_ (removeEntry ex e)?)
          (_ (dropTree ex e.root)?)
          (_ (pagerBumpSchemaVersion ex.pager)?)
        )
          (Ok 0)))
    )))

; ------------------------------------------------------------------
; ALTER TABLE.
; ------------------------------------------------------------------
; `name` as a statement writes it: in double quotes when it must be.
(:: quoteName (-> String String))
(fn (quoteName name)
  (if (! (axqlNameNeedsQuotes name))
    name
    (let ((mut out "\""))
      {
        (for i in 0..(strLen name)
          (let ((c (strByte name i)))
            (set out (concat out
                       (if (== c 34)
                         "\"\""
                         (strSlice name i 1))))))
        (concat out "\"")
      })))

; A CREATE TABLE's text from its name and its columns' texts.
(:: tableText (-> String (Vec String) String))
(fn (tableText name colTexts)
  (let ((mut out (concat (concat "CREATE TABLE " (quoteName name)) " (")))
    {
      (for (t i) in colTexts
        (set out (concat out
                   (concat
                     (if (== i 0)
                       ""
                       ", ")
                     t))))
      (concat out ")")
    }))

; Where the name starting at `at` of `text` ends: past its closing
; quote, or past its last letter, digit or underscore.
(:: nameEnd (-> String Int Int))
(fn (nameEnd text at)
  (let (
    (n (strLen text))
    (mut j (+ at 1))
    (mut done false)
  )
    (if (== (strByte text at) 34)
      {
        (while (&& (! done) (< j n))
          (if (== (strByte text j) 34)
            (if (== (strByte text (+ j 1)) 34)
              (set j (+ j 2))
              {
                (set j (+ j 1))
                (set done true)
              })
            (set j (+ j 1))))
        j
      }
      {
        (while (&& (< j n)
                 (let ((c (strByte text j)))
                   (|| (strIsAlpha c) (|| (strIsDigit c) (== c 95)))))
          (set j (+ j 1)))
        j
      })))

; The columns' texts, with every LINK to table `old` pointed at `new`.
(:: relinkedTexts (-> (Vec ColumnDef) String String (Vec String)))
(fn (relinkedTexts cols old new)
  (let ((out vecNew))
    {
      (for c in cols
        (vecPush out
          (if (&& (>= c.linkAt 0) (axqlNameEq c.link old))
            (let ((end (nameEnd c.text c.linkAt)))
              (concat (concat (strSlice c.text 0 c.linkAt) (quoteName new))
                (strSlice c.text end (- (strLen c.text) end))))
            c.text)))
      out
    }))

; Each column's text, as its statement wrote it.
(:: columnTexts (-> (Vec ColumnDef) (Vec String)))
(fn (columnTexts cols)
  (let ((out vecNew))
    {
      (for c in cols
        (vecPush out c.text))
      out
    }))

; Rewrite schema entry `e` with a new name, table and statement text.
(:: replaceEntry (-> Exec SchemaEntry String String String (Result Int Error)))
;@axiom:effect(io)
(fn (replaceEntry ex e name table text)
  (let (
    (oldRec (axqlEntryRecord e.kind e.name e.table e.root e.text)?)
    (newRec (axqlEntryRecord e.kind name table e.root text)?)
  )
    (putOver ex btreeSchemaRoot (keyRowid e.rowid) newRec oldRec)))

; The links of a table that gains column `c` as its column `n`.
(:: linksWith (-> Schema TableDef (Vec ColumnDef) ColumnDef Int (Result (Vec LinkDef) Error)))
(fn (linksWith schema t cols c n)
  (let ((out vecNew))
    {
      (for ld in t.links
        (vecPush out ld))
      (if (strIsEmpty c.link)
        (Ok out)
        (if (axqlNameEq c.link t.name)
          {
            (vecPush out (LinkDef n (TableDef t.name t.root cols t.pk vecNew vecNew)))
            (Ok out)
          }
          (let ((tgt (axqlBareTableDef schema c.link)?))
            {
              (vecPush out (LinkDef n tgt))
              (Ok out)
            })))
    }))

; Give every row of `t` the new column's DEFAULT, checked, as table
; `t2` stores it.
(:: widenRows (-> Exec TableDef TableDef Rules (Vec RowRef) (Result Int Error)))
;@axiom:effect(io)
(fn (widenRows ex t t2 rules rows)
  (let (
    (dv (vecGet rules.defaults (vecLen t.cols)))
    (mut failure None)
  )
    {
      (for r in rows
        (if (! (isSome failure))
          (let ((values vecNew))
            {
              (for v in r.values
                (vecPush values v))
              (vecPush values dv)
              (match (match (checkRules ex t2 rules values r.rowid)
                ((Err er3) (Err er3))
                ((Ok _)
                  (match (checkLinks ex t2 values r.rowid)
                    ((Err er2) (Err er2))
                    ((Ok _)
                      (match (axqlRowRecord t r.values)
                        ((Err er1) (Err er1))
                        ((Ok oldRec)
                          (match (axqlRowRecord t2 values)
                            ((Err er) (Err er))
                            ((Ok newRec) (putOver ex t.root (keyRowid r.rowid) newRec oldRec)))
                        ))
                    ))
                ))
                ((Ok _) ())
                ((Err err)
                  (set failure (Some err))
                ))
            })))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok 0)))
    }))

; ALTER TABLE t ADD COLUMN c: every row gets c's DEFAULT, or NULL.
(:: runAlterAdd (-> Exec Schema String ColumnDef (Result Int Error)))
;@axiom:effect(io)
(fn (runAlterAdd ex schema table c)
  (let ((t (axqlTableDef schema table)?))
    (if (>= (axqlColumnIndex t.cols c.name) 0)
      (axqErr axqSchema (concat (concat t.name " already has a column named ") c.name)
        "axqlAlterTable")
      (if c.primaryKey
        (axqErr axqSchema "ALTER TABLE can't add a PRIMARY KEY: the rows already have their rowids"
          "axqlAlterTable")
        (if (&& c.notNull (isNone c.dflt))
          (axqErr axqSchema
            (concat (concat "the new column " c.name)
              " is NOT NULL, so it needs a DEFAULT for the rows already there")
            "axqlAlterTable")
          (let ((cols vecNew))
            {
              (for x in t.cols
                (vecPush cols x))
              (vecPush cols c)
              (let (
                (_ (checkColumns t.name cols)?)
                (_ (checkConstraints ex schema t.name cols)?)
                (links (linksWith schema t cols c (vecLen t.cols))?)
              )
                (let ((t2 (TableDef t.name t.root cols t.pk t.indexes links)))
                  (let (
                    (rules (prepareRules ex t2)?)
                    (rows (collectMatches ex t None)?)
                    (_ (widenRows ex t t2 rules rows)?)
                  )
                    (match (axqlFindEntry schema t.name)
                      ((Some e)
                        (let (
                          (_ (replaceEntry ex e e.name e.table
                               (tableText t.name (columnTexts cols)))?)
                          (_ (pagerBumpSchemaVersion ex.pager)?)
                        )
                          (Ok 0))
                      )
                      ((None)
                        (axqErr axqCorrupt "the table left the schema while it was altered"
                          "axqlAlterTable")
                      )))))
            }))))))

; An index's CREATE INDEX text, on table `table`.
(:: indexTextOn (-> SchemaEntry String (Result String Error)))
(fn (indexTextOn x table)
  (let ((p (axqlParse x.text)?))
    (match p.stmt
      ((SCreateIndex unique _ name _ cols)
        (let ((mut out
          (concat
            (concat
              (concat
                (if unique
                  "CREATE UNIQUE INDEX "
                  "CREATE INDEX ")
                (quoteName name))
              " ON ")
            (concat (quoteName table) " ("))))
          {
            (for (c i) in cols
              (set out (concat out
                         (concat
                           (if (== i 0)
                             ""
                             ", ")
                           (quoteName c)))))
            (Ok (concat out ")"))
          })
      )
      (_
        (axqErr axqCorrupt (concat "an index's statement isn't CREATE INDEX: " x.name)
          "axqlAlterTable")
      ))))

; Rename table entry `e` to `new`: its own entry, its indices' entries,
; and every LINK that points at it.
(:: renameEntries (-> Exec Schema SchemaEntry String (Result Int Error)))
;@axiom:effect(io)
(fn (renameEntries ex schema e new)
  (let ((mut failure None))
    {
      (for x in schema.entries
        (if (! (isSome failure))
          (match (if (== x.rowid e.rowid)
            (match (axqlTableColumns x.text)
              ((Err er) (Err er))
              ((Ok cols)
                (replaceEntry ex x new new (tableText new (relinkedTexts cols e.name new)))
              ))
            (if (&& (strEq x.kind kindIndex) (axqlNameEq x.table e.name))
              (match (indexTextOn x new)
                ((Err er) (Err er))
                ((Ok text) (replaceEntry ex x x.name new text)))
              (if (strEq x.kind kindTable)
                (match (axqlTableColumns x.text)
                  ((Err er) (Err er))
                  ((Ok cols)
                    (let ((mut linked false))
                      {
                        (for c in cols
                          (if (&& (! (strIsEmpty c.link)) (axqlNameEq c.link e.name))
                            (set linked true)))
                        (if linked
                          (replaceEntry ex x x.name x.table
                            (tableText x.name (relinkedTexts cols e.name new)))
                          (Ok 0))
                      })
                  ))
                (Ok 0))))
            ((Ok _) ())
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None)
          (let ((_ (pagerBumpSchemaVersion ex.pager)?))
            (Ok 0))
        ))
    }))

; Whether `e` names the column `name` anywhere.
(:: exprNamesColumn (-> Expr String Bool))
(fn (exprNamesColumn e name)
  (match e
    ((EName n _) (axqlNameEq n name))
    (_
      (let ((mut found false))
        {
          (for c in (axqlChildren e)
            (if (exprNamesColumn c name)
              (set found true)))
          found
        })
    )))

(:: optNamesColumn (-> (Option Expr) String Bool))
(fn (optNamesColumn e name)
  (match e
    ((Some x) (exprNamesColumn x name))
    ((None) false)))

; Give every row of `t` its values without column `drop`, checked as
; table `t2` stores them.
(:: narrowRows (-> Exec TableDef TableDef Rules (Vec RowRef) Int (Result Int Error)))
;@axiom:effect(io)
(fn (narrowRows ex t t2 rules rows drop)
  (let ((mut failure None))
    {
      (for r in rows
        (if (! (isSome failure))
          (let ((values vecNew))
            {
              (for (v i) in r.values
                (if (!= i drop)
                  (vecPush values v)))
              (match (match (checkRules ex t2 rules values r.rowid)
                ((Err er3) (Err er3))
                ((Ok _)
                  (match (checkLinks ex t2 values r.rowid)
                    ((Err er2) (Err er2))
                    ((Ok _)
                      (match (axqlRowRecord t r.values)
                        ((Err er1) (Err er1))
                        ((Ok oldRec)
                          (match (axqlRowRecord t2 values)
                            ((Err er) (Err er))
                            ((Ok newRec) (putOver ex t.root (keyRowid r.rowid) newRec oldRec)))
                        ))
                    ))
                ))
                ((Ok _) ())
                ((Err err)
                  (set failure (Some err))
                ))
            })))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok 0)))
    }))

; ALTER TABLE t DROP COLUMN c: every row loses c. The PRIMARY KEY,
; the only column, a column an index covers, and a column another
; column's DEFAULT or CHECK names are refused: each has something
; else pointing at it.
(:: runAlterDrop (-> Exec Schema String String (Result Int Error)))
;@axiom:effect(io)
(fn (runAlterDrop ex schema table column)
  (let ((t (axqlTableDef schema table)?))
    (let ((drop (axqlColumnIndex t.cols column)))
      (if (< drop 0)
        (axqErr axqSchema (concat (concat "table " t.name) (concat " has no column named " column))
          "axqlAlterTable")
        (if (== drop t.pk)
          (axqErr axqSchema
            (concat (concat "ALTER TABLE can't drop " column) ": it is the PRIMARY KEY")
            "axqlAlterTable")
          (if (== (vecLen t.cols) 1)
            (axqErr axqSchema
              (concat (concat "ALTER TABLE can't drop " column) ": it is the table's only column")
              "axqlAlterTable")
            (let ((indexed
              (let ((mut who ""))
                {
                  (for ix in t.indexes
                    (for ci in ix.cols
                      (if (== ci drop)
                        (set who ix.name))))
                  who
                })))
              (if (! (strIsEmpty indexed))
                (axqErr axqSchema
                  (concat (concat (concat "ALTER TABLE can't drop " column) ": index ")
                    (concat indexed " covers it; drop the index first"))
                  "axqlAlterTable")
                (let ((usedBy
                  (let ((mut who ""))
                    {
                      (for (c i) in t.cols
                        (if (&& (!= i drop)
                              (|| (optNamesColumn c.check column) (optNamesColumn c.dflt column)))
                          (set who c.name)))
                      who
                    })))
                  (if (! (strIsEmpty usedBy))
                    (axqErr axqSchema
                      (concat
                        (concat (concat "ALTER TABLE can't drop " column)
                          ": a DEFAULT or CHECK on ")
                        (concat usedBy " names it"))
                      "axqlAlterTable")
                    (let (
                      (cols vecNew)
                      (links vecNew)
                      (indexes vecNew)
                    )
                      {
                        (for (c i) in t.cols
                          (if (!= i drop)
                            (vecPush cols c)))
                        (for ld in t.links
                          (if (!= ld.col drop)
                            (vecPush links
                              (LinkDef
                                (if (> ld.col drop)
                                  (- ld.col 1)
                                  ld.col)
                                ld.target))))
                        (for ix in t.indexes
                          (let ((icols vecNew))
                            {
                              (for ci in ix.cols
                                (vecPush icols
                                  (if (> ci drop)
                                    (- ci 1)
                                    ci)))
                              (vecPush indexes (IndexDef ix.name ix.root ix.unique icols))
                            }))
                        (let ((t2
                          (TableDef t.name t.root cols
                            (if (> t.pk drop)
                              (- t.pk 1)
                              t.pk)
                            indexes links)))
                          (let (
                            (rules (prepareRules ex t2)?)
                            (rows (collectMatches ex t None)?)
                            (_ (narrowRows ex t t2 rules rows drop)?)
                          )
                            (match (axqlFindEntry schema t.name)
                              ((Some e)
                                (let (
                                  (_ (replaceEntry ex e e.name e.table
                                       (tableText t.name (columnTexts cols)))?)
                                  (_ (pagerBumpSchemaVersion ex.pager)?)
                                )
                                  (Ok 0))
                              )
                              ((None)
                                (axqErr axqCorrupt "the table left the schema while it was altered"
                                  "axqlAlterTable")
                              ))))
                      })))))))))))

; The name inside the quoted name that spans `from` to `to` in `text`,
; with `""` read as one quote.
(:: quotedContent (-> String Int Int String))
(fn (quotedContent text from to)
  (let (
    (mut i (+ from 1))
    (mut out "")
  )
    {
      (while (< i (- to 1))
        (if (&& (== (strByte text i) 34) (== (strByte text (+ i 1)) 34))
          {
            (set out (concat out "\""))
            (set i (+ i 2))
          }
          {
            (set out (concat out (strSlice text i 1)))
            (set i (+ i 1))
          }))
      out
    }))

; `text` with every identifier that names `old` rewritten to `new`:
; the spelling a renamed column leaves in a CREATE TABLE or CREATE
; INDEX text. Quoted names are rewritten too; string literals are
; copied as they are.
(:: renamedIdents (-> String String String String))
(fn (renamedIdents text old new)
  (let (
    (n (strLen text))
    (mut i 0)
    (mut out "")
  )
    {
      (while (< i n)
        (let ((c (strByte text i)))
          (if (== c 39)
            (let ((mut j (+ i 1)))
              {
                (while (< j n)
                  (if (== (strByte text j) 39)
                    (set j (if (&& (< (+ j 1) n) (== (strByte text (+ j 1)) 39))
                      (+ j 2)
                      (+ n 1)))
                    (set j (+ j 1))))
                (let ((end
                  (if (> j n)
                    n
                    j)))
                  {
                    (set out (concat out (strSlice text i (- end i))))
                    (set i end)
                  })
              })
            (if (== c 34)
              (let ((end (nameEnd text i)))
                {
                  (set out (concat out
                             (if (axqlNameEq (quotedContent text i end) old)
                               (quoteName new)
                               (strSlice text i (- end i)))))
                  (set i end)
                })
              (if (|| (strIsAlpha c) (== c 95))
                (let ((end (nameEnd text i)))
                  {
                    (set out (concat out
                               (if (axqlNameEq (strSlice text i (- end i)) old)
                                 (quoteName new)
                                 (strSlice text i (- end i)))))
                    (set i end)
                  })
                {
                  (set out (concat out (strSlice text i 1)))
                  (set i (+ i 1))
                })))))
      out
    }))

; An index entry's CREATE INDEX text with column `old` renamed.
(:: indexTextRenamed (-> SchemaEntry String String (Result String Error)))
(fn (indexTextRenamed x old new)
  (let ((p (axqlParse x.text)?))
    (match p.stmt
      ((SCreateIndex unique _ name _ cols)
        (let ((mut out
          (concat
            (concat
              (concat
                (if unique
                  "CREATE UNIQUE INDEX "
                  "CREATE INDEX ")
                (quoteName name))
              " ON ")
            (concat (quoteName x.table) " ("))))
          {
            (for (c i) in cols
              (set out (concat out
                         (concat
                           (if (== i 0)
                             ""
                             ", ")
                           (quoteName
                             (if (axqlNameEq c old)
                               new
                               c))))))
            (Ok (concat out ")"))
          })
      )
      (_
        (axqErr axqCorrupt (concat "an index's statement isn't CREATE INDEX: " x.name)
          "axqlAlterTable")
      ))))

; ALTER TABLE t RENAME COLUMN old TO new: the rows keep their values;
; the column's name changes in the table's text, in any DEFAULT or
; CHECK that names it, and in the indices that cover it.
(:: runAlterRenameColumn (-> Exec Schema String String String (Result Int Error)))
;@axiom:effect(io)
(fn (runAlterRenameColumn ex schema table old new)
  (let ((t (axqlTableDef schema table)?))
    (let (
      (at (axqlColumnIndex t.cols old))
      (taken (axqlColumnIndex t.cols new))
    )
      (if (< at 0)
        (axqErr axqSchema (concat (concat "table " t.name) (concat " has no column named " old))
          "axqlAlterTable")
        (if (&& (>= taken 0) (!= taken at))
          (axqErr axqSchema (concat (concat t.name " already has a column named ") new)
            "axqlAlterTable")
          (let (
            (cols vecNew)
            (mut failure None)
          )
            {
              (for (c i) in t.cols
                (vecPush cols
                  (ColumnDef
                    (if (== i at)
                      new
                      c.name)
                    c.ctype c.notNull c.primaryKey c.link c.dflt c.check
                    (renamedIdents c.text old new) c.linkAt)))
              (for x in schema.entries
                (if (! (isSome failure))
                  (if (&& (strEq x.kind kindIndex) (axqlNameEq x.table t.name))
                    (match (match (indexTextRenamed x old new)
                      ((Err er) (Err er))
                      ((Ok text) (replaceEntry ex x x.name x.table text)))
                      ((Ok _) ())
                      ((Err err)
                        (set failure (Some err))
                      )))))
              (match failure
                ((Some err) (Err err))
                ((None)
                  (match (axqlFindEntry schema t.name)
                    ((Some e)
                      (let (
                        (_ (replaceEntry ex e e.name e.table
                             (tableText t.name (columnTexts cols)))?)
                        (_ (pagerBumpSchemaVersion ex.pager)?)
                      )
                        (Ok 0))
                    )
                    ((None)
                      (axqErr axqCorrupt "the table left the schema while it was altered"
                        "axqlAlterTable")
                    ))
                ))
            }))))))

; ALTER TABLE t RENAME TO new.
(:: runAlterRename (-> Exec Schema String String (Result Int Error)))
;@axiom:effect(io)
(fn (runAlterRename ex schema table new)
  (match (axqlFindEntry schema table)
    ((None)
      (axqErr axqSchema
        (concat (concat "no such table: " table) (axqlHint table (axqlTableNames schema) "tables"))
        "axqlAlterTable")
    )
    ((Some e)
      (if (! (strEq e.kind kindTable))
        (axqErr axqSchema (concat (concat "no such table: " table) " (it names an index)")
          "axqlAlterTable")
        (match (axqlFindEntry schema new)
          ((Some other)
            (if (!= other.rowid e.rowid)
              (axqErr axqSchema (alreadyNamed other) "axqlAlterTable")
              (renameEntries ex schema e new))
          )
          ((None) (renameEntries ex schema e new))))
    )))

; ------------------------------------------------------------------
; The write entry point.
; ------------------------------------------------------------------
;; Run an INSERT, UPDATE, DELETE or DDL statement inside the caller's
;; write transaction. Answers the rows it changed (0 for DDL).
(pub :: axqlRunWrite (-> Exec Stmt String (Result Int Error)))
;@axiom:effect(io)
(pub fn (axqlRunWrite ex stmt text)
  (let ((schema (axqlLoadSchema ex.pager)?))
    (match stmt
      ((SInsert table cols rows) (runInsert ex schema table cols rows))
      ((SUpsert table cols rows) (runUpsert ex schema table cols rows))
      ((SAlterAdd table c) (runAlterAdd ex schema table c))
      ((SAlterRename table new) (runAlterRename ex schema table new))
      ((SAlterDrop table column) (runAlterDrop ex schema table column))
      ((SAlterRenameColumn table old new) (runAlterRenameColumn ex schema table old new))
      ((SUpdate table cols exprs w) (runUpdate ex schema table cols exprs w))
      ((SDelete table w) (runDelete ex schema table w))
      ((SCreateTable ine name cols) (runCreateTable ex schema ine name cols text))
      ((SDropTable ie name) (runDropTable ex schema ie name))
      ((SCreateIndex unique ine name table cols)
        (runCreateIndex ex schema unique ine name table cols text)
      )
      ((SDropIndex ie name) (runDropIndex ex schema ie name))
      (_ (axqErr axqMisuse "not a statement that writes" "axqlRunWrite")))))

;; Check that a statement's names resolve against the current schema,
;; without running it: the check `axqPrepare` makes. DDL is checked when
;; it runs.
(pub :: axqlCheckNames (-> Exec Schema Stmt (Result Int Error)))
(pub fn (axqlCheckNames ex schema stmt)
  (match stmt
    ((SSelect sel)
      (let (
        (t (if (strIsEmpty sel.from)
          (Ok None)
          (match (axqlTableDef schema sel.from)
            ((Err er) (Err er))
            ((Ok td) (Ok (Some td)))))?)
        (_ (checkAllNames ex t (selectExprs sel))?)
      )
        (Ok 0))
    )
    ((SInsert table cols rows)
      (let (
        (t (axqlTableDef schema table)?)
        (_ (insertTargets ex t cols)?)
      )
        (Ok 0))
    )
    ((SUpsert table cols rows)
      (let (
        (t (axqlTableDef schema table)?)
        (_ (insertTargets ex t cols)?)
      )
        (Ok 0))
    )
    ((SUpdate table cols exprs w)
      (let ((t (axqlTableDef schema table)?))
        (let ((all vecNew))
          {
            (for e in exprs
              (vecPush all e))
            (match w
              ((Some e) (vecPush all e))
              ((None) all))
            (let ((_ (checkAllNames ex (Some t) all)?))
              (Ok 0))
          }))
    )
    ((SDelete table w)
      (let ((t (axqlTableDef schema table)?))
        (match w
          ((Some e)
            (let ((_ (bind ex (Some t) e)?))
              (Ok 0))
          )
          ((None) (Ok 0))))
    )
    (_ (Ok 0))))

; The expressions of a SELECT that bind against its table: the items
; and WHERE. ORDER BY may also name result columns, so it is checked
; when the statement runs.
(:: selectExprs (-> Select (Vec Expr)))
(fn (selectExprs sel)
  (let ((out vecNew))
    {
      (for item in sel.items
        (match item.expr
          ((ELink _ c _)
            (if (strEq c "*")
              out
              (vecPush out item.expr))
          )
          (_ (vecPush out item.expr))))
      (match sel.where
        ((Some e) (vecPush out e))
        ((None) out))
      (for e in sel.groupBy
        (vecPush out e))
      (match sel.having
        ((Some e) (vecPush out e))
        ((None) out))
      out
    }))

(:: checkAllNames (-> Exec (Option TableDef) (Vec Expr) (Result Int Error)))
(fn (checkAllNames ex t es)
  (let ((mut failure None))
    {
      (for e in es
        (if (isNone failure)
          (match (bind ex t e)
            ((Ok _) ())
            ((Err err)
              (set failure (Some err))
            ))))
      (match failure
        ((Some err) (Err err))
        ((None) (Ok 0)))
    }))
