; ------------------------------------------------------------------
; Pages for secrets (`stdlib/Crypto/Secret.ax`). A key lives in a
; private anonymous mapping of its own, outside the arena, so a region
; reset cannot reclaim it under a live handle. The mapping is locked
; so it is not written to swap, and where the kernel has an advice for
; it, left out of core dumps. Both are best effort: `Crypto.Secret`
; answers whether each one took, and a kernel that refuses (an
; `RLIMIT_MEMLOCK` of zero, say) leaves the key usable and unlocked.
; A 0 below means the target has no such call.
; ------------------------------------------------------------------
;; no syscall ABI: `Crypto.Secret` answers an availability error here
(pub :: mapPrivateAnon Int)
(pub fn (mapPrivateAnon)
  0)

;; none
(pub :: sysMlockNum Int)
(pub fn (sysMlockNum)
  0)

;; none
(pub :: sysMunlockNum Int)
(pub fn (sysMunlockNum)
  0)

;; none
(pub :: sysMadviseNum Int)
(pub fn (sysMadviseNum)
  0)

;; none
(pub :: madvNoDump Int)
(pub fn (madvNoDump)
  0)

;; 0: no entropy source is wired on this target yet, so `Crypto.Random` answers an availability error
(pub :: randomUsesRndr Int)
(pub fn (randomUsesRndr)
  0)

; ------------------------------------------------------------------
; TCP beyond connect and accept, for `stdlib/Net.ax`: the two calls that
; name a socket's addresses, a write that takes flags, and the options
; a stream sets. A syscall number of 0 means the target has none.
; ------------------------------------------------------------------
;; getsockname - the address a socket is bound to
(pub :: sysGetSockNameNum Int)
(pub fn (sysGetSockNameNum)
  0)

;; getpeername - the address of the connected peer
(pub :: sysGetPeerNameNum Int)
(pub fn (sysGetPeerNameNum)
  0)

;; sendto - a write that takes flags, for `msgNoSignal`
(pub :: sysSendToNum Int)
(pub fn (sysSendToNum)
  0)

;; SO_RCVTIMEO - how long a read may wait, as a struct timeval
(pub :: soRcvTimeo Int)
(pub fn (soRcvTimeo)
  0)

;; SO_SNDTIMEO - how long a write may wait
(pub :: soSndTimeo Int)
(pub fn (soSndTimeo)
  0)

;; SO_NOSIGPIPE - a write to a closed peer answers EPIPE instead of raising SIGPIPE; 0 where the option does not exist
(pub :: soNoSigPipe Int)
(pub fn (soNoSigPipe)
  0)

;; MSG_NOSIGNAL - the same, per write, for `sendto`; 0 where the flag does not exist
(pub :: msgNoSignal Int)
(pub fn (msgNoSignal)
  0)

;; IPPROTO_TCP - the level TCP options are set at
(pub :: ipprotoTcp Int)
(pub fn (ipprotoTcp)
  6)

;; TCP_NODELAY - send small writes at once rather than join them
(pub :: tcpNoDelayOpt Int)
(pub fn (tcpNoDelayOpt)
  1)

;; IPPROTO_IP - the level of the IPv4 socket options, 0 everywhere.
(pub :: ipprotoIp Int)
(pub fn (ipprotoIp)
  0)

;; IP_TTL - the time-to-live of outgoing IPv4 packets: 2 on Linux, 4 on the
;; BSDs.
(pub :: ipTtl Int)
(pub fn (ipTtl)
  2)

;; IPPROTO_IPV6 - the level of the IPv6 socket options, 41 everywhere.
(pub :: ipprotoIpv6 Int)
(pub fn (ipprotoIpv6)
  41)

;; IPV6_UNICAST_HOPS - the hop limit of outgoing IPv6 packets, IPv6's
;; time-to-live: 16 on Linux, 4 on the BSDs.
(pub :: ipv6UnicastHops Int)
(pub fn (ipv6UnicastHops)
  16)

