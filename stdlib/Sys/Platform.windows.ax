;; is 30 here and 10 on Linux.
(pub :: sigTerm Int)
(pub fn (sigTerm)
  15)

;; The `SIGCHLD` signal number, or zero when child signals are unavailable.
(pub :: sigChild Int)
(pub fn (sigChild)
  0)

;; The `SIGINT` signal number.
(pub :: sigInt Int)
(pub fn (sigInt)
  2)

;; Whether `fork` answers 0 in the child, which is the POSIX convention
;; and what Linux does. Darwin answers the child's pid to both, so
;; `sysForkProcess` normalises; see `sysForkNum` above for the measurement.
(pub :: forkChildIsZero Int)
(pub fn (forkChildIsZero)
  1)

; ------------------------------------------------------------------
; The capability, and the bindings behind it.
; ------------------------------------------------------------------
;; 1 where the platform is reached through raw syscalls, 0 where it
;; goes through the C library or a host shim.
(pub :: usesSyscallAbi Int)
(pub fn (usesSyscallAbi)
  0)

; Not `pub`: the raw bindings stay inside this file, so the public
; surface of every platform module is one set of names. `#0` on the
; emitted declares and the `dllimport` on the runtime's own copies of
; four of these are the emitter's business (`emitWinRuntime`).
(extern "kernel32"
  (winGetStdHandle :: (-> Int Int) (symbol "GetStdHandle"))
  (winWriteFile :: (-> Int Int Int Int Int Int) (symbol "WriteFile"))
  (winReadFile :: (-> Int Int Int Int Int Int) (symbol "ReadFile"))
  (winExitProcess :: (-> Int Int) (symbol "ExitProcess"))
  (winGetLastError :: Int (symbol "GetLastError")))

; HANDLE GetStdHandle(DWORD) - a HANDLE: not masked.
; BOOL WriteFile(HANDLE, LPCVOID, DWORD, LPDWORD, LPOVERLAPPED) - BOOL: masked.
; BOOL ReadFile(HANDLE, LPVOID, DWORD, LPDWORD, LPOVERLAPPED) - BOOL: masked.
; void ExitProcess(UINT) - never returns.
; DWORD GetLastError(void) - DWORD: masked.
; A descriptor to a HANDLE: see the header.
(:: winHandleOf (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(fn (winHandleOf fd)
  (if (== fd 0)
    (winGetStdHandle (- 0 10))
    (if (== fd 1)
      (winGetStdHandle (- 0 11))
      (if (== fd 2)
        (winGetStdHandle (- 0 12))
        fd))))

; A Win32 error code as the errno `Sys.ax`'s callers already test for,
; NEGATED, so every `sysFailed`/`sysErrno` comparison above this file
; is unchanged. The table is the console-and-process half; the file
; half (ERROR_ALREADY_EXISTS -> eExist, ERROR_DIRECTORY -> eIsDir, ...)
; arrives with the bindings that can produce it. Anything unmapped is
; EIO (5): a failure, named as a failure, never mistaken for a count.
(:: winErrnoOf (-> Int Int))
(fn (winErrnoOf code)
  (if (|| (== code 2) (== code 3))
    (- 0 2)
    (if (== code 5)
      (- 0 13)
      (if (== code 6)
        (- 0 9)
        (if (== code 8)
          (- 0 12)
          (if (|| (== code 109) (== code 232))
            (- 0 32)
            (- 0 5)))))))

; The DWORD out-cell `WriteFile`/`ReadFile` write their count through.
; A fresh 8-byte word per call, zeroed by `__alloc`, so the upper half
; of the word is 0 when the kernel has written only the lower four
; bytes - the same hazard `sysWaitPid` zeroes its status cell against.
; `lpNumberOfBytesWritten` may be NULL only when `lpOverlapped` is
; not, so the cell is not optional.
(:: winCell Int)
;@axiom:effect(unsafe)
(fn (winCell)
  (__alloc 8))

;; write(fd, buf, count): `Ok` bytes written, or `Err` carrying the
;; errno `winErrnoOf` maps the last error to.
;; The platform's own way to write to a descriptor where raw `write` is
;; not available; `Err` 78 where the raw syscall is used instead.
(pub :: platformWriteFd (-> Int Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformWriteFd fd buf count)
  {
    (let cell winCell)
    {
      (let ok (& (winWriteFile (winHandleOf fd) buf count cell 0) 4294967295))
      (if (== ok 0)
        (Err (mkError (- 0 (winErrnoOf (& winGetLastError 4294967295))) "platformWriteFd"))
        (Ok (& (__load64 cell 0) 4294967295)))
    }
  })

;; read(fd, buf, count): `Ok` bytes read, `Ok 0` at end of file, or
;; `Err` carrying the errno. A broken pipe (ERROR_BROKEN_PIPE, 109) on a
;; read is end of file, which is what a POSIX read of a closed pipe
;; answers too.
;; The platform's own way to read from a descriptor where raw `read` is
;; not available; `Err` 78 where the raw syscall is used instead.
(pub :: platformReadFd (-> Int Int Int (Result Int Error)))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformReadFd fd buf count)
  {
    (let cell winCell)
    {
      (let ok (& (winReadFile (winHandleOf fd) buf count cell 0) 4294967295))
      (if (== ok 0)
        {
          (let code (& winGetLastError 4294967295))
          (if (== code 109)
            (Ok 0)
            (Err (mkError (- 0 (winErrnoOf code)) "platformReadFd")))
        }
        (Ok (& (__load64 cell 0) 4294967295)))
    }
  })

;; exit(code): `ExitProcess` ends every thread, as `exit_group` does.
;; The platform's own way to end the process where raw `exit` is not
;; available; -78 where the raw syscall is used instead.
(pub :: platformExitWith (-> Int Int))
;@axiom:effect(io)
;@axiom:effect(unsafe)
(pub fn (platformExitWith code)
  (winExitProcess code))

; ------------------------------------------------------------------
; The clock id `Sys.ax` hands to clock_gettime. Windows has no
; clock_gettime and no syscall table; `Sys.ax` asks `usesSyscallAbi`
; before it reaches the `__syscall3` that would take this id, so the
; value is never read on this target. It is declared because every
; platform module declares one public surface (`check-stdlib-api.sh`),
; and 0 is the answer that would be wrong loudest if it ever were read.
; ------------------------------------------------------------------
;; The id `clock_gettime` takes for the monotonic clock: 0, unused on
;; this target, which has no `clock_gettime`.
(pub :: clockMonotonicId Int)
(pub fn (clockMonotonicId)
  0)

;; Whether `Sys.ax` reads the arm64 counter for its monotonic clock,
;; which it does only where `clock_gettime` has none. 0 here.
(pub :: clockHasCounter Int)
(pub fn (clockHasCounter)
  0)

; --------------------------------------------------------------------
; Terminals - UNIMPLEMENTED HERE, AND THAT IS THE ANSWER, NOT A GAP
; SOMEBODY FORGOT.
;
; Windows has no `termios` and no `ioctl`. Its terminal control is a
; different mechanism end to end, not different numbers for the same
; one:
;
;   * the object is a console HANDLE, not a file descriptor, and there
;     is no request-number encoding to get wrong because there are no
;     requests - `GetConsoleMode(h, &mode)` and `SetConsoleMode(h,
;     mode)` take a single DWORD of flags;
;   * that DWORD's bits (ENABLE_ECHO_INPUT, ENABLE_LINE_INPUT,
;     ENABLE_PROCESSED_INPUT, ENABLE_VIRTUAL_TERMINAL_INPUT) are not
;     `termios` bits under other names - line and echo are one input
;     handle's mode, where POSIX splits them across c_lflag and
;     c_iflag, and there is no VMIN/VTIME at all;
;   * "is this a terminal" is `GetFileType(h) == FILE_TYPE_CHAR` or a
;     `GetConsoleMode` that succeeds, not an `ioctl` that answers
;     ENOTTY;
;   * the size is `GetConsoleScreenBufferInfo`, whose `srWindow`
;     rectangle gives rows and columns as a difference of coordinates
;     rather than as a `struct winsize`.
;
; So this module answers `ttyUsesTermios` 0 and `Sys.ax` takes the
; branch that reports "not supported on this target" - the same shape
; as `clockHasMonotonic` on Darwin, where the honest -ENOSYS was
; preferred to substituting a clock that could run backwards.
;
; WHY NOT BIND THE FOUR FUNCTIONS NOW, since this module already binds
; kernel32 and the constants are documented rather than derived. Two
; reasons, and the second is the real one. Files, directories,
; processes, the clock, sockets, entropy and signals are all still a
; later phase here, so a console layer would be the only fully-built
; floor in a module whose header calls itself half-done. And nothing in
; this tree can RUN it: `check-cross-targets.sh` assembles Windows
; objects on this host but executes none, so a binding written today
; would be exactly the plausible-looking unverified code this section's
; POSIX counterparts spend their comments avoiding. The mechanism is
; written down above so that whoever has a Windows box does not have to
; rediscover it.
;
; The eighteen names below are 0 for the reason `clockMonotonicId` is:
; every platform module declares one public surface
; (`check-stdlib-api.sh`), and `ttyUsesTermios` 0 keeps every one of
; them unread.
; --------------------------------------------------------------------
;; Whether this platform's terminal control is the POSIX `termios`
;; trio - read the attributes, edit them, write them back - reached
;; through `ioctl`. Windows answers 0: its mechanism is
;; `GetConsoleMode`/`SetConsoleMode` against a HANDLE, which shares no
;; part of this shape.
(pub :: ttyUsesTermios Int)
(pub fn (ttyUsesTermios)
  0)

;; ioctl(fd, request, arg) - BSD 54, encoded the way every number in
;; this file is: `0x2000000 | 54` = 33554486.
;; Probe: `SYS_ioctl = 54 (0x36)`, `SYS_ioctl encoded = 33554486`.
(pub :: sysIoctlNum Int)
(pub fn (sysIoctlNum)
  0)

;; TIOCGETA - read the terminal attributes into a `struct termios`.
(pub :: tcGetAttrReq Int)
(pub fn (tcGetAttrReq)
  0)

;; TIOCSETAF - write the attributes back, after draining pending output
;; and DISCARDING pending input.
(pub :: tcSetAttrReq Int)
(pub fn (tcSetAttrReq)
  0)

;; TIOCGWINSZ - read `struct winsize`.
(pub :: tcWinSizeReq Int)
(pub fn (tcWinSizeReq)
  0)

;; 0 rather than a plausible size. `Sys.ax` allocates this many bytes
;; for a saved terminal state, and a caller that reached here would get
;; a zero-length buffer and the "unsupported" answer, not a short one it
;; could half-fill.
(pub :: termiosBytes Int)
(pub fn (termiosBytes)
  0)

;; The width of one flag word, which is also the STRIDE of the four of
;; them: `c_iflag` at 0, `c_oflag` at 8, `c_cflag` at 16, `c_lflag` at
;; 24. Probe: `c_iflag@0 c_oflag@8 c_cflag@16 c_lflag@24`, each of
;; `size 8`. The four offsets are `n * termiosFlagBytes` on every
;; platform this library targets, so `Sys.ax` carries one multiplication
;; rather than four constants per module.
(pub :: termiosFlagBytes Int)
(pub fn (termiosFlagBytes)
  0)

;; Where the control-character array `c_cc` begins.
;; Probe: `offsetof c_cc = 32 (size 20, NCCS 20)`.
(pub :: termiosCcOff Int)
(pub fn (termiosCcOff)
  0)

;; The two `c_cc` slots that mean something once ICANON is off: how many
;; bytes a `read` must collect before it returns, and how long it waits
;; in tenths of a second. Probe: `VMIN = 16`, `VTIME = 17`.
(pub :: termiosVminIdx Int)
(pub fn (termiosVminIdx)
  0)

;; The index of `VTIME` in the termios control-character array.
(pub :: termiosVtimeIdx Int)
(pub fn (termiosVtimeIdx)
  0)

;; c_lflag bits. Probe: `ECHO = 0x8 (8)`, `ICANON = 0x100 (256)`,
;; `ISIG = 0x80 (128)`, `IEXTEN = 0x400 (1024)`.
(pub :: tiosEcho Int)
(pub fn (tiosEcho)
  0)

;; The `ICANON` local-mode flag: line editing by the terminal.
(pub :: tiosIcanon Int)
(pub fn (tiosIcanon)
  0)

;; The `ISIG` local-mode flag: the terminal turns Ctrl-C into a signal.
(pub :: tiosIsig Int)
(pub fn (tiosIsig)
  0)

;; The `IEXTEN` local-mode flag: extended input processing.
(pub :: tiosIexten Int)
(pub fn (tiosIexten)
  0)

;; c_iflag bits. Probe: `BRKINT = 0x2`, `ICRNL = 0x100`,
;; `ISTRIP = 0x20`, `IXON = 0x200`.
(pub :: tiosBrkint Int)
(pub fn (tiosBrkint)
  0)

;; The `ICRNL` input flag: carriage return becomes newline.
(pub :: tiosIcrnl Int)
(pub fn (tiosIcrnl)
  0)

;; The `ISTRIP` input flag: strip the eighth bit.
(pub :: tiosIstrip Int)
(pub fn (tiosIstrip)
  0)

;; The `IXON` input flag: Ctrl-S and Ctrl-Q flow control.
(pub :: tiosIxon Int)
(pub fn (tiosIxon)
  0)

;; The one c_oflag bit raw mode touches. Probe: `OPOST = 0x1`, and it
;; is 0x1 on Linux and FreeBSD too.
(pub :: tiosOpost Int)
(pub fn (tiosOpost)
  0)

