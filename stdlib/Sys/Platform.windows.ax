(pub :: pollUsesKqueue Int)
(pub fn (pollUsesKqueue)
  0)

;; kqueue() - BSD 362. Takes no arguments.
(pub :: sysPollCreateNum Int)
(pub fn (sysPollCreateNum)
  0)

;; kevent(kq, changelist, nchanges, eventlist, nevents, timeout) - BSD
;; 363, and it is BOTH of epoll's calls: `sysPollCtlNum` names the same
