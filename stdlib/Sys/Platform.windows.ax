(pub :: signalUsesSignalFd Int)
(pub fn (signalUsesSignalFd)
  1)

;; sigprocmask(how, set, oset) - BSD 48.
(pub :: sysSigProcMaskNum Int)
(pub fn (sysSigProcMaskNum)
  0)

;; SIG_BLOCK, which is 1 HERE AND 0 ON LINUX. The values are not shared
;; and the wrong one is `SIG_UNBLOCK` on Darwin - it would unblock the
;; signal it was asked to block, and the process would take the default
;; disposition and die.
(pub :: sigBlockHow Int)
(pub fn (sigBlockHow)
  0)

;; Darwin's `sigset_t` is a single `__uint32_t` - FOUR bytes, against
;; Linux's kernel `sigset_t` of eight. Nothing reads a size argument
;; here, but the buffer's width is what the kernel copies.
(pub :: sigsetBytes Int)
(pub fn (sigsetBytes)
  8)

;; Unused on Darwin (see `signalUsesSignalFd`), but defined so that
;; `Sys.ax` type-checks against every platform module.
(pub :: sysSignalFdNum Int)
(pub fn (sysSignalFdNum)
  0)

;; The size of one `signalfd_siginfo` record, or 0 where none is read.
(pub :: sigInfoSize Int)
(pub fn (sigInfoSize)
  128)

;; EVFILT_SIGNAL, the filter that marks an event as a signal rather than
;; a readable socket. Unused on Linux, where the distinction is which
;; descriptor woke instead.
(pub :: pollSignalFilter Int)
(pub fn (pollSignalFilter)
  0)

;; kill(pid, sig) - BSD 37.
(pub :: sysKillNum Int)
(pub fn (sysKillNum)
  0)

;; SIGTERM and SIGINT AGREE on all four targets, which is worth naming
