(pub :: randomIsGetentropy Int)
(pub fn (randomIsGetentropy)
  0)

;; The most bytes one random-bytes syscall may fill at a time.
(pub :: randomMaxChunk Int)
(pub fn (randomMaxChunk)
  256)

;; 1 where signals are read from a `signalfd`, 0 where a `kqueue`
