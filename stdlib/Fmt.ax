;;! Fmt - number formatting, in Axiom.
;
; This module is what replaced `printf`. Formatting an integer used to
; have meant an FFI binding to a C variadic function - a construct Axiom's
; type system cannot describe and its effect analysis cannot see through.
; Doing it in Axiom instead is about 40 lines, is fully type-checked, and
; leaves nothing for a C library to do.
(import Mem)
(import Str)
(import Float (floatToFixed))

; True for the one `Int` that is its own negation: the most negative
; value, whose magnitude does not fit in an `Int`. Zero negates to itself
; too, so it is excluded.
;
; The value has no positive counterpart. Testing its arithmetic property
; keeps this helper independent of the literal spelling.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: intIsMostNegative (-> Int Bool))
(fn (intIsMostNegative n)
  (&& (< n 0) (== (- 0 n) n)))

;; Decimal digits in `n`, counting a leading `-` and treating 0 as one
;; digit.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(pub :: fmtIntWidth (-> Int Int))
(pub fn (fmtIntWidth n)
  (if (intIsMostNegative n)
    20  ; "-9223372036854775808"
    (if (< n 0)
      (+ 1 (fmtIntWidth (- 0 n)))
      (if (< n 10)
        1
        (+ 1 (fmtIntWidth (/ n 10)))))))

;; `n` in base 10 as a `Str`.
;
; Digits are written back-to-front into an exactly-sized buffer, which
; avoids both a reverse pass and the "how big should the scratch buffer
; be" guess that the C version needed.
;
; `Int` is 64-bit and two's complement, so the most negative value has no
; positive counterpart. Negating it yields itself, so every path that
; formats `|n|` - `fmtNat`, and `fmtIntWidth` inside it - recurses
; forever on that one input. It has exactly one spelling, so it is
; answered outright.
;
; Detected with `intIsMostNegative`, not by comparing against a literal:
; the guard here used to read `(== n (- 0 9223372036854775807))`, which
; is `MIN + 1` and therefore never true of `MIN` itself.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtInt (-> Int String))
(pub fn (fmtInt n)
  (if (intIsMostNegative n)
    "-9223372036854775808"
    (if (< n 0)
      (concat "-" (fmtNat (- 0 n)))
      (fmtNat n))))

;; Format a word's bits as an unsigned decimal integer. `format` uses
;; this for fixed-width unsigned values through their word representation.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtUIntWord (-> Int String))
(pub fn (fmtUIntWord n)
  (if (>= n 0)
    (fmtInt n)
    {
      (let quotient (/ (& (>> n 1) 9223372036854775807) 5))
      (let digit (- n (* quotient 10)))
      (concat (fmtInt quotient) (strFromByte (+ 48 digit)))
    }))

; `n` (assumed non-negative) in base 10.
;@axiom:restrict(no-io,no-foreign)
(:: fmtNat (-> Int String))
(fn (fmtNat n)
  {
    (let width (fmtIntWidth n))
    {
      (let out (strAlloc width))
      {
        (fmtDigits (strData out) n (- width 1))
        out
      }
    }
  })

; Write `n`'s decimal digits into `buf` ending at index `at`, working
; right to left.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtDigits (-> Int Int Int Int))
;@axiom:effect(unsafe)
(fn (fmtDigits buf n at)
  {
    (let digit (+ 48 (% n 10)))
    {
      (__store8 buf at digit)
      (if (< n 10)
        buf
        (fmtDigits buf (/ n 10) (- at 1)))
    }
  })

; `n` in base 16, lower case, no `0x` prefix, no leading zeros.
;
; Used for addresses and bit patterns in compiler diagnostics, where
; decimal is unreadable.
; Hexadecimal is UNSIGNED - the word's bits, as Rust's `{:x}` prints
; them - so `-1` is `ffffffffffffffff` and not a one-byte answer.
;
; It printed one byte until 2026-08-15, and the byte was garbage:
; `(% -1 16)` is `-1` under signed remainder, `48 + -1` is 47, and
; `(fmtHex -1)` answered `/`. `(/ n 16)` compounded it, rounding
; toward zero so the loop stopped after one digit. Nothing in the
; corpus had ever passed a negative - `020-fmt` covers 0, 255 and
; 48879 - and nothing could reach it from a print until the `{n:x}`
; specifier existed, which is what surfaced it.
;
; The fix is to divide by SHIFTING and to take digits by MASKING,
; which is unsigned by construction. `>>` sign-extends, so the mask
; clears the four bits it dragged in; a logical `>>` would make the
; mask a no-op rather than wrong, so this is correct either way.
;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtHexShr4 (-> Int Int))
(fn (fmtHexShr4 n)
  (& (>> n 4) 1152921504606846975))

;; `n` in lowercase hexadecimal with no prefix, such as `ff` for 255. A
;; negative number is written as its two's-complement 64-bit word.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtHex (-> Int String))
(pub fn (fmtHex n)
  (if (== n 0)
    "0"
    {
      (let width (fmtHexWidth n 0))
      {
        (let out (strAlloc width))
        {
          (fmtHexDigits (strData out) n (- width 1))
          out
        }
      }
    }))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtHexWidth (-> Int Int Int))
(fn (fmtHexWidth n acc)
  (if (== n 0)
    acc
    (fmtHexWidth (fmtHexShr4 n) (+ acc 1))))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtHexDigits (-> Int Int Int Int))
;@axiom:effect(unsafe)
(fn (fmtHexDigits buf n at)
  {
    (let nibble (& n 15))
    {
      (let digit
        (if (< nibble 10)
          (+ 48 nibble)
          (+ 87 nibble)))
      {
        (__store8 buf at digit)
        {
          (let rest (fmtHexShr4 n))
          (if (== rest 0)
            buf
            (fmtHexDigits buf rest (- at 1)))
        }
      }
    }
  })

;; `s` padded on the left with spaces to at least `width` bytes.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtPadLeft (-> String Int String))
(pub fn (fmtPadLeft s width)
  {
    (let len (strLen s))
    (if (>= len width)
      s
      {
        (let out (strAlloc width))
        {
          (memSet (strData out) 32 (- width len))
          (memCopy (+ (strData out) (- width len)) (strData s) len)
          out
        }
      })
  })

;; `s` padded on the right with spaces to at least `width` bytes.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtPadRight (-> String Int String))
(pub fn (fmtPadRight s width)
  {
    (let len (strLen s))
    (if (>= len width)
      s
      {
        (let out (strAlloc width))
        {
          (memCopy (strData out) (strData s) len)
          (memSet (+ (strData out) len) 32 (- width len))
          out
        }
      })
  })

;; `s` centred in `width` bytes, with an odd remainder on the right, as
;; Rust's `{:^}` does.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtPadCenter (-> String Int String))
(pub fn (fmtPadCenter s width)
  {
    (let len (strLen s))
    (if (>= len width)
      s
      {
        (let pad (- width len))
        {
          (let left (/ pad 2))
          {
            (let out (strAlloc width))
            {
              (memSet (strData out) 32 left)
              (memCopy (+ (strData out) left) (strData s) len)
              (memSet (+ (strData out) (+ left len)) 32 (- pad left))
              out
            }
          }
        }
      })
  })

;; `s` padded on the left with zeros to at least `width` bytes, keeping a
;; leading sign in front of them: `-7` at width 4 is `-007`. This is the
;; `{n:04}` specifier.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtPadZerosLeft (-> String Int String))
;@axiom:effect(unsafe)
(pub fn (fmtPadZerosLeft s width)
  {
    (let len (strLen s))
    (if (>= len width)
      s
      {
        (let neg
          (if (== len 0)
            0
            (if (== (strByte s 0) 45)
              1
              0)))
        (let out (strAlloc width))
        {
          (if (== neg 1)
            (__store8 (strData out) 0 45))
          (memSet (+ (strData out) neg) 48 (- width len))
          (memCopy (+ (strData out) (+ neg (- width len))) (+ (strData s) neg) (- len neg))
          out
        }
      })
  })

;; `n` in uppercase hexadecimal with no prefix, such as `FF` for 255: the
;; `{n:X}` specifier.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtHexUpper (-> Int String))
(pub fn (fmtHexUpper n)
  (if (== n 0)
    "0"
    {
      (let width (fmtHexWidth n 0))
      {
        (let out (strAlloc width))
        {
          (fmtHexDigitsUpper (strData out) n (- width 1))
          out
        }
      }
    }))

;@axiom:restrict(no-io,no-alloc,no-foreign)
(:: fmtHexDigitsUpper (-> Int Int Int Int))
;@axiom:effect(unsafe)
(fn (fmtHexDigitsUpper buf n at)
  {
    (let nibble (& n 15))
    {
      (let digit
        (if (< nibble 10)
          (+ 48 nibble)
          (+ 55 nibble)))
      {
        (__store8 buf at digit)
        {
          (let rest (fmtHexShr4 n))
          (if (== rest 0)
            buf
            (fmtHexDigitsUpper buf rest (- at 1)))
        }
      }
    }
  })

; ------------------------------------------------------------------
; Floating point
; ------------------------------------------------------------------
;
; Fixed and shortest formatting share Float's exact decimal expansion.
; Fmt keeps the explicit precision API; Float owns conversion and rounding.
;; `x` with six decimal places.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtFloat (-> Float String))
(pub fn (fmtFloat x)
  (fmtFloatPrec x 6))

;; `x` with `places` decimal places, rounded from its exact binary64
;; value, halfway cases away from zero. Negative precision means zero;
;; values above 4096 trap. The integer part covers every finite Float.
;@axiom:restrict(no-io,no-foreign)
(pub :: fmtFloatPrec (-> Float Int String))
(pub fn (fmtFloatPrec x places)
  (floatToFixed x places))
